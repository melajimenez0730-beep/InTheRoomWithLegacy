---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, Users, BookOpen, ArrowRight, Lightbulb, DollarSign, Home, BookMarked } from "lucide-react";
---

<BaseLayout
  title="About Us | In the Room With Legacy"
  description="In the Room with Legacy™ was born in a sacred transition, helping families build and preserve legacy across generations."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          This didn't start with strategy. It started with a story.
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          In the Room with Legacy™ was born in a sacred transition.
        </p>
      </div>
    </div>
  </section>

  <!-- Origin Story Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="relative rounded-lg overflow-hidden shadow-xl">
            <img 
              src="https://images.unsplash.com/photo-1594394489098-74349fae8325?w=800&auto=format&fit=crop&q=80"
              alt="Founder story" 
              class="w-full h-auto object-cover aspect-square"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 to-transparent mix-blend-multiply"></div>
          </div>

          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
              About Our Journey
            </h2>
            <p class="text-foreground/80 mb-4">
              In the Room with Legacy™ began with our founder's personal experience navigating the complex emotions and logistics of family transition. When her grandmother passed, leaving behind a home filled with memories but no clear plan, she found herself asking: "Why don't we talk about these things before crisis hits?"
            </p>
            <p class="text-foreground/80 mb-4">
              That question sparked a mission to help families navigate transitions with intention, preserving what matters most while building for the future.
            </p>
            <p class="text-foreground/80">
              Today, we're creating a suite of tools, resources, and experiences that fuse culture with commerce, tradition with technology, and story with strategy—because legacy isn't just what you leave behind. It's what you live.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Believe Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          What We Believe
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Users className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Families are powerful institutions.</h3>
            </div>
            <p class="text-foreground/80">
              They are the first unit of organization, education, and economic development in our lives.
            </p>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Heart className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Intangible wealth is just as valuable as money.</h3>
            </div>
            <p class="text-foreground/80">
              Stories, values, and cultural wisdom are forms of wealth that deserve to be protected and passed on.
            </p>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <BookOpen className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Storytelling is a strategic asset.</h3>
            </div>
            <p class="text-foreground/80">
              The stories we tell shape our identity, values, and future across generations.
            </p>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Lightbulb className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Stewardship should be taught, not assumed.</h3>
            </div>
            <p class="text-foreground/80">
              The next generation deserves the skills and knowledge to carry forward what matters.
            </p>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10 md:col-span-2">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Home className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Strong families are the blueprint for economic and cultural resilience.</h3>
            </div>
            <p class="text-foreground/80">
              When families thrive, communities and economies thrive alongside them.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Vision Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Our Vision
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          We've seen too much mess and confusion when families navigate transitions without preparation. The sad, preventable story of heirs unprepared for wealth, businesses that die with their founders, and family conflicts that arise from unclear expectations.
        </p>
        <p class="text-lg text-foreground/80 mb-10 text-center font-medium">
          Our radical idea? Every family deserves access to the tools, conversations, and cultural touchstones that make legacy last.
        </p>
      </div>
    </div>
  </section>

  <!-- Five Pillars Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Five Pillars
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <Home className="text-primary w-8 h-8" />
            </div>
            <h3 class="text-lg font-display font-semibold text-primary mb-2">Family Legacy</h3>
            <p class="text-sm text-foreground/80">Preserving stories, values, and cultural touchstones</p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <Lightbulb className="text-primary w-8 h-8" />
            </div>
            <h3 class="text-lg font-display font-semibold text-primary mb-2">Next Gen Stewardship</h3>
            <p class="text-sm text-foreground/80">Preparing heirs for wealth, responsibility, and leadership</p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <BookOpen className="text-primary w-8 h-8" />
            </div>
            <h3 class="text-lg font-display font-semibold text-primary mb-2">Storytelling & Culture</h3>
            <p class="text-sm text-foreground/80">Using narrative as a tool for identity and strategy</p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 flex flex-col items-center text-center md:col-start-2">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <DollarSign className="text-primary w-8 h-8" />
            </div>
            <h3 class="text-lg font-display font-semibold text-primary mb-2">Economic Empowerment</h3>
            <p class="text-sm text-foreground/80">Building and transferring wealth across generations</p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <Heart className="text-primary w-8 h-8" />
            </div>
            <h3 class="text-lg font-display font-semibold text-primary mb-2">Transitions & Healing</h3>
            <p class="text-sm text-foreground/80">Navigating change with intentionality and care</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two Arms Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Two Arms, One Mission
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 hover:border-primary/30 transition-all hover:shadow-md">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Heart className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">IRL Non-Profit</h3>
            </div>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Programs & Retreats</span>
              </li>
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Legacy Building Resources</span>
              </li>
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Community & Network Building</span>
              </li>
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Sponsored Family Programs</span>
              </li>
            </ul>
          </div>

          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 hover:border-primary/30 transition-all hover:shadow-md">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <BookMarked className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">IRL Advisors (For Profit)</h3>
            </div>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">AI-powered Legacy Assessment Tool</span>
              </li>
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Family Business Consulting</span>
              </li>
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Family Meeting Facilitation</span>
              </li>
              <li class="flex items-start gap-3">
                <ArrowRight className="text-primary flex-shrink-0 w-5 h-5 mt-1" />
                <span class="text-foreground/80">Professional Network & Referrals</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-24 bg-primary/5">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Want to support the mission?
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          We're actively seeking aligned partners, sponsors, and collaborators who believe in preserving and amplifying family legacy.
        </p>
        <a 
          href="/contact" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium"
          })}
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>