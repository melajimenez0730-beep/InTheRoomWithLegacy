---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, Users, BookOpen, ArrowRight, Lightbulb, DollarSign, Home, BookMarked, Quote, Star, HandHeart, BookOpenText, Info } from "lucide-react";
import { Image } from 'astro:assets';
import legacyFamilyPhoto from '../../assets/legacy_family_photo_nw_633bbeb1.jpg';
import youngLaurenWithDad from '../../assets/young-lauren-with-dad_nw_5c036dd2.jpg';
import missionImage from '../../assets/mission_nw_4129c880.png';
import visionImage from '../../assets/vision_nw_30412df3.png';
import vintagePaperBg from '../../assets/vintage-paper-background_nw_b3d4f5e6.jpg';
import businessOfFamily from '../../assets/the-business-of-family_nw_b2773ef0.png';
import familyPorch from '../../assets/family_on_porch_nw_6bf9f9ad.jpg';
import laurenMiller from '../../assets/kat_6276_nw_fcaf81f0.jpg';
import logoImage from '../../assets/1-1_nw_565f5565.png';
import legacyCollage from '../../assets/legacy_collage_nw_ddd335e4.png';
import supportMissionImage from '../../assets/support-this-mission_nw_575ae3f7.png';
import MethodologyTabs from "@/components/MethodologyTabs";
import MethodologyAccordion from "@/components/MethodologyAccordion";
---

<BaseLayout
  title="About Us | In the Room With Legacy"
  description="In the Room with Legacy™ was born in a sacred transition, helping families build and preserve legacy across generations."
>
  <!-- Hero Section -->
  <section class="relative min-h-[600px] md:min-h-[700px] flex items-center justify-center overflow-hidden">
    <!-- Background image with parallax effect -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full parallax-container">
        <div class="parallax-image">
          <Image 
            src={businessOfFamily} 
            alt="The Business of Family - multigenerational family gathering" 
            class="w-full h-full object-cover brightness-[0.9] sepia-[0.1]" 
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-primary/30 to-primary/75 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="container relative z-10 py-16 md:py-24 flex flex-col items-center justify-center h-full">
      <div class="max-w-4xl mx-auto text-center my-auto">
        <div class="hero-content-fade-in">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight text-white leading-tight mb-8 px-4 drop-shadow-sm">
            The Business of Family
          </h1>
          <h2 class="text-xl md:text-2xl lg:text-3xl text-white/95 font-medium mb-16 px-4 max-w-3xl mx-auto drop-shadow-sm leading-relaxed">
            Beyond Wealth. Beyond Money. Beyond One Generation.
          </h2>
        </div>
      </div>
      
      <!-- Hero content only -->
    </div>
    
    <!-- Hero Section Styles -->
    <style>
      /* Parallax Effect */
      .parallax-container {
        position: relative;
        height: 130%;
        top: -15%;
      }
      
      .parallax-image {
        position: absolute;
        height: 100%;
        width: 100%;
        animation: subtle-parallax 30s ease-in-out infinite alternate;
      }
      
      @keyframes subtle-parallax {
        0% { transform: translateY(0); }
        100% { transform: translateY(-5%); }
      }
      
      /* Enhanced Ticker Styling */
      .ticker-scroll-container {
        /* Removed background for transparency */
      }
      
      .ticker-item {
        display: inline-block;
        padding: 0 60px;
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.125rem;
        letter-spacing: 0.02em;
        position: relative;
      }
      
      /* Glowing text effect */
      .ticker-item.glow {
        text-shadow: 
          0 0 5px rgba(255, 255, 255, 0.8),
          0 0 10px rgba(255, 255, 255, 0.6),
          0 0 15px rgba(255, 255, 255, 0.4),
          0 0 20px rgba(255, 255, 255, 0.2);
        font-weight: 400;
        color: white;
      }
      
      @media (min-width: 768px) {
        .ticker-item {
          font-size: 1.25rem;
        }
      }
      
      /* Ticker Animation */
      .ticker-wrapper {
        display: inline-block;
        white-space: nowrap;
        animation: ticker 40s linear infinite;
        will-change: transform;
      }
      
      @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      
      /* Fade Edge Effects removed for clean ticker animation */
      
      /* Fade-in Animation for Hero Content */
      .hero-content-fade-in {
        animation: fade-in 1.5s ease-out;
      }
      
      @keyframes fade-in {
        0% { opacity: 0; transform: translateY(10px); }
        100% { opacity: 1; transform: translateY(0); }
      }
    </style>
  </section>

  <!-- Who We Are Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Who We Are
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              In the Room with Legacy™ (IRL) is a platform, movement & home for those building with intention. A place where the business of family, heritage, and wealth come together. Through storytelling, programs, and technology, we make legacy a living practice.
            </p>
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              By bridging the emotional, cultural and financial dimensions of legacy, we help transform awareness into action by equipping families, individuals, and communities with the tools and frameworks to build and preserve what matters most.
            </p>
            <p class="text-foreground/80 text-lg leading-relaxed">
              
            </p>
          </div>

          <div class="relative rounded-lg overflow-hidden shadow-xl aspect-square flex items-center justify-center p-8 bg-white">
            <Image 
              src={logoImage} 
              alt="In the Room with Legacy logo" 
              class="w-full h-full object-contain" 
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-width Ticker Statement Section -->
  <section class="relative overflow-hidden w-full bg-primary text-white">
    <div class="ticker-scroll-container overflow-hidden w-full">
      <!-- Ticker content -->
      <div class="ticker-wrapper whitespace-nowrap py-4">
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          What We Do
        </h2>
        <div class="max-w-4xl mx-auto mb-12">
          <!-- Introduction -->
          <p class="text-lg text-foreground/80 mb-6 text-center">
            Every offering, from our workshops to our technology, is designed to make legacy a living practice. Our work lives at the intersection of four pathways that together make legacy real, relevant, and repeatable:
          </p>
          
          <!-- Desktop Category Tabs -->
          <MethodologyTabs client:load />
          
          <!-- Mobile Category Accordion -->
          <MethodologyAccordion client:load />
          
        </div>
      </div>
    </div>
    
    <!-- All cards are now non-interactive, no filtering logic needed -->
    <style>
      .legacy-dimension-card {
        transition: all 0.3s ease-in-out;
      }
    </style>
  </section>

  <!-- The Pillars That Guide Our Work Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          The Pillars That Guide Our Work
        </h2>
        <div class="max-w-4xl mx-auto mb-12">
          <!-- Five Dimensions of Legacy - Modern Card Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" id="dimensions-grid">
            <!-- Family Legacy Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <HandHeart class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Family Legacy</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Building a foundation of values, traditions, and practices that strengthen family identity and connection across generations.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling & Documentation</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Learning & Tools</span>
                </div>
              </div>
            </div>
            
            <!-- Next-Gen Stewardship Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Users class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Next-Gen Stewardship</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Preparing future generations to receive, maintain, and grow the family's legacy through education, mentorship, and guided experience.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory & Community</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Experiences & Programs</span>
                </div>
              </div>
            </div>
            
            <!-- Storytelling & Culture Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <BookOpenText class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Storytelling & Culture</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Capturing, preserving, and sharing the narratives, values, and wisdom that define your family's unique cultural heritage.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Learning & Tools</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling & Documentation</span>
                </div>
              </div>
            </div>
            
            <!-- Economic Empowerment Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <DollarSign class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Economic Empowerment</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Creating sustainable financial foundations and teaching principles that support multigenerational wealth stewardship and growth.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Experiences & Programs</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory & Community</span>
                </div>
              </div>
            </div>
            
            <!-- Transitions & Healing Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10 md:col-span-2 max-w-lg mx-auto">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Lightbulb class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Transitions & Healing</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Navigating major life changes, succession planning, and healing fractured relationships to ensure continuity during pivotal moments.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling & Documentation</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Experiences & Programs</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory & Community</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Mission & Vision Section -->
  <section class="py-24 bg-[#052d3f]">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-10 text-center">
          Mission & Vision
        </h2>
        
        <!-- Paper texture frame with decorative border -->
        <div class="relative overflow-hidden rounded-xl mb-16 shadow-lg mission-vision-container">
          <!-- Paper texture background -->
          <div class="absolute inset-0 z-0 opacity-10">
            <Image 
              src={vintagePaperBg}
              alt=""
              class="w-full h-full object-cover filter saturate-50"
            />
          </div>
          
          <!-- Decorative border -->
          <div class="absolute inset-0 z-0 border-8 border-white/20 rounded-xl pointer-events-none opacity-60"></div>
          
          <!-- Split-screen Layout with scroll reveal animations -->
          <div class="relative z-10 flex flex-col md:flex-row mission-vision-panels">
            <!-- Mission Side (Left on desktop) -->
            <div class="mission-side flex-1 relative min-h-[400px] transition-all duration-500 ease-in-out md:hover:flex-[1.3] p-8 md:p-10 bg-[#052d3f]/90 backdrop-blur-sm hover-zoom-panel animate-fade-up-mission">
              <div class="relative z-20">
                <div class="flex items-center gap-2 mb-6">
                  <h3 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white section-heading">Mission</h3>
                  <button class="info-tooltip-trigger ml-2 focus:outline-none" aria-label="Mission info" data-tooltip-id="mission-tooltip">
                    <Info class="w-5 h-5 md:w-6 md:h-6 text-white hover:text-white/90 transition-colors" />
                  </button>
                  <div id="mission-tooltip" class="tooltip-content hidden absolute left-0 bottom-full mb-2 w-64 p-4 bg-[#052d3f]/95 backdrop-blur-sm shadow-lg rounded-lg border border-white/20 z-50 text-sm text-white/90">
                    <p>Our mission began as a personal journey of care and remembrance.</p>
                  </div>
                </div>
                <p class="text-xl text-white/90 font-medium mb-6 leading-relaxed max-w-lg">
                  Our mission is to make legacy building and preservation accessible to all, transforming how individuals and families see themselves and their collective power to leverage their heritage, resources, and relationships to build enduring legacy.
                </p>
                <div class="w-20 h-1 bg-white/30 rounded-full my-6"></div>
                <div class="mt-6 md:mt-10">
                  <div class="inline-block rounded-full p-3 bg-white/20">
                    <HandHeart class="w-6 h-6 text-white" />
                  </div>
                </div>
              </div>
              
              <!-- Mission photo background -->
              <div class="absolute inset-0 z-10 opacity-15 transition-opacity duration-500 mission-bg-image">
                <Image 
                  src={missionImage}
                  alt="Multigenerational family in community garden"
                  class="w-full h-full object-cover object-center"
                />
              </div>
            </div>
            
            <!-- Divider for desktop -->
            <div class="hidden md:block w-px bg-white/20 mx-0"></div>
            
            <!-- Divider for mobile -->
            <div class="block md:hidden h-px bg-white/20 my-0"></div>
            
            <!-- Vision Side (Right on desktop) -->
            <div class="vision-side flex-1 relative min-h-[400px] transition-all duration-500 ease-in-out md:hover:flex-[1.3] p-8 md:p-10 bg-[#052d3f]/80 backdrop-blur-sm hover-zoom-panel animate-fade-up-vision">
              <div class="relative z-20">
                <div class="flex items-center gap-2 mb-6">
                  <h3 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white italic section-heading">Vision</h3>
                  <button class="info-tooltip-trigger ml-2 focus:outline-none" aria-label="Vision info" data-tooltip-id="vision-tooltip">
                    <Info class="w-5 h-5 md:w-6 md:h-6 text-white hover:text-white/90 transition-colors" />
                  </button>
                  <div id="vision-tooltip" class="tooltip-content hidden absolute left-0 bottom-full mb-2 w-64 p-4 bg-[#052d3f]/95 backdrop-blur-sm shadow-lg rounded-lg border border-white/20 z-50 text-sm text-white/90">
                    <p>We envision a future where stories and values are passed down with the same care as financial assets.</p>
                  </div>
                </div>
                <p class="text-xl text-white/90 font-medium mb-6 leading-relaxed italic max-w-lg">
                  A world where legacy is a living practice. Where families operate with clarity, unity, and generational purpose.
                </p>
                <div class="w-20 h-1 bg-white/30 rounded-full my-6"></div>
                <p class="text-lg text-white/90 italic max-w-lg">
                  We envision communities built on strong family foundations, where legacy transcends wealth to include wisdom, values, and stewardship.
                </p>
                <div class="mt-6 md:mt-10">
                  <div class="inline-block rounded-full p-3 bg-white/20">
                    <Lightbulb class="w-6 h-6 text-white" />
                  </div>
                </div>
              </div>
              
              <!-- Vision photo background -->
              <div class="absolute inset-0 z-10 opacity-15 transition-opacity duration-500 vision-bg-image">
                <Image 
                  src={visionImage}
                  alt="Family reading together in garden with tree of knowledge mural"
                  class="w-full h-full object-cover object-center"
                />
              </div>
            </div>
          </div>
        </div>
        
        <!-- Decorative elements -->
        <div class="relative h-6 w-full flex justify-center items-center mb-16">
          <div class="w-32 h-px bg-white/20"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-white/20"></div>
        </div>
      </div>
    </div>
    
    <!-- Interactive effects for split-screen layout -->
    <style>
      /* Panel hover effects for desktop */
      @media (min-width: 768px) {
        .mission-side:hover .mission-bg-image,
        .vision-side:hover .vision-bg-image {
          opacity: 0.15;
        }
        
        /* Panel expansion/contraction animation */
        .mission-side, .vision-side {
          transition: flex 0.5s ease-in-out, background-color 0.3s ease;
        }

        /* Hover zoom effect for panel content */
        .hover-zoom-panel .relative.z-20 {
          transition: transform 0.5s ease;
        }
        
        /* Disable hover effects on mobile */
        :not(.mobile-view) .hover-zoom-panel:hover .relative.z-20 {
          transform: scale(1.02);
        }
        
        /* Background parallax effect on hover - desktop only */
        .mission-side .mission-bg-image img,
        .vision-side .vision-bg-image img {
          transition: transform 0.5s ease-out;
        }
        
        :not(.mobile-view) .mission-side:hover .mission-bg-image img {
          transform: scale(1.05) translateY(-5px);
        }
        
        :not(.mobile-view) .vision-side:hover .vision-bg-image img {
          transform: scale(1.05) translateY(-5px);
        }
      }
      
      /* Paper texture styling */
      .mission-vision-container {
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
      }
      
      .mission-vision-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
        pointer-events: none;
        z-index: 15;
      }
      
      /* Key word styling removed as requested */
      
      /* Enhanced heading styling */
      .section-heading {
        position: relative;
        display: inline-block;
      }
      
      /* Info tooltip styling */
      .info-tooltip-trigger {
        opacity: 0.7;
        transition: opacity 0.2s ease;
        position: relative;
      }
      
      .info-tooltip-trigger:hover {
        opacity: 1;
      }
      
      .tooltip-content {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      
      .tooltip-content.animate-fade-in {
        opacity: 1;
        transform: translateY(0);
      }
      
      /* Scroll triggered animations */
      .mission-vision-panels {
        opacity: 0;
        animation: fade-in-panels 1.2s ease forwards;
        animation-play-state: paused;
      }
      
      .animate-fade-up-mission {
        opacity: 0;
        animation: fade-up 0.8s ease forwards;
        animation-delay: 0.2s;
        animation-play-state: paused;
      }
      
      .animate-fade-up-vision {
        opacity: 0;
        animation: fade-up 0.8s ease forwards;
        animation-delay: 0.5s;
        animation-play-state: paused;
      }
      
      /* Define the animations */
      @keyframes fade-in-panels {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      
      @keyframes fade-up {
        from { 
          opacity: 0;
          transform: translateY(30px);
        }
        to { 
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      /* IntersectionObserver script to trigger animations */
      :global(.intersecting) {
        animation-play-state: running !important;
      }
    </style>
    
    <script>
      // Wait for DOM content to load
      document.addEventListener('DOMContentLoaded', () => {
        // Set up Intersection Observer for animations
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            // If the element is in the viewport
            if (entry.isIntersecting) {
              // Add the 'intersecting' class
              entry.target.classList.add('intersecting');
              // Unobserve after animation has been triggered
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 }); // Trigger when 20% of the element is visible
        
        // Observe the panels container
        const panelsContainer = document.querySelector('.mission-vision-panels');
        if (panelsContainer) {
          observer.observe(panelsContainer);
        }
        
        // Observe individual panels
        const missionPanel = document.querySelector('.animate-fade-up-mission');
        const visionPanel = document.querySelector('.animate-fade-up-vision');
        
        if (missionPanel) observer.observe(missionPanel);
        if (visionPanel) observer.observe(visionPanel);

        // Tooltip functionality
        const tooltipTriggers = document.querySelectorAll('.info-tooltip-trigger');
        
        tooltipTriggers.forEach(trigger => {
          const tooltipId = trigger.getAttribute('data-tooltip-id');
          const tooltip = document.getElementById(tooltipId);
          
          // Only set up if tooltip exists
          if (!tooltip) return;
          
          // Show tooltip on mouse enter or touch
          trigger.addEventListener('mouseenter', () => {
            tooltip.classList.remove('hidden');
            tooltip.classList.add('animate-fade-in');
          });
          
          // Hide tooltip on mouse leave
          trigger.addEventListener('mouseleave', () => {
            tooltip.classList.add('hidden');
            tooltip.classList.remove('animate-fade-in');
          });

          // For mobile - toggle tooltip on click
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            tooltip.classList.toggle('hidden');
            
            if (!tooltip.classList.contains('hidden')) {
              tooltip.classList.add('animate-fade-in');
              
              // Close tooltip when clicking outside of it (for mobile)
              const closeOnClickOutside = (e) => {
                if (!tooltip.contains(e.target) && !trigger.contains(e.target)) {
                  tooltip.classList.add('hidden');
                  tooltip.classList.remove('animate-fade-in');
                  document.removeEventListener('click', closeOnClickOutside);
                }
              };
              
              // Set timeout to allow the current click event to finish
              setTimeout(() => {
                document.addEventListener('click', closeOnClickOutside);
              }, 0);
            } else {
              tooltip.classList.remove('animate-fade-in');
            }
          });
        });
        
        // Disable animations on mobile
        function handleViewportChange(mediaQuery) {
          const isMobile = !mediaQuery.matches; // matches returns true for min-width: 768px
          
          // If mobile, add a class to the container to disable hover effects
          document.querySelector('.mission-vision-container')?.classList.toggle('mobile-view', isMobile);
        }
        
        // Set up media query for desktop/mobile detection
        const mediaQuery = window.matchMedia('(min-width: 768px)');
        
        // Initial check
        handleViewportChange(mediaQuery);
        
        // Set up listener for viewport changes
        mediaQuery.addEventListener('change', handleViewportChange);
      });
    </script>
  </section>



