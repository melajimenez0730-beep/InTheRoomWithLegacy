---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, Users, BookOpen, ArrowRight, Lightbulb, DollarSign, Home, BookMarked, Quote, Star, HandHeart, BookOpenText } from "lucide-react";
import { Image } from 'astro:assets';
import legacyFamilyPhoto from '../../assets/legacy_family_photo_nw_633bbeb1.jpg';
import familyGathering from '../../assets/family_gathering_nw_664eb12a.jpg';
import familyPorch from '../../assets/family_on_porch_nw_6bf9f9ad.jpg';
import laurenMiller from '../../assets/kat_6276_nw_fcaf81f0.jpg';
import logoImage from '../../assets/1-1_nw_565f5565.png';
import legacyCollage from '../../assets/legacy_collage_nw_ddd335e4.png';
import MethodologyTabs from "@/components/MethodologyTabs";
import MethodologyAccordion from "@/components/MethodologyAccordion";
---

<BaseLayout
  title="About Us | In the Room With Legacy"
  description="In the Room with Legacy™ was born in a sacred transition, helping families build and preserve legacy across generations."
>
  <!-- Hero Section -->
  <section class="relative min-h-[600px] md:min-h-[700px] flex items-center justify-center overflow-hidden">
    <!-- Background image with parallax effect -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full parallax-container">
        <div class="parallax-image">
          <Image 
            src={familyGathering} 
            alt="Warm multigenerational family gathering" 
            class="w-full h-full object-cover brightness-[0.9] sepia-[0.1]" 
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-primary/30 to-primary/75 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="container relative z-10 py-16 md:py-24 flex flex-col items-center justify-center h-full">
      <div class="max-w-4xl mx-auto text-center my-auto">
        <div class="hero-content-fade-in">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight text-white leading-tight mb-8 px-4 drop-shadow-sm">
            The Business of Family
          </h1>
          <h2 class="text-xl md:text-2xl lg:text-3xl text-white/95 font-medium mb-16 px-4 max-w-3xl mx-auto drop-shadow-sm leading-relaxed">
            Beyond Wealth. Beyond Money. Beyond One Generation.
          </h2>
        </div>
      </div>
      
      <!-- Full-width Ticker Container -->
      <div class="ticker-scroll-container absolute bottom-16 left-0 right-0 overflow-hidden w-full">
        <!-- Ticker content -->
        <div class="ticker-wrapper whitespace-nowrap py-4">
          <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
          <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
          <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
          <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
          <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
          <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        </div>
      </div>
    </div>
    
    <!-- Hero Section Styles -->
    <style>
      /* Parallax Effect */
      .parallax-container {
        position: relative;
        height: 130%;
        top: -15%;
      }
      
      .parallax-image {
        position: absolute;
        height: 100%;
        width: 100%;
        animation: subtle-parallax 30s ease-in-out infinite alternate;
      }
      
      @keyframes subtle-parallax {
        0% { transform: translateY(0); }
        100% { transform: translateY(-5%); }
      }
      
      /* Enhanced Ticker Styling */
      .ticker-scroll-container {
        /* Removed background for transparency */
      }
      
      .ticker-item {
        display: inline-block;
        padding: 0 60px;
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.125rem;
        letter-spacing: 0.02em;
        position: relative;
      }
      
      /* Glowing text effect */
      .ticker-item.glow {
        text-shadow: 
          0 0 5px rgba(255, 255, 255, 0.8),
          0 0 10px rgba(255, 255, 255, 0.6),
          0 0 15px rgba(255, 255, 255, 0.4),
          0 0 20px rgba(255, 255, 255, 0.2);
        font-weight: 400;
        color: white;
      }
      
      @media (min-width: 768px) {
        .ticker-item {
          font-size: 1.25rem;
        }
      }
      
      /* Ticker Animation */
      .ticker-wrapper {
        display: inline-block;
        white-space: nowrap;
        animation: ticker 40s linear infinite;
        will-change: transform;
      }
      
      @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      
      /* Fade Edge Effects removed for clean ticker animation */
      
      /* Fade-in Animation for Hero Content */
      .hero-content-fade-in {
        animation: fade-in 1.5s ease-out;
      }
      
      @keyframes fade-in {
        0% { opacity: 0; transform: translateY(10px); }
        100% { opacity: 1; transform: translateY(0); }
      }
    </style>
  </section>

  <!-- Who We Are Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Who We Are
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              In the Room with Legacy™ (IRL) is a platform and movement.
            </p>
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              We bridge emotional
            </p>
            <p class="text-foreground/80 text-lg leading-relaxed">
              We walk with families at every stage of legacy: those planting the first seeds and setting new foundations, those working to bring everyone together and create structure, those carrying forward what's been entrusted to them, those reconnecting with roots and stories, and those preparing for the closing chapters of life with care and clarity.
            </p>
          </div>

          <div class="relative rounded-lg overflow-hidden shadow-xl aspect-square flex items-center justify-center p-8 bg-white">
            <Image 
              src={logoImage} 
              alt="In the Room with Legacy logo" 
              class="w-full h-full object-contain" 
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          What We Do
        </h2>
        <div class="max-w-4xl mx-auto mb-12">
          <!-- Introduction -->
          <p class="text-lg text-foreground/80 mb-6 text-center">
            In the Room with Legacy™ helps families thrive across generations through programs, tools, and resources designed to turn values into practice and legacy into action.
          </p>
          
          <!-- Desktop Category Tabs -->
          <MethodologyTabs client:load />
          
          <!-- Mobile Category Accordion -->
          <MethodologyAccordion client:load />
          
          <!-- Five Dimensions of Legacy - Modern Card Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" id="dimensions-grid">
            <!-- Family Legacy Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" data-categories="conversation storytelling">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <HandHeart class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Family Legacy</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Building a foundation of values, traditions, and practices that strengthen family identity and connection across generations.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Conversation</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling</span>
                </div>
              </div>
            </div>
            
            <!-- Next-Gen Stewardship Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" data-categories="assessment advisory">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Users class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Next-Gen Stewardship</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Preparing future generations to receive, maintain, and grow the family's legacy through education, mentorship, and guided experience.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Assessment</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory</span>
                </div>
              </div>
            </div>
            
            <!-- Storytelling & Culture Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" data-categories="storytelling conversation">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <BookOpenText class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Storytelling & Culture</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Capturing, preserving, and sharing the narratives, values, and wisdom that define your family's unique cultural heritage.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Conversation</span>
                </div>
              </div>
            </div>
            
            <!-- Economic Empowerment Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" data-categories="advisory assessment">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <DollarSign class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Economic Empowerment</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Creating sustainable financial foundations and teaching principles that support multigenerational wealth stewardship and growth.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Assessment</span>
                </div>
              </div>
            </div>
            
            <!-- Transitions & Healing Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10 md:col-span-2 max-w-lg mx-auto" data-categories="conversation advisory assessment">
              <div class="p-6">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Lightbulb class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Transitions & Healing</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-4">
                      Navigating major life changes, succession planning, and healing fractured relationships to ensure continuity during pivotal moments.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-2">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Conversation</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Assessment</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Interactive Logic for Categories and Dimensions -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const dimensionCards = document.querySelectorAll('.legacy-dimension-card');
        
        // Function to handle filtering of dimensions based on selected category
        function filterDimensions(categoryId) {
          // If no category is selected (or null is passed), show all dimensions
          if (!categoryId) {
            dimensionCards.forEach(card => {
              card.classList.remove('opacity-40');
              card.classList.remove('scale-95');
              card.classList.add('scale-100');
            });
            return;
          }
          
          // Otherwise, filter dimensions based on selected category
          dimensionCards.forEach(card => {
            const categories = card.getAttribute('data-categories').split(' ');
            
            if (categories.includes(categoryId)) {
              card.classList.remove('opacity-40');
              card.classList.remove('scale-95');
              card.classList.add('scale-100');
              card.classList.add('ring-2');
              card.classList.add('ring-primary/20');
            } else {
              card.classList.add('opacity-40');
              card.classList.add('scale-95');
              card.classList.remove('scale-100');
              card.classList.remove('ring-2');
              card.classList.remove('ring-primary/20');
            }
          });
        }
        
        // Expose filter function to window for component access
        window.filterMethodologyDimensions = filterDimensions;
        
        // Initialize all dimensions visible
        filterDimensions(null);
      });
    </script>
    
    <style>
      .legacy-dimension-card {
        transition: all 0.3s ease-in-out;
      }
    </style>
  </section>
  
  <!-- Mission & Vision Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Mission & Vision
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-stretch mb-16">
          <!-- Mission Column -->
          <div class="bg-[#f9f8f6] p-8 md:p-10 rounded-xl shadow-sm border border-primary/5">
            <h3 class="text-2xl font-display font-bold text-primary mb-6">Mission</h3>
            <p class="text-xl text-foreground/90 font-medium mb-6 leading-relaxed">
              To transform how families see themselves — not just as relatives, but as powerful institutions.
            </p>
            <div class="w-20 h-1 bg-primary/30 rounded-full my-6"></div>
            <p class="text-lg text-foreground/80">
              We help families develop clarity, tools, and systems that transform how they build and preserve legacy. 
            </p>
          </div>
          
          <!-- Vision Column -->
          <div class="bg-primary/5 p-8 md:p-10 rounded-xl shadow-sm border border-primary/5">
            <h3 class="text-2xl font-display font-bold text-primary mb-6 italic">Vision</h3>
            <p class="text-xl text-foreground/90 font-medium mb-6 leading-relaxed italic">
              A world where families operate with clarity, unity, and generational purpose.
            </p>
            <div class="w-20 h-1 bg-primary/30 rounded-full my-6"></div>
            <p class="text-lg text-foreground/80 italic">
              We envision communities built on strong family foundations, where legacy transcends wealth to include wisdom, values, and stewardship.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Beliefs & Manifesto Section -->
  <section class="py-24 bg-[#F7F7F7]">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Our Beliefs & Manifesto
        </h2>
        
        <div class="text-center mb-12 relative">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-16 h-1 bg-primary/20 rounded-full"></div>
          
          <div class="max-w-2xl mx-auto px-6 py-12 bg-white rounded-xl shadow-sm">
            <p class="text-xl md:text-2xl text-primary/80 font-medium leading-relaxed mb-6">
              We believe family is sacred — an evolving institution of heritage, responsibility, and care.
            </p>
            
            <p class="text-xl md:text-2xl text-primary/80 font-medium leading-relaxed mb-6">
              We commit to creating systems, stories, and structures that last beyond one lifetime.
            </p>
            
            <p class="text-xl md:text-2xl text-primary/80 font-medium leading-relaxed mb-8">
              We honor the work, the joy, and the truth of legacy in motion.
            </p>
            
            <div class="flex justify-center">
              <a 
                href="/about/manifesto" 
                class="group inline-flex items-center gap-2 text-primary/80 font-medium hover:text-primary transition-colors"
              >
                Read the Full Manifesto <ArrowRight className="h-4 w-4 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>
          
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-16 h-1 bg-primary/20 rounded-full"></div>
        </div>
      </div>
    </div>
  </section>


  <!-- About the Founder Section -->
  <section class="py-24 bg-[#f9f8f6]">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          About the Founder
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
          <!-- Image - Left -->
          <div class="relative rounded-xl overflow-hidden shadow-xl">
            <Image 
              src={laurenMiller} 
              alt="Lauren Rosa Miller, Founder & Chief Legacy Officer" 
              class="w-full h-auto object-cover" 
            />
          </div>

          <!-- Content - Right -->
          <div>
            <div class="mb-3">
              <p class="text-primary/70 text-sm font-semibold uppercase tracking-wider">Founder & Chief Legacy Officer</p>
            </div>
            
            <h3 class="text-2xl font-display font-bold text-primary mb-6">
              Lauren Rosa Miller
            </h3>
            
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              Lauren Rosa Miller is a second-generation business owner, speaker, and legacy strategist who serves as keeper of her family's 150-year heritage.
            </p>
            
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              The daughter of pioneers in government and economic inclusion, she bridges business, heritage, and heart to help families move with clarity and purpose.
            </p>
            
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              A global citizen and storyteller at heart, Lauren has dedicated her career to preserving what matters most — not just wealth, but wisdom and identity.
            </p>
            
            <p class="text-foreground/80 mb-8 text-lg leading-relaxed">
              She founded In the Room with Legacy™ to bring structure and soul to the way families build and sustain their legacies.
            </p>
            
            <div class="flex">
              <a 
                href="/about/founder-letter" 
                class={buttonVariants({
                  variant: "outline",
                  size: "lg",
                  class: "border-primary text-primary hover:bg-primary/5"
                })}
              >
                Read Lauren's Letter
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Support This Mission Section -->
  <section class="relative py-24 overflow-hidden">
    <!-- Patterned Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <div class="w-full h-full">
        <Image 
          src={legacyCollage} 
          alt="" 
          class="w-full h-full object-cover opacity-30 filter grayscale"
          quality="mid"
        />
        <div class="absolute inset-0 bg-[#052d3f]/90 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white mb-8 drop-shadow-sm">
          Support This Mission
        </h2>
        
        <p class="text-xl md:text-2xl text-white font-medium mb-6 max-w-3xl mx-auto leading-relaxed drop-shadow-sm">
          Our flagship program, While We're Still Here™, is live today.
        </p>
        
        <p class="text-lg text-white/95 mb-6 max-w-3xl mx-auto leading-relaxed">
          Your investment helps families access meaningful conversations, guided frameworks, and tools for preserving their legacies.
        </p>
        
        <p class="text-lg text-white/95 mb-10 max-w-3xl mx-auto leading-relaxed">
          Partner with us to make legacy-building accessible to every generation.
        </p>
        
        <div class="flex justify-center">
          <a 
            href="/about/partnership-pathways" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium bg-white text-secondary hover:bg-white/90 border-0 text-lg py-6 px-8"
            })}
          >
            Partner With Us
          </a>
        </div>
      </div>
    </div>
    
    <!-- Subtle Texture Overlay -->
    <div class="absolute inset-0 bg-texture opacity-10 pointer-events-none z-[1]"></div>
    
