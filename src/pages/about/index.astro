---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, Users, BookOpen, ArrowRight, Lightbulb, DollarSign, Home, BookMarked, Quote, Star } from "lucide-react";
import { Image } from 'astro:assets';
import legacyFamilyPhoto from '../../assets/legacy_family_photo_nw_633bbeb1.jpg';
import familyGathering from '../../assets/family_gathering_nw_664eb12a.jpg';
import familyPorch from '../../assets/family_on_porch_nw_6bf9f9ad.jpg';
---

<BaseLayout
  title="About Us | In the Room With Legacy"
  description="In the Room with Legacy™ was born in a sacred transition, helping families build and preserve legacy across generations."
>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden">
    <!-- Background image with overlay -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full">
        <Image 
          src={legacyFamilyPhoto} 
          alt="Family heritage photo showing multigenerational connections" 
          class="w-full h-full object-cover brightness-[0.85] sepia-[0.15]" 
        />
        <div class="absolute inset-0 bg-primary/60 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-4 px-4">
          The Business of Family
        </h1>
        <h2 class="text-xl md:text-2xl text-white/90 font-medium mb-6 px-4">
          Beyond Wealth. Beyond Money. Beyond One Generation.
        </h2>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto px-4">
          In the Room with Legacy is reimagining what it means to build, sustain, and pass down legacy.
        </p>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto px-4">
          We help families move with unity, intention, and purpose; creating lives, businesses, and communities that stand the test of time.
        </p>
      </div>
    </div>
  </section>

  <!-- About Us Intro Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          In the Room with Legacy
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="text-foreground/80 mb-6">
              In the Room with Legacy (IRL) is a platform, a movement, and a philosophy.
            </p>
            <p class="text-foreground/80 mb-6">
              We exist to help people understand the purpose and power of family; not just as a set of relationships, but as a living institution capable of shaping identity, wealth, and well-being for generations.
            </p>
            <p class="text-foreground/80 mb-6">
              We walk with families at every stage of legacy: those planting the first seeds and setting new foundations, those working to bring everyone together and give their family structure, those carrying forward what has been entrusted to them, those reaching back to reconnect with the stories and roots that shaped them, and those who are preparing for the closing chapters of life with care and clarity.
            </p>
            <p class="text-foreground/80">
              Through storytelling, programs, and practical tools, we help families move from intention to action and from preservation to progression.
            </p>
          </div>

          <div class="relative rounded-lg overflow-hidden shadow-xl aspect-square">
            <Image 
              src={familyGathering} 
              alt="Family gathering around table, sharing moments and creating legacy" 
              class="w-full h-full object-cover" 
            />
            <div class="absolute inset-0 bg-primary/10 mix-blend-overlay"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          What We Do
        </h2>
        <div class="max-w-3xl mx-auto text-center mb-12">
          <p class="text-lg text-foreground/80 mb-6">
            We create experiences, education, and systems that help families and individuals build and sustain legacy with clarity and care.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            Through guided conversations, strategic planning, and holistic tools, we bridge the gap between heritage and foresight—empowering families to preserve what matters and prepare for what's next.
          </p>
          <p class="text-lg text-foreground/80">
            From the While We're Still Here guided legacy program to the Legacy Assessment Tool and our storytelling and advisory work, every IRL experience is designed to help families live, lead, and plan with purpose.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div class="relative rounded-lg overflow-hidden shadow-xl aspect-video">
            <Image 
              src={familyPorch} 
              alt="Family on porch, planning and connecting" 
              class="w-full h-full object-cover" 
            />
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 text-center flex flex-col items-center hover:shadow-md transition-all">
              <div class="w-14 h-14 mb-4 rounded-full bg-primary/10 flex items-center justify-center">
                <BookOpen class="text-primary h-7 w-7" />
              </div>
              <h4 class="font-display font-medium text-primary">Conversation</h4>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 text-center flex flex-col items-center hover:shadow-md transition-all">
              <div class="w-14 h-14 mb-4 rounded-full bg-primary/10 flex items-center justify-center">
                <Star class="text-primary h-7 w-7" />
              </div>
              <h4 class="font-display font-medium text-primary">Assessment</h4>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 text-center flex flex-col items-center hover:shadow-md transition-all">
              <div class="w-14 h-14 mb-4 rounded-full bg-primary/10 flex items-center justify-center">
                <BookMarked class="text-primary h-7 w-7" />
              </div>
              <h4 class="font-display font-medium text-primary">Advisory</h4>
            </div>
            
            <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10 text-center flex flex-col items-center hover:shadow-md transition-all">
              <div class="w-14 h-14 mb-4 rounded-full bg-primary/10 flex items-center justify-center">
                <Quote class="text-primary h-7 w-7" />
              </div>
              <h4 class="font-display font-medium text-primary">Storytelling</h4>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Mission Statement Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Mission Statement
        </h2>
        
        <div class="bg-muted/10 rounded-lg p-8 md:p-12 border border-primary/10 mb-12 text-center">
          <p class="text-xl text-foreground/90 font-medium mb-6">
            Our mission is to transform how families see themselves; not just as relatives, but as powerful institutions capable of creating and sustaining value across generations.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            We help families build legacy with strategy, governance, and foresight. True wealth is more than money; it includes wisdom, culture, and relationships.
          </p>
          <p class="text-lg text-foreground/80">
            Through storytelling, governance, and strategic planning, we equip families with the tools to strengthen their foundation, preserve their influence, and shape their future with intention.
          </p>
        </div>
        
        <h3 class="text-2xl font-display font-semibold text-primary mb-8 text-center">
          What We Believe
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-start gap-4 mb-2">
              <div class="flex-shrink-0 mt-1">
                <div class="w-3 h-3 rotate-45 bg-secondary"></div>
              </div>
              <p class="text-foreground/80 font-medium">
                Families are powerful institutions — not just personal relationships
              </p>
            </div>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-start gap-4 mb-2">
              <div class="flex-shrink-0 mt-1">
                <div class="w-3 h-3 rotate-45 bg-secondary"></div>
              </div>
              <p class="text-foreground/80 font-medium">
                Intangible wealth is just as valuable as money
              </p>
            </div>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-start gap-4 mb-2">
              <div class="flex-shrink-0 mt-1">
                <div class="w-3 h-3 rotate-45 bg-secondary"></div>
              </div>
              <p class="text-foreground/80 font-medium">
                Storytelling is a strategic asset
              </p>
            </div>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-start gap-4 mb-2">
              <div class="flex-shrink-0 mt-1">
                <div class="w-3 h-3 rotate-45 bg-secondary"></div>
              </div>
              <p class="text-foreground/80 font-medium">
                Stewardship should be taught, not assumed
              </p>
            </div>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-start gap-4 mb-2">
              <div class="flex-shrink-0 mt-1">
                <div class="w-3 h-3 rotate-45 bg-secondary"></div>
              </div>
              <p class="text-foreground/80 font-medium">
                Strong families are the blueprint for economic and cultural resilience
              </p>
            </div>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-start gap-4 mb-2">
              <div class="flex-shrink-0 mt-1">
                <div class="w-3 h-3 rotate-45 bg-secondary"></div>
              </div>
              <p class="text-foreground/80 font-medium">
                Legacy is not something you leave — it's something you live.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision Statement Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Vision Statement
        </h2>
        
        <div class="relative rounded-lg overflow-hidden mb-12">
          <Image 
            src={familyPorch} 
            alt="Panoramic view of family legacy across generations" 
            class="w-full h-[300px] object-cover" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent flex items-end">
            <div class="p-8 text-center w-full">
              <p class="text-xl text-white font-medium mb-3">
                We envision a world where families intentionally build, sustain, and evolve their legacies; ensuring their values, influence, and contributions endure across generations.
              </p>
              <p class="text-lg text-white/90">
                Through holistic legacy-building, we empower families to be the architects of their own future, preserving both tangible and intangible wealth with clarity and purpose.
              </p>
            </div>
          </div>
        </div>
        
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          What We Believe
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Belief 1 -->
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10">
            <h3 class="text-xl font-display font-semibold text-primary mb-4">Families Are the Solution</h3>
            <p class="text-foreground/80">
              We believe that restoring and strengthening families is the key to solving many of the economic, social, and cultural challenges we face today. When family structures are fractured, history is lost, cycles of struggle repeat, and communities weaken.
            </p>
            <p class="text-foreground/80 mt-3">
              By rebuilding strong family foundations—whether through blood or chosen bonds—we don't just address symptoms; we create lasting solutions that shape the future.
            </p>
          </div>
          
          <!-- Belief 2 -->
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10">
            <h3 class="text-xl font-display font-semibold text-primary mb-4">Intangible Wealth is as Valuable as Tangible Wealth</h3>
            <p class="text-foreground/80">
              True wealth is not just financial assets…it's wisdom, identity, values, and relationships. While money can be lost, regained, and multiplied, the intangible assets of a family are what sustain wealth across generations.
            </p>
          </div>
          
          <!-- Belief 3 -->
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10">
            <h3 class="text-xl font-display font-semibold text-primary mb-4">Family Unity Turns Legacy Into Momentum</h3>
            <p class="text-foreground/80">
              A unified family is more than just a group of relatives; it is a powerful force for progress. When families move together with shared values, vision, and purpose, they create stability, multiply opportunities, and accelerate generational success.
            </p>
            <p class="text-foreground/80 mt-3">
              Activating your family through collaboration, resource-sharing, or collective decision-making ensures that wealth, wisdom, and culture are not only preserved but expanded.
            </p>
          </div>
          
          <!-- Belief 4 -->
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10">
            <h3 class="text-xl font-display font-semibold text-primary mb-4">Holistic Legacy Building</h3>
            <p class="text-foreground/80">
              Legacy is not just about inheritance—it's about intentionally building, sustaining, and evolving what a family stands for, from one generation to the next. From seeds to sequoias, legacies must be planted, nurtured, and grown over time.
            </p>
            <p class="text-foreground/80 mt-3">
              We honor the belief that family—in all its forms—holds the blueprint for continuity, belonging, and progress.
            </p>
          </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Manifesto Section -->
  <section class="py-24 bg-muted/30 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="relative w-full h-full">
        <Image 
          src={legacyFamilyPhoto} 
          alt="Multi-generational family legacy" 
          class="w-full h-full object-cover opacity-20 brightness-75" 
        />
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Our Manifesto
        </h2>
        
        <div class="bg-white/80 backdrop-blur-sm p-8 md:p-12 rounded-lg shadow-lg text-center">
          <p class="text-xl text-primary font-medium mb-6">
            Legacy is the visible and invisible thread that connects generations.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            Honoring the past, shaping the present, and securing the future.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            At In the Room with Legacy, we believe that families are strongest when they are intentional about their history, their actions today, and the future they are building.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            Without guidance, wisdom is lost. Without connection, traditions fade. Without intention, the next generation starts over instead of building upon a strong foundation.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            That's why we exist: to help families not only preserve their stories but actively create their legacy in real time.
          </p>
          <p class="text-lg text-foreground/80 mb-6">
            By strengthening bonds, stewarding resources, and shaping culture, families can build a legacy that is both deeply rooted and forward-focused.
          </p>
          <p class="text-lg text-foreground/80">
            Because when families honor their past, take action in the present, and invest in their future, their legacy doesn't just live on—it thrives.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Two Arms, One Mission Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Two Arms. One Mission.
        </h2>
        <p class="text-lg text-foreground/80 mb-12 text-center max-w-3xl mx-auto">
          IRL Advisors and IRL Non-profit create a holistic ecosystem for families and institutions—weaving mission-driven programs with strategic advisory and tools.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-primary text-white p-8 rounded-lg">
            <h3 class="text-2xl font-display font-semibold mb-6">IRL Non Profit</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Programs & Retreats</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Guiding Legacy Conversations While We're Still Here!</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Storytelling & Cultural Missions</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Community & Convenings</span>
              </li>
            </ul>
          </div>

          <div class="bg-secondary text-white p-8 rounded-lg">
            <h3 class="text-2xl font-display font-semibold mb-6">IRL Advisors (For Profit)</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>AI-powered Legacy Assessment Tool</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Strategic Advisory & Governance Design</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Products & Licensing</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Immersive Retreats to look to the land</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-white mt-1">⦁</span>
                <span>Events & Experiences</span>
              </li>
            </ul>
          </div>
        </div>
        
        <p class="text-center text-lg text-foreground/80 mt-8 max-w-3xl mx-auto">
          IRL builds community and culture. IRL Advisors builds tools and strategy. Together, they help families move in unison across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- About the Founder Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
          <div class="relative rounded-lg overflow-hidden shadow-xl bg-muted/20 aspect-square flex items-center justify-center">
            <div class="text-muted-foreground/50 text-center">
              <p class="font-medium">Founder Image</p>
              <p class="text-sm">(Image placeholder)</p>
            </div>
          </div>

          <div>
            <h2 class="text-3xl font-display font-bold text-primary mb-6">
              About the Founder, Lauren R. Miller
            </h2>
            <p class="text-foreground/80 mb-6">
              Lauren is a serial entrepreneur, business builder, speaker, and visionary reimagining the foundation of legacy. She believes that legacy is not only something you leave—it's something you live—on purpose.
            </p>
            <p class="text-foreground/80 mb-6">
              
            </p>
            <p class="text-foreground/80">
              Influenced by her heritage, Lauren has carried her family's ethos into her own path of global citizenship. From building a thriving, fast-paced marketing company that merged a new generation of Black women in venture capital to embarking on a deeply personal journey toward inspiring families through storytelling, Lauren's mission is to heal and re-imagine what we believe is possible for ourselves, our families, and communities. She believes legacy is not something you leave—it's something you live—on purpose.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing Statement Section -->
  <section class="py-24 bg-white text-center">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-display font-bold text-primary mb-8">
          Rooted in where we come from. Grounded in who we are. Committed to who's coming after us.
        </h2>
        <p class="text-xl text-foreground/80 italic">
          Sacred roots. Strategic futures.
        </p>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-primary/5">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-primary mb-4 sm:mb-6">
          Want to support the mission?
        </h2>
        <p class="text-base sm:text-lg text-foreground/80 mb-6 sm:mb-10">
          We're actively seeking aligned partners, sponsors, and collaborators who believe in preserving and amplifying family legacy.
        </p>
        <div class="w-full max-w-md mx-auto mb-8">
          <a 
            href="/contact" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium w-full justify-center"
            })}
          >
            Contact Us
          </a>
        </div>
        
        <p class="text-foreground/70">Email us – <a href="mailto:hello@intheroomwithlegacy.com" class="text-primary hover:underline">hello@intheroomwithlegacy.com</a></p>
      </div>
    </div>
  </section>
</BaseLayout>