---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, Users, BookOpen, ArrowRight, Lightbulb, DollarSign, Home, BookMarked, Quote, Star, HandHeart, BookOpenText, Info, User, BookCopy, CircleDollarSign, Sprout } from "lucide-react";
import { Image } from 'astro:assets';
// TimeTriggeredModal import removed to disable floating CTA on this page
import legacyFamilyPhoto from '../../assets/legacy_family_photo_nw_633bbeb1.jpg';
import familyLegacyPhoto from '../../assets/family_legacy_photo_nw_1911e843.jpg';
import youngLaurenWithDad from '../../assets/young-lauren-with-dad_nw_5c036dd2.jpg';
import identityImage from '../../assets/identity_nw_b5b0f5e4.png';
import missionImage from '../../assets/mission_nw_4129c880.png';
import visionImage from '../../assets/vision_nw_30412df3.png';
import vintagePaperBg from '../../assets/vintage-paper-background_nw_b3d4f5e6.jpg';
import businessOfFamily from '../../assets/the-business-of-family_nw_b2773ef0.png';
import familyPorch from '../../assets/family_on_porch_nw_6bf9f9ad.jpg';
import laurenMiller from '../../assets/kat_6276_nw_fcaf81f0.jpg';
import logoImage from '../../assets/1-1_nw_565f5565.png';
import legacyCollage from '../../assets/legacy_collage_nw_ddd335e4.png';
import MethodologyTabs from "@/components/MethodologyTabs";
import MethodologyAccordion from "@/components/MethodologyAccordion";
---

<BaseLayout
  title="About Us | In the Room With Legacy"
  description="In the Room with Legacy™ was born in a sacred transition, helping families build and preserve legacy across generations."
>
  <!-- Hero Section -->
  <section class="relative min-h-[600px] md:min-h-[700px] flex items-center justify-center overflow-hidden">
    <!-- Background image with parallax effect -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full parallax-container">
        <div class="parallax-image">
          <Image 
            src={businessOfFamily} 
            alt="The Business of Family - multigenerational family gathering" 
            class="w-full h-full object-cover brightness-[0.9] sepia-[0.1]" 
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-b from-primary/30 to-primary/75 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="container relative z-10 py-16 md:py-24 flex flex-col items-center justify-center h-full">
      <div class="max-w-4xl mx-auto text-center my-auto">
        <div class="hero-content-fade-in">
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight text-white leading-tight mb-8 px-4 drop-shadow-sm">
            The Business of Family
          </h1>
          <h2 class="text-xl md:text-2xl lg:text-3xl text-white/95 font-medium mb-16 px-4 max-w-3xl mx-auto drop-shadow-sm leading-relaxed">
            Beyond Wealth. Beyond Money. Beyond One Generation.
          </h2>
        </div>
      </div>
      
      <!-- Hero content only -->
    </div>
    
    <!-- Hero Section Styles -->
    <style>
      /* Parallax Effect */
      .parallax-container {
        position: relative;
        height: 130%;
        top: -15%;
      }
      
      .parallax-image {
        position: absolute;
        height: 100%;
        width: 100%;
        animation: subtle-parallax 30s ease-in-out infinite alternate;
      }
      
      @keyframes subtle-parallax {
        0% { transform: translateY(0); }
        100% { transform: translateY(-5%); }
      }
      
      /* Enhanced Ticker Styling */
      .ticker-scroll-container {
        /* Removed background for transparency */
      }
      
      .ticker-item {
        display: inline-block;
        padding: 0 60px;
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.125rem;
        letter-spacing: 0.02em;
        position: relative;
      }
      
      /* Glowing text effect */
      .ticker-item.glow {
        text-shadow: 
          0 0 5px rgba(255, 255, 255, 0.8),
          0 0 10px rgba(255, 255, 255, 0.6),
          0 0 15px rgba(255, 255, 255, 0.4),
          0 0 20px rgba(255, 255, 255, 0.2);
        font-weight: 400;
        color: white;
      }
      
      @media (min-width: 768px) {
        .ticker-item {
          font-size: 1.25rem;
        }
      }
      
      /* Ticker Animation */
      .ticker-wrapper {
        display: inline-block;
        white-space: nowrap;
        animation: ticker 40s linear infinite;
        will-change: transform;
      }
      
      @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      
      /* Fade Edge Effects removed for clean ticker animation */
      
      /* Fade-in Animation for Hero Content */
      .hero-content-fade-in {
        animation: fade-in 1.5s ease-out;
      }
      
      @keyframes fade-in {
        0% { opacity: 0; transform: translateY(10px); }
        100% { opacity: 1; transform: translateY(0); }
      }
    </style>
  </section>

  <!-- Who We Are Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Who We Are
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
          <div>
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              In the Room with Legacy™ (IRL) is a platform, movement & home for those building with intention. A place where the business of family, heritage, and wealth come together. Through storytelling, programs, and technology, we make legacy a living practice.
            </p>
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              Powered by IRL Advisors, our family governance and legacy-tech advisory firm, we bridge the emotional, cultural and financial dimensions of legacy. Transforming awareness into action by equipping families, individuals, and communities with the tools and frameworks to build and preserve what matters most. We help families understand where they stand today, strengthen what they've inherited, and prepare the next generation to lead with clarity.
            </p>
            
            <!-- Mobile-only logo between paragraphs -->
            <div class="md:hidden my-8 flex justify-center">
              <div class="relative rounded-lg overflow-hidden shadow-xl aspect-square flex items-center justify-center p-8 bg-white w-full max-w-sm">
                <Image 
                  src={logoImage} 
                  alt="In the Room with Legacy logo" 
                  class="w-full h-full object-contain" 
                />
              </div>
            </div>
            
            <p class="text-foreground/80 mb-6 text-lg leading-relaxed">
              We begin with the Legacy Snapshot, our 3–5 minute assessment. We are also piloting NIA, the beta version of In the Room with Legacy's emerging Legacy Operating System — designed to help families assess, document, preserve, and carry legacy while we're still here.
            </p>
          </div>

          <div class="relative rounded-lg overflow-hidden shadow-xl aspect-square flex items-center justify-center p-8 bg-white hidden md:flex">
            <Image 
              src={logoImage} 
              alt="In the Room with Legacy logo" 
              class="w-full h-full object-contain" 
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-width Ticker Statement Section -->
  <section class="relative overflow-hidden w-full bg-primary text-white">
    <div class="ticker-scroll-container overflow-hidden w-full">
      <!-- Ticker content -->
      <div class="ticker-wrapper whitespace-nowrap py-4">
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
        <span class="ticker-item glow font-light">Reimagining what it means to build, sustain, and pass down legacy.</span>
      </div>
    </div>
  </section>
  
  <!-- Four Pillars of Legacy Section -->
  <section class="py-24 bg-[#f7f5ed]">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          The Four Pillars of Legacy
        </h2>
        
        <p class="text-lg text-foreground/80 mb-12 text-center max-w-3xl mx-auto">
          The enduring foundations that shape how individuals & families understand themselves, honor where they come from, and build what continues after them.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
          <!-- IDENTITY Pillar -->
          <div class="bg-white rounded-lg p-8 shadow-md border border-primary/10 hover:shadow-lg transition-all">
            <div class="flex flex-col items-center mb-6">
              <div class="w-64 h-48 rounded-lg overflow-hidden mb-6 shadow-md border border-primary/10">
                <Image 
                  src={identityImage} 
                  alt="Woman confidently posing - representing self-identity" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 -mt-10 shadow-md border border-white">
                <User class="text-primary h-6 w-6" />
              </div>
            </div>
            <h4 class="text-xl font-display font-bold text-primary mb-4 text-center">IDENTITY</h4>
            <p class="text-foreground/80 text-center">
              Your values, name, beliefs, and the sense of belonging that shapes your path.
            </p>
          </div>
          
          <!-- HERITAGE Pillar -->
          <div class="bg-white rounded-lg p-8 shadow-md border border-primary/10 hover:shadow-lg transition-all">
            <div class="flex flex-col items-center mb-6">
              <div class="w-64 h-48 rounded-lg overflow-hidden mb-6 shadow-md border border-primary/10">
                <Image 
                  src={familyLegacyPhoto} 
                  alt="Family legacy photo - representing heritage and lineage" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 -mt-10 shadow-md border border-white">
                <BookCopy class="text-primary h-6 w-6" />
              </div>
            </div>
            <h4 class="text-xl font-display font-bold text-primary mb-4 text-center">HERITAGE</h4>
            <p class="text-foreground/80 text-center">
              The culture, land, lineage, rituals, and stories that formed you.
            </p>
          </div>
          
          <!-- WEALTH Pillar -->
          <div class="bg-white rounded-lg p-8 shadow-md border border-primary/10 hover:shadow-lg transition-all">
            <div class="flex flex-col items-center mb-6">
              <div class="w-64 h-48 rounded-lg overflow-hidden mb-6 shadow-md border border-primary/10">
                <img 
                  src="https://images.unsplash.com/photo-1595713985190-10aeb61c1924?w=600&h=400&auto=format&fit=crop&q=80" 
                  alt="Jar with coins - representing wealth and resources" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 -mt-10 shadow-md border border-white">
                <CircleDollarSign class="text-primary h-6 w-6" />
              </div>
            </div>
            <h4 class="text-xl font-display font-bold text-primary mb-4 text-center">WEALTH</h4>
            <p class="text-foreground/80 text-center">
              Financial, cultural, relational, and spiritual resources — all of which require stewardship.
            </p>
          </div>
          
          <!-- CONTINUATION Pillar -->
          <div class="bg-white rounded-lg p-8 shadow-md border border-primary/10 hover:shadow-lg transition-all">
            <div class="flex flex-col items-center mb-6">
              <div class="w-64 h-48 rounded-lg overflow-hidden mb-6 shadow-md border border-primary/10">
                <img 
                  src="https://images.unsplash.com/photo-1693423362454-7db6c8e07a5c?w=600&h=400&auto=format&fit=crop&q=80" 
                  alt="Small plant sprouting - representing growth and continuation" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 -mt-10 shadow-md border border-white">
                <Sprout class="text-primary h-6 w-6" />
              </div>
            </div>
            <h4 class="text-xl font-display font-bold text-primary mb-4 text-center">CONTINUATION</h4>
            <p class="text-foreground/80 text-center">
              The systems, roles, and transitions that ensure what you are building outlives you.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          What We Do
        </h2>
        <div class="max-w-4xl mx-auto mb-12">
          <!-- Introduction -->
          <p class="text-lg text-foreground/80 mb-6 text-center">
            Every offering, from our workshops to our technology, is designed to make legacy a living practice. Our work lives at the intersection of four pathways that together make legacy real, relevant, and repeatable:
          </p>
          
          <!-- Desktop Category Tabs -->
          <MethodologyTabs client:load />
          
          <!-- Mobile Category Accordion -->
          <MethodologyAccordion client:load />
          
        </div>
      </div>
    </div>
    
    <!-- All cards are now non-interactive, no filtering logic needed -->
    <style>
      .legacy-dimension-card {
        transition: all 0.3s ease-in-out;
      }
    </style>
  </section>

  <!-- Key Practice Areas Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          Key Practice Areas
        </h2>
        <p class="text-lg text-foreground/80 mb-12 text-center max-w-3xl mx-auto">
          These practice areas guide how we design every tool, program, and experience within In the Room with Legacy. They represent the domains where families most often seek clarity, support, and structure — and where our work can make the greatest impact.
        </p>
        <div class="max-w-4xl mx-auto mb-12">
          <!-- Five Dimensions of Legacy - Modern Card Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12" id="dimensions-grid">
            <!-- Family Legacy Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" style="height: 270px;">
              <div class="p-6">
                <div class="flex items-start gap-4 mb-2">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <HandHeart class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Family Legacy</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-6">
                      Building a foundation of values, traditions, and practices that strengthen family identity and connection across generations.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling & Documentation</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Learning & Tools</span>
                </div>
              </div>
            </div>
            
            <!-- Next-Gen Stewardship Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" style="height: 270px;">
              <div class="p-6">
                <div class="flex items-start gap-4 mb-2">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Users class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Next-Gen Stewardship</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-6">
                      Preparing future generations to receive, maintain, and grow the family's legacy through education, mentorship, and guided experience.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory & Community</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Experiences & Programs</span>
                </div>
              </div>
            </div>
            
            <!-- Community & Belonging Card (formerly Storytelling & Culture) -->
            <div class="legacy-dimension-card expandable-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" style="height: 270px;">
              <div class="p-6">
                <div class="flex items-start gap-4 mb-4">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <BookOpenText class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-4">Community & Belonging</h4>
                    <div class="text-content">
                      <div class="description-container">
                        <p class="text-foreground/80 text-sm leading-relaxed full-description">
                          Strengthening the bonds, rituals, and relationships that keep families rooted across generations, geography, and life seasons. Centering connection: how families gather, how they communicate, how they resolve conflict, and how they remain emotionally woven together even as life shifts. Helping families cultivate spaces where everyone feels seen, valued, and part of something larger than themselves.
                        </p>
                      </div>
                      <div class="text-action-wrapper">
                        <button aria-label="Toggle content visibility" class="text-blue-600 text-xs font-medium toggle-btn hover:underline focus:outline-none"><span class="mobile-button-text">See More</span></button>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Learning & Tools</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling & Documentation</span>
                </div>
              </div>
            </div>
            
            <!-- Economic Empowerment Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10" style="height: 270px;">
              <div class="p-6">
                <div class="flex items-start gap-4 mb-2">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <DollarSign class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Economic Empowerment</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-6">
                      Creating sustainable financial foundations and teaching principles that support multigenerational wealth stewardship and growth.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Experiences & Programs</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory & Community</span>
                </div>
              </div>
            </div>
            
            <!-- Transitions & Healing Card -->
            <div class="legacy-dimension-card bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all border border-primary/10 md:col-span-1" style="height: 270px;">
              <div class="p-6">
                <div class="flex items-start gap-4 mb-2">
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-1">
                    <Lightbulb class="text-primary h-6 w-6" />
                  </div>
                  <div>
                    <h4 class="font-display font-bold text-primary text-xl mb-3">Transitions & Healing</h4>
                    <p class="text-foreground/80 text-sm leading-relaxed mb-6">
                      Navigating major life changes, succession planning, and healing fractured relationships to ensure continuity during pivotal moments.
                    </p>
                  </div>
                </div>
                <!-- Category Tags -->
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Storytelling & Documentation</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Experiences & Programs</span>
                  <span class="text-xs px-3 py-1 rounded-full bg-primary/5 text-primary/70">Advisory & Community</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const expandableCard = document.querySelector('.expandable-card');
        const descContainer = document.querySelector('.description-container');
        const toggleBtn = document.querySelector('.toggle-btn');
        
        // Force initialization of card height at load time
        window.setTimeout(() => {
          if (expandableCard) {
            // Set initial height
            expandableCard.style.height = (window.innerWidth < 768 ? '320px' : '270px');
            
            // Ensure toggle button is properly styled and visible initially
            const btnText = document.querySelector('.mobile-button-text');
            if (btnText) {
              btnText.style.display = 'inline-block';
              btnText.style.visibility = 'visible';
              btnText.style.opacity = '1';
              btnText.textContent = 'See More';
            }
          }
        }, 100);
        
        if (expandableCard && descContainer && toggleBtn) {
          // Track expanded state
          let isExpanded = false;
          
          // Function to get base card height based on viewport
          function getBaseCardHeight() {
            return window.innerWidth < 768 ? 320 : 270; // 320px on mobile, 270px on desktop
          }
          
          // Function to toggle card expansion
          function toggleCard() {
            const baseHeight = getBaseCardHeight();
            const isMobile = window.innerWidth < 768;
            
            if (isExpanded) {
              // === COLLAPSE CARD ===
              
              // Update classes
              descContainer.classList.remove('expanded');
              expandableCard.classList.remove('expanded');
              
              // Update button text and attributes for mobile/desktop
              const btnText = document.querySelector('.mobile-button-text');
              if (btnText) {
                btnText.textContent = 'See More';
                // Immediately update button styles to ensure it's visible
                btnText.style.display = 'inline-block';
                btnText.style.visibility = 'visible';
                btnText.style.opacity = '1';
              } else {
                toggleBtn.textContent = 'See More';
              }
              
              toggleBtn.setAttribute('aria-expanded', 'false');
              toggleBtn.style.display = 'block';
              
              // Start animation to collapse the card
              requestAnimationFrame(() => {
                expandableCard.style.height = baseHeight + 'px';
              });
              
              // Ensure button stays visible during animation
              const ensureButtonVisibility = () => {
                const mobileBtn = document.querySelector('.mobile-button-text');
                if (mobileBtn) {
                  mobileBtn.style.display = 'inline-block';
                  mobileBtn.style.visibility = 'visible';
                  mobileBtn.style.opacity = '1';
                  mobileBtn.textContent = 'See More';
                }
              };
              
              // Check multiple times to ensure button visibility throughout animation
              setTimeout(ensureButtonVisibility, 50);
              setTimeout(ensureButtonVisibility, 200);
              setTimeout(ensureButtonVisibility, 400);
            } else {
              // === EXPAND CARD ===
              
              // Update classes
              descContainer.classList.add('expanded');
              expandableCard.classList.add('expanded');
              
              // Update button text for mobile/desktop
              const btnText = document.querySelector('.mobile-button-text');
              if (btnText) {
                btnText.textContent = 'See Less';
                // Immediately update button styles
                btnText.style.display = 'inline-block';
                btnText.style.visibility = 'visible';
                btnText.style.opacity = '1';
                btnText.style.zIndex = '50';
              } else {
                toggleBtn.textContent = 'See Less';
              }
              
              toggleBtn.setAttribute('aria-expanded', 'true');
              toggleBtn.style.display = 'block';
              
              // Calculate expanded height
              expandableCard.style.height = 'auto';
              const expandedHeight = expandableCard.scrollHeight;
              expandableCard.style.height = baseHeight + 'px';
              
              // Force reflow before animation
              void expandableCard.offsetHeight;
              
              // Add extra padding to ensure See Less button has enough space
              // More padding on mobile to ensure visibility
              const extraPadding = isMobile ? 100 : 40;
              
              // Start expansion animation
              requestAnimationFrame(() => {
                expandableCard.style.height = (expandedHeight + extraPadding) + 'px';
              });
              
              // Multiple checks to ensure button visibility throughout animation
              const ensureLessButtonVisibility = () => {
                const btnText = document.querySelector('.expandable-card.expanded .mobile-button-text');
                if (btnText) {
                  btnText.style.display = 'inline-block';
                  btnText.style.visibility = 'visible';
                  btnText.style.opacity = '1';
                  btnText.style.zIndex = '50';
                  btnText.textContent = 'See Less';
                }
              };
              
              // Check at multiple intervals to ensure visibility through animation
              setTimeout(ensureLessButtonVisibility, 100);
              setTimeout(ensureLessButtonVisibility, 300);
              setTimeout(ensureLessButtonVisibility, 500);
              
              // Ensure card and button are visible in viewport after expansion
              setTimeout(() => {
                if (isMobile) {
                  // Get updated card position
                  const cardRect = expandableCard.getBoundingClientRect();
                  const btnText = document.querySelector('.expandable-card.expanded .mobile-button-text');
                  
                  if (btnText) {
                    const btnRect = btnText.getBoundingClientRect();
                    
                    // If button is below viewport, scroll to make it visible
                    if (btnRect.bottom > window.innerHeight) {
                      window.scrollBy({
                        top: btnRect.bottom - window.innerHeight + 60,
                        behavior: 'smooth'
                      });
                    }
                  } else if (cardRect.bottom > window.innerHeight) {
                    // If no button found but card is off screen, scroll to see the bottom of card
                    window.scrollBy({
                      top: Math.min(cardRect.bottom - window.innerHeight + 100, 200),
                      behavior: 'smooth'
                    });
                  }
                }
                
                // Final check to ensure button visibility
                ensureLessButtonVisibility();
              }, 600);
            }
            
            // Toggle expanded state
            isExpanded = !isExpanded;
          }
          
          // Toggle button click handler with improved touch support
          toggleBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation(); // Prevent event bubbling
            toggleCard();
          });
          
          // Enhanced touch event support for mobile devices
          toggleBtn.addEventListener('touchend', function(e) {
            e.preventDefault();
            e.stopPropagation(); // Prevent event bubbling
            toggleCard();
          });
          
          // Visual feedback for touch interactions
          toggleBtn.addEventListener('touchstart', function(e) {
            toggleBtn.classList.add('touch-active');
          });
          
          // Remove touch-active class when touch ends
          document.addEventListener('touchend', function() {
            toggleBtn.classList.remove('touch-active');
          });
          
          // Handle window resize and orientation changes
          let resizeTimeout;
          function handleResize() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function() {
              const baseHeight = getBaseCardHeight();
              
              if (!isExpanded) {
                // Update base height for non-expanded state
                expandableCard.style.height = baseHeight + 'px';
                
                // Ensure button is visible
                const btnText = document.querySelector('.mobile-button-text');
                if (btnText) {
                  btnText.style.display = 'inline-block';
                  btnText.style.visibility = 'visible';
                  btnText.textContent = 'See More';
                }
              } else {
                // Recalculate expanded height
                expandableCard.style.height = 'auto';
                const newHeight = expandableCard.scrollHeight;
                const extraPadding = window.innerWidth < 768 ? 100 : 40;
                expandableCard.style.height = (newHeight + extraPadding) + 'px';
                
                // Ensure "See Less" button remains visible
                const btnText = document.querySelector('.expandable-card.expanded .mobile-button-text');
                if (btnText) {
                  btnText.style.display = 'inline-block';
                  btnText.style.visibility = 'visible';
                  btnText.style.opacity = '1';
                  btnText.textContent = 'See Less';
                }
              }
            }, 100);
          }
          
          // Listen for viewport changes
          window.addEventListener('resize', handleResize);
          window.addEventListener('orientationchange', handleResize);
        }
      });
    </script>

