---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Handshake, Lightbulb, Building, Sparkles, School, Landmark } from "lucide-react";
import { Image } from 'astro:assets';
import legacyCollage from '../../../assets/legacy_collage_nw_ddd335e4.png';
---

<BaseLayout
  title="Partnership Pathways | In the Room With Legacy"
  description="Explore collaboration opportunities with In the Room with Legacy through content collaborations, program partnerships, and strategic alliances."
>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden">
    <!-- Background image with overlay -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full">
        <Image 
          src={legacyCollage} 
          alt="Vintage family photos showing generational connections" 
          class="w-full h-full object-cover" 
        />
        <div class="absolute inset-0 bg-primary/70 mix-blend-multiply"></div>
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 px-4">
          Partnership Pathways
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto px-4">
          Create impact through strategic collaboration with In the Room with Legacy™.
        </p>
      </div>
    </div>
  </section>

  <!-- Partnership Categories Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Partnership Categories
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Category 1: Content Collaborations -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden">
            <div class="bg-primary/5 p-6 flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold">
                1
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Content Collaborations</h3>
            </div>
            <div class="p-6">
              <p class="text-foreground/80 mb-6">
                Co-create powerful narratives that amplify legacy stories and cultural impact.
              </p>
              
              <h4 class="font-medium text-primary mb-3">Examples:</h4>
              <ul class="space-y-2 text-foreground/70 text-sm">
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Co-created storytelling campaigns with brands, media outlets, and cultural institutions</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Co-produced short films or podcast series highlighting legacy families</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Collaborative research projects on family legacy and succession trends</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Custom content development for institutions serving multi-generational families</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Media partnerships amplifying diverse perspectives on legacy building</span>
                </li>
              </ul>
            </div>
          </div>
          
          <!-- Category 2: Program Partnerships -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden">
            <div class="bg-primary/5 p-6 flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold">
                2
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Program Partnerships</h3>
            </div>
            <div class="p-6">
              <p class="text-foreground/80 mb-6">
                Design and deliver transformative learning experiences that strengthen family legacies.
              </p>
              
              <h4 class="font-medium text-primary mb-3">Examples:</h4>
              <ul class="space-y-2 text-foreground/70 text-sm">
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Co-hosted retreats, workshops, or labs blending IRL methodology with partner expertise</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Universities or foundations sponsoring While We're Still Here cohorts</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Corporate-sponsored legacy programs for employee resource groups</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Co-branded assessment tools for financial institutions</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Legacy planning modules integrated into family office service offerings</span>
                </li>
              </ul>
            </div>
          </div>
          
          <!-- Category 3: Strategic Alliances -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden">
            <div class="bg-primary/5 p-6 flex items-center gap-4">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold">
                3
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Strategic Alliances</h3>
            </div>
            <div class="p-6">
              <p class="text-foreground/80 mb-6">
                Build long-term collaborative relationships that create systemic impact.
              </p>
              
              <h4 class="font-medium text-primary mb-3">Examples:</h4>
              <ul class="space-y-2 text-foreground/70 text-sm">
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Long-term collaborations with institutions, universities, financial partners, or civic orgs</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Municipal partnerships integrating legacy assessments into family business initiatives</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Cultural preservation organizations adopting IRL methodologies</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Foundations supporting intergenerational wealth building in underserved communities</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-primary mt-1">•</span>
                  <span>Joint ventures developing technology solutions for family governance and storytelling</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partnership Case Studies Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Partnership Case Studies
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Case Study 1 -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden">
            <div class="bg-primary/5 p-6 flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Building className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Financial Institution Integration</h3>
            </div>
            <div class="p-6">
              <div class="mb-6">
                <p class="text-foreground/80 text-sm">
                  Partnered with a leading private bank to develop a specialized legacy planning toolkit for their high-net-worth clients, blending financial planning with cultural preservation strategies.
                </p>
              </div>
              
              <div>
                <h4 class="font-medium text-primary mb-2">Results:</h4>
                <p class="text-foreground/70 text-sm">
                  The program strengthened client retention, deepened relationships with next generation heirs, and created a distinctive service offering that differentiated the institution from competitors.
                </p>
              </div>
            </div>
          </div>
          
          <!-- Case Study 2 -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden">
            <div class="bg-primary/5 p-6 flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <School className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">University Research Initiative</h3>
            </div>
            <div class="p-6">
              <div class="mb-6">
                <p class="text-foreground/80 text-sm">
                  Collaborated with a major university's family business center to conduct comprehensive research on succession challenges facing multi-generational businesses.
                </p>
              </div>
              
              <div>
                <h4 class="font-medium text-primary mb-2">Results:</h4>
                <p class="text-foreground/70 text-sm">
                  Findings were published in a widely-cited white paper and led to the development of new curriculum for family business owners and next-generation leaders.
                </p>
              </div>
            </div>
          </div>
          
          <!-- Case Study 3 -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden">
            <div class="bg-primary/5 p-6 flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Landmark className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Cultural Institution Program</h3>
            </div>
            <div class="p-6">
              <div class="mb-6">
                <p class="text-foreground/80 text-sm">
                  Worked with a prominent museum to create an intergenerational storytelling program capturing the legacies of founding community families.
                </p>
              </div>
              
              <div>
                <h4 class="font-medium text-primary mb-2">Results:</h4>
                <p class="text-foreground/70 text-sm">
                  The program strengthened community engagement, preserved important local history, and created an ongoing revenue stream for both organizations through a successful event series.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Interested in Partnering with IRL?
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          We're excited to explore collaboration opportunities that align with your goals and our mission. Reach out to discuss how we might work together.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Contact Us
          </a>
          <a 
            href="/contact?type=consultation" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium"
            })}
          >
            Schedule a Consultation
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>