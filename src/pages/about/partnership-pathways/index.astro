---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Handshake, Building, DollarSign, Users, Briefcase, Award } from "lucide-react";
---

<BaseLayout
  title="Partnership Pathways | In the Room With Legacy"
  description="Partner with In the Room with Legacy™ to help preserve and amplify family legacies across generations."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          Partnership Pathways
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          Join us in preserving and amplifying legacy across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Partnership Overview Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Why Partner With Us?
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 hover:border-primary/30 transition-all hover:shadow-md">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Users className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Access to Our Community</h3>
            </div>
            <p class="text-foreground/80 mb-4">
              Connect with a growing network of families committed to legacy preservation and multi-generational success.
            </p>
          </div>
          
          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 hover:border-primary/30 transition-all hover:shadow-md">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Award className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">Mission Alignment</h3>
            </div>
            <p class="text-foreground/80 mb-4">
              Associate your brand with meaningful work that transforms families and preserves cultural wealth.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partnership Types Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Partnership Opportunities
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10 flex flex-col h-full">
            <div class="mb-6">
              <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4 mx-auto">
                <Building className="text-primary w-8 h-8" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-3 text-center">Corporate Sponsors</h3>
            </div>
            <ul class="space-y-3 mb-6 flex-grow">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Branded events and resources</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Employee legacy benefits</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Content co-creation</span>
              </li>
            </ul>
            <div class="text-center mt-auto">
              <a 
                href="/contact?inquiry=corporate" 
                class={buttonVariants({
                  variant: "outline",
                  class: "border-primary text-primary hover:bg-primary/10 font-medium"
                })}
              >
                Learn More
              </a>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10 flex flex-col h-full">
            <div class="mb-6">
              <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4 mx-auto">
                <DollarSign className="text-primary w-8 h-8" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-3 text-center">Institutional Funders</h3>
            </div>
            <ul class="space-y-3 mb-6 flex-grow">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Program-specific grants</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Research partnerships</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Impact reporting</span>
              </li>
            </ul>
            <div class="text-center mt-auto">
              <a 
                href="/contact?inquiry=funding" 
                class={buttonVariants({
                  variant: "outline",
                  class: "border-primary text-primary hover:bg-primary/10 font-medium"
                })}
              >
                Learn More
              </a>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-lg shadow-md border border-primary/10 flex flex-col h-full">
            <div class="mb-6">
              <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4 mx-auto">
                <Briefcase className="text-primary w-8 h-8" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-3 text-center">Professional Partners</h3>
            </div>
            <ul class="space-y-3 mb-6 flex-grow">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Client referral networks</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Co-hosted client events</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80 text-sm">Professional development</span>
              </li>
            </ul>
            <div class="text-center mt-auto">
              <a 
                href="/contact?inquiry=professional" 
                class={buttonVariants({
                  variant: "outline",
                  class: "border-primary text-primary hover:bg-primary/10 font-medium"
                })}
              >
                Learn More
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Stories Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Our Impact Together
        </h2>
        
        <div class="bg-primary/5 rounded-lg p-8 border border-primary/10 mb-12 relative overflow-hidden">
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-primary/5 rounded-full"></div>
          <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-primary/5 rounded-full"></div>
          
          <div class="relative z-10">
            <h3 class="text-2xl font-display font-semibold text-primary mb-4">
              Community Bank Partnership
            </h3>
            <p class="text-foreground/80 mb-6">
              "Through our partnership with In the Room with Legacy, we've been able to offer our clients something truly unique – a way to preserve not just their financial legacy, but their values, stories, and cultural wealth. The response has been incredible." 
            </p>
            <p class="text-primary font-medium">
              – Regional Community Bank, Program Partner
            </p>
          </div>
        </div>
        
        <div class="text-center">
          <p class="text-lg text-foreground/80 mb-8">
            Ready to explore how we can work together to protect and amplify legacy?
          </p>
          <a 
            href="/contact" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Start the Conversation
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>