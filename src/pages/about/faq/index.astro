---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ChevronDown } from "lucide-react";
import { Image } from 'astro:assets';
import faqsImage from '../../../assets/faqs_nw_51f94a39.png';
---

<BaseLayout
  title="Frequently Asked Questions | In the Room With Legacy"
  description="Find answers to common questions about In the Room with Legacy™ programs, services, and approach to legacy building."
>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden">
    <!-- Background image with overlay -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full">
        <Image 
          src={faqsImage} 
          alt="Frequently Asked Questions - FAQ information concept" 
          class="w-full h-full object-cover" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-primary/60"></div>
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 px-4">
          Frequently Asked Questions
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto px-4">
          Find answers to common questions about our programs, services, and approach to legacy building.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-border/30">
          <!-- Custom FAQ accordion implementation -->
          <div class="divide-y divide-border/50">
            <!-- Question 1 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>Do we need to know exactly what we're looking for before reaching out?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>No. Many families begin without clarity. The initiation session helps identify needs and next steps.</p>
              </div>
            </div>
            
            <!-- Question 2 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>Is IRL Advisors only for families with established businesses or wealth?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>Not at all. Legacy is defined by intention, values, and vision — not size.</p>
              </div>
            </div>
            
            <!-- Question 3 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>What makes IRL Advisors unique?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>We blend cultural grounding, emotional intelligence, and strategic advisory — honoring heritage while designing long-term legacy frameworks.</p>
              </div>
            </div>
            
            <!-- Question 4 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>What happens after the initiation session?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>You receive a personalized roadmap outlining recommended next steps — no pressure or obligation.</p>
              </div>
            </div>
            
            <!-- Question 5 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>How does the private circle work?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>It is a curated, invitation-based community for Black family enterprise leaders. Interested families may submit a request for consideration.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-12 text-center">
          <p class="text-foreground/80 mb-6">
            Don't see your question answered here?
          </p>
          <a 
            href="/contact" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side script for FAQ accordion functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const faqItems = document.querySelectorAll('.faq-item');
      
      faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content');
        const icon = trigger.querySelector('svg');
        
        trigger.addEventListener('click', () => {
          // Close all other items
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              otherItem.querySelector('.faq-content').classList.add('hidden');
              otherItem.querySelector('svg').classList.remove('rotate-180');
            }
          });
          
          // Toggle current item
          content.classList.toggle('hidden');
          icon.classList.toggle('rotate-180');
        });
      });
    });
  </script>

</BaseLayout>