---
import { Image } from 'astro:assets';
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Search, Download, FileText, Book, Bookmark, Filter, Settings, Tool, FileQuestion, ScrollText, ChevronDown, ChevronUp, ListFilter } from "lucide-react";
// TimeTriggeredModal removed as requested

// Import all thumbnail images individually
import assessmentToolThumbnail from "@/assets/ai-powered-legacy-assessment-tool_nw_f99ce436.png";
import conversationKitThumbnail from "@/assets/the-legacy-conversation-starter-kit_nw_b7f32dd0.png";
import parentingParentThumbnail from "@/assets/parenting-a-parent-a-guide-for-adult-children-1_nw_9542e0d7.png";
import ethicalNepotismThumbnail from "@/assets/the-case-for-ethical-nepotism_nw_5c0b9ae9.png";

// Import hero background image
import heroBackgroundImage from "@/assets/ethical-nepotism-thumbnail_nw_a25135d4.png";
---

<BaseLayout
  title="Legacy Insights, Tools & Resources | In the Room With Legacy"
  description="A living library of guides, tools, and reflections to help families build and sustain legacy across every stage and generation."
>
  <!-- Hero Section with Full-Width Background Image -->
  <section class="relative py-16 md:py-24 border-b border-primary/10 bg-white overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 w-full h-full">
      <Image 
        src={heroBackgroundImage} 
        alt="The Case for Ethical Nepotism" 
        class="w-full h-full object-cover object-center"
        width={1920}
        height={1080}
        loading="eager"
      />
      <!-- Overlay removed for better visibility -->
      
      <!-- Photo Credits removed as requested -->
    </div>
    
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight text-black leading-tight mb-6">
          Legacy Insights, Tools &amp; Resources
        </h1>
        <p class="text-xl md:text-2xl text-black mb-0 max-w-2xl mx-auto font-light leading-relaxed">
          A living library of guides, tools, and reflections to help families build and sustain legacy, across every stage and generation.
        </p>
      </div>
    </div>
  </section>

  <!-- Enhanced Filters & Search Section with Better Visual Hierarchy -->
  <section class="pt-8 pb-16 bg-white border-b border-primary/10">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <!-- Mobile Filter Toggle Button (visible only on mobile) -->
        <button id="filter-toggle-btn" class="flex md:hidden w-full mb-4 py-3 px-6 bg-primary text-white rounded-lg shadow items-center justify-center font-medium transition-all hover:bg-primary/90">
          <ListFilter className="w-5 h-5 mr-2" />
          <span>Filter Resources</span>
          <ChevronDown id="filter-down-icon" className="w-5 h-5 ml-2" />
          <ChevronUp id="filter-up-icon" className="w-5 h-5 ml-2 hidden" />
        </button>
        
        <!-- Filter Panel with Enhanced Visual Hierarchy (hidden on mobile by default) -->
        <div id="filter-panel" class="bg-white shadow rounded-xl border border-primary/15 p-8 mb-10 hidden md:block">
          <!-- Primary Tabs - Main Content Type Filters -->
          <div class="mb-10">
            <h3 class="text-sm font-medium text-primary/90 mb-4 uppercase tracking-wider font-semibold">Content Type</h3>
            <div class="w-full flex flex-wrap gap-3">
              <button id="all-filter" class="inline-flex items-center rounded-full bg-primary text-white px-6 py-3 text-sm font-medium transition-all shadow-sm hover:shadow">
                All
              </button>
              <button id="articles-filter" class="inline-flex items-center rounded-full bg-primary/5 hover:bg-primary/10 text-primary px-6 py-3 text-sm font-medium transition-all">
                Articles &amp; Essays
              </button>
              <button id="guides-filter" class="inline-flex items-center rounded-full bg-primary/5 hover:bg-primary/10 text-primary px-6 py-3 text-sm font-medium transition-all">
                Guides &amp; Frameworks
              </button>
              <button id="worksheets-filter" class="inline-flex items-center rounded-full bg-primary/5 hover:bg-primary/10 text-primary px-6 py-3 text-sm font-medium transition-all">
                Worksheets &amp; Templates
              </button>
              <button id="tools-filter" class="inline-flex items-center rounded-full bg-primary/5 hover:bg-primary/10 text-primary px-6 py-3 text-sm font-medium transition-all">
                Tools &amp; Checklists
              </button>
              <button id="videos-filter" class="inline-flex items-center rounded-full bg-primary/5 hover:bg-primary/10 text-primary px-6 py-3 text-sm font-medium transition-all">
                Videos &amp; Webinars
              </button>
            </div>
          </div>

          <!-- Secondary Filters - Audience -->
          <div class="mb-8">
            <h3 class="text-sm font-medium text-primary/80 mb-3 uppercase tracking-wider">Audience</h3>
            <div class="w-full flex flex-wrap gap-2">
              <button id="founders-filter" class="inline-flex items-center rounded-full bg-secondary/10 hover:bg-secondary/20 text-secondary px-5 py-2 text-sm font-medium transition-all">
                Founders
              </button>
              <button id="heirs-filter" class="inline-flex items-center rounded-full bg-secondary/10 hover:bg-secondary/20 text-secondary px-5 py-2 text-sm font-medium transition-all">
                Heirs
              </button>
              <button id="families-filter" class="inline-flex items-center rounded-full bg-secondary/10 hover:bg-secondary/20 text-secondary px-5 py-2 text-sm font-medium transition-all">
                Families
              </button>
              <button id="cousins-filter" class="inline-flex items-center rounded-full bg-secondary/10 hover:bg-secondary/20 text-secondary px-5 py-2 text-sm font-medium transition-all">
                Cousins &amp; Collectives
              </button>
            </div>
          </div>

          <!-- Tertiary Tags - Legacy Dimension -->
          <div class="mb-8">
            <h3 class="text-sm font-medium text-primary/70 mb-3 uppercase tracking-wider">Topics</h3>
            <div class="w-full flex flex-wrap gap-2">
              <button id="legacy-filter" class="inline-flex items-center rounded-full bg-muted hover:bg-muted/80 text-foreground/70 px-4 py-1 text-xs font-medium transition-all">
                Family Legacy
              </button>
              <button id="nextgen-filter" class="inline-flex items-center rounded-full bg-muted hover:bg-muted/80 text-foreground/70 px-4 py-1 text-xs font-medium transition-all">
                Next-Gen Stewardship
              </button>
              <button id="storytelling-filter" class="inline-flex items-center rounded-full bg-muted hover:bg-muted/80 text-foreground/70 px-4 py-1 text-xs font-medium transition-all">
                Storytelling &amp; Culture
              </button>
              <button id="economic-filter" class="inline-flex items-center rounded-full bg-muted hover:bg-muted/80 text-foreground/70 px-4 py-1 text-xs font-medium transition-all">
                Economic Empowerment
              </button>
              <button id="transitions-filter" class="inline-flex items-center rounded-full bg-muted hover:bg-muted/80 text-foreground/70 px-4 py-1 text-xs font-medium transition-all">
                Transitions &amp; Healing
              </button>
            </div>
          </div>
          
          <!-- Search -->
          <div class="w-full mt-8 relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <Search className="h-4 w-4 text-muted-foreground" />
            </div>
            <input 
              type="search" 
              id="resource-search" 
              class="block w-full pl-10 pr-4 py-3 border border-primary/20 rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/40 bg-white/80"
              placeholder="Search resources..."
            />
          </div>
          
          <!-- Mobile Apply Filters Button (visible only when filters are expanded on mobile) -->
          <div class="mt-6 md:hidden">
            <button id="apply-filters-btn" class="w-full py-3 px-6 bg-primary text-white rounded-lg shadow flex items-center justify-center font-medium transition-all hover:bg-primary/90">
              <span>Apply Filters</span>
              <ChevronUp className="w-5 h-5 ml-2" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Introduction Section -->
  <section class="py-16 bg-primary/5 border-y border-primary/15 my-8">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <div class="bg-white p-10 rounded-xl shadow-sm border border-primary/10">
          <p class="text-xl text-foreground/90 leading-relaxed">
            Explore frameworks, stories, and tools created by In the Room with Legacy™ — along with curated insights from thought leaders, family enterprises, and communities around the world. Whether you're the founder of your family, a successor, or a family steward, you'll find something here that helps make legacy real in your everyday life.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Resources Heading -->
  <section class="pt-8 pb-4 bg-muted/10">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4">Featured Resources</h2>
        <p class="text-lg text-foreground/80 mb-8">Start with a few of our most loved and most used resources — from conversation frameworks to practical guides.</p>
      </div>
    </div>
  </section>

  <!-- Resource Cards -->
  <section class="pt-0 pb-16 bg-muted/10">
    <div class="container" id="resource-container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12" id="resources-grid">
          <!-- Featured Resources rendered server-side for better SEO -->
          <div class="content-card featured-card" data-type="tool" data-audience="" data-dimensions="">
            <div class="content-card-content bg-white border border-primary/20 shadow-md rounded-lg overflow-hidden">
              <div class="w-full h-48 overflow-hidden">
                <Image 
                  src={assessmentToolThumbnail} 
                  alt="Digital assessment tool interface displaying family legacy metrics" 
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                />
              </div>
              <div class="p-5">
                <div class="absolute top-2 right-2 bg-secondary/20 text-secondary px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
                <div class="flex gap-2 items-center mb-3">
                  <span class="inline-block bg-primary/20 text-primary py-1 px-3 rounded-full text-xs font-medium">
                    Tool
                  </span>
                </div>
                <h3 class="content-card-title text-xl font-semibold">
                  AI-Powered Legacy Assessment Tool
                </h3>
                <p class="content-card-description line-clamp-3 mt-2">
                  The first AI-powered tool that helps families measure where they are, map what matters most, and take real steps to protect their legacy across generations.
                </p>
                <div class="mt-3 mb-4 flex flex-wrap"></div>
                <a 
                  href="/tools/legacy-assessment" 
                  class="content-card-actions inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-10 px-5 py-2 border border-primary bg-primary text-white shadow hover:bg-primary/90 w-full mt-2"
                >
                  <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                  Request Access to the Tool
                </a>
              </div>
            </div>
          </div>
          
          <div class="content-card featured-card" data-type="worksheet" data-audience="families" data-dimensions="transitions-healing">
            <div class="content-card-content bg-white border border-primary/20 shadow-md rounded-lg overflow-hidden">
              <div class="w-full h-48 overflow-hidden">
                <Image 
                  src={conversationKitThumbnail} 
                  alt="The Legacy Conversation Starter Kit showing conversation prompts and templates" 
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                />
              </div>
              <div class="p-5">
                <div class="absolute top-2 right-2 bg-secondary/20 text-secondary px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
                <div class="flex gap-2 items-center mb-3">
                  <span class="inline-block bg-primary/20 text-primary py-1 px-3 rounded-full text-xs font-medium">
                    Worksheet
                  </span>
                  <span class="inline-block bg-secondary/10 text-secondary py-0.5 px-2 rounded-full text-xs font-medium ml-1">Families</span>
                </div>
                <h3 class="content-card-title text-xl font-semibold">
                  The Legacy Conversation Starter Kit
                </h3>
                <p class="content-card-description line-clamp-3 mt-2">
                  A comprehensive guide with prompts, questions, and frameworks to facilitate meaningful conversations about legacy within your family.
                </p>
                <div class="mt-3 mb-4 flex flex-wrap">
                  <span class="inline-block bg-muted text-foreground/70 py-0.5 px-2 rounded-full text-xs font-medium mr-1 mb-1">Transitions & Healing</span>
                </div>
                <a 
                  href="/pdfs/legacy_conversation_starter_kit.pdf" 
                  class="content-card-actions inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-10 px-5 py-2 border border-primary bg-primary text-white shadow hover:bg-primary/90 w-full mt-2"
                  download
                >
                  <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                  Download Kit
                </a>
              </div>
            </div>
          </div>
          
          <div class="content-card featured-card" data-type="guide" data-audience="families" data-dimensions="transitions-healing">
            <div class="content-card-content bg-white border border-primary/20 shadow-md rounded-lg overflow-hidden">
              <div class="w-full h-48 overflow-hidden">
                <Image 
                  src={parentingParentThumbnail} 
                  alt="Parenting a Parent: A Guide for Adult Children showing caregiving strategies" 
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                />
              </div>
              <div class="p-5">
                <div class="absolute top-2 right-2 bg-secondary/20 text-secondary px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
                <div class="flex gap-2 items-center mb-3">
                  <span class="inline-block bg-primary/20 text-primary py-1 px-3 rounded-full text-xs font-medium">
                    Guide
                  </span>
                  <span class="inline-block bg-secondary/10 text-secondary py-0.5 px-2 rounded-full text-xs font-medium ml-1">Families</span>
                </div>
                <h3 class="content-card-title text-xl font-semibold">
                  Parenting a Parent: A Guide for Adult Children
                </h3>
                <p class="content-card-description line-clamp-3 mt-2">
                  Navigate the complex transition from child to caregiver with practical strategies, emotional support, and planning tools.
                </p>
                <div class="mt-3 mb-4 flex flex-wrap">
                  <span class="inline-block bg-muted text-foreground/70 py-0.5 px-2 rounded-full text-xs font-medium mr-1 mb-1">Transitions & Healing</span>
                </div>
                <a 
                  href="/articles/parenting-a-parent" 
                  class="content-card-actions inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-10 px-5 py-2 border border-primary bg-primary text-white shadow hover:bg-primary/90 w-full mt-2"
                >
                  <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  Read Guide
                </a>
              </div>
            </div>
          </div>
          
          <div class="content-card featured-card" data-type="article" data-audience="heirs" data-dimensions="family-legacy next-gen-stewardship">
            <div class="content-card-content bg-white border border-primary/20 shadow-md rounded-lg overflow-hidden">
              <div class="w-full h-48 overflow-hidden">
                <Image 
                  src={ethicalNepotismThumbnail} 
                  alt="The Case for Ethical Nepotism featuring ethical inheritance principles" 
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                />
              </div>
              <div class="p-5">
                <div class="absolute top-2 right-2 bg-secondary/20 text-secondary px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
                <div class="flex gap-2 items-center mb-3">
                  <span class="inline-block bg-primary/20 text-primary py-1 px-3 rounded-full text-xs font-medium">
                    Article
                  </span>
                  <span class="inline-block bg-secondary/10 text-secondary py-0.5 px-2 rounded-full text-xs font-medium ml-1">Heirs</span>
                </div>
                <h3 class="content-card-title text-xl font-semibold">
                  The Case for Ethical Nepotism™
                </h3>
                <p class="content-card-description line-clamp-3 mt-2">
                  How families can create opportunity for their own while maintaining integrity and excellence. Redefining inheritance as responsibility, not entitlement.
                </p>
                <div class="mt-3 mb-4 flex flex-wrap">
                  <span class="inline-block bg-muted text-foreground/70 py-0.5 px-2 rounded-full text-xs font-medium mr-1 mb-1">Family Legacy</span>
                  <span class="inline-block bg-muted text-foreground/70 py-0.5 px-2 rounded-full text-xs font-medium mr-1 mb-1">Next-Gen Stewardship</span>
                </div>
                <a 
                  href="/articles/ethical-nepotism" 
                  class="content-card-actions inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-10 px-5 py-2 border border-primary bg-primary text-white shadow hover:bg-primary/90 w-full mt-2"
                >
                  <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  Read Article
                </a>
              </div>
            </div>
          </div>

          <!-- Non-featured resources will be added dynamically by JavaScript -->
        </div>

        <!-- No Results Message (hidden by default) -->
        <div id="no-results" class="hidden text-center py-16">
          <div class="max-w-md mx-auto">
            <Search className="w-16 h-16 mx-auto text-primary/30 mb-4" />
            <h3 class="text-xl font-medium text-primary mb-2">No matching resources</h3>
            <p class="text-muted-foreground">Try adjusting your search or filters to find what you're looking for.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Curated External Resources -->
  <section class="py-16 bg-white border-t border-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4">Curated External Resources</h2>
        <p class="text-lg text-foreground/80 mb-8">Valuable insights from respected sources in family legacy planning, storytelling, and wealth management.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- External Resource 1 -->
          <div class="border border-muted rounded-lg p-6 hover:shadow-md transition-shadow h-full flex flex-col">
            <h3 class="text-xl font-display font-semibold mb-3 text-primary">Family Business Governance: A Guide for Lasting Success</h3>
            <p class="text-foreground/80 mb-4 flex-grow">A comprehensive framework for establishing governance structures that support family business continuity across generations.</p>
            <div class="flex justify-between items-center mt-auto">
              <span class="text-sm text-muted-foreground">via Egon Zehnder</span>
              <a href="https://www.egonzehnder.com/industries/family-business-advisory/insights/family-business-governance" target="_blank" class="text-primary font-medium hover:underline inline-flex items-center">
                Read Article
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              </a>
            </div>
          </div>
          
          <!-- External Resource 2 -->
          <div class="border border-muted rounded-lg p-6 hover:shadow-md transition-shadow h-full flex flex-col">
            <h3 class="text-xl font-display font-semibold mb-3 text-primary">The Power of Family Stories</h3>
            <p class="text-foreground/80 mb-4 flex-grow">How storytelling can strengthen family bonds, preserve values, and create a sense of shared identity and purpose.</p>
            <div class="flex justify-between items-center mt-auto">
              <span class="text-sm text-muted-foreground">via Bessemer Trust</span>
              <a href="https://www.bessemertrust.com/insights/the-power-of-family-stories" target="_blank" class="text-primary font-medium hover:underline inline-flex items-center">
                Read Article
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              </a>
            </div>
          </div>
          
          <!-- External Resource 3 -->
          <div class="border border-muted rounded-lg p-6 hover:shadow-md transition-shadow h-full flex flex-col">
            <h3 class="text-xl font-display font-semibold mb-3 text-primary">Preserving Family Legacy: Heather K.'s Remento Review</h3>
            <p class="text-foreground/80 mb-4 flex-grow">A personal account of using digital tools to capture and preserve family stories for future generations.</p>
            <div class="flex justify-between items-center mt-auto">
              <span class="text-sm text-muted-foreground">via Remento Journal</span>
              <a href="https://www.remento.co/journal/preserving-family-legacy-heather-k-s-remento-review" target="_blank" class="text-primary font-medium hover:underline inline-flex items-center">
                Read Article
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              </a>
            </div>
          </div>
          
          <!-- External Resource 4 -->
          <div class="border border-muted rounded-lg p-6 hover:shadow-md transition-shadow h-full flex flex-col">
            <h3 class="text-xl font-display font-semibold mb-3 text-primary">Why Telling Our Family Stories Is So Beneficial</h3>
            <p class="text-foreground/80 mb-4 flex-grow">Research-backed insights on how family storytelling impacts emotional well-being, resilience, and intergenerational connections.</p>
            <div class="flex justify-between items-center mt-auto">
              <span class="text-sm text-muted-foreground">via Lifebook Memoirs</span>
              <a href="https://www.lifebookmemoirs.com/why-telling-our-family-stories-is-so-beneficial/" target="_blank" class="text-primary font-medium hover:underline inline-flex items-center">
                Read Article
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Updates Signup Section -->
  <section class="py-16 bg-muted/5 border-t border-muted/30">
    <div class="container">
      <div class="max-w-4xl mx-auto bg-primary/5 rounded-lg overflow-hidden shadow-sm">
        <div class="p-8 md:p-10">
          <h2 class="text-2xl font-display font-bold text-primary mb-3 text-center">Stay Connected</h2>
          <p class="text-foreground/80 mb-6 text-center">Get new tools, stories, and insights sent directly to your inbox.</p>
          
          <div class="flex justify-center">
            <a 
              href="/#join-the-room" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
              })}
            >
              Join the Room →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Time Triggered Modal has been removed to provide a cleaner user experience on this page -->
</BaseLayout>

<script>
  // Resource data for non-featured resources
  const resources = [
    {
      title: "Legacy Lessons from the Land",
      description: "Lessons from the land on stewardship, patience, and the rhythm of generational thinking.",
      type: "article",
      topic: "stewardship",
      audience: "founders",
      tags: ["family-legacy"],
      icon: "FileText", 
      url: "/pdfs/legacy_lessons_from_the_land_nw_a977d8d2.pdf",
      buttonText: "Read Article",
      isDownloadable: true
    },
    {
      title: "Raising the Steward: Preparing the Next Generation",
      description: "How to nurture a stewardship mindset in the next generation and prepare them for the responsibility of carrying forward a legacy.",
      type: "article",
      topic: "stewardship",
      audience: "founders",
      tags: ["nextgen-stewardship"],
      icon: "FileText",
      url: "/pdfs/raising_the_steward_blog_post_nw_2a8581a4.pdf",
      buttonText: "Read Article",
      isDownloadable: true
    },
    {
      title: "Why Legacy is a Lifestyle, Not Just Inheritance",
      description: "Moving beyond the narrow definition of legacy as what you leave behind to embrace it as how you live today.",
      type: "article",
      topic: "legacy",
      audience: "families",
      tags: ["family-legacy"],
      icon: "FileText",
      url: "/blog/legacy-lifestyle",
      buttonText: "Read Article",
      isDownloadable: false
    },
    {
      title: "Heir Readiness: 5 Questions to Ask Yourself",
      description: "Are you prepared to receive and steward what's being passed to you? Practical reflections for next-generation leaders.",
      type: "worksheet",
      topic: "strategy",
      audience: "heirs",
      tags: ["nextgen-stewardship"],
      icon: "FileQuestion",
      url: "/blog/heir-readiness",
      buttonText: "Read Worksheet",
      isDownloadable: false
    }
  ];

  // Full list of resources for filtering
  const allResources = [
    {
      title: "AI-Powered Legacy Assessment Tool",
      description: "The first AI-powered tool that helps families measure where they are, map what matters most, and take real steps to protect their legacy across generations.",
      type: "tool",
      topic: "assessment",
      audience: "", // No audience tag
      tags: [], // No dimension tags
      icon: "Tool",
      url: "/tools/legacy-assessment",
      buttonText: "Request Access to the Tool",
      isDownloadable: false,
      featured: true
    },
    {
      title: "The Legacy Conversation Starter Kit",
      description: "A comprehensive guide with prompts, questions, and frameworks to facilitate meaningful conversations about legacy within your family.",
      type: "worksheet",
      topic: "conversations",
      audience: "families",
      tags: ["transitions-healing"],
      icon: "ScrollText",
      url: "/pdfs/legacy_conversation_starter_kit.pdf",
      buttonText: "Download Kit",
      isDownloadable: true,
      featured: true
    },
    {
      title: "Parenting a Parent: A Guide for Adult Children",
      description: "Navigate the complex transition from child to caregiver with practical strategies, emotional support, and planning tools.",
      type: "guide",
      topic: "caregiving",
      audience: "families",
      tags: ["transitions-healing"],
      icon: "Book",
      url: "/articles/parenting-a-parent",
      buttonText: "Read Guide",
      isDownloadable: false,
      featured: true
    },
    {
      title: "The Case for Ethical Nepotism™",
      description: "How families can create opportunity for their own while maintaining integrity and excellence. Redefining inheritance as responsibility, not entitlement.",
      type: "article",
      topic: "nepotism",
      audience: "heirs",
      tags: ["family-legacy", "nextgen-stewardship"],
      icon: "FileText",
      url: "/articles/ethical-nepotism",
      buttonText: "Read Article",
      isDownloadable: false,
      featured: true
    },
    ...resources
  ];

  // Map filter button IDs to their corresponding data values
  const contentTypeMap = {
    'articles-filter': 'article',
    'guides-filter': 'guide',
    'worksheets-filter': 'worksheet',
    'tools-filter': 'tool',
    'videos-filter': 'video'
  };
  
  const audienceMap = {
    'founders-filter': 'founders',
    'heirs-filter': 'heirs',
    'families-filter': 'families',
    'cousins-filter': 'cousins'
  };
  
  const topicMap = {
    'legacy-filter': 'family-legacy',
    'nextgen-filter': 'nextgen-stewardship',
    'storytelling-filter': 'storytelling-culture',
    'economic-filter': 'economic-empowerment',
    'transitions-filter': 'transitions-healing'
  };
  
  // DOM Elements
  const resourcesGrid = document.getElementById('resources-grid');
  const noResults = document.getElementById('no-results');
  const searchInput = document.getElementById('resource-search');
  const filterButtons = [
    document.getElementById('all-filter'),
    document.getElementById('articles-filter'),
    document.getElementById('guides-filter'),
    document.getElementById('worksheets-filter'),
    document.getElementById('tools-filter'),
    document.getElementById('videos-filter')
  ];

  // Filter state
  let activeContentFilter = 'all-filter';
  let activeAudienceFilters = [];
  let activeTopicFilters = [];
  let searchQuery = '';

  // Function to update visibility of resource cards based on filters
  function updateCardVisibility() {
    // Get all resource cards
    const resourceCards = document.querySelectorAll('.featured-card');
    let visibleCards = 0;
    
    resourceCards.forEach(card => {
      // Get card data attributes
      const cardType = card.getAttribute('data-type');
      const cardAudience = card.getAttribute('data-audience');
      const cardDimensions = card.getAttribute('data-dimensions')?.split(' ') || [];
      
      // Check content type filter
      const matchesContentType = activeContentFilter === 'all-filter' || 
                             contentTypeMap[activeContentFilter] === cardType;
      
      // Check audience filter - AND logic between tiers, OR within tier
      const matchesAudience = activeAudienceFilters.length === 0 || 
                          activeAudienceFilters.includes(cardAudience);
      
      // Check topic filter - AND logic between tiers, OR within tier
      const matchesTopic = activeTopicFilters.length === 0 || 
                       cardDimensions.some(dim => activeTopicFilters.includes(dim));
      
      // Apply AND logic between different filter tiers
      const shouldShow = matchesContentType && matchesAudience && matchesTopic;
      
      // Show or hide the card
      if (shouldShow) {
        card.style.display = '';
        visibleCards++;
      } else {
        card.style.display = 'none';
      }
    });
    
    // Show no results message if needed
    if (visibleCards === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  // Initialize page
  function initPage() {
    // Add event listeners for search
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase();
        updateCardVisibility();
      });
    }
    
    // Get all filter buttons by category
    const contentTypeFilters = document.querySelectorAll('[id$="-filter"]');
    const audienceFilters = [
      document.getElementById('founders-filter'),
      document.getElementById('heirs-filter'),
      document.getElementById('families-filter'),
      document.getElementById('cousins-filter')
    ];
    const topicFilters = [
      document.getElementById('legacy-filter'),
      document.getElementById('nextgen-filter'),
      document.getElementById('storytelling-filter'),
      document.getElementById('economic-filter'),
      document.getElementById('transitions-filter')
    ];
    
    // Add primary filter button listeners (Content Type)
    contentTypeFilters.forEach(button => {
      if (button && filterButtons.some(btn => btn && btn.id === button.id)) {
        button.addEventListener('click', () => {
          // Update active filter
          activeContentFilter = button.id;
          
          // If this is the 'all' filter, reset other filters too
          if (button.id === 'all-filter') {
            // Reset audience and topic filters
            activeAudienceFilters = [];
            activeTopicFilters = [];
            
            // Reset audience filter UI
            audienceFilters.forEach(btn => {
              if (btn) {
                btn.classList.remove('bg-secondary', 'text-white');
                btn.classList.add('bg-secondary/10', 'text-secondary');
              }
            });
            
            // Reset topic filter UI
            topicFilters.forEach(btn => {
              if (btn) {
                btn.classList.remove('bg-primary/20', 'text-primary');
                btn.classList.add('bg-muted', 'text-foreground/70');
              }
            });
          }
          
          // Update button styles
          filterButtons.forEach(btn => {
            if (btn) {
              if (btn.id === activeContentFilter) {
                btn.classList.remove('bg-primary/5', 'hover:bg-primary/10', 'text-primary');
                btn.classList.add('bg-primary', 'text-white', 'shadow-sm');
              } else {
                btn.classList.remove('bg-primary', 'text-white', 'shadow-sm');
                btn.classList.add('bg-primary/5', 'hover:bg-primary/10', 'text-primary');
              }
            }
          });
          
          // Update card visibility
          updateCardVisibility();
        });
      }
    });
    
    // Add audience filter button listeners - use OR logic within tier
    audienceFilters.forEach(button => {
      if (button) {
        button.addEventListener('click', () => {
          // Get the audience value from the button id
          const audienceValue = audienceMap[button.id];
          
          // Toggle active state - OR logic within this tier
          if (activeAudienceFilters.includes(audienceValue)) {
            // Remove from active filters
            activeAudienceFilters = activeAudienceFilters.filter(a => a !== audienceValue);
            button.classList.remove('bg-secondary', 'text-white');
            button.classList.add('bg-secondary/10', 'text-secondary');
          } else {
            // Add to active filters
            activeAudienceFilters.push(audienceValue);
            button.classList.remove('bg-secondary/10', 'text-secondary');
            button.classList.add('bg-secondary', 'text-white');
          }
          
          // Update card visibility
          updateCardVisibility();
        });
      }
    });
    
    // Add topic filter button listeners - use OR logic within tier
    topicFilters.forEach(button => {
      if (button) {
        button.addEventListener('click', () => {
          // Get the topic value from button id
          const topicValue = topicMap[button.id];
          
          // Toggle active state - OR logic within this tier
          if (activeTopicFilters.includes(topicValue)) {
            // Remove from active filters
            activeTopicFilters = activeTopicFilters.filter(t => t !== topicValue);
            button.classList.remove('bg-primary/20', 'text-primary');
            button.classList.add('bg-muted', 'text-foreground/70');
          } else {
            // Add to active filters
            activeTopicFilters.push(topicValue);
            button.classList.remove('bg-muted', 'text-foreground/70');
            button.classList.add('bg-primary/20', 'text-primary');
          }
          
          // Update card visibility
          updateCardVisibility();
        });
      }
    });
  }

  // Mobile filter toggle functionality
  function initMobileFilters() {
    const filterToggleBtn = document.getElementById('filter-toggle-btn');
    const filterPanel = document.getElementById('filter-panel');
    const filterDownIcon = document.getElementById('filter-down-icon');
    const filterUpIcon = document.getElementById('filter-up-icon');
    const applyFiltersBtn = document.getElementById('apply-filters-btn');
    
    if (filterToggleBtn && filterPanel) {
      // Toggle filter panel visibility
      filterToggleBtn.addEventListener('click', () => {
        // Toggle filter panel
        filterPanel.classList.toggle('hidden');
        filterPanel.classList.toggle('md:block');
        filterPanel.classList.toggle('block');
        
        // Toggle icons
        filterDownIcon.classList.toggle('hidden');
        filterUpIcon.classList.toggle('hidden');
      });
      
      // Apply filters button (closes the filter panel on mobile)
      if (applyFiltersBtn) {
        applyFiltersBtn.addEventListener('click', () => {
          // Only take action if we're in mobile view
          if (window.innerWidth < 768) { // md breakpoint
            filterPanel.classList.add('hidden');
            filterPanel.classList.remove('block');
            filterDownIcon.classList.remove('hidden');
            filterUpIcon.classList.add('hidden');
          }
        });
      }
      
      // Handle resize events to ensure proper display state
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) { // md breakpoint
          // On desktop/tablet, always show filter panel
          filterPanel.classList.remove('hidden');
          filterPanel.classList.add('md:block');
        } else {
          // On mobile, hide by default unless explicitly shown
          if (!filterPanel.classList.contains('block')) {
            filterPanel.classList.add('hidden');
            filterDownIcon.classList.remove('hidden');
            filterUpIcon.classList.add('hidden');
          }
        }
      });
    }
  }

  // Run when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    initPage();
    initMobileFilters();
  });
</script>