---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, DollarSign, CreditCard, Banknote, Repeat, Shirt, ShoppingBag, ShoppingCart } from "lucide-react";
---

<BaseLayout
  title="Join the Room | In the Room With Legacy"
  description="Support the Legacy Movement by donating to our nonprofit programs and shopping our merchandise collection. Your contribution helps sustain our mission of preserving and building legacy across generations."
>
  <!-- Hero/Donation Section -->
  <section class="py-24 md:py-32 bg-[#f7f6dc]/50 relative">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-[#052d3f] leading-tight mb-6">
            Support the Legacy Movement.<br/>Join the Room.
          </h1>
          <p class="text-lg md:text-xl text-[#052d3f]/80 mb-8 max-w-3xl mx-auto">
            Your donation directly funds our nonprofit's mission to foster cultural conversation, build community, and provide public programming around legacy building. Every contribution helps us create spaces where legacy can thrive across generations.
          </p>
        </div>

        <!-- Donation Form -->
        <div class="bg-white rounded-xl shadow-lg border border-[#052d3f]/10 overflow-hidden">
          <div class="p-8">
            <div class="flex items-center gap-3 mb-6">
              <Heart className="h-6 w-6 text-[#9a4a0b]" />
              <h2 class="text-2xl font-display font-semibold text-[#052d3f]">Make a Donation</h2>
            </div>
            
            <form class="space-y-6">
              <div>
                <label for="donation-amount" class="block text-sm font-medium text-[#052d3f] mb-2">
                  Enter Custom Donation Amount
                </label>
                <div class="mt-1 relative rounded-md shadow-sm">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <DollarSign className="h-5 w-5 text-[#052d3f]/40" />
                  </div>
                  <input 
                    type="text" 
                    name="donation-amount" 
                    id="donation-amount" 
                    class="block w-full pl-10 pr-12 py-3 border-[#052d3f]/20 rounded-md focus:ring-[#052d3f] focus:border-[#052d3f]" 
                    placeholder="0.00"
                  />
                  <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <span class="text-gray-500 sm:text-sm">USD</span>
                  </div>
                </div>
              </div>
              
              <div>
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input 
                      id="recurring" 
                      name="recurring" 
                      type="checkbox" 
                      class="h-4 w-4 text-[#9a4a0b] border-gray-300 rounded"
                    >
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="recurring" class="font-medium text-[#052d3f] flex items-center">
                      <Repeat className="h-4 w-4 mr-2 text-[#9a4a0b]" />
                      Make this a monthly donation
                    </label>
                    <p class="text-[#052d3f]/70 mt-1">
                      Recurring donations help us plan and sustain our programs throughout the year.
                    </p>
                  </div>
                </div>
              </div>
              
              <div class="pt-4">
                <button 
                  type="submit" 
                  class={buttonVariants({
                    size: "lg",
                    class: "w-full justify-center font-medium bg-[#9a4a0b] text-[#f7f6dc] hover:bg-[#9a4a0b]/90 py-6 text-lg shadow-md"
                  })}
                >
                  <CreditCard className="mr-2 h-5 w-5" />
                  Donate Now
                </button>
                <p class="text-[#052d3f]/60 text-sm text-center mt-3 flex items-center justify-center">
                  <Banknote className="h-4 w-4 mr-1" />
                  Secure payment processed via Stripe
                </p>
              </div>
              
              <input type="hidden" name="form_name" value="Donation Form" />
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual Separator -->
  <div class="h-24 bg-[#052d3f]/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-[#052d3f]/5 transform -skew-y-2"></div>
  </div>

  <!-- Merchandise Section -->
  <section class="py-24 md:py-32 bg-white">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-[#052d3f] mb-6">
            Shop the Legacy Collection
          </h2>
          <p class="text-lg text-[#052d3f]/80 max-w-3xl mx-auto">
            Every purchase from our merchandise collection directly supports the IRL ecosystem and mission. Show your commitment to legacy building while helping us expand our impact.
          </p>
        </div>
        
        <!-- Product Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- T-shirt Design 1 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <Shirt className="h-20 w-20 text-[#052d3f]/30" />
                </div>
              </div>
              <div class="absolute top-4 right-4 bg-[#9a4a0b] text-[#f7f6dc] text-xs font-medium px-2 py-1 rounded">
                New
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL T-shirt (Design 1)</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$35.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- T-shirt Design 2 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <Shirt className="h-20 w-20 text-[#052d3f]/30" />
                </div>
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL T-shirt (Design 2)</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$35.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Sweatshirt -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <Shirt className="h-20 w-20 text-[#052d3f]/30" />
                </div>
              </div>
              <div class="absolute top-4 right-4 bg-[#052d3f] text-[#f7f6dc] text-xs font-medium px-2 py-1 rounded">
                Best Seller
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL Sweatshirt</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$55.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Tote Bag Design 1 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <ShoppingBag className="h-20 w-20 text-[#052d3f]/30" />
                </div>
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL Tote Bag (Design 1)</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$25.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Tote Bag Design 2 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <ShoppingBag className="h-20 w-20 text-[#052d3f]/30" />
                </div>
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL Tote Bag (Design 2)</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$25.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Mug Design 1 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <div class="h-16 w-16 bg-[#052d3f]/10 rounded-full"></div>
                </div>
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL Mug (Design 1)</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$18.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Mug Design 2 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <div class="h-16 w-16 bg-[#052d3f]/10 rounded-full"></div>
                </div>
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL Mug (Design 2)</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$18.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Cap -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <div class="w-16 h-8 bg-[#052d3f]/10 rounded-t-full"></div>
                </div>
              </div>
            </div>
            <div class="p-4 flex-grow">
              <h3 class="font-display text-lg font-semibold text-[#052d3f]">IRL Cap</h3>
              <p class="text-[#9a4a0b] font-medium mt-1">$28.00</p>
            </div>
            <div class="p-4 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
        </div>
        
        <div class="text-center mt-12">
          <a 
            href="#full-catalog" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/5"
            })}
          >
            View Full Catalog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>