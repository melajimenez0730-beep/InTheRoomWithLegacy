---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Quote } from "lucide-react";
---

<BaseLayout
  title="Submit Your Family Story | In the Room With Legacy"
  description="Share your family's legacy story to inspire others and preserve your narrative for generations to come."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          Every Family Has a Story
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          Storytelling is the heart of legacy building. Our narratives connect generations, preserve wisdom, and honor the shoulders we stand on. Through intentional documentation and celebration of our stories, we create living bridges between past, present, and future.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a 
            href="#submit-form" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Submit Your Story
          </a>
          <a 
            href="/about/founder-letter" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium"
            })}
          >
            Our Founder's Family Story
          </a>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-8 border border-primary/10 relative max-w-2xl mx-auto">
          <div class="absolute top-6 left-6 text-primary/20">
            <Quote className="h-10 w-10" />
          </div>
          <blockquote class="pl-12 text-lg text-foreground/80 italic">
            "The story of my grandmother's migration from Mississippi to Chicago in 1943 is the foundation of our family's identity. Working with IRL to document her journey gave us more than just memories—it gave us a roadmap for resilience and a legacy for generations to come."
          </blockquote>
          <div class="mt-4 text-right">
            <p class="font-medium text-primary">— Darius Williams</p>
            <p class="text-sm text-foreground/70">Chicago, IL • Legacy Member</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Submit Your Story Form Section -->
  <section class="py-24 bg-white" id="submit-form">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Share Your Family's Legacy
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          We're collecting family stories to inspire, educate, and celebrate the rich tapestry of legacy being built in communities everywhere.
        </p>

        <div class="bg-white rounded-lg shadow-md p-6 md:p-8 border border-primary/10">
          <form class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-foreground mb-1">
                  Your Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-foreground mb-1">
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
            </div>
            
            <div>
              <label for="story_title" class="block text-sm font-medium text-foreground mb-1">
                Story Title
              </label>
              <input
                type="text"
                id="story_title"
                name="story_title"
                required
                placeholder="E.g., 'How My Grandmother Built Our Family Business'"
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="story_summary" class="block text-sm font-medium text-foreground mb-1">
                Brief Summary
              </label>
              <textarea
                id="story_summary"
                name="story_summary"
                rows={3}
                required
                placeholder="A short description of your story (2-3 sentences)"
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <div>
              <label for="story_content" class="block text-sm font-medium text-foreground mb-1">
                Your Family Story
              </label>
              <textarea
                id="story_content"
                name="story_content"
                rows={8}
                required
                placeholder="Share the details of your family's legacy story. What happened? Who was involved? What lessons were learned? How has this story shaped your family's identity or values?"
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <div>
              <label for="permission" class="flex items-start gap-2">
                <input
                  type="checkbox"
                  id="permission"
                  name="permission"
                  required
                  class="mt-1"
                />
                <span class="text-sm text-foreground/80">
                  I give permission for In the Room with Legacy to share my story on their website, social media, and other promotional materials. I understand that my story may be edited for clarity and length.
                </span>
              </label>
            </div>
            
            <input name="form_name" type="hidden" value="Family Story Submission" />
            
            <button
              type="submit"
              class="w-full py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Submit Your Story
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Share Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Why Share Your Story?
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <path d="M12 3v12"></path>
                <path d="M8 11c1 3.399 3.043 7 4 8.667 1.054-1.667 3-5.268 4-8.667C16 5 12 3 12 3s-4 2-4 8z"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Preserve Your Legacy</h3>
            <p class="text-foreground/80">
              Document your family's story so that it can be passed down for generations to come.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <path d="M17 10h-1a2 2 0 0 0-2 2v2c0 1.657.343 3 2 3a2 2 0 0 0 2-2"></path>
                <path d="M10 2v2c0 1.657-1.657 3-3.5 3S3 5.657 3 4V2"></path>
                <path d="M4 11h6"></path>
                <path d="M7 11v4h6"></path>
                <path d="M7 15H6"></path>
                <path d="M19 8h1a2 2 0 0 1 2 2v2c0 1.657-.343 3-2 3a2 2 0 0 1-2-2"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Inspire Others</h3>
            <p class="text-foreground/80">
              Your story might be exactly what another family needs to hear to start their own legacy journey.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <path d="M12 17h.01"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Gain New Insights</h3>
            <p class="text-foreground/80">
              The process of writing your story often reveals new perspectives and meanings you hadn't considered before.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Stories Preview -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Featured Family Stories
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          Read inspiring stories from families who have shared their legacy journeys.
        </p>
        
        <div class="bg-muted/10 p-8 rounded-lg border border-primary/10">
          <p class="text-xl font-medium text-primary italic">Coming Soon</p>
          <p class="text-foreground/80 mt-4">
            We're currently collecting our first round of family stories to feature. Submit yours today to be among the first!
          </p>
        </div>
        
        <div class="mt-12">
          <a 
            href="/blog" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Back to Blog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>