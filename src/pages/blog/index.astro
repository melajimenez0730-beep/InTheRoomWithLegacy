---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ArrowRight, Mail, ThumbsUp, Heart, BookOpen, ExternalLink, Instagram, Youtube, FileText } from "lucide-react";
import BlogNewsletterForm from "@/components/BlogNewsletterForm";
import StorySubmissionForm from "@/components/StorySubmissionForm";
import { Image } from 'astro:assets';
import familyBackground from "@/assets/snapinstato_511515285_18490157317069681_633616474964641373_n_nw_7c1699e8.jpg";
import familyPortrait from "@/assets/family_on_porch_nw_6bf9f9ad.jpg";
import legacyFamily from "@/assets/legacy_family_photo_nw_633bbeb1.jpg";
import familyGathering from "@/assets/family_gathering_nw_664eb12a.jpg";
import legacyMoments from "@/assets/legacy_moments_nw_f6fe48da.png";
import { Quote } from "lucide-react";
---

<BaseLayout
  title="Family Stories | In the Room With Legacy"
  description="Legacy lives through story. Explore real families' journeys of love, lineage, and learning, along with curated videos and features that celebrate inherited responsibility and belonging."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 relative overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute inset-0 z-0">
      <Image 
        src={familyBackground} 
        alt="Group of young girls smiling together, representing legacy in action" 
        class="w-full h-full object-cover brightness-[0.8] sepia-[0.15]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-primary/70 to-primary/60 mix-blend-multiply"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6">
          Family Stories
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-6 max-w-2xl mx-auto font-medium">
          Stories & Videos from Families Living Their Legacy
        </p>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Legacy lives through story. Explore real families' journeys of love, lineage, and learning, along with curated videos and features that celebrate inherited responsibility and belonging.
        </p>
      </div>
    </div>
  </section>
  

  <!-- Featured Stories Section - Reading Section -->
  <section id="featured-blogs" class="py-24 bg-gradient-to-b from-primary/5 to-primary/10">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Featured Stories
        </h2>
        <div class="bg-white border border-primary/20 rounded-lg p-10 shadow-sm relative overflow-hidden mb-10">
          <div class="absolute top-0 left-0 w-full h-2 bg-primary/30"></div>
          <div class="flex flex-col items-center justify-center py-6">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <path d="M12 9v4"></path>
                <path d="M12 17h.01"></path>
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
              </svg>
            </div>
            <h3 class="text-2xl font-display font-bold text-primary mb-3">Coming Soon</h3>
            <p class="text-lg text-foreground/80 max-w-2xl mx-auto">
              Our first featured stories are coming soon. We're building a living library of families who are preserving, creating, and reimagining legacy in their own ways.
            </p>
            <div class="mt-6 mb-2">
              <a 
                href="#newsletter-form" 
                class={buttonVariants({
                  size: "lg",
                  class: "font-medium"
                })}
              >
                Join the Room <ArrowRight className="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Legacy We Love Section - Curated Content -->
  <section class="py-24 bg-white border-t border-primary/5">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Legacy We Love <span class="text-lg font-normal text-primary/70">(Curated Content)</span>
        </h2>
        
        <div class="mt-12 space-y-6">
          <!-- Curated Item 1 -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md p-6">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-xl font-display font-bold text-primary mb-2">
                  The Robinson Family Farm — 6 Generations Strong
                </h3>
                <div class="flex items-center text-sm text-primary/70 mb-4">
                  <Instagram className="h-4 w-4 mr-1" /> 
                  <span>Source: Instagram</span>
                </div>
              </div>
              <a 
                href="https://www.instagram.com/explore/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-primary hover:text-primary/80 transition-colors"
              >
                <ExternalLink className="h-5 w-5" />
              </a>
            </div>
            <p class="text-foreground/80">Follow along with the Robinson family as they document their multigenerational journey of land stewardship and agricultural heritage.</p>
          </div>
          
          <!-- Curated Item 2 -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md p-6">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-xl font-display font-bold text-primary mb-2">
                  The Williams Sisters on Heritage & Drive
                </h3>
                <div class="flex items-center text-sm text-primary/70 mb-4">
                  <FileText className="h-4 w-4 mr-1" /> 
                  <span>Source: Article</span>
                </div>
              </div>
              <a 
                href="https://www.example.com/article" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-primary hover:text-primary/80 transition-colors"
              >
                <ExternalLink className="h-5 w-5" />
              </a>
            </div>
            <p class="text-foreground/80">An insightful exploration of how family legacy and shared values shaped one of sports' most inspiring sibling partnerships.</p>
          </div>
          
          <!-- Curated Item 3 -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md p-6">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-xl font-display font-bold text-primary mb-2">
                  Passing Down Purpose: A Short Film on Family Legacy
                </h3>
                <div class="flex items-center text-sm text-primary/70 mb-4">
                  <Youtube className="h-4 w-4 mr-1" /> 
                  <span>Source: YouTube</span>
                </div>
              </div>
              <a 
                href="https://www.youtube.com/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-primary hover:text-primary/80 transition-colors"
              >
                <ExternalLink className="h-5 w-5" />
              </a>
            </div>
            <p class="text-foreground/80">This touching documentary captures three generations of a family business and how they've maintained their values while adapting to changing times.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Visual Divider Section -->
  <section class="py-16 bg-[#F7F7F7] border-y border-primary/10">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center justify-center">
          <div class="h-px bg-primary/20 flex-grow"></div>
          <div class="px-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary/50">
              <path d="M12 3v12"></path>
              <path d="M8 11c1 3.399 3.043 7 4 8.667 1.054-1.667 3-5.268 4-8.667C16 5 12 3 12 3s-4 2-4 8z"></path>
            </svg>
          </div>
          <div class="h-px bg-primary/20 flex-grow"></div>
        </div>
        <div class="text-center mt-8">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
            Share Your Family's Story
          </h2>
          <p class="text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
            Every family carries something worth passing down — a story, a ritual, a lesson.
          </p>
          <div class="mt-6">
            <a 
              href="#submit-form" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium text-white bg-primary hover:bg-primary/90 transition-colors duration-300 px-8 py-6 text-lg shadow-md"
              })}
            >
              Submit Your Story <ArrowRight className="ml-2 h-5 w-5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Submit Your Story Form Section - Contribution Section -->
  <section class="py-24 bg-primary/5" id="submit-form">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Submit Your Story
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          We're collecting family stories to inspire, educate, and celebrate the rich tapestry of legacy being built in communities everywhere.
        </p>

        <StorySubmissionForm client:load />
      </div>
    </div>
  </section>

  <!-- Why Share Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Why Share Your Story?
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <path d="M12 3v12"></path>
                <path d="M8 11c1 3.399 3.043 7 4 8.667 1.054-1.667 3-5.268 4-8.667C16 5 12 3 12 3s-4 2-4 8z"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Preserve Your Legacy</h3>
            <p class="text-foreground/80">
              Document your family's story so that it can be passed down for generations to come.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <path d="M17 10h-1a2 2 0 0 0-2 2v2c0 1.657.343 3 2 3a2 2 0 0 0 2-2"></path>
                <path d="M10 2v2c0 1.657-1.657 3-3.5 3S3 5.657 3 4V2"></path>
                <path d="M4 11h6"></path>
                <path d="M7 11v4h6"></path>
                <path d="M7 15H6"></path>
                <path d="M19 8h1a2 2 0 0 1 2 2v2c0 1.657-.343 3-2 3a2 2 0 0 1-2-2"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Inspire Others</h3>
            <p class="text-foreground/80">
              Your story might be exactly what another family needs to hear to start their own legacy journey.
            </p>
          </div>
          
          <div class="bg-white p-6 rounded-lg shadow-sm border border-primary/10">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <path d="M12 17h.01"></path>
              </svg>
            </div>
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Gain New Insights</h3>
            <p class="text-foreground/80">
              The process of writing your story often reveals new perspectives and meanings you hadn't considered before.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Newsletter Form -->
  <section class="py-16 bg-white" id="newsletter-form">
    <div class="container">
      <div class="max-w-md mx-auto">
        <BlogNewsletterForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Custom styles for blog cards */
  @media (min-width: 768px) {
    .grid {
      grid-template-rows: 1fr 1fr;
      grid-auto-rows: 1fr;
    }
  }
</style>