---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ArrowRight, Mail, Bookmark, Users } from "lucide-react";
---

<BaseLayout
  title="Blog | In the Room With Legacy"
  description="Explore powerful stories, reflections, and insights on what it means to build, carry, and live legacy—in all its forms."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          Where Legacy Lives in Real Life
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          Explore powerful stories, reflections, and insights on what it means to build, carry, and live legacy—in all its forms.
        </p>
      </div>
    </div>
  </section>

  <!-- Stories & Reflections Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Stories & Reflections
            </h2>
            <p class="text-foreground/80 text-lg">
              Founder's voice & timely insights.
            </p>
          </div>
          <a 
            href="/blog/stories" 
            class="inline-flex items-center text-primary font-medium mt-4 md:mt-0 hover:underline"
          >
            Read More Stories <ArrowRight className="ml-1 h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Article 1 -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="aspect-[16/9] bg-muted/30 relative">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <Mail className="w-12 h-12 text-primary/20" />
              </div>
            </div>
            <div class="p-6">
              <h3 class="font-display text-xl font-semibold text-primary mb-2 group-hover:text-primary/80 transition-colors">
                Letter from Our Founder
              </h3>
              <p class="text-foreground/70 mb-4 line-clamp-3">
                The journey that led to creating In the Room with Legacy and the mission that drives our work.
              </p>
              <a 
                href="/about/founder-letter" 
                class={buttonVariants({
                  variant: "outline",
                  class: "mt-2 w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Letter
              </a>
            </div>
          </div>

          <!-- Article 2 -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="aspect-[16/9] bg-muted/30 relative">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <Users className="w-12 h-12 text-primary/20" />
              </div>
            </div>
            <div class="p-6">
              <h3 class="font-display text-xl font-semibold text-primary mb-2 group-hover:text-primary/80 transition-colors">
                Ethical Nepotism™: Reclaiming Family Advantage
              </h3>
              <p class="text-foreground/70 mb-4 line-clamp-3">
                How families can create opportunity for their own while maintaining integrity and excellence.
              </p>
              <a 
                href="/blog/ethical-nepotism" 
                class={buttonVariants({
                  variant: "outline",
                  class: "mt-2 w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>

          <!-- Article 3 -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="aspect-[16/9] bg-muted/30 relative">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-primary/20">
                  <path d="M3 6l9 4.5L21 6"></path>
                  <path d="M3 10l9 4.5L21 10"></path>
                  <path d="M3 14l9 4.5L21 14"></path>
                  <path d="M3 18l9 4.5L21 18"></path>
                </svg>
              </div>
            </div>
            <div class="p-6">
              <h3 class="font-display text-xl font-semibold text-primary mb-2 group-hover:text-primary/80 transition-colors">
                What the Farm Taught Me About Legacy
              </h3>
              <p class="text-foreground/70 mb-4 line-clamp-3">
                Lessons from the land on stewardship, patience, and the rhythm of generational thinking.
              </p>
              <a 
                href="/blog/farm-legacy-lessons" 
                class={buttonVariants({
                  variant: "outline",
                  class: "mt-2 w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Family Spotlights Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Family Spotlights
            </h2>
            <p class="text-foreground/80 text-lg">
              Celebrating real stories of legacy in action.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 mb-8">
          <div class="flex flex-col md:flex-row">
            <div class="md:w-1/3 bg-muted/30 relative min-h-[200px] md:min-h-0">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <Users className="w-16 h-16 text-primary/20" />
              </div>
            </div>
            <div class="md:w-2/3 p-6 md:p-8">
              <h3 class="font-display text-2xl font-semibold text-primary mb-3">
                While We're Still Here: A Family Pilot Story
              </h3>
              <p class="text-foreground/80 mb-6">
                <span class="inline-block bg-secondary/20 text-secondary py-1 px-3 rounded-full text-sm font-medium">Coming Soon</span>
              </p>
              <p class="text-foreground/80 mb-6">
                An intimate look at how one family used our While We're Still Here program to bridge generations, honor their elders, and create a plan for their collective future.
              </p>
              <a 
                href="#join-the-room" 
                class={buttonVariants({
                  class: "mt-2"
                })}
              >
                Join the Room
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Legacy Insights Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Legacy Insights
            </h2>
            <p class="text-foreground/80 text-lg">
              Practical reflections to help you start building.
            </p>
          </div>
          <a 
            href="/tools" 
            class="inline-flex items-center text-primary font-medium mt-4 md:mt-0 hover:underline"
          >
            Explore Tools & Resources <ArrowRight className="ml-1 h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Insight 1 -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="p-6">
              <div class="mb-4">
                <Bookmark className="h-10 w-10 text-primary/30" />
              </div>
              <h3 class="font-display text-xl font-semibold text-primary mb-2 group-hover:text-primary/80 transition-colors">
                Heir Readiness: 5 Questions to Ask Yourself
              </h3>
              <p class="text-foreground/70 mb-4">
                Are you prepared to receive and steward what's being passed to you? Practical reflections for next-generation leaders.
              </p>
              <a 
                href="/blog/heir-readiness" 
                class={buttonVariants({
                  variant: "outline",
                  class: "mt-2 w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>

          <!-- Insight 2 -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="p-6">
              <div class="mb-4">
                <Bookmark className="h-10 w-10 text-primary/30" />
              </div>
              <h3 class="font-display text-xl font-semibold text-primary mb-2 group-hover:text-primary/80 transition-colors">
                Why Legacy is a Lifestyle, Not Just Inheritance
              </h3>
              <p class="text-foreground/70 mb-4">
                Moving beyond the narrow definition of legacy as what you leave behind to embrace it as how you live today.
              </p>
              <a 
                href="/blog/legacy-lifestyle" 
                class={buttonVariants({
                  variant: "outline",
                  class: "mt-2 w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-primary/5" id="join-the-room">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-primary mb-4 sm:mb-6">
          Want more stories, tools, and updates in your inbox?
        </h2>
        <div class="w-full max-w-md mx-auto mb-8">
          <a 
            href="#newsletter-form" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium w-full justify-center"
            })}
          >
            Join the Room
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Form -->
  <section class="py-16 bg-white" id="newsletter-form">
    <div class="container">
      <div class="max-w-md mx-auto">
        <div class="bg-white rounded-xl shadow-lg border border-primary/10 overflow-hidden">
          <div class="bg-primary/5 p-6 border-b border-primary/10">
            <h3 class="font-display text-2xl font-bold text-primary mb-2">Join the Room</h3>
            <p class="text-foreground/80">
              Be the first to receive new stories, resources and event invitations to help preserve your family's legacy.
            </p>
          </div>
          
          <form class="space-y-5 p-6">
            <div>
              <label for="name" class="block text-sm font-medium text-foreground mb-1">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>

            <div>
              <label for="interests" class="block text-sm font-medium text-foreground mb-1">
                What aspect of legacy are you most interested in? (Optional)
              </label>
              <textarea
                id="interests"
                name="interests"
                rows={3}
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>

            <input name="form_name" type="hidden" value="Blog Newsletter Signup" />
            
            <button
              type="submit"
              class="w-full py-6 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Join the Room
            </button>

            <p class="text-sm text-foreground/60 text-center">
              We respect your privacy and will never share your information.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>