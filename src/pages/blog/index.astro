---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ArrowRight, Mail, ThumbsUp, Heart, BookOpen } from "lucide-react";
import BlogNewsletterForm from "@/components/BlogNewsletterForm";
import { Image } from 'astro:assets';
import familyBackground from "@/assets/snapinstato_511515285_18490157317069681_633616474964641373_n_nw_7c1699e8.jpg";
import familyPortrait from "@/assets/family_on_porch_nw_6bf9f9ad.jpg";
import legacyFamily from "@/assets/legacy_family_photo_nw_633bbeb1.jpg";
import familyGathering from "@/assets/family_gathering_nw_664eb12a.jpg";
import legacyMoments from "@/assets/legacy_moments_nw_f6fe48da.png";
---

<BaseLayout
  title="Family Stories | In the Room With Legacy"
  description="Legacy lives through story. Explore real families' journeys of love, lineage, and learning, along with curated videos and features that celebrate inherited responsibility and belonging."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 relative overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute inset-0 z-0">
      <Image 
        src={familyBackground} 
        alt="Group of young girls smiling together, representing legacy in action" 
        class="w-full h-full object-cover brightness-[0.8] sepia-[0.15]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-primary/70 to-primary/60 mix-blend-multiply"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6">
          Family Stories
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-6 max-w-2xl mx-auto font-medium">
          Stories & Videos from Families Living Their Legacy
        </p>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Legacy lives through story. Explore real families' journeys of love, lineage, and learning, along with curated videos and features that celebrate inherited responsibility and belonging.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Featured Founder Video Section -->
  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg overflow-hidden shadow-md">
          <div class="aspect-w-16 aspect-h-9 w-full">
            <!-- Responsive Video Embed -->
            <div class="w-full h-0 pb-[56.25%] relative">
              <iframe 
                class="absolute top-0 left-0 w-full h-full" 
                src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
                title="Founder Video" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen
              ></iframe>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-display font-bold text-primary mb-2">A Message from Our Founder</h3>
            <p class="text-foreground/80">Our founder shares the vision and purpose behind In the Room with Legacy™ and how family stories shape our shared journey.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Blogs Section -->
  <section id="featured-blogs" class="py-24 bg-gradient-to-b from-primary/5 to-primary/10">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Featured Stories
            </h2>
            <p class="text-foreground/80 text-lg">
              Real families sharing their legacy journeys and insights.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
          <!-- Blog 1: Ethical Nepotism -->
          <div class="bg-white rounded-lg overflow-hidden shadow-md h-full flex flex-col transform hover:translate-y-[-5px] transition-all duration-300">
            <div class="w-full h-64 relative overflow-hidden">
              <Image 
                src={legacyMoments} 
                alt="Legacy moments collage showing family traditions" 
                class="w-full h-full object-cover"
                width="600"
                height="400"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="mb-2">
                <span class="inline-block bg-primary/10 text-primary py-1 px-3 rounded-full text-xs font-medium">
                  Article
                </span>
              </div>
              <h3 class="text-xl font-display font-bold text-primary mb-3">
                The Case for Ethical Nepotism: Reclaiming Family Advantage
              </h3>
              <p class="text-foreground/80 mb-6 flex-grow">
                How families can create opportunity for their own while maintaining integrity and excellence.
              </p>
              <a 
                href="/articles/ethical-nepotism" 
                class={buttonVariants({
                  variant: "default",
                  class: "w-full justify-center bg-primary text-white hover:bg-primary/90 mt-auto"
                })}
              >
                Read Article
              </a>
            </div>
          </div>

          <!-- Blog 2: Parenting a Parent -->
          <div class="bg-white rounded-lg overflow-hidden shadow-md h-full flex flex-col transform hover:translate-y-[-5px] transition-all duration-300">
            <div class="w-full h-64 relative overflow-hidden">
              <Image 
                src={familyPortrait} 
                alt="Family portrait on a porch, representing multigenerational connections" 
                class="w-full h-full object-cover"
                width="600"
                height="400"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="mb-2">
                <span class="inline-block bg-primary/10 text-primary py-1 px-3 rounded-full text-xs font-medium">
                  Guide
                </span>
              </div>
              <h3 class="text-xl font-display font-bold text-primary mb-3">
                Parenting a Parent: A Guide for Adult Children
              </h3>
              <p class="text-foreground/80 mb-6 flex-grow">
                Navigate the complex transition from child to caregiver with practical strategies, emotional support, and planning tools.
              </p>
              <a 
                href="/blog/parenting-a-parent" 
                class={buttonVariants({
                  variant: "default",
                  class: "w-full justify-center bg-primary text-white hover:bg-primary/90 mt-auto"
                })}
              >
                Read Guide
              </a>
            </div>
          </div>

          <!-- Blog 3: Raising the Steward -->
          <div class="bg-white rounded-lg overflow-hidden shadow-md h-full flex flex-col transform hover:translate-y-[-5px] transition-all duration-300">
            <div class="w-full h-64 relative overflow-hidden">
              <Image 
                src={legacyFamily} 
                alt="Family beach gathering, representing legacy and generational connections" 
                class="w-full h-full object-cover"
                width="600"
                height="400"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="mb-2">
                <span class="inline-block bg-primary/10 text-primary py-1 px-3 rounded-full text-xs font-medium">
                  Article
                </span>
              </div>
              <h3 class="text-xl font-display font-bold text-primary mb-3">
                Raising the Steward: Preparing the Next Generation for Responsibility
              </h3>
              <p class="text-foreground/80 mb-6 flex-grow">
                How to nurture a stewardship mindset in the next generation and prepare them for the responsibility of carrying forward a legacy.
              </p>
              <a 
                href="/articles/raising-the-steward" 
                class={buttonVariants({
                  variant: "default",
                  class: "w-full justify-center bg-primary text-white hover:bg-primary/90 mt-auto"
                })}
              >
                Read Article
              </a>
            </div>
          </div>

          <!-- Blog 4: Legacy Lessons from the Land -->
          <div class="bg-white rounded-lg overflow-hidden shadow-md h-full flex flex-col transform hover:translate-y-[-5px] transition-all duration-300">
            <div class="w-full h-64 relative overflow-hidden">
              <Image 
                src={familyGathering} 
                alt="Family gathering outdoors, representing land stewardship and connection" 
                class="w-full h-full object-cover"
                width="600"
                height="400"
              />
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <div class="mb-2">
                <span class="inline-block bg-primary/10 text-primary py-1 px-3 rounded-full text-xs font-medium">
                  Article
                </span>
              </div>
              <h3 class="text-xl font-display font-bold text-primary mb-3">
                Legacy Lessons from the Land
              </h3>
              <p class="text-foreground/80 mb-6 flex-grow">
                Lessons from the land on stewardship, patience, and the rhythm of generational thinking.
              </p>
              <a 
                href="/articles/legacy-lessons-land" 
                class={buttonVariants({
                  variant: "default",
                  class: "w-full justify-center bg-primary text-white hover:bg-primary/90 mt-auto"
                })}
              >
                Read Article
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Submit Your Story Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="md:w-1/2">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
              Have a Legacy Story to Share?
            </h2>
            <p class="text-foreground/80 text-lg mb-6">
              Your family's legacy journey could inspire others. We're collecting stories of how families are preserving what matters most across generations.
            </p>
            <a 
              href="/blog/submit-story" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium"
              })}
            >
              Submit Your Story
            </a>
          </div>
          <div class="md:w-1/2">
            <div class="bg-primary/5 rounded-lg p-8 flex items-center justify-center">
              <BookOpen className="w-24 h-24 text-primary/30" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-primary/5" id="join-the-room">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-primary mb-4 sm:mb-6">
          Want more stories, tools, and updates in your inbox?
        </h2>
        <div class="w-full max-w-md mx-auto mb-8">
          <a 
            href="#newsletter-form" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium w-full justify-center"
            })}
          >
            Join the Room
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Form -->
  <section class="py-16 bg-white" id="newsletter-form">
    <div class="container">
      <div class="max-w-md mx-auto">
        <BlogNewsletterForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Custom styles for blog cards */
  @media (min-width: 768px) {
    .grid {
      grid-template-rows: 1fr 1fr;
      grid-auto-rows: 1fr;
    }
  }
</style>