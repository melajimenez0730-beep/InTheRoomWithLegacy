---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ArrowRight, Mail, Bookmark, Users } from "lucide-react";
import BlogNewsletterForm from "@/components/BlogNewsletterForm";
import { Image } from 'astro:assets';
import familyBackground from "@/assets/snapinstato_511515285_18490157317069681_633616474964641373_n_nw_7c1699e8.jpg";
---

<BaseLayout
  title="Blog | In the Room With Legacy"
  description="Explore powerful stories, reflections, and insights on what it means to build, carry, and live legacy—in all its forms."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 relative overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute inset-0 z-0">
      <Image 
        src={familyBackground} 
        alt="Group of young girls smiling together, representing legacy in action" 
        class="w-full h-full object-cover brightness-[0.8] sepia-[0.15]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-primary/70 to-primary/60 mix-blend-multiply"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6">
          This didn't start with strategy.<br/>It started with a story.
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          In the Room with Legacy™ was born in a sacred transition.
        </p>
        <a 
          href="#stories-reflections" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium bg-[#9a4a0b] text-[#f7f6dc] hover:bg-[#052d3f] transition-colors duration-300 px-8 py-3 text-lg shadow-lg"
          })}
        >
          Explore Our Stories
        </a>
      </div>
    </div>
  </section>

  <!-- Stories & Reflections Section -->
  <section id="stories-reflections" class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Stories & Reflections
            </h2>
            <p class="text-foreground/80 text-lg">
              Founder's voice & timely insights.
            </p>
          </div>
          <a 
            href="/blog/stories" 
            class="inline-flex items-center text-primary font-medium mt-4 md:mt-0 hover:underline"
          >
            Read More Stories <ArrowRight className="ml-1 h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Article 1 -->
          <div class="content-card">
            <div class="content-card-header content-card-media">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <Mail className="w-12 h-12 content-card-icon" />
              </div>
            </div>
            <div class="content-card-content">
              <h3 class="content-card-title">
                Letter from Our Founder
              </h3>
              <p class="content-card-description line-clamp-3">
                The journey that led to creating In the Room with Legacy and the mission that drives our work.
              </p>
              <a 
                href="/about/founder-letter" 
                class={buttonVariants({
                  variant: "outline",
                  class: "content-card-actions w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Letter
              </a>
            </div>
          </div>

          <!-- Article 2 -->
          <div class="content-card">
            <div class="content-card-header content-card-media">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <Users className="w-12 h-12 content-card-icon" />
              </div>
            </div>
            <div class="content-card-content">
              <h3 class="content-card-title">
                Ethical Nepotism™: Reclaiming Family Advantage
              </h3>
              <p class="content-card-description line-clamp-3">
                How families can create opportunity for their own while maintaining integrity and excellence.
              </p>
              <a 
                href="/blog/ethical-nepotism" 
                class={buttonVariants({
                  variant: "outline",
                  class: "content-card-actions w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>

          <!-- Article 3 -->
          <div class="content-card">
            <div class="content-card-header content-card-media">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="content-card-icon">
                  <path d="M3 6l9 4.5L21 6"></path>
                  <path d="M3 10l9 4.5L21 10"></path>
                  <path d="M3 14l9 4.5L21 14"></path>
                  <path d="M3 18l9 4.5L21 18"></path>
                </svg>
              </div>
            </div>
            <div class="content-card-content">
              <h3 class="content-card-title">
                Why Farming  is such a great example to understand of
              </h3>
              <p class="content-card-description line-clamp-3">
                Lessons from the land on stewardship, patience, and the rhythm of generational thinking.
              </p>
              <a 
                href="/blog/farm-legacy-lessons" 
                class={buttonVariants({
                  variant: "outline",
                  class: "content-card-actions w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Family Spotlights Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Family Spotlights
            </h2>
            <p class="text-foreground/80 text-lg">
              Celebrating real stories of legacy in action.
            </p>
          </div>
        </div>

        <div class="content-card mb-8">
          <div class="flex flex-col md:flex-row">
            <div class="md:w-1/3 content-card-header content-card-media min-h-[200px] md:min-h-0">
              <div class="absolute inset-0 flex items-center justify-center text-muted-foreground/50">
                <Users className="w-16 h-16 content-card-icon" />
              </div>
            </div>
            <div class="md:w-2/3 content-card-content">
              <h3 class="content-card-title text-2xl">
                While We're Still Here: A Family Pilot Story
              </h3>
              <p class="content-card-description mb-2">
                <span class="inline-block bg-secondary/20 text-secondary py-1 px-3 rounded-full text-sm font-medium">Coming Soon</span>
              </p>
              <p class="content-card-description mb-2">
                An intimate look at how one family used our While We're Still Here program to bridge generations, honor their elders, and create a plan for their collective future.
              </p>
              <a 
                href="#join-the-room" 
                class={buttonVariants({
                  class: "content-card-actions"
                })}
              >
                Join the Room
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Legacy Insights Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-3">
              Legacy Insights
            </h2>
            <p class="text-foreground/80 text-lg">
              Practical reflections to help you start building.
            </p>
          </div>
          <a 
            href="/tools" 
            class="inline-flex items-center text-primary font-medium mt-4 md:mt-0 hover:underline"
          >
            Explore Tools & Resources <ArrowRight className="ml-1 h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Insight 1 -->
          <div class="content-card">
            <div class="content-card-content">
              <div class="mb-4">
                <Bookmark className="h-10 w-10 content-card-icon" />
              </div>
              <h3 class="content-card-title">
                Heir Readiness: 5 Questions to Ask Yourself
              </h3>
              <p class="content-card-description">
                Are you prepared to receive and steward what's being passed to you? Practical reflections for next-generation leaders.
              </p>
              <a 
                href="/blog/heir-readiness" 
                class={buttonVariants({
                  variant: "outline",
                  class: "content-card-actions w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>

          <!-- Insight 2 -->
          <div class="content-card">
            <div class="content-card-content">
              <div class="mb-4">
                <Bookmark className="h-10 w-10 content-card-icon" />
              </div>
              <h3 class="content-card-title">
                Why Legacy is a Lifestyle, Not Just Inheritance
              </h3>
              <p class="content-card-description">
                Moving beyond the narrow definition of legacy as what you leave behind to embrace it as how you live today.
              </p>
              <a 
                href="/blog/legacy-lifestyle" 
                class={buttonVariants({
                  variant: "outline",
                  class: "content-card-actions w-full justify-center border-primary text-primary hover:bg-primary/10"
                })}
              >
                Read Article
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-primary/5" id="join-the-room">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-primary mb-4 sm:mb-6">
          Want more stories, tools, and updates in your inbox?
        </h2>
        <div class="w-full max-w-md mx-auto mb-8">
          <a 
            href="#newsletter-form" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium w-full justify-center"
            })}
          >
            Join the Room
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Form -->
  <section class="py-16 bg-white" id="newsletter-form">
    <div class="container">
      <div class="max-w-md mx-auto">
        <BlogNewsletterForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>