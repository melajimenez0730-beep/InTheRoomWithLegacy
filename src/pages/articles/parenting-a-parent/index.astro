  <!-- JavaScript for TOC toggle -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // TOC toggle functionality for mobile
      const tocToggle = document.getElementById('toc-toggle');
      const tocContent = document.getElementById('toc-content');
      const tocDown = document.getElementById('toc-down');
      const tocUp = document.getElementById('toc-up');
      
      if (tocToggle && tocContent && tocDown && tocUp) {
        tocToggle.addEventListener('click', () => {
          tocContent.classList.toggle('hidden');
          tocDown.classList.toggle('hidden');
          tocUp.classList.toggle('hidden');
        });
      }
      
      // Highlight active section in TOC based on scroll position
      const sections = document.querySelectorAll('div[id]');
      const navLinks = document.querySelectorAll('#article-nav a');
      
      function highlightActiveSection() {
        const scrollPosition = window.scrollY + 200; // Offset for better highlighting
        
        sections.forEach((section) => {
          const sectionTop = section.offsetTop;
          const sectionId = section.getAttribute('id');
          
          if (scrollPosition >= sectionTop) {
            navLinks.forEach((link) => {
              link.classList.remove('font-semibold', 'text-primary');
              if (link.getAttribute('href') === `#${sectionId}`) {
                link.classList.add('font-semibold', 'text-primary');
              }
            });
          }
        });
      }
      
      window.addEventListener('scroll', highlightActiveSection);
      highlightActiveSection(); // Initialize on load
    });
  </script>
