---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { CalendarDays, Users, Building, BookOpen, HeartHandshake, Star, DollarSign, Lightbulb, ArrowRight, CheckCircle, PlusCircle, Blocks, ChartNetwork, DraftingCompass, BookOpenText, Tent, Milestone } from "lucide-react";
import { Image } from 'astro:assets';
// TimeTriggeredModal import removed to disable floating CTA on this page
import legacyCollage from '../../assets/legacy_collage_nw_ddd335e4.png';
import familyTreeLogo from '../../assets/3_nw_b5691621.png';
import heroBackground from '../../assets/programs-hero-new_nw_92b9c4ca.jpg';
import whileWereStillHereImage from '../../assets/while-were-still-here_nw_7503e0d2.png';
import legacyFoundersLabImage from '../../assets/legacy-founders-lab_nw_f73e6c48.png';
import cousinCorpImage from '../../assets/cousin-corp_nw_ee448cf9.png';
import whyOurApproachWorksImage from '../../assets/why-our-approach-works_nw_488984b0.png';
import guidedStorytellingImage from '../../assets/guided-storytelling-documentation_nw_8d2ba124.png';
import strategicLegacyAdvisoryImage from '../../assets/strategic-legacy-advisory_nw_454507fe.png';
import intergenerationalRetreatsImage from '../../assets/intergenerational-retreats_nw_da108855.png';
import legacyPhoto from '../../assets/programs/legacy-photo_nw_1fc58f54.jpg';
import familyLegacyPhoto from '../../assets/programs/family-legacy_nw_7f4ee194.jpg';
import { CustomProgramModal } from "@/components/CustomProgramModal";
---

<BaseLayout
  title="Legacy Programs | In the Room With Legacy"
  description="Programs built around five core dimensions of legacy — designed to meet you where you are, and wherever you want to go."
>
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden bg-primary">
    <!-- Background with photo image -->
    <div class="absolute inset-0 w-full h-full z-0">
      <!-- Background Photo -->
      <Image 
        src={heroBackground} 
        alt="Legacy Programs - In the Room with Legacy" 
        class="w-full h-full object-cover object-center"
        width={1920}
        height={1080}
        loading="eager"
      />
      <!-- Dark overlay for readability -->
      <div class="absolute inset-0 bg-primary/70"></div>
      
      <!-- Photo Credits -->
      <div class="absolute bottom-4 right-4 text-white/70 text-xs z-10">
        <p>Photos via the Ann Arbor District Library</p>
      </div>
      
      <!-- Family tree logo overlay removed -->
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 px-4 drop-shadow-md">
          Legacy in Action: Programs Rooted in Purpose
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 max-w-2xl mx-auto px-4">
          Programs built around five core dimensions of legacy — designed to meet you where you are, and wherever you want to go.
        </p>
      </div>
    </div>
  </section>

  <!-- The Five Pillars of Legacy Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Key Practice Areas
        </h2>

        <p class="text-lg text-center text-foreground/80 mb-10 max-w-3xl mx-auto">
          Our programs are built around five critical practice domains where legacy is most actively lived and strengthened. They're designed to meet families where they are today — whether you're getting started or scaling across generations — and launch you into what's next.
        </p>
        
        <p class="text-lg text-center text-foreground/80 mb-10 max-w-3xl mx-auto">
          Each program is powered by our Legacy Framework and our emerging Legacy Operating System (beta).
        </p>

        <!-- Pillars Cards Row -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-12">
          <!-- Family Legacy Pillar -->
          <div class="pillar-box bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col cursor-pointer" tabindex="0">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <BookOpen className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Family Legacy</h3>
              <p class="text-xs text-foreground/70">Preservation, Charters, Governance, Traditions, Systems</p>
              <div class="pillar-description absolute inset-0 opacity-0 md:group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Preserving the systems, charters, governance, and traditions that help families stay aligned across generations.
                </p>
              </div>
            </div>
          </div>

          <!-- Next-Gen Stewardship Pillar -->
          <div class="pillar-box bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col cursor-pointer" tabindex="0">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <Users className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Next-Gen Stewardship</h3>
              <p class="text-xs text-foreground/70">Youth, Heirs, Succession, Preparation</p>
              <div class="pillar-description absolute inset-0 opacity-0 md:group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Preparing heirs and youth to inherit with discipline, confidence, and purpose.
                </p>
              </div>
            </div>
          </div>

          <!-- Community & Belonging Pillar -->
          <div class="pillar-box bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col cursor-pointer" tabindex="0">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <HeartHandshake className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Community & Belonging</h3>
              <p class="text-xs text-foreground/70">Connection, Support, Relationships, Unity</p>
              <div class="pillar-description absolute inset-0 opacity-0 md:group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Strengthening relationships, cultivating shared cultural practices, and building purposeful connection that holds families together across generations.
                </p>
              </div>
            </div>
          </div>

          <!-- Economic Empowerment Pillar -->
          <div class="pillar-box bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col cursor-pointer" tabindex="0">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <DollarSign className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Economic Empowerment</h3>
              <p class="text-xs text-foreground/70">Family Business, Wealth Building, Financial Literacy</p>
              <div class="pillar-description absolute inset-0 opacity-0 md:group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Building wealth and enterprise that serve both the family and the broader community.
                </p>
              </div>
            </div>
          </div>

          <!-- Transitions & Healing Pillar -->
          <div class="pillar-box bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col cursor-pointer" tabindex="0">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <Lightbulb className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Transitions & Healing</h3>
              <p class="text-xs text-foreground/70">End-of-Life, Grief, Inheritance Readiness</p>
              <div class="pillar-description absolute inset-0 opacity-0 md:group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Guiding families through periods of change—such as end-of-life, grief, and inheritance readiness.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature Program Section -->
  <section class="py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">
              <Star className="w-4 h-4 mr-1" /> Flagship Program
            </div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4">
              While We're Still Here™
            </h2>
            <h3 class="text-xl text-primary/80 font-medium mb-6">
              Our flagship guided family experience — conversations that matter most, structured and sacred.
            </h3>
            
            <p class="text-foreground/80 mb-6">
              Step into your legacy with clarity, compassion, and connection. While We're Still Here™ offers families a space to confront transitions, align values, tell stories, and preserve what matters across generations.
            </p>
            <p class="text-foreground/80 mb-8">
              This is where families move from intention into structure, from silence into voice, and from legacy in theory into legacy in life.
            </p>
            <p class="text-foreground/80 mb-8">
              This foundational experience is the first in our program portfolio and uses the Legacy Framework and early components of the Legacy OS (beta).
            </p>
            
            <h4 class="font-display text-lg font-medium text-primary mb-4">What You'll Walk Away With:</h4>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>A recorded keepsake</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>A personalized Legacy Guidebook</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>Reflection and integration tools</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>Greater clarity, peace, and connection across generations</span>
              </li>
            </ul>
            
            <a 
              href="/programs/while-were-still-here" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium"
              })}
            >
              Learn More
            </a>
          </div>
          
          <div class="relative">
            <Image 
              src={whileWereStillHereImage} 
              alt="While We're Still Here - family legacy conversations program" 
              class="rounded-xl shadow-lg w-full h-auto object-cover aspect-[4/3]" 
              width={600}
              height={600}
            />
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-white/50 backdrop-blur-sm rounded-lg -z-10"></div>
            <div class="absolute -top-6 -right-6 w-24 h-24 border-2 border-primary/20 rounded-lg -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Programs Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Building What Comes Next
        </h2>
        
        <p class="text-xl md:text-2xl text-center text-primary/90 font-medium mb-12 max-w-3xl mx-auto">
          Our upcoming programs expand how families and kin groups learn, collaborate, and create shared value together.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
          <!-- Legacy Founders Lab Card -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md flex flex-col h-full">
            <div class="relative">
              <!-- Visual Header with Foundation Image -->
              <div class="h-52 bg-primary/5 flex items-center justify-center overflow-hidden">
                <Image 
                  src={legacyFoundersLabImage} 
                  alt="Legacy Founders Lab - Building family legacy foundation"
                  class="w-full h-full object-cover opacity-80"
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                
                <!-- Overlay Icon -->
                <div class="absolute bottom-0 right-0 transform translate-y-1/2 translate-x-[-15%]">
                  <div class="w-20 h-20 rounded-full bg-white shadow-lg p-4 flex items-center justify-center">
                    <Blocks className="text-primary w-12 h-12" />
                  </div>
                </div>
              </div>
            </div>
            
            <div class="p-8 pt-12 flex flex-col flex-grow">
              <div class="flex justify-between items-center mb-4">
                <h3 class="font-display text-2xl font-bold text-primary">Legacy Founders Lab™</h3>
                <span class="inline-block px-3 py-1 bg-secondary/10 text-secondary text-xs font-semibold rounded-full whitespace-nowrap ml-2">Launching 2026</span>
              </div>
              
              <h4 class="text-lg text-primary/80 font-medium mb-4">
                Where first-generation legacy builders lay the foundation for everything to come.
              </h4>
              
              <div class="flex-grow flex flex-col">
                <p class="text-foreground/80 mb-6">
                  A guided lab for entrepreneurs, creatives, and professionals who are building the "first brick" of family legacy.
                </p>
                
                <p class="text-foreground/80 mb-8">
                  Participants define what legacy means to them, clarify family values, and design early systems: from communication rituals to succession planning basics. Each cohort leaves with a First Brick Legacy Blueprint — a personal framework for building with intention and discipline.
                </p>
              </div>
              
              <div class="mt-auto">
                <a 
                  href="https://laurenrosamiller.kit.com/d714efb37b" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class={buttonVariants({
                    variant: "outline",
                    class: "border-primary text-primary hover:bg-primary/10 w-full justify-center"
                  })}
                >
                  Join Waitlist
                </a>
              </div>
            </div>
          </div>
          
          <!-- Cousin Corp Card -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md flex flex-col h-full">
            <div class="relative">
              <!-- Visual Header with Network Image -->
              <div class="h-52 bg-primary/5 flex items-center justify-center overflow-hidden">
                <Image 
                  src={cousinCorpImage} 
                  alt="Cousin Corp - Building collaborative family enterprises"
                  class="w-full h-full object-cover opacity-80"
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
                
                <!-- Overlay Icon -->
                <div class="absolute bottom-0 right-0 transform translate-y-1/2 translate-x-[-15%]">
                  <div class="w-20 h-20 rounded-full bg-white shadow-lg p-4 flex items-center justify-center">
                    <ChartNetwork className="text-primary w-12 h-12" />
                  </div>
                </div>
              </div>
            </div>
            
            <div class="p-8 pt-12 flex flex-col flex-grow">
              <div class="flex justify-between items-center mb-4">
                <h3 class="font-display text-2xl font-bold text-primary">Cousin Corp™</h3>
                <span class="inline-block px-3 py-1 bg-secondary/10 text-secondary text-xs font-semibold rounded-full whitespace-nowrap ml-2">Launching 2026</span>
              </div>
              
              <h4 class="text-lg text-primary/80 font-medium mb-4">
                From group chat to collective enterprise.
              </h4>
              
              <div class="flex-grow flex flex-col">
                <p class="text-foreground/80 mb-6">
                  Cousin Corp™ brings cousin groups together to co-create value — investing, launching ventures, and building together.
                </p>
                
                <p class="text-foreground/80 mb-8">
                  Each cohort learns the fundamentals of collaboration, shared decision-making, and financial stewardship, leaving with a "Cousin Operating Agreement" and collective action plan. It's a lab for building trust, wealth, and a new family narrative of ownership.
                </p>
              </div>
              
              <div class="mt-auto">
                <a 
                  href="https://laurenrosamiller.kit.com/d714efb37b" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class={buttonVariants({
                    variant: "outline",
                    class: "border-primary text-primary hover:bg-primary/10 w-full justify-center"
                  })}
                >
                  Join Waitlist
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Why These Pillars & Programs Matter -->
  <section class="py-24 bg-[#F7F7F7]">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
              Why Our Approach Works
            </h2>
            <p class="text-foreground/80 mb-6">
              Many legacy initiatives feel disconnected. Too abstract, too siloed, or too transactional. At In the Room with Legacy, we believe that legacy is holistic: story, systems, purpose, and transition all interwoven.
            </p>
            <p class="text-foreground/80 mb-6">
              By aligning programs with the five pillars, we ensure every offering connects purpose with practice, heart with structure, and memory with momentum.
            </p>
          </div>
          
          <div class="order-1 md:order-2 relative">
            <Image 
              src={whyOurApproachWorksImage} 
              alt="Why Our Approach Works - Holistic legacy building" 
              class="rounded-xl shadow-lg w-full h-auto object-cover aspect-[4/3]" 
              width={600}
              height={600}
            />
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/5 rounded-lg -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Custom Programs Section - Clean Image-Based Layout with Deep Blue Background -->
  <section class="py-24 bg-primary"> <!-- Primary Deep Blue background (#052d3f) -->
    <div class="container">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Headline -->
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white mb-6">
          Create Your Bespoke Legacy Experience
        </h2>
        
        <!-- Introductory Text -->
        <p class="text-xl md:text-2xl text-white/95 leading-relaxed mb-6 mx-auto max-w-3xl font-medium">
          Whether you join a flagship program or design a custom journey, we'll meet you where you are and help you build forward.
        </p>
        
        <p class="text-base text-white/80 leading-relaxed mb-12 mx-auto max-w-3xl">
          Advisors and family enterprise professionals can also license our tool-set, integrate our frameworks, and deliver legacy-focused solutions at scale.
        </p>
        
        <!-- Program Focus Areas with Images - Clean Three-Item List -->
        <div class="mb-16">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Focus Area 1: Storytelling & Documentation -->
            <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all">
              <div class="h-48 overflow-hidden">
                <Image 
                  src={guidedStorytellingImage}
                  alt="Guided Storytelling & Documentation - Preserving family memories"
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                  width={600}
                  height={400}
                />
              </div>
              <div class="p-6 text-center">
                <h4 class="font-semibold text-primary text-xl mb-2">Guided Storytelling & Documentation</h4>
                <p class="text-foreground/80">Capture and preserve the stories that define your family's journey and values.</p>
              </div>
            </div>
            
            <!-- Focus Area 2: Strategic Legacy Advisory -->
            <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all">
              <div class="h-48 overflow-hidden">
                <Image 
                  src={strategicLegacyAdvisoryImage}
                  alt="Strategic Legacy Advisory - Building frameworks for long-term family vision"
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                  width={600}
                  height={400}
                />
              </div>
              <div class="p-6 text-center">
                <h4 class="font-semibold text-primary text-xl mb-2">Strategic Legacy Advisory</h4>
                <p class="text-foreground/80">Create frameworks that align your resources with your family's long-term vision.</p>
              </div>
            </div>
            
            <!-- Focus Area 3: Intergenerational Retreats -->
            <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all">
              <div class="h-48 overflow-hidden">
                <Image 
                  src={intergenerationalRetreatsImage}
                  alt="Intergenerational Retreats - Strengthening family bonds across generations"
                  class="w-full h-full object-cover transition-transform hover:scale-105 duration-500"
                  width={600}
                  height={400}
                />
              </div>
              <div class="p-6 text-center">
                <h4 class="font-semibold text-primary text-xl mb-2">Intergenerational Retreats</h4>
                <p class="text-foreground/80">Curated gatherings that strengthen bonds and transfer wisdom across generations.</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- CTA content -->
        <div class="max-w-2xl mx-auto border-t border-white/10 pt-10">
          <p class="text-xl text-white mb-8">
            Our expert facilitators will guide you through a personalized discovery process to create a program that honors your family's unique story and aspirations.
          </p>
          
          <!-- CTA Button with direct link - Dark Brown Accent button with white text -->
          <div class="flex justify-center">
            <a 
              href="https://laurenrosamiller.kit.com/406652a985" 
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-base font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 px-8 py-4 text-lg !bg-[#8a5f36] !text-white hover:!bg-[#8a5f36]/90 font-medium shadow-lg"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer / CTA Section -->
  <section class="py-24 bg-[#f8f7f2]" id="waitlist">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Begin Your Legacy Journey
        </h2>
        <p class="text-xl text-foreground/80 mb-10 max-w-2xl mx-auto">
          Start with your Legacy Snapshot, our 3-5 minute assessment. Complete it to explore program fit, unlock priority access, and join our early beta tool cohort.
        </p>
        
        <div class="flex justify-center">
          <a 
            href="https://form.typeform.com/to/SM7cDSbt" 
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Take the Legacy Snapshot
          </a>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Time Triggered Modal has been removed to provide a cleaner user experience on this page -->
  
  <!-- Client-side script for mobile pillar box interaction -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const pillarBoxes = document.querySelectorAll('.pillar-box');
      const isMobile = window.matchMedia('(max-width: 768px)').matches;
      let activeBox = null;

      // Add click event to each pillar box
      pillarBoxes.forEach(box => {
        const description = box.querySelector('.pillar-description');
        
        // Only add click events for mobile
        if (isMobile) {
          box.addEventListener('click', (e) => {
            e.stopPropagation();
            
            // If this box is already active, close it
            if (activeBox === box) {
              description.classList.remove('opacity-100');
              description.classList.add('opacity-0');
              activeBox = null;
              return;
            }
            
            // Close any previously opened box
            if (activeBox) {
              const activeDesc = activeBox.querySelector('.pillar-description');
              activeDesc.classList.remove('opacity-100');
              activeDesc.classList.add('opacity-0');
            }
            
            // Open this box
            description.classList.remove('opacity-0');
            description.classList.add('opacity-100');
            activeBox = box;
          });
          
          // Support keyboard navigation for accessibility
          box.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              box.click();
            }
          });
        }
      });
      
      // Close active box when clicking elsewhere on the page (mobile only)
      if (isMobile) {
        document.addEventListener('click', () => {
          if (activeBox) {
            const activeDesc = activeBox.querySelector('.pillar-description');
            activeDesc.classList.remove('opacity-100');
            activeDesc.classList.add('opacity-0');
            activeBox = null;
          }
        });
      }
      
      // Update mobile detection on window resize
      window.addEventListener('resize', () => {
        const wasDesktop = !isMobile;
        const nowMobile = window.matchMedia('(max-width: 768px)').matches;
        
        // If switched from desktop to mobile
        if (wasDesktop && nowMobile) {
          location.reload(); // Reload page to re-initialize event handlers
        }
      });
    });
  </script>
</BaseLayout>