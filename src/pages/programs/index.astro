---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { CalendarDays, Users, Building, BookOpen, Quote, Star, DollarSign, Lightbulb, ArrowRight, CheckCircle, PlusCircle } from "lucide-react";
import { Image } from 'astro:assets';
import legacyCollage from '../../assets/legacy_collage_nw_ddd335e4.png';
import familyTreeLogo from '../../assets/3_nw_b5691621.png';
---

<BaseLayout
  title="Legacy Programs | In the Room With Legacy"
  description="Programs built around five core dimensions of legacy — designed to meet you where you are, and wherever you want to go."
>
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden bg-[#2C5F7F]">
    <!-- Background with enlarged family tree logo image -->
    <div class="absolute inset-0 w-full h-full z-0">
      <div class="relative w-full h-full flex items-center justify-center">
        <div class="absolute w-full mx-auto flex justify-center">
          <Image
            src={familyTreeLogo} 
            alt="Family tree logo symbolizing generations and legacy"
            class="w-[150%] md:w-[120%] max-w-none h-auto opacity-30"
            width={1200}
          />
        </div>
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 px-4 drop-shadow-md">
          Legacy in Action: Programs Rooted in Purpose
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 max-w-2xl mx-auto px-4">
          Programs built around five core dimensions of legacy — designed to meet you where you are, and wherever you want to go.
        </p>
      </div>
    </div>
  </section>

  <!-- The Five Pillars of Legacy Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          The Five Pillars That Guide Our Work
        </h2>

        <p class="text-lg text-center text-foreground/80 mb-10 max-w-3xl mx-auto">
          At In the Room with Legacy™, our offerings, from programs to tools to experiences, are built across these five foundational dimensions. These pillars represent how we approach legacy in real life.
        </p>

        <!-- Pillars Cards Row -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-12">
          <!-- Family Legacy Pillar -->
          <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <BookOpen className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Family Legacy</h3>
              <p class="text-xs text-foreground/70">Preservation, Charters, Governance, Traditions, Systems</p>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Preserving the systems, charters, governance, and traditions that help families stay aligned across generations.
                </p>
              </div>
            </div>
          </div>

          <!-- Next-Gen Stewardship Pillar -->
          <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <Users className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Next-Gen Stewardship</h3>
              <p class="text-xs text-foreground/70">Youth, Heirs, Succession, Preparation</p>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Preparing heirs and youth to inherit with discipline, confidence, and purpose.
                </p>
              </div>
            </div>
          </div>

          <!-- Storytelling & Culture Pillar -->
          <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <Quote className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Storytelling & Culture</h3>
              <p class="text-xs text-foreground/70">Oral History, Memory, Identity</p>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Honoring stories, memories, and oral history that connect generations and strengthen identity.
                </p>
              </div>
            </div>
          </div>

          <!-- Economic Empowerment Pillar -->
          <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <DollarSign className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Economic Empowerment</h3>
              <p class="text-xs text-foreground/70">Family Business, Wealth Building, Financial Literacy</p>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Building wealth and enterprise that serve both the family and the broader community.
                </p>
              </div>
            </div>
          </div>

          <!-- Transitions & Healing Pillar -->
          <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/10 hover:shadow-md transition-all group relative h-[250px] md:aspect-[1/1.2] flex flex-col">
            <div class="p-6 flex flex-col items-center text-center flex-grow">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
                <Lightbulb className="text-primary" size={20} />
              </div>
              <h3 class="font-display font-semibold text-primary mb-2">Transitions & Healing</h3>
              <p class="text-xs text-foreground/70">End-of-Life, Grief, Inheritance Readiness</p>
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 bg-white transition-opacity duration-300 flex flex-col justify-center p-4">
                <p class="text-sm text-foreground/80">
                  Guiding families through periods of change—such as end-of-life, grief, and inheritance readiness.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature Program Section -->
  <section class="py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">
              <Star className="w-4 h-4 mr-1" /> Flagship Program
            </div>
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4">
              While We're Still Here™
            </h2>
            <h3 class="text-xl text-primary/80 font-medium mb-6">
              Our flagship guided family experience — conversations that matter most, structured and sacred.
            </h3>
            
            <p class="text-foreground/80 mb-6">
              Step into your legacy with clarity, compassion, and connection. While We're Still Here™ offers families a space to confront transitions, align values, tell stories, and preserve what matters across generations.
            </p>
            <p class="text-foreground/80 mb-8">
              This is where families move from intention into structure, from silence into voice, and from legacy in theory into legacy in life.
            </p>
            
            <h4 class="font-display text-lg font-medium text-primary mb-4">What You'll Walk Away With:</h4>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>A recorded keepsake</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>A personalized Legacy Guidebook</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>Reflection and integration tools</span>
              </li>
              <li class="flex items-start gap-2">
                <CheckCircle className="text-primary w-5 h-5 mt-0.5 flex-shrink-0" />
                <span>Greater clarity, peace, and connection across generations</span>
              </li>
            </ul>
            
            <a 
              href="/programs/while-were-still-here" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium"
              })}
            >
              Learn More / Apply for Session
            </a>
          </div>
          
          <div class="relative">
            <img 
              src="https://images.unsplash.com/photo-1760544140069-89879dfd4031?w=1200&h=600&auto=format&fit=crop&q=80" 
              alt="Legacy roots symbolizing family connections" 
              class="rounded-xl shadow-lg w-full h-auto object-cover aspect-[4/3]" 
            />
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-white/50 backdrop-blur-sm rounded-lg -z-10"></div>
            <div class="absolute -top-6 -right-6 w-24 h-24 border-2 border-primary/20 rounded-lg -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Programs Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Building What Comes Next
        </h2>
        
        <p class="text-lg text-center text-foreground/80 mb-12 max-w-3xl mx-auto">
          Our upcoming programs expand how families and kin groups learn, collaborate, and create shared value together.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
          <!-- Legacy Founders Lab Card -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md">
            <div class="p-8">
              <div class="flex justify-between items-start mb-4">
                <h3 class="font-display text-2xl font-bold text-primary">Legacy Founders Lab™</h3>
                <span class="inline-block px-3 py-1 bg-secondary/10 text-secondary text-xs font-semibold rounded-full">Launching 2026</span>
              </div>
              
              <h4 class="text-lg text-primary/80 font-medium mb-4">
                Where first-generation legacy builders lay the foundation for everything to come.
              </h4>
              
              <p class="text-foreground/80 mb-6">
                A guided lab for entrepreneurs, creatives, and professionals who are building the "first brick" of family legacy.
              </p>
              
              <p class="text-foreground/80 mb-8">
                Participants define what legacy means to them, clarify family values, and design early systems: from communication rituals to succession planning basics. Each cohort leaves with a First Brick Legacy Blueprint — a personal framework for building with intention and discipline.
              </p>
              
              <a 
                href="#waitlist" 
                class={buttonVariants({
                  variant: "outline",
                  class: "border-primary text-primary hover:bg-primary/10"
                })}
              >
                Join Waitlist
              </a>
            </div>
          </div>
          
          <!-- Cousin Corp Card -->
          <div class="bg-white rounded-lg border border-primary/10 shadow-sm overflow-hidden transition-all hover:shadow-md">
            <div class="p-8">
              <div class="flex justify-between items-start mb-4">
                <h3 class="font-display text-2xl font-bold text-primary">Cousin Corp™</h3>
                <span class="inline-block px-3 py-1 bg-secondary/10 text-secondary text-xs font-semibold rounded-full">Launching 2026</span>
              </div>
              
              <h4 class="text-lg text-primary/80 font-medium mb-4">
                From group chat to collective enterprise.
              </h4>
              
              <p class="text-foreground/80 mb-6">
                Cousin Corp™ brings cousin groups together to co-create value — investing, launching ventures, and building together.
              </p>
              
              <p class="text-foreground/80 mb-8">
                Each cohort learns the fundamentals of collaboration, shared decision-making, and financial stewardship, leaving with a "Cousin Operating Agreement" and collective action plan.
                It's a lab for building trust, wealth, and a new family narrative of ownership.
              </p>
              
              <a 
                href="#waitlist" 
                class={buttonVariants({
                  variant: "outline",
                  class: "border-primary text-primary hover:bg-primary/10"
                })}
              >
                Join Waitlist
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- How It Works / Participation Flow -->
  <section class="py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          How to Engage with IRL Programs
        </h2>
        
        <div class="relative">
          <!-- Connector Line -->
          <div class="absolute left-[29px] top-12 bottom-12 w-0.5 bg-primary/20 hidden md:block"></div>
          
          <div class="space-y-10">
            <!-- Step 1 -->
            <div class="flex gap-6 items-start">
              <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-white font-bold text-xl z-10">1</div>
              <div>
                <h3 class="text-xl font-display font-semibold text-primary mb-2">Explore the Pillars</h3>
                <p class="text-foreground/80">Identify which dimension of legacy resonates most with your family's needs and goals.</p>
              </div>
            </div>
            
            <!-- Step 2 -->
            <div class="flex gap-6 items-start">
              <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-white font-bold text-xl z-10">2</div>
              <div>
                <h3 class="text-xl font-display font-semibold text-primary mb-2">Select a Program</h3>
                <p class="text-foreground/80">Begin with our flagship offering or join the waitlist for a future cohort.</p>
              </div>
            </div>
            
            <!-- Step 3 -->
            <div class="flex gap-6 items-start">
              <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-white font-bold text-xl z-10">3</div>
              <div>
                <h3 class="text-xl font-display font-semibold text-primary mb-2">Prepare Your Family or Group</h3>
                <p class="text-foreground/80">Receive guided prompts and reflections to prepare for meaningful engagement.</p>
              </div>
            </div>
            
            <!-- Step 4 -->
            <div class="flex gap-6 items-start">
              <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-white font-bold text-xl z-10">4</div>
              <div>
                <h3 class="text-xl font-display font-semibold text-primary mb-2">Participate Fully</h3>
                <p class="text-foreground/80">Engage in live or virtual facilitation rooted in care and structured for impact.</p>
              </div>
            </div>
            
            <!-- Step 5 -->
            <div class="flex gap-6 items-start">
              <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-white font-bold text-xl z-10">5</div>
              <div>
                <h3 class="text-xl font-display font-semibold text-primary mb-2">Integrate and Sustain</h3>
                <p class="text-foreground/80">Continue your legacy journey with follow-up resources and integration tools.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why These Pillars & Programs Matter -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
              Why Our Approach Works
            </h2>
            <p class="text-foreground/80 mb-6">
              Many legacy initiatives feel disconnected. Too abstract, too siloed, or too transactional. At IRL, we believe that legacy is holistic: story, systems, purpose, and transition all interwoven.
            </p>
            <p class="text-foreground/80 mb-6">
              By aligning programs with the five pillars, we ensure every offering connects purpose with practice, heart with structure, and memory with momentum.
            </p>
          </div>
          
          <div class="order-1 md:order-2 relative">
            <img src="https://images.unsplash.com/photo-1724156806455-b85572ae6608?w=1200&h=600&auto=format&fit=crop&q=80" alt="Tree roots symbolizing family legacy" class="rounded-xl shadow-lg w-full h-auto" />
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/5 rounded-lg -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer / CTA Section with Waitlist Form -->
  <section class="py-24 bg-[#f8f7f2]" id="waitlist">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Begin Your Legacy Journey
        </h2>
        <p class="text-xl text-foreground/80 mb-10 max-w-2xl mx-auto">
          Legacy lives in motion. Start with our signature experience, While We're Still Here™, or join the waitlist for our upcoming labs and collectives.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
          <a 
            href="/programs/while-were-still-here" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Apply for a Session
          </a>
          
          <a 
            href="#waitlist-form" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium"
            })}
          >
            Join the Waitlist
          </a>
        </div>
        
        <!-- Waitlist Form -->
        <div id="waitlist-form" class="bg-white rounded-xl shadow-lg border border-primary/10 overflow-hidden max-w-2xl mx-auto">
          <div class="bg-primary/5 p-6 border-b border-primary/10">
            <h3 class="font-display text-2xl font-bold text-primary mb-2">Program Waitlist</h3>
            <p class="text-foreground/80">
              Be the first to know when new programs launch. No spam, just legacy in motion.
            </p>
          </div>
          
          <form class="space-y-5 p-6">
            <div>
              <label for="name" class="block text-sm font-medium text-foreground mb-1">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="program-interest" class="block text-sm font-medium text-foreground mb-1">
                I'm most interested in:
              </label>
              <select
                id="program-interest"
                name="program_interest"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              >
                <option value="">Please select...</option>
                <option value="legacy-founders-lab">Legacy Founders Lab™</option>
                <option value="cousin-corp">Cousin Corp™</option>
                <option value="all-programs">All Future Programs</option>
              </select>
            </div>
            
            <input name="form_name" type="hidden" value="Program Waitlist" />
            
            <button
              type="submit"
              class="w-full py-6 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium text-base"
            >
              Join the Waitlist
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>