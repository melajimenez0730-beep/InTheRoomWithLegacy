---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { CalendarDays, Users, Building } from "lucide-react";
---

<BaseLayout
  title="Programs | In the Room With Legacy"
  description="Explore our programs designed to help families preserve their legacy, build stronger bonds, and prepare for the future."
>
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          Our Legacy Programs
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          Practical tools and experiences designed to help families preserve what matters most across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Signature Programs Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Signature Programs
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- While We're Still Here Program -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="bg-primary/10 p-5 flex items-center gap-3">
              <CalendarDays className="text-primary" size={20} />
              <h3 class="font-display font-semibold text-primary">While We're Still Here™</h3>
            </div>
            <div class="p-6">
              <p class="text-foreground/80 mb-4">
                A guided family experience bringing generations together for truth-telling, storytelling, and preparation—while you still can.
              </p>
              <a 
                href="/programs/while-were-still-here" 
                class={buttonVariants({
                  class: "w-full justify-center"
                })}
              >
                Learn More
              </a>
            </div>
          </div>

          <!-- Black Family Business Network Program -->
          <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
            <div class="bg-secondary/20 p-5 flex items-center gap-3">
              <Building className="text-primary" size={20} />
              <h3 class="font-display font-semibold text-primary">Black Family Business Network</h3>
            </div>
            <div class="p-6">
              <p class="text-foreground/80 mb-4">
                Specialized support for Black-owned family businesses navigating succession, growth, and generational wealth building.
              </p>
              <a 
                href="/programs/black-family-business-network" 
                class={buttonVariants({
                  class: "w-full justify-center"
                })}
              >
                Learn More
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools & Resources Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          Tools & Resources
        </h2>

        <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 p-8">
          <div class="flex flex-col md:flex-row gap-8 items-center">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
              <Users className="text-primary w-8 h-8" />
            </div>
            <div class="flex-1">
              <h3 class="font-display text-xl font-semibold text-primary mb-3">Legacy Assessment</h3>
              <p class="text-foreground/80 mb-6">
                Our AI-powered assessment tool helps you understand where you are in your legacy journey and provides actionable steps to preserve what matters most.
              </p>
              <a 
                href="/legacy-assessment" 
                class={buttonVariants({
                  variant: "outline",
                  class: "border-primary text-primary hover:bg-primary/10"
                })}
              >
                Take the Assessment
              </a>
            </div>
          </div>
        </div>

        <div class="text-center mt-10">
          <a 
            href="/tools-resources" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            View All Tools & Resources
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Where We're Headed Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Where We're Headed
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          We're constantly developing new programs to meet the needs of families at every stage of their legacy journey.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-muted/20 p-6 rounded-lg">
            <h3 class="font-display text-xl font-semibold text-primary mb-2">First Brick Legacy Founders Lab</h3>
            <p class="text-foreground/80 text-sm">Coming soon: An intensive program for first-generation wealth builders creating legacy from scratch.</p>
          </div>
          <div class="bg-muted/20 p-6 rounded-lg">
            <h3 class="font-display text-xl font-semibold text-primary mb-2">Cousin Court</h3>
            <p class="text-foreground/80 text-sm">Coming soon: A framework for extended family decision-making and conflict resolution across generations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-24 bg-muted/30" id="contact">
    <div class="container">
      <div class="max-w-xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-primary mb-6 text-center">
          Interested in Our Programs?
        </h2>
        <p class="text-foreground/80 mb-8 text-center">
          Fill out the form below to learn more about our programs or to inquire about partnership opportunities.
        </p>
        
        <div class="bg-white rounded-lg shadow-md p-6 md:p-8">
          <form class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-foreground mb-1">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="program-interest" class="block text-sm font-medium text-foreground mb-1">
                I'm interested in:
              </label>
              <select
                id="program-interest"
                name="program_interest"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              >
                <option value="">Please select...</option>
                <option value="while-were-still-here">While We're Still Here™</option>
                <option value="black-family-business">Black Family Business Network</option>
                <option value="legacy-assessment">Legacy Assessment</option>
                <option value="upcoming-programs">Upcoming Programs</option>
                <option value="other">Other inquiry</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-foreground mb-1">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows={4}
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <input name="form_name" type="hidden" value="Programs Inquiry" />
            
            <button
              type="submit"
              class="w-full py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Submit Inquiry
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>