  <!-- Client-side scripts -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Pillars Carousel functionality
      const carousel = document.getElementById('pillarsCarousel');
      
      if (carousel) {
        const slidesContainer = carousel.querySelector('.js-carousel-slides');
        const slides = carousel.querySelectorAll('.js-carousel-slide');
        const dotsContainer = carousel.querySelector('.flex.justify-center');
        const dots = carousel.querySelectorAll('.js-carousel-dot');
        const prevButton = carousel.querySelector('.js-carousel-prev');
        const nextButton = carousel.querySelector('.js-carousel-next');
        const totalSlides = slides.length;
        
        let currentIndex = 0;
        let intervalId;
        let isTransitioning = false;
        let isPaused = false;
        
        // Initialize slide widths and container width
        function initializeCarousel() {
          // Set the width of the slides container to accommodate all slides
          slidesContainer.style.width = `${totalSlides * 100}%`;
          
          // Set the width of each individual slide
          slides.forEach(slide => {
            slide.style.width = `${100 / totalSlides}%`;
          });
        }
        
        // Go to a specific slide
        function goToSlide(index) {
          if (isTransitioning) return;
          
          // Handle bounds
          if (index < 0) {
            index = totalSlides - 1;
          } else if (index >= totalSlides) {
            index = 0;
          }
          
          // Set transitioning flag
          isTransitioning = true;
          
          // Update current index
          currentIndex = index;
          
          // Move the slides
          slidesContainer.style.transform = `translateX(-${currentIndex * (100 / totalSlides)}%)`;
          
          // Update the dots
          dots.forEach((dot, i) => {
            if (i === currentIndex) {
              dot.classList.remove('bg-primary/30');
              dot.classList.add('bg-primary');
              dot.classList.add('active');
            } else {
              dot.classList.remove('bg-primary');
              dot.classList.remove('active');
              dot.classList.add('bg-primary/30');
            }
          });
          
          // Reset transitioning flag after animation completes
          setTimeout(() => {
            isTransitioning = false;
          }, 500); // Match CSS transition duration
        }
        
        // Start auto-sliding
        function startAutoSlide() {
          // Clear any existing interval
          clearInterval(intervalId);
          
          // Set up a new interval
          intervalId = setInterval(() => {
            if (!isPaused) {
              goToSlide(currentIndex + 1);
            }
          }, 5000); // 5 seconds between slides
        }
        
        // Event listeners
        function setupEventListeners() {
          // Previous button
          if (prevButton) {
            prevButton.addEventListener('click', () => {
              goToSlide(currentIndex - 1);
              startAutoSlide(); // Reset the interval
            });
          }
          
          // Next button
          if (nextButton) {
            nextButton.addEventListener('click', () => {
              goToSlide(currentIndex + 1);
              startAutoSlide(); // Reset the interval
            });
          }
          
          // Dots
          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              goToSlide(index);
              startAutoSlide(); // Reset the interval
            });
          });
          
          // Pause on hover
          carousel.addEventListener('mouseenter', () => {
            isPaused = true;
          });
          
          carousel.addEventListener('mouseleave', () => {
            isPaused = false;
          });
          
          // Handle window resize
          window.addEventListener('resize', () => {
            initializeCarousel();
            goToSlide(currentIndex); // Realign current slide
          });
        }
        
        // Initialize everything
        initializeCarousel();
        setupEventListeners();
        startAutoSlide();
      }
    });
  </script>

