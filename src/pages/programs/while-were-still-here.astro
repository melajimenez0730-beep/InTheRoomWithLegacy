---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Quote, Users, Heart, Book, Clock, DollarSign, Sparkles, MessageCircle, ChevronDown, MessageCircleMore, Archive, HandHeart, House, RefreshCw, ChevronLeft, ChevronRight, BookOpenText, BookOpenCheck, TableProperties, BookAudio, BookMarked, Speech, Video, UsersRound, ClipboardList } from "lucide-react";
import { Image } from 'astro:assets';
import familyVintagePhoto from "@/assets/snapinstato_509607686_18490265482069681_7611223003304458758_n_nw_a861f184.jpg";
import familyGatheringPhoto from "@/assets/family_gathering_nw_664eb12a.jpg";
import familyPorchPhoto from "@/assets/family_on_porch_nw_6bf9f9ad.jpg";
import legacyCollagePhoto from "@/assets/legacy_collage_nw_ddd335e4.png";
import gatherPhoto from "@/assets/legacy_family_photo_nw_633bbeb1.jpg";
import sharePhoto from "@/assets/snapinstato_529766155_18496969693069681_9043892236276025072_n_nw_0ec9db1c.jpg";
import alignPhoto from "@/assets/snapinstato_530365975_18496969774069681_3642407730921360497_n_nw_645f791c.jpg";
import preservePhoto from "@/assets/legacy_moments_nw_f6fe48da.png";
import integratePhoto from "@/assets/snapinstato_527636150_18496969756069681_5178750769135698917_n_nw_42ff2157.jpg";
import familyLegacyPhoto from "@/assets/ash-grey-and-black-modern-professional-brand-research-presentation-4_nw_2c87fa2a.png";
import laurenPhoto from "@/assets/kat_6276_nw_fcaf81f0.jpg";
import laurenVirtualPhoto from "@/assets/kat_6186_nw_05b4c467.jpg";
import laurenGroupPhoto from "@/assets/kat_6336_nw_f0e98a15.jpg";
import laurenPortraitPhoto from "@/assets/kat_6104_nw_d8b9de0d.jpg";
import legacyKidsPhoto from "@/assets/programs/legacy-kids_nw_efc270a4.jpg";
import whatIsWwshPhoto from "@/assets/programs/what-is-wwsh_nw_cbf3414a.jpg";
import heroBackgroundImage from "@/assets/hero/hero-family-legacy_nw_6cf7ce3c.jpg";
import legacyHeroBg from "@/assets/programs/legacy-hero-bg_nw_ff8d96a2.jpg";
import conversationsPhoto from "@/assets/programs/323769093_1223802644875475_4578389523644540484_n_nw_df63aa37.jpg";
import legacyGiftsPhoto from "@/assets/programs/556461416_18506426296069681_7302950192156255647_n_nw_3978208a.jpg";
---

<BaseLayout
  title="While We're Still Here™ | In the Room With Legacy"
  description="Bring your family together across generations for an unforgettable day of truth-telling, storytelling, and preparation — while you still can."
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 md:py-32 bg-primary relative overflow-hidden">
    <!-- Background Image with Blue Overlay -->
    <div class="absolute inset-0 z-0">
      <!-- Primary Background Image -->
      <Image 
        src={heroBackgroundImage} 
        alt="Family legacy photograph"
        class="w-full h-full object-cover"
      />
      <!-- Blue Tint Overlay -->
      <div class="absolute inset-0 bg-[#052d3f] opacity-70"></div>
    </div>

    
    <div class="container relative z-10">
      <div class="flex flex-col md:flex-row items-center">
        <!-- Text Content (Left on desktop, centered on mobile) -->
        <div class="md:w-1/2 text-center md:text-left px-4 mb-8 md:mb-0">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 drop-shadow-md">
            Because love, legacy, and truth can't wait until it's too late.
          </h1>
          
          <p class="text-base sm:text-lg md:text-xl text-white mb-8 max-w-xl mx-auto md:mx-0 drop-shadow-md">
            Guided family conversations that bring peace to life's transitions, preserve your stories, and prepare the next generation — while we're still here
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md mx-auto md:mx-0">
            <a 
              href="#apply" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90 transition-colors duration-300"
              })}
            >
              Request a Family Session
            </a>
          </div>
        </div>
        
        <!-- Right side for desktop - just spacing -->
        <div class="hidden md:block md:w-1/2"></div>
      </div>
    </div>
    
    <!-- Ticker Bar at Bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-12 bg-primary/40 backdrop-blur-sm border-t border-white/10 overflow-hidden z-[5]">
      <div class="ticker-wrap">
        <div class="ticker">
          <div class="ticker__item text-white/90">Preserve Family Stories</div>
          <div class="ticker__item text-white/90">Honor Shared Values</div>
          <div class="ticker__item text-white/90">Create a Living Legacy</div>
          <div class="ticker__item text-white/90">Build Intergenerational Connection</div>
          <div class="ticker__item text-white/90">Say What Needs to Be Said</div>
          <div class="ticker__item text-white/90">Strengthen Family Bonds</div>
          <div class="ticker__item text-white/90">Pass Down Family Wisdom</div>
          <div class="ticker__item text-white/90">Document Your Journey</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CSS for Hero Section Animations -->
  <style>
    /* Ticker Bar Styles */
    .ticker-wrap {
      width: 100%;
      overflow: hidden;
      height: 3rem;
      padding-left: 100%;
      box-sizing: content-box;
    }

    .ticker {
      display: inline-block;
      height: 3rem;
      line-height: 3rem;
      white-space: nowrap;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
      animation-name: ticker;
      animation-duration: 30s;
    }

    .ticker__item {
      display: inline-block;
      padding: 0 2rem;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.9);
    }

    @keyframes ticker {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-100%, 0, 0);
      }
    }
  </style>

  <!-- What It Is Section -->
  <section class="py-24 bg-[#f3f4f6]">
    <div class="container">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
        What is While We're Still Here™?
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 items-start">
        <div class="md:col-span-3 order-2 md:order-1">
          <div class="prose prose-lg max-w-none text-primary/80 space-y-6">
            <p>
              Silence is the quiet oppressor in many families — the topics we avoid are often the ones that matter most.
            </p>
            
            <p>
              While We're Still Here™ is your invitation to face those conversations now: about values, transitions, love, loss, and what it means to belong.
            </p>
            
            <div class="relative border-l-4 border-[#9a4a0b] pl-6 py-2 my-8">
              <p class="text-xl md:text-2xl font-display italic text-[#9a4a0b] !leading-relaxed">
                It's not a class or a lecture — it's a sacred space for your family to meet, speak, and heal together.
              </p>
            </div>
            
            <p>
              Through storytelling and guided dialogue, families gain the
              courage and structure to talk about the things that bring peace, closure, and connection — while we still can.
            </p>
            
            <p class="font-medium">
              Because preparing for tomorrow starts with honest conversation today.
            </p>
          </div>
        </div>
        
        <div class="md:col-span-2 order-1 md:order-2 flex justify-center md:justify-end">
          <div class="relative rounded-lg overflow-hidden shadow-xl max-w-sm">
            <Image 
              src={whatIsWwshPhoto} 
              alt="Historical black and white photo of children playing outdoors" 
              class="w-full object-cover brightness-[0.95] aspect-[3/4]" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/30 via-transparent to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why It Matters Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
        Why It Matters
      </h2>
      
      <div class="max-w-3xl mx-auto mb-12 text-center">
        <p class="text-lg text-primary/80 mb-6">
          Every family carries stories, wisdom, and lessons — but too often, those truths
          only surface after someone is gone.
        </p>
        
        <p class="text-lg text-primary/80 font-medium">
          This experience helps you:
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Benefit 1: Hard Conversations -->
        <div class="bg-[#f3f4f6] rounded-lg overflow-hidden shadow-md transition-transform hover:translate-y-[-4px]">
          <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
            <img 
              src={conversationsPhoto.src} 
              alt="Family legacy conversation" 
              width={conversationsPhoto.width} 
              height={conversationsPhoto.height} 
              class="object-cover w-full h-64 brightness-[0.9]" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 via-transparent to-transparent"></div>
          </div>
          
          <div class="p-6">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <MessageCircleMore className="text-primary w-6 h-6" />
            </div>
            
            <h3 class="text-xl font-display font-semibold text-primary mb-3">Have the hard conversations</h3>
            
            <p class="text-primary/80">
              About health, legacy, and end-of-life care with grace and intention.
            </p>
          </div>
        </div>
        
        <!-- Benefit 2: Preserve Stories -->
        <div class="bg-[#f3f4f6] rounded-lg overflow-hidden shadow-md transition-transform hover:translate-y-[-4px]">
          <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
            <img 
              src={legacyCollagePhoto.src} 
              alt="Collage of family photos preserving memories" 
              width={legacyCollagePhoto.width} 
              height={legacyCollagePhoto.height} 
              class="object-cover w-full h-64 brightness-[0.9]" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 via-transparent to-transparent"></div>
          </div>
          
          <div class="p-6">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <Archive className="text-primary w-6 h-6" />
            </div>
            
            <h3 class="text-xl font-display font-semibold text-primary mb-3">Preserve your family's stories</h3>
            
            <p class="text-primary/80">
              And values for generations to come.
            </p>
          </div>
        </div>
        
        <!-- Benefit 3: Find Peace -->
        <div class="bg-[#f3f4f6] rounded-lg overflow-hidden shadow-md transition-transform hover:translate-y-[-4px]">
          <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
            <img 
              src={familyGatheringPhoto.src} 
              alt="Peaceful family gathering in backyard" 
              width={familyGatheringPhoto.width} 
              height={familyGatheringPhoto.height} 
              class="object-cover w-full h-64 brightness-[0.9]" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 via-transparent to-transparent"></div>
          </div>
          
          <div class="p-6">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <HandHeart className="text-primary w-6 h-6" />
            </div>
            
            <h3 class="text-xl font-display font-semibold text-primary mb-3">Find peace now, not later</h3>
          </div>
        </div>
      </div>
      
      <div class="max-w-3xl mx-auto mt-12 mb-12 text-center">
        <p class="text-xl md:text-2xl font-display text-primary/90 max-w-2xl mx-auto">
          These conversations aren't just about loss. They're about love, living legacy, and leaving nothing unsaid.
        </p>
      </div>
    </div>
  </section>

  <!-- The Experience Section -->
  <section class="py-24 bg-[#f3f4f6] relative overflow-hidden">
        
    <style>
      .bg-pattern {
        background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23052d3f' fill-opacity='0.1' fill-rule='evenodd'%3E%3Cpath d='M0 38.59l2.83-2.83 1.41 1.41L1.41 40H0v-1.41zM0 1.4l2.83 2.83 1.41-1.41L1.41 0H0v1.41zM38.59 40l-2.83-2.83 1.41-1.41L40 38.59V40h-1.41zM40 1.41l-2.83 2.83-1.41-1.41L38.59 0H40v1.41zM20 18.6l2.83-2.83 1.41 1.41L21.41 20l2.83 2.83-1.41 1.41L20 21.41l-2.83 2.83-1.41-1.41L18.59 20l-2.83-2.83 1.41-1.41L20 18.59z'/%3E%3C/g%3E%3C/svg%3E");
      }
      
      .pillar-card {
        transition: all 0.3s ease-out;
      }
      
      .pillar-card:hover {
        transform: translateY(-5px);
      }
      
      .phase-title {
        letter-spacing: 0.03em;
      }
      
      .js-carousel-dot.active {
        width: 24px;
        border-radius: 12px;
      }
    </style>
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          What to Expect
        </h2>
        <h3 class="text-xl md:text-2xl text-primary/90 mb-4 text-center font-medium leading-relaxed max-w-2xl mx-auto">
          Every While We're Still Here™ experience — whether intimate or collective — is guided by five universal phases.
        </h3>
        <p class="text-lg text-primary/70 mb-14 text-center font-light leading-relaxed max-w-2xl mx-auto">
          Each pillar meets families where they are, from deep-dive retreats to our 90-minute Guided Gatherings.
        </p>

        <!-- Carousel Container with refined styling -->
        <div id="pillarsCarousel" class="relative rounded-xl mb-12 max-w-4xl mx-auto">
          <div class="overflow-hidden">
            <!-- Slides wrapper -->
            <div class="js-carousel-slides flex transition-all duration-500 ease-in-out">
              <!-- Slide 1: Gather -->
              <div class="js-carousel-slide pillar-card flex-shrink-0 w-full p-0 rounded-xl shadow-lg overflow-hidden bg-white">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={gatherPhoto.src} 
                    alt="Group of family members gathered together" 
                    width={gatherPhoto.width} 
                    height={gatherPhoto.height}
                    class="w-full h-64 md:h-72 object-cover object-center brightness-[0.95]"
                  />
                                  </div>
                <div class="p-8 md:p-10">
                  <h3 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4 phase-title tracking-wide">1. Gather</h3>
                  <p class="text-lg md:text-xl text-primary/70 leading-relaxed">
                    Create a safe, sacred space for honest conversation — whether it's one family in a living room or many families joining virtually.
                  </p>
                </div>
              </div>

              <!-- Slide 2: Share -->
              <div class="js-carousel-slide pillar-card flex-shrink-0 w-full p-0 rounded-xl shadow-lg overflow-hidden bg-white">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={sharePhoto.src} 
                    alt="Family sharing stories together" 
                    width={sharePhoto.width} 
                    height={sharePhoto.height}
                    class="w-full h-64 md:h-72 object-cover object-center brightness-[0.95]"
                  />
                                  </div>
                <div class="p-8 md:p-10">
                  <h3 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4 phase-title tracking-wide">2. Share</h3>
                  <p class="text-lg md:text-xl text-primary/70 leading-relaxed">
                    Speak what often goes unsaid. Families exchange stories, dream together, voice hopes and fears, and share wishes for how they want to live, love, and transition.
                  </p>
                </div>
              </div>

              <!-- Slide 3: Align -->
              <div class="js-carousel-slide pillar-card flex-shrink-0 w-full p-0 rounded-xl shadow-lg overflow-hidden bg-white">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={alignPhoto.src} 
                    alt="Couple aligned in purpose standing together" 
                    width={alignPhoto.width} 
                    height={alignPhoto.height}
                    class="w-full h-64 md:h-72 object-cover object-center brightness-[0.95]"
                  />
                                  </div>
                <div class="p-8 md:p-10">
                  <h3 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4 phase-title tracking-wide">3. Align</h3>
                  <p class="text-lg md:text-xl text-primary/70 leading-relaxed">
                    Find clarity around values, health wishes, estate hopes, and relational intentions — ensuring everyone understands what truly matters most.
                  </p>
                </div>
              </div>

              <!-- Slide 4: Preserve -->
              <div class="js-carousel-slide pillar-card flex-shrink-0 w-full p-0 rounded-xl shadow-lg overflow-hidden bg-white">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={preservePhoto.src} 
                    alt="Collection of precious family memories" 
                    width={preservePhoto.width} 
                    height={preservePhoto.height}
                    class="w-full h-64 md:h-72 object-cover object-center brightness-[0.95]"
                  />
                                  </div>
                <div class="p-8 md:p-10">
                  <h3 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4 phase-title tracking-wide">4. Preserve</h3>
                  <p class="text-lg md:text-xl text-primary/70 leading-relaxed">
                    Capture the moment. Families receive guided frameworks, recordings, and tangible resources to document and carry forward what was shared.
                  </p>
                </div>
              </div>

              <!-- Slide 5: Integrate -->
              <div class="js-carousel-slide pillar-card flex-shrink-0 w-full p-0 rounded-xl shadow-lg overflow-hidden bg-white">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={integratePhoto.src} 
                    alt="Continuing the legacy across generations" 
                    width={integratePhoto.width} 
                    height={integratePhoto.height}
                    class="w-full h-64 md:h-72 object-cover object-center brightness-[0.95]"
                  />
                                  </div>
                <div class="p-8 md:p-10">
                  <h3 class="text-2xl md:text-3xl font-display font-bold text-primary mb-4 phase-title tracking-wide">5. Integrate</h3>
                  <p class="text-lg md:text-xl text-primary/70 leading-relaxed">
                    Turn intention into continuity — with next steps, rituals, and plans that strengthen family connection beyond the session itself.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Navigation Arrows with enhanced styling -->
          <button class="js-carousel-prev absolute top-1/2 left-4 md:left-8 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-3 md:p-4 shadow-lg z-10 focus:outline-none transition-all duration-300 transform hover:scale-105" aria-label="Previous slide">
            <ChevronLeft className="w-5 h-5 md:w-6 md:h-6 text-primary" />
          </button>
          
          <button class="js-carousel-next absolute top-1/2 right-4 md:right-8 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-3 md:p-4 shadow-lg z-10 focus:outline-none transition-all duration-300 transform hover:scale-105" aria-label="Next slide">
            <ChevronRight className="w-5 h-5 md:w-6 md:h-6 text-primary" />
          </button>

          <!-- Indicator Dots with enhanced styling -->
          <div class="flex justify-center mt-8 space-x-3">
            <button class="js-carousel-dot w-3 h-3 rounded-full bg-primary active transition-all duration-300" data-index="0" aria-label="Go to slide 1"></button>
            <button class="js-carousel-dot w-3 h-3 rounded-full bg-primary/30 transition-all duration-300" data-index="1" aria-label="Go to slide 2"></button>
            <button class="js-carousel-dot w-3 h-3 rounded-full bg-primary/30 transition-all duration-300" data-index="2" aria-label="Go to slide 3"></button>
            <button class="js-carousel-dot w-3 h-3 rounded-full bg-primary/30 transition-all duration-300" data-index="3" aria-label="Go to slide 4"></button>
            <button class="js-carousel-dot w-3 h-3 rounded-full bg-primary/30 transition-all duration-300" data-index="4" aria-label="Go to slide 5"></button>
          </div>
        </div>

        <p class="text-lg text-primary/70 my-12 text-center italic font-light max-w-2xl mx-auto leading-relaxed">
          Each experience is designed to honor truth, deepen connection, and build peace that lasts.
        </p>

        <div class="flex flex-col md:flex-row gap-6 bg-muted/30 rounded-lg p-6 mt-12">
          <div class="flex-1 border-b md:border-b-0 md:border-r border-border/50 pb-4 md:pb-0 md:pr-6">
            <h3 class="text-lg font-semibold text-primary mb-2">In-Person Full-Day Retreat</h3>
            <p class="text-foreground/80 text-sm">An immersive, face-to-face experience for your family, facilitated in your home or a meaningful location.</p>
          </div>
          <div class="flex-1 pt-4 md:pt-0 md:pl-6">
            <h3 class="text-lg font-semibold text-primary mb-2">Virtual 3-Part Guided Series</h3>
            <p class="text-foreground/80 text-sm">Connect across distances with a thoughtfully paced series of facilitated virtual sessions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Gifts You Leave With Section -->
  <section class="pb-24 bg-[#f3f4f6] overflow-hidden" style="margin-top: 0 !important; padding-top: 0 !important;">
    <div class="container" style="padding-top: 60px;">
      <div class="max-w-6xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
            The Gifts You Leave With
          </h2>
          
          <div class="max-w-3xl mx-auto">
            <p class="text-lg text-primary mb-4">
              Every While We're Still Here™ experience leaves families with more than memories.
            </p>
            
            <p class="text-lg text-primary">
              You'll walk away with tangible keepsakes, new understanding, and practical tools that preserve your legacy and strengthen your bonds long after the conversation ends.
            </p>
          </div>
        </div>
        
        <!-- Main Two-Column Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">
          <!-- Left Column: Static Image -->
          <div class="relative rounded-xl overflow-hidden shadow-xl h-[500px] md:h-[600px]">
            <img 
              src={legacyGiftsPhoto.src}
              alt="Legacy moments captured over time - family memories"
              width={legacyGiftsPhoto.width}
              height={legacyGiftsPhoto.height}
              class="w-full h-full object-cover"
            />
                      </div>
          
          <!-- Right Column: Vertical Sliding Ticker -->
          <div class="relative overflow-hidden h-[500px] md:h-[600px] rounded-xl shadow-lg bg-white p-8 flex flex-col">
            <h3 class="text-2xl font-display font-semibold text-primary mb-6">You'll leave with:</h3>
            
            <!-- Vertical Ticker Container -->
            <div class="gifts-ticker-container relative overflow-hidden flex-1 flex items-center">
              <div class="gifts-ticker w-full">
                <!-- Gift Item 1 -->
                <div class="ticker-item py-7 px-5 border-b border-primary/10">
                  <div class="flex items-start gap-5">
                    <div class="flex-shrink-0 mt-1">
                      <div class="w-8 h-8 rounded-full bg-[#9a4a0b]/20 flex items-center justify-center">
                        <div class="w-4 h-4 rounded-full bg-[#9a4a0b]"></div>
                      </div>
                    </div>
                    <div class="flex-1">
                      <p class="text-xl text-primary font-semibold mb-1">Preserved stories and memories</p>
                      <p class="text-lg text-primary/70">Captured from elders and loved ones to carry forward.</p>
                    </div>
                  </div>
