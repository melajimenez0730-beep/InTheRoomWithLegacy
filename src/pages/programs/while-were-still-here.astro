    <!-- Vertical Ticker Animation Styles & Script -->
    <style>
      .gifts-ticker {
        animation: tickerAnimation 35s linear infinite;
        position: relative;
        width: 100%;
      }
      
      .ticker-item {
        opacity: 1;
        transition: opacity 0.5s ease;
        width: 100%;
      }
      
      @keyframes tickerAnimation {
        0% { transform: translateY(0); }
        100% { transform: translateY(-50%); }
      }
      
      /* Pause animation on hover */
      .gifts-ticker-container:hover .gifts-ticker {
        animation-play-state: paused;
      }
      
      .gifts-ticker-container {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        height: 100%;
      }
    </style>
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Calculate the total height of original items (not duplicates)
        const tickerContainer = document.querySelector('.gifts-ticker-container');
        const ticker = document.querySelector('.gifts-ticker');
        const items = document.querySelectorAll('.ticker-item');
        
        if (ticker && items.length > 0) {
          // Get all unique items (exclude duplicates)
          const uniqueItems = [...items].slice(0, 7);
          let totalHeight = 0;
          
          uniqueItems.forEach(item => {
            totalHeight += item.offsetHeight;
          });
          
          // Set the animation duration based on content length (slower for more content)
          const animationDuration = Math.max(25, totalHeight / 25); // Minimum 25 seconds for better readability
          ticker.style.animationDuration = `${animationDuration}s`;
          
          // Adjust the ticker container height for better visibility
          if (tickerContainer) {
            // Position the first ticker item centered vertically initially
            const itemHeight = uniqueItems[0].offsetHeight;
            const containerHeight = tickerContainer.offsetHeight;
            const offset = (containerHeight - itemHeight) / 2;
            
            // Add margin to the first item to center it initially
            ticker.style.paddingTop = `${offset}px`;
            ticker.style.paddingBottom = `${offset}px`;
            
            // Center the first visible item
            const visibleItemsCount = Math.floor(containerHeight / itemHeight);
            if (visibleItemsCount > 0) {
              // Adjust the ticker to ensure visible items are centered
              ticker.style.transform = `translateY(${-itemHeight * (visibleItemsCount / 4)}px)`;
            }
          }
        }
        
        // Reset animation when window is resized
        window.addEventListener('resize', () => {
          location.reload();
        });
      });
    </script>
