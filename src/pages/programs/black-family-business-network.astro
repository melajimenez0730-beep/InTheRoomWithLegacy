  <!-- Carousels and Animations JS -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // ====== Main Business Carousel ======
      // Get carousel elements
      const carousel = document.getElementById('businessCarousel');
      const slides = document.querySelectorAll('.carousel-slide');
      const prevButton = document.getElementById('prevSlide');
      const nextButton = document.getElementById('nextSlide');
      const indicators = document.querySelectorAll('#carouselIndicators button');
      
      // Set initial state
      let currentIndex = 0;
      const slideWidth = 100; // 100%

      // Function to update carousel position
      function updateCarousel(index) {
        // Ensure index is within bounds
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        
        // Update current index
        currentIndex = index;
        
        // Move carousel to show current slide
        carousel.style.transform = `translateX(-${currentIndex * slideWidth}%)`;
        
        // Update indicators
        indicators.forEach((indicator, i) => {
          if (i === currentIndex) {
            indicator.classList.remove('bg-primary/30');
            indicator.classList.add('bg-primary');
          } else {
            indicator.classList.remove('bg-primary');
            indicator.classList.add('bg-primary/30');
          }
        });
      }

      // Auto-rotate carousel every 5 seconds
      let autoRotate = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);

      // Add click handlers to navigation buttons
      if (prevButton && nextButton) {
        prevButton.addEventListener('click', () => {
          clearInterval(autoRotate);
          updateCarousel(currentIndex - 1);
          
          // Restart auto-rotation after manual navigation
          autoRotate = setInterval(() => {
            updateCarousel(currentIndex + 1);
          }, 5000);
        });
        
        nextButton.addEventListener('click', () => {
          clearInterval(autoRotate);
          updateCarousel(currentIndex + 1);
          
          // Restart auto-rotation after manual navigation
          autoRotate = setInterval(() => {
            updateCarousel(currentIndex + 1);
          }, 5000);
        });
      }

      // Add click handlers to indicator buttons
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          clearInterval(autoRotate);
          updateCarousel(index);
          
          // Restart auto-rotation after manual navigation
          autoRotate = setInterval(() => {
            updateCarousel(currentIndex + 1);
          }, 5000);
        });
      });
      
      // Initialize carousel
      if (carousel) {
        updateCarousel(0);
      }
      
      // ====== Audience Carousel ======
      const audienceCarousel = document.getElementById('audienceCarousel');
      const audienceSlides = document.querySelectorAll('.audience-slide');
      const prevAudience = document.getElementById('prevAudience');
      const nextAudience = document.getElementById('nextAudience');
      const audienceIndicators = document.querySelectorAll('#audienceIndicators button');
      
      // Set initial state
      let currentAudienceIndex = 0;
      
      // Function to update audience carousel position
      function updateAudienceCarousel(index) {
        // Ensure index is within bounds
        if (index < 0) index = audienceSlides.length - 1;
        if (index >= audienceSlides.length) index = 0;
        
        // Update current index
        currentAudienceIndex = index;
        
        // Move carousel to show current slide
        audienceCarousel.style.transform = `translateX(-${currentAudienceIndex * slideWidth}%)`;
        
        // Update indicators
        audienceIndicators.forEach((indicator, i) => {
          if (i === currentAudienceIndex) {
            indicator.classList.remove('bg-primary/30');
            indicator.classList.add('bg-primary');
          } else {
            indicator.classList.remove('bg-primary');
            indicator.classList.add('bg-primary/30');
          }
        });
      }
      
      // Auto-rotate audience carousel every 6 seconds
      let audienceAutoRotate = setInterval(() => {
        updateAudienceCarousel(currentAudienceIndex + 1);
      }, 6000);
      
      // Add click handlers to audience navigation buttons
      if (prevAudience && nextAudience) {
        prevAudience.addEventListener('click', () => {
          clearInterval(audienceAutoRotate);
          updateAudienceCarousel(currentAudienceIndex - 1);
          
          // Restart auto-rotation after manual navigation
          audienceAutoRotate = setInterval(() => {
            updateAudienceCarousel(currentAudienceIndex + 1);
          }, 6000);
        });
        
        nextAudience.addEventListener('click', () => {
          clearInterval(audienceAutoRotate);
          updateAudienceCarousel(currentAudienceIndex + 1);
          
          // Restart auto-rotation after manual navigation
          audienceAutoRotate = setInterval(() => {
            updateAudienceCarousel(currentAudienceIndex + 1);
          }, 6000);
        });
      }
      
      // Add click handlers to audience indicator buttons
      audienceIndicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          clearInterval(audienceAutoRotate);
          updateAudienceCarousel(index);
          
          // Restart auto-rotation after manual navigation
          audienceAutoRotate = setInterval(() => {
            updateAudienceCarousel(currentAudienceIndex + 1);
          }, 6000);
        });
      });
      
      // Initialize audience carousel
      if (audienceCarousel) {
        updateAudienceCarousel(0);
      }
      
      // ====== Purpose Scroller ======
      const purposeItems = document.querySelectorAll('.purpose-item');
      const purposeIndicators = document.querySelectorAll('#purposeIndicators button');
      
      // Set initial state
      let currentPurposeIndex = 0;
      
      // Function to update purpose scroller
      function updatePurposeScroller(index) {
        // Ensure index is within bounds
        if (index < 0) index = purposeItems.length - 1;
        if (index >= purposeItems.length) index = 0;
        
        // Update current index
        currentPurposeIndex = index;
        
        // Update active purpose item
        purposeItems.forEach((item, i) => {
          if (i === currentPurposeIndex) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
        
        // Update indicators
        purposeIndicators.forEach((indicator, i) => {
          if (i === currentPurposeIndex) {
            indicator.classList.remove('bg-primary/30');
            indicator.classList.add('bg-primary');
          } else {
            indicator.classList.remove('bg-primary');
            indicator.classList.add('bg-primary/30');
          }
        });
      }
      
      // Auto-rotate purpose scroller every 4 seconds
      let purposeAutoRotate = setInterval(() => {
        updatePurposeScroller(currentPurposeIndex + 1);
      }, 4000);
      
      // Add click handlers to purpose indicator buttons
      purposeIndicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          clearInterval(purposeAutoRotate);
          updatePurposeScroller(index);
          
          // Restart auto-rotation after manual navigation
          purposeAutoRotate = setInterval(() => {
            updatePurposeScroller(currentPurposeIndex + 1);
          }, 4000);
        });
      });
      
      // Initialize purpose scroller
      if (purposeItems.length > 0) {
        // Set first item as active initially
        purposeItems[0].classList.add('active');
        updatePurposeScroller(0);
      }
    });
  </script>

