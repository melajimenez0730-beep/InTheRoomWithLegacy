---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Building, Users, ChevronRight, Sparkles, Clock, Award, MessageCircle, ChevronDown } from "lucide-react";
---

<BaseLayout
  title="Black Family Business Network | In the Room With Legacy"
  description="A new initiative to honor, connect, and equip Black family business leaders across generations."
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-4 sm:mb-6">
          Black Family Business Network
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-foreground/80 mb-6 sm:mb-8 max-w-2xl mx-auto">
          A new initiative to honor, connect, and equip Black family business leaders across generations.
        </p>
        <div class="flex flex-col gap-4 w-full max-w-md mx-auto">
          <a 
            href="#join" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium w-full justify-center"
            })}
          >
            Join the Network
          </a>
          <a 
            href="#partner" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium w-full justify-center"
            })}
          >
            Partner With Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Network Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          About the Network
        </h2>
        <p class="text-lg text-foreground/80 mb-6 text-center">
          The Black Family Business Network honors and connects Black-owned family businesses—the foundation of economic resilience in our communities for generations.
        </p>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          This initiative brings together founders, successors, and inheritors to create a powerful ecosystem of support, knowledge-sharing, and strategic growth.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
          <div class="bg-muted/30 p-6 md:p-8 rounded-lg">
            <ul class="space-y-4">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <div class="w-2 h-2 rounded-full bg-primary"></div>
                </div>
                <span class="text-foreground/80">Succession planning and next-gen leadership development</span>
              </li>
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <div class="w-2 h-2 rounded-full bg-primary"></div>
                </div>
                <span class="text-foreground/80">Access to specialized resources and advisors</span>
              </li>
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <div class="w-2 h-2 rounded-full bg-primary"></div>
                </div>
                <span class="text-foreground/80">Family governance and alignment strategies</span>
              </li>
            </ul>
          </div>
          <div class="bg-muted/30 p-6 md:p-8 rounded-lg">
            <ul class="space-y-4">
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <div class="w-2 h-2 rounded-full bg-primary"></div>
                </div>
                <span class="text-foreground/80">Peer learning and mentorship opportunities</span>
              </li>
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <div class="w-2 h-2 rounded-full bg-primary"></div>
                </div>
                <span class="text-foreground/80">Strategic connections with aligned institutions</span>
              </li>
              <li class="flex gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <div class="w-2 h-2 rounded-full bg-primary"></div>
                </div>
                <span class="text-foreground/80">Legacy preservation and storytelling initiatives</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why It Matters Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Why This Matters
        </h2>
        <p class="text-lg text-foreground/80 mb-6">
          Black family businesses represent cultural anchors, wealth vehicles, and community institutions. Yet they face unique challenges in succession, access to capital, and institutional support.
        </p>
        <p class="text-lg text-foreground/80 mb-6">
          We're building a network that addresses these challenges head-on, ensuring these businesses not only survive but thrive across generations.
        </p>
        
        <div class="bg-white p-8 md:p-10 rounded-lg shadow-md border border-primary/10 my-12">
          <div class="text-primary/10 mb-4">
            <Building className="w-12 h-12 mx-auto text-primary/30" />
          </div>
          <p class="text-xl md:text-2xl font-display text-primary/90">
            "Family business is the backbone of Black economic resilience."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Network Offerings Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Network Offerings
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          The Black Family Business Network provides a comprehensive ecosystem of support:
        </p>

        <div class="space-y-8 mt-8">
          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <Users className="text-primary w-6 h-6" />
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Quarterly Roundtables</h3>
              <p class="text-foreground/80">Intimate gatherings of family business leaders tackling common challenges together.</p>
            </div>
          </div>
          
          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <Sparkles className="text-primary w-6 h-6" />
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Next-Gen Leadership Academy</h3>
              <p class="text-foreground/80">Preparing the next generation to lead with excellence through hands-on learning.</p>
            </div>
          </div>
          
          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <Clock className="text-primary w-6 h-6" />
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Legacy Documentation</h3>
              <p class="text-foreground/80">Professional services to capture your family business story and preserve it for future generations.</p>
            </div>
          </div>
          
          <div class="flex gap-6 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <Award className="text-primary w-6 h-6" />
            </div>
            <div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Recognition & Visibility</h3>
              <p class="text-foreground/80">Celebrating the impact and legacy of Black family businesses through our annual awards and media partnerships.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who It's For Section -->
  <section class="py-24 bg-primary/5">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          This Network is for you if…
        </h2>

        <div class="bg-white rounded-lg shadow-md p-8 md:p-10">
          <ul class="space-y-6">
            <li class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-1">
                <div class="w-2 h-2 rounded-full bg-primary"></div>
              </div>
              <p class="text-foreground/80 text-lg">You own or lead a Black-owned family business.</p>
            </li>
            <li class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-1">
                <div class="w-2 h-2 rounded-full bg-primary"></div>
              </div>
              <p class="text-foreground/80 text-lg">You're preparing to succeed a family member in business.</p>
            </li>
            <li class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-1">
                <div class="w-2 h-2 rounded-full bg-primary"></div>
              </div>
              <p class="text-foreground/80 text-lg">You're building a business you intend to pass down to future generations.</p>
            </li>
            <li class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-1">
                <div class="w-2 h-2 rounded-full bg-primary"></div>
              </div>
              <p class="text-foreground/80 text-lg">You want to connect with other Black family business leaders.</p>
            </li>
            <li class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-1">
                <div class="w-2 h-2 rounded-full bg-primary"></div>
              </div>
              <p class="text-foreground/80 text-lg">You believe in the power of Black generational wealth and legacy.</p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Membership Section -->
  <section class="py-24 bg-white" id="join">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Join the Network
        </h2>
        <p class="text-lg text-foreground/80 mb-12 text-center">
          The Black Family Business Network is now accepting founding members. Space is limited for our inaugural cohort.
        </p>

        <div class="bg-muted/20 rounded-lg p-6 md:p-8 border border-primary/10">
          <div class="flex flex-col md:flex-row gap-6 items-center mb-6">
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
              <Building className="text-primary w-8 h-8" />
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Founding Membership</h3>
              <p class="text-foreground/80 mb-4">
                Be part of the first cohort of Black family business leaders shaping this powerful network from the ground up.
              </p>
            </div>
          </div>
          
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-2">
              <ChevronRight className="text-primary flex-shrink-0 mt-1 w-4 h-4" />
              <span class="text-foreground/80">Access to quarterly roundtables and special events</span>
            </li>
            <li class="flex items-start gap-2">
              <ChevronRight className="text-primary flex-shrink-0 mt-1 w-4 h-4" />
              <span class="text-foreground/80">Next-gen family member access to Leadership Academy</span>
            </li>
            <li class="flex items-start gap-2">
              <ChevronRight className="text-primary flex-shrink-0 mt-1 w-4 h-4" />
              <span class="text-foreground/80">Custom family business assessment and roadmap</span>
            </li>
            <li class="flex items-start gap-2">
              <ChevronRight className="text-primary flex-shrink-0 mt-1 w-4 h-4" />
              <span class="text-foreground/80">Professional documentation of your family business story</span>
            </li>
          </ul>
          
          <div class="text-center">
            <p class="text-foreground/80 mb-6">Annual membership starts at $2,500 with sponsorships available for eligible businesses.</p>
            <a 
              href="#contact" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium"
              })}
            >
              Apply for Membership
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Section -->
  <section class="py-24 bg-muted/30" id="partner">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Partner With Us
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          We're seeking aligned partners who believe in supporting Black family business legacies.
        </p>

        <div class="bg-white rounded-lg shadow-md p-8 border border-primary/10">
          <div class="flex flex-col md:flex-row gap-6 items-center">
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
              <MessageCircle className="text-primary w-8 h-8" />
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Partnership Opportunities</h3>
              <p class="text-foreground/80 mb-6">
                Banks, foundations, corporations, and institutions can partner with us to strengthen Black family businesses through sponsorships, programmatic support, or strategic collaborations.
              </p>
              <a 
                href="#contact" 
                class={buttonVariants({
                  size: "default",
                  class: "font-medium"
                })}
              >
                Discuss Partnership Options
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-white" id="faq">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          FAQ
        </h2>

        <div class="bg-white rounded-lg shadow-sm border border-border/30">
          <!-- Custom FAQ accordion implementation -->
          <div class="divide-y divide-border/50">
            <!-- Question 1 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>What qualifies as a "family business"?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>We define family businesses as enterprises where multiple family members are involved in ownership, governance, or operation, or where there's a clear intention to transfer the business to the next generation. This includes businesses at various stages of family involvement.</p>
              </div>
            </div>
            
            <!-- Question 2 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>What if I'm just starting my business but want it to become a family legacy?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>We welcome "legacy builders" - entrepreneurs who are intentionally building businesses to pass down. Our network provides the foundation and frameworks to build with legacy in mind from day one.</p>
              </div>
            </div>
            
            <!-- Question 3 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>Where do events and programs take place?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>We host both virtual and in-person gatherings. Our quarterly roundtables rotate between major cities with significant concentrations of Black-owned family businesses. The Leadership Academy includes both virtual sessions and in-person intensives.</p>
              </div>
            </div>
            
            <!-- Question 4 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>Are scholarships available for membership?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>Yes. Thanks to our corporate and foundation partners, we offer a limited number of sponsored memberships for eligible businesses. The application process includes an option to be considered for sponsorship.</p>
              </div>
            </div>
            
            <!-- Question 5 -->
            <div class="faq-item">
              <button class="faq-trigger w-full flex items-center justify-between px-6 py-4 text-left font-display font-semibold text-primary text-lg">
                <span>How can larger corporations get involved?</span>
                <ChevronDown className="h-5 w-5 text-primary transform transition-transform" />
              </button>
              <div class="faq-content px-6 pb-6 text-foreground/80 hidden">
                <p>We offer several partnership opportunities for corporations interested in supporting Black family business growth. These include sponsoring memberships, funding specific programs, providing expertise, and more. Contact us to discuss a customized partnership strategy.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side script for FAQ accordion functionality -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const faqItems = document.querySelectorAll('.faq-item');
      
      faqItems.forEach(item => {
        const trigger = item.querySelector('.faq-trigger');
        const content = item.querySelector('.faq-content');
        const icon = trigger.querySelector('svg');
        
        trigger.addEventListener('click', () => {
          // Close all other items
          faqItems.forEach(otherItem => {
            if (otherItem !== item) {
              otherItem.querySelector('.faq-content').classList.add('hidden');
              otherItem.querySelector('svg').classList.remove('rotate-180');
            }
          });
          
          // Toggle current item
          content.classList.toggle('hidden');
          icon.classList.toggle('rotate-180');
        });
      });
    });
  </script>

  <!-- Contact Form Section -->
  <section class="py-24 bg-muted/30" id="contact">
    <div class="container">
      <div class="max-w-xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-primary mb-6 text-center">
          Get in Touch
        </h2>
        <p class="text-foreground/80 mb-8 text-center">
          Fill out the form below to inquire about membership or partnership opportunities.
        </p>
        
        <div class="bg-white rounded-lg shadow-md p-6 md:p-8">
          <form class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-foreground mb-1">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="business-name" class="block text-sm font-medium text-foreground mb-1">
                Business Name
              </label>
              <input
                type="text"
                id="business-name"
                name="business_name"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="inquiry-type" class="block text-sm font-medium text-foreground mb-1">
                I'm interested in:
              </label>
              <select
                id="inquiry-type"
                name="inquiry_type"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              >
                <option value="">Please select...</option>
                <option value="membership">Network Membership</option>
                <option value="partnership">Partnership Opportunities</option>
                <option value="sponsorship">Sponsorship Information</option>
                <option value="more-info">More Information</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-foreground mb-1">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows={4}
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <input name="form_name" type="hidden" value="Black Family Business Network Inquiry" />
            
            <button
              type="submit"
              class="w-full py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Submit Inquiry
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>