---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Award, Users, History, ChevronLeft, ChevronRight, BookOpen, Milestone, Shield, HandHelping, Network, Scroll, Search, Medal, GalleryHorizontal, SquaresUnite, ScrollText, Ticket, Anchor, User, ArrowRight, Send, MessageCircle, Workflow } from "lucide-react";
import ReferBusinessButton from "@/components/ReferBusinessButton";
import { Image } from 'astro:assets';
import { TimeTriggeredModal } from "@/components/TimeTriggeredModal";
import blackFamilyBusinessImage from "@/assets/bfbn/the-black-family-business-network-1_nw_84484c73.png";
import businessLeaderImage from "@/assets/bfbn/carousel/leadership-vision_nw_39a92e9e.png";
import familyMeetingImage from "@/assets/bfbn/carousel/family-connection_nw_a59cb614.png";
import entrepreneurImage from "@/assets/bfbn/carousel/innovation-growth_nw_e740470d.png";
import businessTeamImage from "@/assets/bfbn/carousel/collective-wisdom_nw_f4d016b1.png";
import familyBusinessImage from "@/assets/bfbn/visual-blocks/black-family-business_nw_a6f8d92e.jpg";
import familyMeetingRoomImage from "@/assets/bfbn/visual-blocks/black-family-meeting_nw_e5f6g7h8.jpg";
// Audience Carousel Images
import founderImage from "@/assets/bfbn/audience-carousel/family-business-founder_nw_a7b9c8d6.jpg";
import enterpriseImage from "@/assets/bfbn/audience-carousel/family-owned-enterprise_nw_e3f4g5h2.jpg";
import successorImage from "@/assets/bfbn/audience-carousel/business-successor_nw_j8k9l7m3.jpg";
import stewardImage from "@/assets/bfbn/audience-carousel/asset-steward_nw_p4q5r6s8.jpg";
---

<BaseLayout
  title="Black Family Business Network | In the Room With Legacy"
  description="A new initiative designed to honor, connect, and equip Black family business leaders across generations."
>
  <!-- Section 1: Hero Section (Full-Width Background) -->
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden bg-primary">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 w-full h-full z-0">
      <Image 
        src={familyBusinessImage} 
        alt="Black family business members in a professional setting" 
        class="w-full h-full object-cover object-center"
        width={1920}
        height={1080}
      />
      <!-- Dark overlay for readability -->
      <div class="absolute inset-0 bg-primary/70"></div>
    </div>
    
    <!-- Content Layer -->
    <div class="container relative z-10 py-16 sm:py-20 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 drop-shadow-md">
          Legacy. Enterprise. Community.
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-white/90 max-w-2xl mx-auto font-medium leading-relaxed">
          A private, curated circle for Black family business founders, multigenerational successors, and active stewards carrying forward family wealth, business, and heritage across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Section: WHY THIS EXISTS -->
  <section class="py-16 md:py-20 bg-white border-t border-gray-100">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8 text-center">
          WHY THIS EXISTS
        </h2>
        
        <div class="prose prose-lg max-w-none">
          <p class="mb-6">
            Across generations, Black families have built, protected, and sustained businesses, land, and legacies that have shaped entire communities. Yet the experience of being born into, working within, or continuing a family business is often misunderstood — even within our own communities. It carries a unique mix of responsibility, expectation, pride, sacrifice, pressure, judgment, and deep, generational purpose. Many of us have inherited not just a business or responsibility, but a calling.
          </p>
          
          <!-- Visual Block 1: The Inherited Purpose (3-Column Layout) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 not-prose">
            <!-- Column 1: A story -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
              <div class="p-6 flex flex-col items-center text-center h-full">
                <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                  <Scroll className="h-8 w-8 text-white" />
                </div>
                <h3 class="text-xl font-display font-semibold text-primary mb-3">A story.</h3>
                <p class="text-foreground/80 text-sm leading-relaxed">
                  A narrative rich with history, wisdom, triumph, and resilience across generations.
                </p>
              </div>
            </div>
            
            <!-- Column 2: A duty -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
              <div class="p-6 flex flex-col items-center text-center h-full">
                <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                  <Shield className="h-8 w-8 text-white" />
                </div>
                <h3 class="text-xl font-display font-semibold text-primary mb-3">A duty.</h3>
                <p class="text-foreground/80 text-sm leading-relaxed">
                  A responsibility to protect, grow, and pass on what has been entrusted to you.
                </p>
              </div>
            </div>
            
            <!-- Column 3: A calling -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
              <div class="p-6 flex flex-col items-center text-center h-full">
                <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                  <Milestone className="h-8 w-8 text-white" />
                </div>
                <h3 class="text-xl font-display font-semibold text-primary mb-3">A calling.</h3>
                <p class="text-foreground/80 text-sm leading-relaxed">
                  A journey that calls you to steward something greater than yourself.
                </p>
              </div>
            </div>
          </div>
          
          <p class="mb-6">
            A dream someone before us fought to make real and we are also building new visions that will become the inheritance of those who come after us. And while this journey is rich, it can also be isolating because few people understand what it means to serve something bigger than yourself. The Black Family Business Network was created to give us a place to feel seen, supported, connected, and understood.
          </p>
          
          <!-- Visual Block 2: The Community Value (2-Column Layout) -->
          <div class="bg-[#f8f5f0] rounded-xl shadow-md overflow-hidden my-10 not-prose border border-gray-200">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
              <!-- Column A: Bulleted list -->
              <div class="p-8 md:p-10 flex flex-col justify-center">
                <h3 class="text-xl font-display font-semibold text-primary mb-6">A room where:</h3>
                
                <ul class="space-y-3 list-none pl-0">
                  <li class="flex items-start">
                    <span class="text-primary mr-3 text-xl">•</span>
                    <span class="text-foreground/90">you don't have to downplay your inheritance,</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-primary mr-3 text-xl">•</span>
                    <span class="text-foreground/90">you don't have to apologize for your responsibility or your opportunity,</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-primary mr-3 text-xl">•</span>
                    <span class="text-foreground/90">you don't have to translate your experience,</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-primary mr-3 text-xl">•</span>
                    <span class="text-foreground/90">you don't have to shrink your story,</span>
                  </li>
                  <li class="flex items-start">
                    <span class="text-primary mr-3 text-xl">•</span>
                    <span class="text-foreground/90">and you don't have to carry the weight alone.</span>
                  </li>
                </ul>
              </div>
              
              <!-- Column B: Visual image -->
              <div class="relative h-full min-h-[300px] md:min-h-0">
                <Image 
                  src={familyMeetingRoomImage} 
                  alt="Black family meeting around a table, sharing stories and connecting across generations" 
                  class="w-full h-full object-cover"
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-primary opacity-10"></div>
              </div>
            </div>
          </div>
          
          <p class="mb-6">
            We're setting the table for the next generation of Black family business leaders — and you are part of the first wave shaping what comes next.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: WHAT IT IS -->
  <section class="py-16 md:py-20 bg-[#f8f7f2] border-t border-gray-100">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          WHAT IT IS
        </h2>
        
        <!-- Two-column layout for dynamic elements -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-14">
          <!-- Column A: Community Audience Section (Carousel Implementation) -->
          <div class="relative h-full">
            <div class="overflow-hidden rounded-xl shadow-lg h-full">
              <!-- Introductory text moved inside the carousel container -->
              <div class="bg-primary text-white p-4 text-center">
                <p class="font-medium">
                  The Black Family Business Network is an invitation- and nomination-based community for those who:
                </p>
              </div>
              <!-- Audience Carousel -->
              <div id="audienceCarousel" class="flex transition-transform duration-700 ease-in-out h-full">
                <!-- Slide 1: Founders -->
                <div class="flex-none w-full audience-slide">
                  <div class="relative h-full">
                    <Image 
                      src={founderImage} 
                      alt="Black entrepreneur who founded a family business" 
                      class="w-full h-full object-cover"
                      width={600}
                      height={500}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(5,45,63,0.9)] to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                      <h3 class="text-lg md:text-xl font-display font-bold tracking-tight mb-2">Founded a family business</h3>
                      <p class="text-white/80 text-sm md:text-base">Entrepreneurs who created businesses with the intention of building multi-generational enterprises.</p>
                    </div>
                  </div>
                </div>
                
                <!-- Slide 2: Enterprise Workers -->
                <div class="flex-none w-full audience-slide">
                  <div class="relative h-full">
                    <Image 
                      src={enterpriseImage} 
                      alt="Professionals working within a Black family-owned enterprise" 
                      class="w-full h-full object-cover"
                      width={600}
                      height={500}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(5,45,63,0.9)] to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                      <h3 class="text-lg md:text-xl font-display font-bold tracking-tight mb-2">Work within a family-owned enterprise</h3>
                      <p class="text-white/80 text-sm md:text-base">Professionals who play key roles in sustaining and growing businesses owned by their families.</p>
                    </div>
                  </div>
                </div>
                
                <!-- Slide 3: Successors -->
                <div class="flex-none w-full audience-slide">
                  <div class="relative h-full">
                    <Image 
                      src={successorImage} 
                      alt="Next generation Black business leaders inheriting family enterprises" 
                      class="w-full h-full object-cover"
                      width={600}
                      height={500}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(5,45,63,0.9)] to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                      <h3 class="text-lg md:text-xl font-display font-bold tracking-tight mb-2">Are inheriting and continuing the business</h3>
                      <p class="text-white/80 text-sm md:text-base">Next generation leaders taking the helm of businesses built by previous generations.</p>
                    </div>
                  </div>
                </div>
                
                <!-- Slide 4: Stewards -->
                <div class="flex-none w-full audience-slide">
                  <div class="relative h-full">
                    <Image 
                      src={stewardImage} 
                      alt="Black individuals stewarding family assets and enterprises across generations" 
                      class="w-full h-full object-cover"
                      width={600}
                      height={500}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(5,45,63,0.9)] to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                      <h3 class="text-lg md:text-xl font-display font-bold tracking-tight mb-2">Are stewarding their family's assets, land, or enterprise</h3>
                      <p class="text-white/80 text-sm md:text-base">Individuals responsible for managing and growing family wealth, property, or legacy businesses.</p>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Carousel Controls -->
              <button aria-label="Previous audience" class="absolute top-1/2 left-2 transform -translate-y-1/2 w-8 h-8 rounded-full bg-white/80 shadow-md flex items-center justify-center text-primary hover:bg-white transition-colors z-10" id="prevAudience">
                <ChevronLeft className="w-4 h-4" />
              </button>
              <button aria-label="Next audience" class="absolute top-1/2 right-2 transform -translate-y-1/2 w-8 h-8 rounded-full bg-white/80 shadow-md flex items-center justify-center text-primary hover:bg-white transition-colors z-10" id="nextAudience">
                <ChevronRight className="w-4 h-4" />
              </button>
            </div>
            
            <!-- Carousel Indicators -->
            <div class="flex gap-2 justify-center mt-4" id="audienceIndicators">
              <button aria-label="Go to audience 1" class="w-2 h-2 rounded-full bg-primary cursor-pointer transition-all duration-300" data-index="0"></button>
              <button aria-label="Go to audience 2" class="w-2 h-2 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="1"></button>
              <button aria-label="Go to audience 3" class="w-2 h-2 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="2"></button>
              <button aria-label="Go to audience 4" class="w-2 h-2 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="3"></button>
            </div>
          </div>
          
          <!-- Column B: Core Purposes Section (Auto-Scrolling Box Implementation) -->
          <div class="flex flex-col h-full">
            <div class="bg-primary text-white p-4 text-center">
              <p class="font-medium">The Network exists to:</p>
            </div>
            
            <div class="bg-white rounded-xl shadow-md overflow-hidden h-full">
              <div class="relative h-full">
                <div id="purposeScroller" class="purpose-scroller">
                  <div class="purpose-item p-5 lg:p-6 border-b border-gray-100">
                    <h3 class="text-2xl md:text-3xl font-display font-extrabold text-primary mb-2 tracking-tight">CONNECT</h3>
                    <p class="text-foreground/90 text-sm md:text-base leading-tight md:leading-snug">Unite Black family business professionals across industries and generations who understand the rare lived experience of stewardship.</p>
                  </div>
                  <div class="purpose-item p-5 lg:p-6 border-b border-gray-100">
                    <h3 class="text-2xl md:text-3xl font-display font-extrabold text-primary mb-2 tracking-tight">PRESERVE</h3>
                    <p class="text-foreground/90 text-sm md:text-base leading-tight md:leading-snug">Document & uplift the stories, lessons, and models of intergenerational success so they are not lost or undervalued.</p>
                  </div>
                  <div class="purpose-item p-5 lg:p-6 border-b border-gray-100">
                    <h3 class="text-2xl md:text-3xl font-display font-extrabold text-primary mb-2 tracking-tight">COLLABORATE</h3>
                    <p class="text-foreground/90 text-sm md:text-base leading-tight md:leading-snug">Create pathways for shared opportunities that advance economic power, cultural preservation, and community impact.</p>
                  </div>
                  <div class="purpose-item p-5 lg:p-6">
                    <h3 class="text-2xl md:text-3xl font-display font-extrabold text-primary mb-2 tracking-tight">INSPIRE</h3>
                    <p class="text-foreground/90 text-sm md:text-base leading-tight md:leading-snug">Provide a supportive environment where members can learn from one another, grow together, and navigate generational leadership with clarity.</p>
                  </div>
                </div>
                
                <!-- Purpose navigation dots -->
                <div class="absolute right-3 top-0 bottom-0 flex flex-col items-center justify-center gap-2" id="purposeIndicators">
                  <button aria-label="Purpose 1" class="w-2 h-2 rounded-full bg-primary cursor-pointer transition-all duration-300" data-index="0"></button>
                  <button aria-label="Purpose 2" class="w-2 h-2 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="1"></button>
                  <button aria-label="Purpose 3" class="w-2 h-2 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="2"></button>
                  <button aria-label="Purpose 4" class="w-2 h-2 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="3"></button>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="prose prose-lg max-w-none">
          <p class="mb-0 italic text-foreground/80 text-center max-w-2xl mx-auto">
            Membership is not application-based. It is curated — built through invitation, referral, and thoughtful review. Each member represents a lineage, a legacy, or a vision worth sustaining.
          </p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Section: FOUNDING CIRCLE -->
  <section class="py-16 md:py-20 bg-white border-t border-gray-100">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-10 text-center">
          FOUNDING CIRCLE
        </h2>
        
        <div class="prose prose-lg max-w-none mb-12">
          <p class="mb-6">
            We are currently forming the Founding Circle of the Black Family Business Network. This initial phase is about bringing together pioneering members who will help set the foundation and direction for this community.
          </p>
          
          <p class="mb-6">
            Our focus in this phase is on quality of connection rather than quantity - creating space for the right members to find each other and begin building. We're moving with intention, care, and strategic vision.
          </p>
        </div>
        
        <!-- 1x4 Grid: Right now is about -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          <!-- Connection -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
            <div class="p-6 flex flex-col items-center text-center h-full">
              <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                <Network className="h-8 w-8 text-white" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Connection</h3>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Building meaningful relationships that support growth and legacy.
              </p>
            </div>
          </div>
          
          <!-- Discernment -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
            <div class="p-6 flex flex-col items-center text-center h-full">
              <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                <Search className="h-8 w-8 text-white" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Discernment</h3>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Making thoughtful choices about who and how we grow together.
              </p>
            </div>
          </div>
          
          <!-- Honoring the Work -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
            <div class="p-6 flex flex-col items-center text-center h-full">
              <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                <Medal className="h-8 w-8 text-white" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Honoring the Work</h3>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Celebrating and elevating the journeys of Black family enterprises.
              </p>
            </div>
          </div>
          
          <!-- Curating Voices -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.02] transform">
            <div class="p-6 flex flex-col items-center text-center h-full">
              <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
                <GalleryHorizontal className="h-8 w-8 text-white" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Curating Voices</h3>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Building a foundation with the right perspectives and experiences.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Founding Members Heading -->
        <div class="max-w-3xl mx-auto mb-8">
          <h3 class="text-2xl md:text-3xl font-display font-bold text-primary text-center">Founding Members of the Network</h3>
        </div>
        
        <!-- 2x2 Grid: Founding Members Benefits -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto mb-12">
          <!-- Shape Enterprises -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 flex flex-col md:flex-row gap-4 items-start md:items-center">
            <div class="w-14 h-14 rounded-full bg-[#052d3f] flex flex-shrink-0 items-center justify-center transform hover:scale-110 duration-300 shadow-md">
              <SquaresUnite className="h-7 w-7 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-display font-semibold text-primary mb-2">Shape Collaboration</h4>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Help shape how Black family enterprises gather and collaborate across generations.
              </p>
            </div>
          </div>
          
          <!-- Network Origin Story -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 flex flex-col md:flex-row gap-4 items-start md:items-center">
            <div class="w-14 h-14 rounded-full bg-[#052d3f] flex flex-shrink-0 items-center justify-center transform hover:scale-110 duration-300 shadow-md">
              <ScrollText className="h-7 w-7 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-display font-semibold text-primary mb-2">Origin Story Recognition</h4>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Be recognized as part of the Network's founding story and legacy.
              </p>
            </div>
          </div>
          
          <!-- Early Access -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 flex flex-col md:flex-row gap-4 items-start md:items-center">
            <div class="w-14 h-14 rounded-full bg-[#052d3f] flex flex-shrink-0 items-center justify-center transform hover:scale-110 duration-300 shadow-md">
              <Ticket className="h-7 w-7 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-display font-semibold text-primary mb-2">Early Access</h4>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Receive priority access to upcoming gatherings, convenings and events.
              </p>
            </div>
          </div>
          
          <!-- Model Stewardship -->
          <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 flex flex-col md:flex-row gap-4 items-start md:items-center">
            <div class="w-14 h-14 rounded-full bg-[#052d3f] flex flex-shrink-0 items-center justify-center transform hover:scale-110 duration-300 shadow-md">
              <Anchor className="h-7 w-7 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-display font-semibold text-primary mb-2">Represent Stewardship</h4>
              <p class="text-foreground/80 text-sm leading-relaxed">
                Embody the models of stewardship that anchor and inspire this work.
              </p>
            </div>
          </div>
        </div>
        
        <!-- Closing Statement -->
        <div class="prose prose-lg max-w-3xl mx-auto">
          <p class="font-bold text-center text-lg sm:text-xl mb-0 text-primary/90">
            You're being invited into something sacred and visionary — the first wave of those shaping what comes next.
          </p>
        </div>
      </div>
    </div>
  </section>


      
  
