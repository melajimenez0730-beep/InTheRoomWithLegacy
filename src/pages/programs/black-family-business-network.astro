---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Award, Users, History, ChevronLeft, ChevronRight } from "lucide-react";
import ReferBusinessButton from "@/components/ReferBusinessButton";
import { Image } from 'astro:assets';
import blackFamilyBusinessImage from "@/assets/bfbn/the-black-family-business-network-1_nw_84484c73.png";
import businessLeaderImage from "@/assets/bfbn/carousel/leadership-vision_nw_39a92e9e.png";
import familyMeetingImage from "@/assets/bfbn/carousel/family-connection_nw_a59cb614.png";
import entrepreneurImage from "@/assets/bfbn/carousel/innovation-growth_nw_e740470d.png";
import businessTeamImage from "@/assets/bfbn/carousel/collective-wisdom_nw_f4d016b1.png";
---

<BaseLayout
  title="Black Family Business Network | In the Room With Legacy"
  description="A new initiative designed to honor, connect, and equip Black family business leaders across generations."
>
  <!-- Section 1: Hero Section (Header Only) -->
  <section class="py-16 sm:py-20 md:py-32 bg-white relative overflow-hidden">

    <div class="container relative z-10">
      <div class="flex flex-col md:flex-row md:items-stretch md:space-x-8 lg:space-x-12 max-w-6xl mx-auto">
        <!-- Left Column: Text Content (Simplified) -->
        <div class="md:w-1/2 space-y-6 md:space-y-8 mb-8 md:mb-0 flex flex-col justify-center">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight">
            The Black Family Business Network
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-foreground/80 max-w-xl font-medium">
            Celebrating Legacy. Building Connection. Amplifying Black Enterprise.
          </p>
        </div>
        
        <!-- Right Column: Image -->
        <div class="md:w-1/2 h-full flex items-stretch">
          <div class="relative rounded-xl overflow-hidden shadow-xl w-full">
            <Image 
              src={blackFamilyBusinessImage} 
              alt="Two Black professional women shaking hands in a business setting, representing partnership and connection" 
              class="w-full h-full object-cover rounded-xl"
              width={1200}
              height={800}
            />
            <div class="absolute inset-0 bg-primary opacity-15 rounded-xl"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Foundational Statement & Carousel -->
  <section class="py-16 md:py-20 bg-[#f3f4f6]">
    <div class="container">
      <!-- Foundational Statement -->
      <div class="max-w-3xl mx-auto text-center mb-10 px-4">
        <p class="text-base sm:text-lg md:text-xl text-foreground/80 leading-relaxed">
          Across generations, Black families have built, led, and sustained businesses that shape our communities. The Black Family Business Network—powered by In the Room with Legacy™—exists to recognize those stories, strengthen our connections, and preserve the legacies we're still writing.
        </p>
      </div>

      <!-- Carousel UI Component -->
      <div class="relative max-w-4xl mx-auto px-4 md:px-0 mb-10">
        <div class="carousel-container overflow-hidden relative">
          <div id="businessCarousel" class="flex transition-transform duration-500 ease-in-out">
            <!-- Slide 1 -->
            <div class="flex-none w-full carousel-slide">
              <div class="bg-white rounded-xl overflow-hidden shadow-md">
                <div class="relative aspect-[3/2] overflow-hidden">
                  <Image 
                    src={businessLeaderImage} 
                    alt="Black business leader waving to a crowd, representing leadership and vision" 
                    class="w-full h-full object-cover"
                    width={600}
                    height={400}
                  />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-display font-semibold text-primary mb-2">Leadership & Vision</h3>
                  <p class="text-foreground/70">Black enterprise leaders are shaping the future of business across industries.</p>
                </div>
              </div>
            </div>

            <!-- Slide 2 -->
            <div class="flex-none w-full carousel-slide">
              <div class="bg-white rounded-xl overflow-hidden shadow-md">
                <div class="relative aspect-[3/2] overflow-hidden">
                  <Image 
                    src={familyMeetingImage} 
                    alt="Black family reading together, parents and children sharing a moment that strengthens family bonds" 
                    class="w-full h-full object-cover"
                    width={600}
                    height={400}
                  />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-display font-semibold text-primary mb-2">Family Connection</h3>
                  <p class="text-foreground/70">Family foundations strengthen business values and create lasting legacies.</p>
                </div>
              </div>
            </div>

            <!-- Slide 3 -->
            <div class="flex-none w-full carousel-slide">
              <div class="bg-white rounded-xl overflow-hidden shadow-md">
                <div class="relative aspect-[3/2] overflow-hidden">
                  <Image 
                    src={entrepreneurImage} 
                    alt="Black business professionals collaborating around a table with digital technology, showcasing innovation in action" 
                    class="w-full h-full object-cover"
                    width={600}
                    height={400}
                  />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-display font-semibold text-primary mb-2">Innovation & Growth</h3>
                  <p class="text-foreground/70">Black entrepreneurs are driving innovation and creating new opportunities.</p>
                </div>
              </div>
            </div>

            <!-- Slide 4 -->
            <div class="flex-none w-full carousel-slide">
              <div class="bg-white rounded-xl overflow-hidden shadow-md">
                <div class="relative aspect-[3/2] overflow-hidden">
                  <Image 
                    src={businessTeamImage} 
                    alt="Black business professionals brainstorming around a conference table with whiteboards in the background, sharing collective wisdom" 
                    class="w-full h-full object-cover"
                    width={600}
                    height={400}
                  />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-display font-semibold text-primary mb-2">Collective Wisdom</h3>
                  <p class="text-foreground/70">Collaboration and knowledge-sharing propel Black enterprises forward.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Carousel Controls -->
          <button aria-label="Previous slide" class="absolute top-1/2 left-2 md:left-4 transform -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 shadow-md flex items-center justify-center text-primary hover:bg-white transition-colors z-10" id="prevSlide">
            <ChevronLeft className="w-5 h-5" />
          </button>
          <button aria-label="Next slide" class="absolute top-1/2 right-2 md:right-4 transform -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 shadow-md flex items-center justify-center text-primary hover:bg-white transition-colors z-10" id="nextSlide">
            <ChevronRight className="w-5 h-5" />
          </button>
        </div>

        <!-- Carousel Indicators -->
        <div class="flex gap-2 justify-center mt-6" id="carouselIndicators">
          <button aria-label="Go to slide 1" class="w-2.5 h-2.5 rounded-full bg-primary cursor-pointer transition-all duration-300" data-index="0"></button>
          <button aria-label="Go to slide 2" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="1"></button>
          <button aria-label="Go to slide 3" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="2"></button>
          <button aria-label="Go to slide 4" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="3"></button>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Community Statement & Ticker -->
  <section class="py-12 bg-[#f8f8f9] overflow-hidden border-y border-gray-200">
    <!-- Ticker UI Element -->
    <div class="ticker-wrap w-full overflow-hidden py-8 bg-[#0a3f58]">
      <div class="ticker inline-block whitespace-nowrap animate-ticker">
        <span class="ticker-item text-lg sm:text-xl md:text-2xl font-display font-medium px-6 text-white ticker-glow">We're gathering a powerful community of Black family business professionals, founders, and heirs who are redefining what legacy looks like today. &nbsp;&nbsp;•&nbsp;&nbsp;</span>
        <span class="ticker-item text-lg sm:text-xl md:text-2xl font-display font-medium px-6 text-white ticker-glow">We're gathering a powerful community of Black family business professionals, founders, and heirs who are redefining what legacy looks like today. &nbsp;&nbsp;•&nbsp;&nbsp;</span>
        <span class="ticker-item text-lg sm:text-xl md:text-2xl font-display font-medium px-6 text-white ticker-glow">We're gathering a powerful community of Black family business professionals, founders, and heirs who are redefining what legacy looks like today. &nbsp;&nbsp;•&nbsp;&nbsp;</span>
      </div>
    </div>
  </section>
      
  <!-- Section 4: Why Join (Light Background) -->
  <section class="py-16 md:py-20 bg-[#f8f8f9] border-t border-gray-200">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-display font-bold mb-10 text-center text-primary">Why Join?</h2>
        
        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <!-- Item 1 -->
          <div class="flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
              <Award className="h-8 w-8 text-white" />
            </div>
            <p class="text-base sm:text-lg font-medium leading-relaxed text-foreground/80">
              Celebrate your family's entrepreneurial journey and legacy.
            </p>
          </div>
          
          <!-- Item 2 -->
          <div class="flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
              <Users className="h-8 w-8 text-white" />
            </div>
            <p class="text-base sm:text-lg font-medium leading-relaxed text-foreground/80">
              Connect with other Black business founders, professionals, and heirs.
            </p>
          </div>
          
          <!-- Item 3 -->
          <div class="flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-full bg-[#052d3f] flex items-center justify-center mb-4 transform transition-transform hover:scale-110 duration-300 shadow-md">
              <History className="h-8 w-8 text-white" />
            </div>
            <p class="text-base sm:text-lg font-medium leading-relaxed text-foreground/80">
              Uplift collective stories and ensure the history of Black enterprise endures.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Section 5: Call to Action -->
  <section class="py-20 bg-[#f8f8f9] border-t border-gray-200">
    <div class="container relative z-10">
        
      <div class="w-full max-w-lg sm:max-w-xl md:max-w-2xl mx-auto bg-[#052d3f] rounded-lg shadow-md p-6 sm:p-8 md:p-10 mb-12">
        <h3 class="text-xl font-display font-semibold text-white mb-4 text-center">Join the network.</h3>
        <p class="text-white/90 mb-8 text-center max-w-2xl mx-auto">
          Be part of a growing database of changemakers building across generations. Share your family's story, connect with others, and keep the legacy alive.
        </p>
          
          <div class="flex flex-col gap-6 w-full sm:max-w-sm mx-auto px-0 sm:px-4 py-3">
            <a 
              href="https://forms.gle/C5ziQzvQdazXiTRt6" 
              target="_blank"
              rel="noopener noreferrer"
              class={`${buttonVariants({
                size: "lg",
                variant: "outline",
                class: "font-medium w-full block justify-center text-center text-[13px] xs:text-[14px] sm:text-sm max-w-full my-1 mx-0 overflow-hidden px-2 sm:px-4 transition-colors duration-300"
              })} cta-primary-button`}
            >
              Submit Your Family Business Profile
            </a>
            <ReferBusinessButton client:load className="cta-secondary-button" />
          </div>
        </div>
        
        <p class="text-lg sm:text-xl md:text-2xl font-display text-primary mb-0 mt-8 text-center">
          The more of us in the room, the stronger our collective future becomes.
        </p>
      </div>
    </div>
  </section>

  <!-- CSS for Animations -->
  <style>
    /* Ticker Animation */
    @keyframes ticker {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-33.33%, 0, 0);
      }
    }

    .animate-ticker {
      animation: ticker 30s linear infinite;
    }

    .ticker-item {
      display: inline-block;
    }

    /* Glowing text effect for ticker */
    .ticker-glow {
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.5), 0 0 15px rgba(255, 255, 255, 0.3);
      letter-spacing: 0.02em;
    }

    /* CTA button hover styles */
    :global(.cta-primary-button) {
      background-color: white !important;
      color: #052d3f !important;
      border-color: white !important;
      transition: all 0.3s ease-in-out !important;
    }

    :global(.cta-primary-button:hover),
    :global(.cta-primary-button:focus) {
      background-color: #9a4a0b !important;
      color: white !important;
      border-color: #9a4a0b !important;
    }

    :global(.cta-secondary-button) {
      background-color: white !important;
      color: #052d3f !important;
      border-color: #052d3f !important;
      transition: all 0.3s ease-in-out !important;
    }

    :global(.cta-secondary-button:hover),
    :global(.cta-secondary-button:focus) {
      background-color: #9a4a0b !important;
      color: white !important;
      border-color: #9a4a0b !important;
    }

    /* Carousel Animation */
    @media (max-width: 768px) {
      .carousel-slide {
        padding: 0 16px;
      }
    }
  </style>

  <!-- Carousel JS -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Get carousel elements
      const carousel = document.getElementById('businessCarousel');
      const slides = document.querySelectorAll('.carousel-slide');
      const prevButton = document.getElementById('prevSlide');
      const nextButton = document.getElementById('nextSlide');
      const indicators = document.querySelectorAll('#carouselIndicators button');
      
      // Set initial state
      let currentIndex = 0;
      const slideWidth = 100; // 100%

      // Function to update carousel position
      function updateCarousel(index) {
        // Ensure index is within bounds
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        
        // Update current index
        currentIndex = index;
        
        // Move carousel to show current slide
        carousel.style.transform = `translateX(-${currentIndex * slideWidth}%)`;
        
        // Update indicators
        indicators.forEach((indicator, i) => {
          if (i === currentIndex) {
            indicator.classList.remove('bg-primary/30');
            indicator.classList.add('bg-primary');
          } else {
            indicator.classList.remove('bg-primary');
            indicator.classList.add('bg-primary/30');
          }
        });
      }

      // Auto-rotate carousel every 5 seconds
      let autoRotate = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);

      // Add click handlers to navigation buttons
      prevButton.addEventListener('click', () => {
        clearInterval(autoRotate);
        updateCarousel(currentIndex - 1);
        
        // Restart auto-rotation after manual navigation
        autoRotate = setInterval(() => {
          updateCarousel(currentIndex + 1);
        }, 5000);
      });
      
      nextButton.addEventListener('click', () => {
        clearInterval(autoRotate);
        updateCarousel(currentIndex + 1);
        
        // Restart auto-rotation after manual navigation
        autoRotate = setInterval(() => {
          updateCarousel(currentIndex + 1);
        }, 5000);
      });

      // Add click handlers to indicator buttons
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          clearInterval(autoRotate);
          updateCarousel(index);
          
          // Restart auto-rotation after manual navigation
          autoRotate = setInterval(() => {
            updateCarousel(currentIndex + 1);
          }, 5000);
        });
      });
      
      // Initialize carousel
      updateCarousel(0);
    });
  </script>
</BaseLayout>