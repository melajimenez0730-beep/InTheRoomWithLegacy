---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Building, Users, ChevronRight, Sparkles, Clock, Award, MessageCircle, ChevronDown, Share2, Send } from "lucide-react";
---

<BaseLayout
  title="Black Family Business Network | In the Room With Legacy"
  description="A new initiative designed to honor, connect, and equip Black family business leaders across generations."
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-4 sm:mb-6">
          Black Family Business Network
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-foreground/80 mb-6 sm:mb-8 max-w-2xl mx-auto">
          The Black Family Business Network is a new initiative designed to honor, connect, and equip Black family business leaders across generations.
        </p>
        
        <p class="text-base sm:text-lg text-foreground/80 mb-6 sm:mb-8 max-w-2xl mx-auto">
          Before our official launch, we're building a foundation: collecting stories, mapping businesses, and creating a community that reflects the richness of our legacy. This is more than a directory—it's the start of a living archive and a gathering place where Black family enterprises can be recognized, celebrated, and supported.
        </p>
        
        <p class="text-base sm:text-lg text-foreground/80 mb-8 max-w-2xl mx-auto">
          By sharing your story now, you'll help shape a resource that will grow into programming, convenings, and opportunities designed specifically for families like yours.
        </p>
        
        <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-6 md:p-8 border border-primary/10 mb-10">
          <h3 class="text-xl font-display font-semibold text-primary mb-4">Here's how you can be part of the start:</h3>
          
          <div class="flex flex-col gap-4 w-full max-w-md mx-auto">
            <a 
              href="#submit-profile" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium w-full justify-center"
              })}
            >
              Submit Your Family Business Profile
            </a>
            <a 
              href="#share" 
              class={buttonVariants({
                variant: "outline",
                size: "lg",
                class: "border-primary text-primary hover:bg-primary/10 font-medium w-full justify-center"
              })}
            >
              Share with Another Family Business
            </a>
            <a 
              href="#updates" 
              class={buttonVariants({
                variant: "outline",
                size: "lg",
                class: "border-primary text-primary hover:bg-primary/10 font-medium w-full justify-center"
              })}
            >
              Sign Up for Updates
            </a>
          </div>
        </div>
        
        <p class="text-lg sm:text-xl md:text-2xl font-display text-primary mb-6">
          Together, we can link our stories, strengthen our collective voice, and build pathways to generational wealth.
        </p>
      </div>
    </div>
  </section>

  <!-- Submit Profile Section -->
  <section class="py-24 bg-white" id="submit-profile">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Submit Your Family Business Profile
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          Help us build a comprehensive archive of Black family businesses by sharing your story.
        </p>

        <div class="bg-white rounded-lg shadow-md p-6 md:p-8 border border-primary/10">
          <form class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="business_name" class="block text-sm font-medium text-foreground mb-1">
                  Business Name
                </label>
                <input
                  type="text"
                  id="business_name"
                  name="business_name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
              
              <div>
                <label for="year_founded" class="block text-sm font-medium text-foreground mb-1">
                  Year Founded
                </label>
                <input
                  type="text"
                  id="year_founded"
                  name="year_founded"
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
            </div>
            
            <div>
              <label for="business_description" class="block text-sm font-medium text-foreground mb-1">
                Business Description
              </label>
              <textarea
                id="business_description"
                name="business_description"
                rows={4}
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>

            <div>
              <label for="family_connection" class="block text-sm font-medium text-foreground mb-1">
                Family Connection (How is your family involved in the business?)
              </label>
              <textarea
                id="family_connection"
                name="family_connection"
                rows={3}
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="contact_name" class="block text-sm font-medium text-foreground mb-1">
                  Contact Name
                </label>
                <input
                  type="text"
                  id="contact_name"
                  name="contact_name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
              
              <div>
                <label for="contact_email" class="block text-sm font-medium text-foreground mb-1">
                  Contact Email
                </label>
                <input
                  type="email"
                  id="contact_email"
                  name="contact_email"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
            </div>
            
            <input name="form_name" type="hidden" value="Black Family Business Profile Submission" />
            
            <button
              type="submit"
              class="w-full py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Submit Profile
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Share Section -->
  <section class="py-24 bg-muted/30" id="share">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Share with Another Family Business
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          Help us expand our network by referring another Black family business.
        </p>

        <div class="bg-white rounded-lg shadow-md p-6 md:p-8 border border-primary/10">
          <div class="flex flex-col md:flex-row gap-6 items-center mb-8">
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
              <Share2 className="text-primary w-8 h-8" />
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Refer a Family Business</h3>
              <p class="text-foreground/80 mb-4">
                Do you know another Black family business that should be part of our network? Help us connect with them by sharing their information.
              </p>
            </div>
          </div>
          
          <form class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="referral_business_name" class="block text-sm font-medium text-foreground mb-1">
                  Business Name
                </label>
                <input
                  type="text"
                  id="referral_business_name"
                  name="referral_business_name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
              
              <div>
                <label for="referral_contact_name" class="block text-sm font-medium text-foreground mb-1">
                  Contact Person
                </label>
                <input
                  type="text"
                  id="referral_contact_name"
                  name="referral_contact_name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
            </div>
            
            <div>
              <label for="referral_email" class="block text-sm font-medium text-foreground mb-1">
                Contact Email
              </label>
              <input
                type="email"
                id="referral_email"
                name="referral_email"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="referral_note" class="block text-sm font-medium text-foreground mb-1">
                Additional Notes (Optional)
              </label>
              <textarea
                id="referral_note"
                name="referral_note"
                rows={3}
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <div>
              <label for="your_name" class="block text-sm font-medium text-foreground mb-1">
                Your Name
              </label>
              <input
                type="text"
                id="your_name"
                name="your_name"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <div>
              <label for="your_email" class="block text-sm font-medium text-foreground mb-1">
                Your Email
              </label>
              <input
                type="email"
                id="your_email"
                name="your_email"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              />
            </div>
            
            <input name="form_name" type="hidden" value="Black Family Business Referral" />
            
            <button
              type="submit"
              class="w-full py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Submit Referral
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Updates Section -->
  <section class="py-24 bg-white" id="updates">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Stay Updated
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          Sign up to receive updates about the Black Family Business Network, including launch announcements, events, and opportunities.
        </p>

        <div class="bg-white rounded-lg shadow-md p-6 md:p-8 border border-primary/10">
          <div class="flex flex-col md:flex-row gap-6 items-center mb-8">
            <div class="flex-shrink-0 w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center">
              <Send className="text-primary w-8 h-8" />
            </div>
            <div class="flex-1 text-center md:text-left">
              <h3 class="text-xl font-display font-semibold text-primary mb-2">Join Our Mailing List</h3>
              <p class="text-foreground/80">
                Be the first to know when we officially launch the network and gain early access to resources and events.
              </p>
            </div>
          </div>
          
          <form class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="signup_name" class="block text-sm font-medium text-foreground mb-1">
                  Full Name
                </label>
                <input
                  type="text"
                  id="signup_name"
                  name="signup_name"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
              
              <div>
                <label for="signup_email" class="block text-sm font-medium text-foreground mb-1">
                  Email Address
                </label>
                <input
                  type="email"
                  id="signup_email"
                  name="signup_email"
                  required
                  class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
                />
              </div>
            </div>
            
            <div>
              <label for="business_owner" class="block text-sm font-medium text-foreground mb-1">
                Are you a Black family business owner or representative?
              </label>
              <select
                id="business_owner"
                name="business_owner"
                required
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              >
                <option value="">Please select...</option>
                <option value="yes">Yes, I own or represent a Black family business</option>
                <option value="future">Not yet, but I plan to start one</option>
                <option value="no">No, but I'm interested in supporting Black family businesses</option>
              </select>
            </div>
            
            <div>
              <label for="interests" class="block text-sm font-medium text-foreground mb-1">
                What aspects of the Network are you most interested in? (Optional)
              </label>
              <textarea
                id="interests"
                name="interests"
                rows={3}
                class="w-full px-4 py-3 border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 bg-card"
              ></textarea>
            </div>
            
            <input name="form_name" type="hidden" value="Black Family Business Network Updates" />
            
            <button
              type="submit"
              class="w-full py-3 bg-primary text-white rounded-md hover:bg-primary/90 transition-colors font-medium"
            >
              Sign Up for Updates
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-primary/5">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold text-primary mb-4 sm:mb-6">
          Building a Legacy That Lasts
        </h2>
        <p class="text-base sm:text-lg text-foreground/80 mb-6 sm:mb-10">
          The Black Family Business Network is just one part of our commitment to preserving and celebrating Black legacy. Thank you for helping us lay the foundation.
        </p>
        <div class="flex flex-col gap-4 w-full max-w-md mx-auto">
          <a 
            href="/programs" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium w-full justify-center"
            })}
          >
            Explore All Programs
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>