  <!-- CSS for Animations -->
  <style>
    /* Ticker Animation */
    @keyframes ticker {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-33.33%, 0, 0);
      }
    }

    .animate-ticker {
      animation: ticker 30s linear infinite;
    }

    .ticker-item {
      display: inline-block;
    }

    /* Glowing text effect for ticker */
    .ticker-glow {
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.5), 0 0 15px rgba(255, 255, 255, 0.3);
      letter-spacing: 0.02em;
    }
    
    /* Purpose Scroller Animation */
    .purpose-scroller {
      height: 340px;
      overflow: hidden;
      position: relative;
    }
    
    .purpose-item {
      opacity: 0;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
      padding-right: 1.5rem; /* Add space for navigation dots */
    }
    
    .purpose-item.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    
    /* Side by side responsive adjustments */
    @media (max-width: 1023px) {
      .purpose-scroller {
        height: 320px;
      }
    }
    
    @media (max-width: 768px) {
      .purpose-scroller {
        height: 360px;
      }
    }
    
    /* Make carousel and purpose box equal height in side-by-side view */
    @media (min-width: 1024px) {
      .audience-slide, .audience-slide .relative {
        height: 310px;
      }
      
      #audienceCarousel, #audienceCarousel .relative {
        height: 100%;
      }
    }

    /* CTA button hover styles */
    :global(.cta-primary-button) {
      background-color: white !important;
      color: #052d3f !important;
      border-color: white !important;
      transition: all 0.3s ease-in-out !important;
    }

    :global(.cta-primary-button:hover),
    :global(.cta-primary-button:focus) {
      background-color: #9a4a0b !important;
      color: white !important;
      border-color: #9a4a0b !important;
    }

    :global(.cta-secondary-button) {
      background-color: white !important;
      color: #052d3f !important;
      border-color: #052d3f !important;
      transition: all 0.3s ease-in-out !important;
