---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Share2 } from "lucide-react";
import ReferBusinessButton from "@/components/ReferBusinessButton";
---

<BaseLayout
  title="Black Family Business Network | In the Room With Legacy"
  description="A new initiative designed to honor, connect, and equip Black family business leaders across generations."
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center px-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-4 sm:mb-6">
          The Black Family Business Network
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-foreground/80 mb-6 sm:mb-8 max-w-2xl mx-auto">
          Celebrating Legacy. Building Connection. Amplifying Black Enterprise.
        </p>
        
        <p class="text-base sm:text-lg text-foreground/80 mb-6 sm:mb-8 max-w-2xl mx-auto">
          Across generations, Black families have built, led, and sustained businesses that shape our communities. The Black Family Business Network—powered by In the Room with Legacy™—exists to recognize those stories, strengthen our connections, and preserve the legacies we're still writing.
        </p>
        
        <p class="text-base sm:text-lg text-foreground/80 mb-8 max-w-2xl mx-auto">
          We're gathering a powerful community of Black family business professionals, founders, and heirs who are redefining what legacy looks like today.
        </p>
        
        <div class="w-full max-w-2xl mx-auto bg-white rounded-lg shadow-md p-6 md:p-8 border border-primary/10 mb-10">
          <h3 class="text-xl font-display font-semibold text-primary mb-4">Join the network.</h3>
          <p class="text-foreground/80 mb-6 text-center">
            Be part of a growing database of changemakers building across generations. Share your family's story, connect with others, and keep the legacy alive.
          </p>
          
          <div class="flex flex-col gap-5 w-full sm:max-w-md mx-auto px-0 sm:px-4">
            <a 
              href="https://forms.gle/C5ziQzvQdazXiTRt6" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                size: "lg",
                class: "font-medium w-full justify-center text-center text-[15px] sm:text-sm max-w-full"
              })}
            >
              Submit Your Family Business Profile
            </a>
            <ReferBusinessButton client:load />
          </div>
        </div>
        
        <p class="text-lg sm:text-xl md:text-xl font-display text-primary mb-6">
          The more of us in the room, the stronger the movement.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>