---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Users, MessageCircle, Heart, BookOpen, Handshake } from "lucide-react";
import { Image } from 'astro:assets';
import { TimeTriggeredModal } from '@/components/TimeTriggeredModal';

// Import images
import familyGathering from '../../assets/community/family_gathering_nw_664eb12a.jpg';
import businessOfFamily from '../../assets/community/the-business-of-family_nw_b2773ef0.png';
import familyTreeLogo from '../../assets/3_nw_b5691621.png';
---

<BaseLayout
  title="The Community | In the Room With Legacy"
  description="Where families, founders, and legacy stewards gather, connect, and grow across generations."
>
  <!-- Hero Section -->
  <section class="relative min-h-[500px] md:min-h-[600px] flex items-center overflow-hidden bg-primary">
    <!-- Background with photo image -->
    <div class="absolute inset-0 w-full h-full z-0">
      <!-- Background Photo -->
      <Image 
        src={familyGathering} 
        alt="Family gathering and connecting across generations" 
        class="w-full h-full object-cover object-center"
        width={1920}
        height={1080}
        loading="eager"
      />
      <!-- Dark overlay for readability -->
      <div class="absolute inset-0 bg-primary/70"></div>
      
      <!-- Family tree logo overlay -->
      <div class="absolute inset-0 z-10 flex items-center justify-center">
        <div class="w-full mx-auto flex justify-center">
          <Image
            src={familyTreeLogo} 
            alt="Family tree logo symbolizing generations and legacy"
            class="w-[150%] md:w-[120%] max-w-none h-auto opacity-30"
            width={1200}
          />
        </div>
      </div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 px-4 drop-shadow-md">
          The Community
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 max-w-2xl mx-auto px-4">
          Where families, founders, and legacy stewards gather, connect, and grow across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-foreground/80 leading-relaxed mb-8">
          Legacy is relational. It's strengthened in the rooms where stories are shared, wisdom is exchanged, and the weight of inherited responsibility is understood. The Community pillar of In the Room with Legacy™ exists to create these rooms — spaces where families, builders, founders, and heirs can build connection, find support, and feel seen in the unique journey of generational stewardship. Our first official community is the Black Family Business Network, with additional communities and convenings launching over time.
        </p>
      </div>
    </div>
  </section>

  <!-- What Community Means Section -->
  <section class="py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          What Community Means at IRL
        </h2>
        
        <!-- Four pillars of community -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Pillar 1 -->
          <div class="bg-white rounded-lg shadow-md p-8 hover:shadow-lg transition-all border border-primary/10">
            <div class="flex items-start gap-4">
              <div class="p-3 rounded-full bg-primary/10 flex-shrink-0">
                <Users size={24} className="text-primary" />
              </div>
              <div>
                <h3 class="text-xl font-display font-semibold mb-3 text-primary">Bring legacy-driven families into connection</h3>
                <p class="text-foreground/80 text-base">
                  Creating spaces where families with similar values and aspirations can connect, share experiences, and build relationships that transcend individual journeys.
                </p>
              </div>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="bg-white rounded-lg shadow-md p-8 hover:shadow-lg transition-all border border-primary/10">
            <div class="flex items-start gap-4">
              <div class="p-3 rounded-full bg-primary/10 flex-shrink-0">
                <MessageCircle size={24} className="text-primary" />
              </div>
              <div>
                <h3 class="text-xl font-display font-semibold mb-3 text-primary">Provide space for honest, culturally grounded conversations</h3>
                <p class="text-foreground/80 text-base">
                  Facilitating authentic dialogue that acknowledges the cultural context and lived experiences that shape how we build and preserve legacy.
                </p>
              </div>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="bg-white rounded-lg shadow-md p-8 hover:shadow-lg transition-all border border-primary/10">
            <div class="flex items-start gap-4">
              <div class="p-3 rounded-full bg-primary/10 flex-shrink-0">
                <Heart size={24} className="text-primary" />
              </div>
              <div>
                <h3 class="text-xl font-display font-semibold mb-3 text-primary">Honor the experiences that shape generational leadership</h3>
                <p class="text-foreground/80 text-base">
                  Recognizing the unique challenges and opportunities that come with inheriting or creating multigenerational legacies in different contexts.
                </p>
              </div>
            </div>
          </div>

          <!-- Pillar 4 -->
          <div class="bg-white rounded-lg shadow-md p-8 hover:shadow-lg transition-all border border-primary/10">
            <div class="flex items-start gap-4">
              <div class="p-3 rounded-full bg-primary/10 flex-shrink-0">
                <Handshake size={24} className="text-primary" />
              </div>
              <div>
                <h3 class="text-xl font-display font-semibold mb-3 text-primary">Foster a growing network of families committed to building something bigger than themselves</h3>
                <p class="text-foreground/80 text-base">
                  Cultivating an ecosystem where families support each other in creating impact that extends beyond individual family units to communities and future generations.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Community Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Featured Community
        </h2>
        <h3 class="text-xl md:text-2xl font-display font-semibold text-primary/80 mb-12 text-center">
          The Black Family Business Network
        </h3>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="order-2 lg:order-1">
            <p class="text-foreground/80 text-lg mb-8">
              The first curated IRL community — designed for Black family enterprise founders, heirs, and professionals stewarding wealth, heritage, and responsibility across generations.
            </p>
            <p class="text-foreground/80 mb-8">
              This network brings together Black business families committed to creating, protecting, and transferring wealth and wisdom across generations. Through facilitated gatherings, knowledge sharing, and collaborative opportunities, members access the support, resources, and connections needed to overcome unique challenges and leverage distinctive strengths.
            </p>
            <a 
              href="/programs/black-family-business-network" 
              class={buttonVariants({
                size: "lg",
                class: "font-medium"
              })}
            >
              Learn More
            </a>
          </div>
          
          <div class="order-1 lg:order-2 relative">
            <Image 
              src={businessOfFamily} 
              alt="The Business of Family - Black Family Business Network" 
              class="rounded-xl shadow-lg w-full h-auto object-cover"
              width={600}
              height={400}
            />
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-primary/5 rounded-lg -z-10"></div>
            <div class="absolute -top-6 -left-6 w-24 h-24 border-2 border-primary/20 rounded-lg -z-10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-8">
          Join Our Community
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          Legacy is built together. Connect with like-minded families, founders, and stewards committed to creating meaningful impact across generations.
        </p>
        <a 
          href="/#join-the-room" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium inline-flex items-center gap-2"
          })}
        >
          Stay connected as our communities grow
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- Time Triggered Modal - shows after 10 seconds -->
  <TimeTriggeredModal 
    client:load
    guideName="Parenting a Parent: A Guide for Adult Children"
    delaySeconds={10}
  />
</BaseLayout>