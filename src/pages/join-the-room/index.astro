---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, ArrowRight } from "lucide-react";
---

<BaseLayout
  title="Join the Room | In the Room With Legacy"
  description="Join the Legacy Movement. Your support helps us foster cultural conversation, build community, and provide public programming around legacy building."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-[#f7f6dc] relative">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-[#052d3f] leading-tight mb-6">
            Join the Room.<br/>Support the Legacy Movement.
          </h1>
          <p class="text-lg md:text-xl text-[#052d3f]/80 mb-10 max-w-3xl mx-auto">
            By joining the room, you become part of a movement dedicated to transforming how families see themselves across generations. Your support directly enables our mission to create spaces where legacy can thrive.
          </p>

          <!-- Primary CTA Button -->
          <a 
            href="/support/donation"
            class={buttonVariants({
              size: "lg",
              class: "bg-[#9a4a0b] hover:bg-[#9a4a0b]/90 text-white py-7 px-10 text-lg font-semibold shadow-lg inline-flex items-center justify-center mx-auto"
            })}
          >
            <Heart className="mr-2 h-5 w-5" />
            Donate Now
          </a>
        </div>

        <!-- Impact Cards -->
        <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white rounded-xl shadow-md p-8 border border-[#052d3f]/10">
            <h2 class="text-2xl font-display font-bold text-[#052d3f] mb-4">What Your Support Makes Possible</h2>
            <ul class="space-y-4 text-[#052d3f]/80">
              <li class="flex items-start">
                <span class="text-[#9a4a0b] mr-2 font-bold">•</span>
                <span>Free public programming on legacy building</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#9a4a0b] mr-2 font-bold">•</span>
                <span>Resources for families to document and preserve their stories</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#9a4a0b] mr-2 font-bold">•</span>
                <span>Community spaces where legacy conversations can flourish</span>
              </li>
              <li class="flex items-start">
                <span class="text-[#9a4a0b] mr-2 font-bold">•</span>
                <span>Research on effective legacy practices across cultures</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-white rounded-xl shadow-md p-8 border border-[#052d3f]/10">
            <h2 class="text-2xl font-display font-bold text-[#052d3f] mb-4">Why Join Now?</h2>
            <p class="text-[#052d3f]/80 mb-4">
              The work of legacy building is urgent. When we wait to have important conversations, document our stories, or share our values, we risk losing the connections that matter most.
            </p>
            <p class="text-[#052d3f]/80 mb-4">
              Your support today helps families start their legacy journey while they still can—creating meaning, purpose, and connection that will last for generations.
            </p>
            <a 
              href="/support/donation" 
              class="inline-flex items-center text-[#052d3f] font-semibold hover:text-[#9a4a0b] transition-colors"
            >
              Make a difference today <ArrowRight className="ml-2 h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recognition Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#052d3f] mb-6">
          Your Support is Recognized
        </h2>
        <p class="text-[#052d3f]/80 mb-8 max-w-2xl mx-auto">
          In the Room with Legacy™ acknowledges the generosity of our supporters through recognition opportunities and exclusive member benefits.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-[#f7f6dc] p-6 rounded-lg">
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">
              Donor Recognition
            </h3>
            <p class="text-[#052d3f]/80">
              Supporters are acknowledged on our website and in annual reports.
            </p>
          </div>
          
          <div class="bg-[#f7f6dc] p-6 rounded-lg">
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">
              Member Updates
            </h3>
            <p class="text-[#052d3f]/80">
              Receive exclusive updates on the impact of your support.
            </p>
          </div>
          
          <div class="bg-[#f7f6dc] p-6 rounded-lg">
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">
              Event Access
            </h3>
            <p class="text-[#052d3f]/80">
              Early access to events and members-only programming.
            </p>
          </div>
        </div>
        
        <div class="mt-10">
          <a 
            href="/support/donation"
            class={buttonVariants({
              size: "lg",
              class: "bg-[#9a4a0b] hover:bg-[#9a4a0b]/90 text-white py-6 px-8 text-lg font-semibold shadow-md"
            })}
          >
            <Heart className="mr-2 h-5 w-5" />
            Donate Now
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Tax Information -->
  <section class="py-10 bg-[#f7f6dc]/50">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-[#052d3f]/80 italic">
          In the Room with Legacy™ is a registered 501(c)(3) nonprofit organization. All donations are tax-deductible to the extent allowed by law.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>