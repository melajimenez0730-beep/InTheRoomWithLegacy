---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Heart, DollarSign, CreditCard, Banknote, Repeat } from "lucide-react";
---

<BaseLayout
  title="Join the Room | In the Room With Legacy"
  description="Support the Legacy Movement through donations. Your contribution directly funds our mission to foster cultural conversation, build community, and provide public programming around legacy building."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-[#f3f4f6] relative">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-[#052d3f] leading-tight mb-6">
            Support the Legacy Movement.<br/>Join the Room.
          </h1>
          <p class="text-lg md:text-xl text-[#052d3f]/80 mb-8 max-w-3xl mx-auto">
            Your donation directly funds our mission to foster cultural conversation, build community, and provide public programming around legacy building. Every contribution helps us create spaces where legacy can thrive across generations.
          </p>
        </div>

        <!-- Donation Form -->
        <div class="bg-white rounded-xl shadow-lg border border-[#052d3f]/10 overflow-hidden">
          <div class="p-8 md:p-10">
            <div class="flex items-center gap-3 mb-8">
              <Heart className="h-7 w-7 text-[#9a4a0b]" />
              <h2 class="text-2xl md:text-3xl font-display font-semibold text-[#052d3f]">Make a Donation</h2>
            </div>
            
            <form class="space-y-8" action="https://api.new.website/api/submit-form/" method="POST" enctype="multipart/form-data">
              <div>
                <label for="donation_amount" class="block text-base font-medium text-[#052d3f] mb-2">
                  Enter Custom Donation Amount
                </label>
                <div class="mt-1 relative rounded-md shadow-sm">
                  <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <DollarSign className="h-5 w-5 text-[#052d3f]/40" />
                  </div>
                  <input 
                    type="text" 
                    name="donation_amount" 
                    id="donation_amount" 
                    class="block w-full pl-10 pr-12 py-4 border-[#052d3f]/20 rounded-md focus:ring-[#052d3f] focus:border-[#052d3f] text-lg" 
                    placeholder="0.00"
                    required
                  />
                  <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <span class="text-gray-500 sm:text-sm">USD</span>
                  </div>
                </div>
                <p class="mt-2 text-sm text-[#052d3f]/60">
                  Donations of any amount are greatly appreciated and put to immediate use.
                </p>
              </div>
              
              <div class="bg-[#f3f4f6] p-6 rounded-lg">
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input 
                      id="recurring" 
                      name="recurring" 
                      type="checkbox" 
                      class="h-4 w-4 text-[#9a4a0b] border-gray-300 rounded"
                      value="yes"
                    >
                  </div>
                  <div class="ml-3">
                    <label for="recurring" class="font-medium text-[#052d3f] flex items-center text-base">
                      <Repeat className="h-4 w-4 mr-2 text-[#9a4a0b]" />
                      Make this a monthly donation
                    </label>
                    <p class="text-[#052d3f]/70 mt-1">
                      Recurring donations help us plan and sustain our programs throughout the year.
                    </p>
                  </div>
                </div>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-[#052d3f] mb-2">
                    Your Name
                  </label>
                  <input 
                    type="text" 
                    name="name" 
                    id="name" 
                    class="block w-full px-4 py-3 border-[#052d3f]/20 rounded-md focus:ring-[#052d3f] focus:border-[#052d3f]" 
                    placeholder="Full Name"
                    required
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-[#052d3f] mb-2">
                    Email Address
                  </label>
                  <input 
                    type="email" 
                    name="email" 
                    id="email" 
                    class="block w-full px-4 py-3 border-[#052d3f]/20 rounded-md focus:ring-[#052d3f] focus:border-[#052d3f]" 
                    placeholder="you@example.com"
                    required
                  />
                </div>
              </div>
              
              <div class="pt-4">
                <button 
                  type="submit" 
                  class={buttonVariants({
                    size: "lg",
                    class: "w-full justify-center font-medium bg-[#9a4a0b] text-white hover:bg-[#9a4a0b]/90 py-6 text-lg shadow-md"
                  })}
                >
                  <CreditCard className="mr-2 h-5 w-5" />
                  Donate Now
                </button>
                <p class="text-[#052d3f]/60 text-sm text-center mt-3 flex items-center justify-center">
                  <Banknote className="h-4 w-4 mr-1" />
                  Secure payment processed via Stripe
                </p>
              </div>
              
              <input type="hidden" name="form_name" value="Donation Form" />
            </form>
            
            <div class="mt-10 pt-8 border-t border-[#052d3f]/10">
              <h3 class="text-lg font-semibold text-[#052d3f] mb-4">Where Your Donation Goes:</h3>
              <ul class="space-y-3 text-[#052d3f]/80">
                <li class="flex items-start">
                  <span class="text-[#9a4a0b] mr-2">•</span>
                  <span>Supporting free public programming on legacy building</span>
                </li>
                <li class="flex items-start">
                  <span class="text-[#9a4a0b] mr-2">•</span>
                  <span>Creating resources for families to document and preserve their stories</span>
                </li>
                <li class="flex items-start">
                  <span class="text-[#9a4a0b] mr-2">•</span>
                  <span>Building community spaces where legacy conversations can flourish</span>
                </li>
                <li class="flex items-start">
                  <span class="text-[#9a4a0b] mr-2">•</span>
                  <span>Funding research on effective legacy practices across cultures</span>
                </li>
              </ul>
              
              <p class="mt-6 text-[#052d3f]/80 italic">
                In the Room with Legacy™ is a registered organization. All donations are tax-deductible to the extent allowed by law.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Ways to Support -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-[#052d3f] mb-6">
          Other Ways to Support Our Mission
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          <div class="bg-white border border-[#f3f4f6] p-6 rounded-lg shadow-sm">
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-3">
              Shop Our Merchandise
            </h3>
            <p class="text-[#052d3f]/80 mb-4">
              Purchase IRL apparel and accessories to support our mission and spread the word.
            </p>
            <a 
              href="/shop" 
              class={buttonVariants({
                variant: "outline",
                class: "border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/5"
              })}
            >
              Shop Now
            </a>
          </div>
          
          <div class="bg-white border border-[#f3f4f6] p-6 rounded-lg shadow-sm">
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-3">
              Become a Partner
            </h3>
            <p class="text-[#052d3f]/80 mb-4">
              Organizations can partner with us to create meaningful legacy programs.
            </p>
            <a 
              href="/about/partnership-pathways" 
              class={buttonVariants({
                variant: "outline",
                class: "border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/5"
              })}
            >
              Learn More
            </a>
          </div>
          
          <div class="bg-white border border-[#f3f4f6] p-6 rounded-lg shadow-sm">
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-3">
              Volunteer Your Time
            </h3>
            <p class="text-[#052d3f]/80 mb-4">
              Share your skills and passion by volunteering with our programs and events.
            </p>
            <a 
              href="/contact" 
              class={buttonVariants({
                variant: "outline",
                class: "border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/5"
              })}
            >
              Get Involved
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>