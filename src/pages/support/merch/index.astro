---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Shirt, ShoppingBag, ShoppingCart, Package, Truck, CreditCard } from "lucide-react";
---

<BaseLayout
  title="Merch | In the Room With Legacy"
  description="Shop the Legacy Collection. Every purchase directly supports our mission and helps us expand our impact in building legacy across generations."
>
  <!-- Hero Section -->
  <section class="py-20 bg-[#052d3f]">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight text-white leading-tight mb-6">
          Shop the Legacy Collection
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-3xl mx-auto">
          Wear your support for the legacy movement. Every purchase directly funds our ecosystem and helps us expand our impact in legacy building across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Product Benefits Section -->
  <section class="py-10 bg-[#f7f6dc]/70">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          <div class="flex flex-col items-center">
            <Package className="h-10 w-10 text-[#052d3f] mb-3" />
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">Quality Products</h3>
            <p class="text-[#052d3f]/80 text-sm">
              Ethically sourced, durable merchandise designed to last
            </p>
          </div>
          <div class="flex flex-col items-center">
            <Truck className="h-10 w-10 text-[#052d3f] mb-3" />
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">Free Shipping</h3>
            <p class="text-[#052d3f]/80 text-sm">
              On all domestic orders over $50
            </p>
          </div>
          <div class="flex flex-col items-center">
            <CreditCard className="h-10 w-10 text-[#052d3f] mb-3" />
            <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">Secure Checkout</h3>
            <p class="text-[#052d3f]/80 text-sm">
              Safe, protected payment processing
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-display font-bold text-[#052d3f] mb-6">
            Our Products
          </h2>
          <p class="text-lg text-[#052d3f]/80 max-w-2xl mx-auto">
            Every purchase from our merchandise collection directly supports the IRL ecosystem and mission, helping us reach more families with our legacy-building tools and programs.
          </p>
        </div>
        
        <!-- Product Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
          
          <!-- T-shirt Design 1 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <Shirt className="h-20 w-20 text-[#052d3f]/30 group-hover:text-[#052d3f]/50 transition-colors" />
                </div>
              </div>
              <div class="absolute top-4 right-4 bg-[#9a4a0b] text-[#f7f6dc] text-xs font-medium px-2 py-1 rounded">
                New
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL T-shirt (Design 1)</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Classic fit t-shirt with our signature legacy emblem on front.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$35.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- T-shirt Design 2 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <Shirt className="h-20 w-20 text-[#052d3f]/30 group-hover:text-[#052d3f]/50 transition-colors" />
                </div>
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL T-shirt (Design 2)</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Relaxed fit t-shirt with 'Legacy' script across the back.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$35.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Sweatshirt -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <Shirt className="h-20 w-20 text-[#052d3f]/30 group-hover:text-[#052d3f]/50 transition-colors" />
                </div>
              </div>
              <div class="absolute top-4 right-4 bg-[#052d3f] text-[#f7f6dc] text-xs font-medium px-2 py-1 rounded">
                Best Seller
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL Sweatshirt</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Premium fleece sweatshirt with embroidered logo on chest.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$55.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Tote Bag Design 1 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <ShoppingBag className="h-20 w-20 text-[#052d3f]/30 group-hover:text-[#052d3f]/50 transition-colors" />
                </div>
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL Tote Bag (Design 1)</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Canvas tote with 'Legacy in Progress' quote and inner pocket.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$25.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Tote Bag Design 2 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <ShoppingBag className="h-20 w-20 text-[#052d3f]/30 group-hover:text-[#052d3f]/50 transition-colors" />
                </div>
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL Tote Bag (Design 2)</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Heavy-duty canvas with full legacy timeline graphic design.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$25.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Mug Design 1 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <div class="h-16 w-16 bg-[#052d3f]/10 rounded-full group-hover:bg-[#052d3f]/20 transition-colors"></div>
                </div>
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL Mug (Design 1)</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Ceramic mug with our 'In The Room' logo wrapped around.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$18.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Mug Design 2 -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <div class="h-16 w-16 bg-[#052d3f]/10 rounded-full group-hover:bg-[#052d3f]/20 transition-colors"></div>
                </div>
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL Mug (Design 2)</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Travel mug with quote: "Building Legacy One Day at a Time"
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$18.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
          
          <!-- Cap -->
          <div class="bg-[#f7f6dc] rounded-lg border border-[#052d3f]/10 overflow-hidden hover:shadow-lg transition-all flex flex-col h-full group">
            <div class="relative pt-[100%] bg-white">
              <div class="absolute inset-0 flex items-center justify-center p-4">
                <div class="bg-[#052d3f]/5 w-full h-full rounded flex items-center justify-center">
                  <div class="w-16 h-8 bg-[#052d3f]/10 rounded-t-full group-hover:bg-[#052d3f]/20 transition-colors"></div>
                </div>
              </div>
            </div>
            <div class="p-5 flex-grow">
              <h3 class="font-display text-xl font-semibold text-[#052d3f] mb-2">IRL Cap</h3>
              <p class="text-[#052d3f]/70 text-sm mb-3">
                Adjustable cotton cap with embroidered legacy symbol.
              </p>
              <p class="text-[#9a4a0b] font-medium text-lg">$28.00</p>
            </div>
            <div class="p-5 pt-0">
              <button 
                class={buttonVariants({
                  size: "default",
                  class: "w-full justify-center bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
                })}
              >
                <ShoppingCart className="mr-2 h-4 w-4" />
                Shop Now
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-16 bg-[#052d3f]">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-6">
          Support the Legacy Movement
        </h2>
        <p class="text-lg text-white/80 mb-8">
          Looking for other ways to contribute to our mission? Consider making a direct donation to support our nonprofit programs.
        </p>
        <a 
          href="/support/donation" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium bg-[#9a4a0b] text-[#f7f6dc] hover:bg-[#9a4a0b]/90"
          })}
        >
          Make a Donation
        </a>
      </div>
    </div>
  </section>
</BaseLayout>