---

<BaseLayout 
  title="Shop | Ethical Nepotism™ Collection" 
  description="Legacy with accountability. Privilege made purposeful. Our Ethical Nepotism™ collection makes the message wearable."
>
  <!-- Hero Section - Full Width Banner -->
  <div class="relative w-full h-[70vh] md:h-[80vh] overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#f5f5f5]/30 via-[#e0e0e0]/50 to-[#d8d8d8]/80">
      <img 
        src="https://images.unsplash.com/photo-1666358085605-b3b717d5a210?w=1200&h=600&auto=format&fit=crop&q=80" 
        alt="Model wearing Ethical Nepotism apparel" 
        class="w-full h-full object-cover object-center opacity-85 mix-blend-overlay"
      />
    </div>
    
    <div class="absolute inset-0 flex flex-col items-center justify-center px-4 md:px-8 text-center">
      <div class="max-w-4xl animate-fade-in">
        <h1 class="font-serif text-4xl md:text-6xl font-bold text-primary mb-6">
          Legacy with accountability.<br/>Privilege made purposeful.
        </h1>
        
        <p class="text-lg md:text-xl text-primary/90 max-w-2xl mx-auto mb-8">
          Ethical Nepotism™ isn't about favoritism—it's about formation. It's the reclamation of inheritance as something earned through intention, discipline, and stewardship.
        </p>
        
        <Button 
          id="shop-cta"
          size="lg"
          class="text-white bg-primary hover:bg-primary/90 text-lg font-medium px-8 py-6"
          onclick="document.getElementById('product-section').scrollIntoView({behavior: 'smooth'})"
        >
          Shop the Collection <ChevronDown className="ml-2 h-5 w-5" />
        </Button>
      </div>
    </div>
  </div>

  <!-- Product Feature Section -->
  <div id="product-section" class="py-24 bg-[#f7f7f7]">
    <div class="container mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {products.map(product => (
          <div class="product-card group relative overflow-hidden rounded-xl bg-white shadow-md hover:shadow-xl border border-transparent hover:border-primary/10 transition-all duration-300 hover:-translate-y-1">
            <div class="relative overflow-hidden h-72">
              <img 
                src={product.image} 
                alt={product.alt}
                class="w-full h-full object-cover object-center transform transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 flex items-end translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                <div class="p-6 bg-white/90 w-full border-t border-primary/10 shadow-sm">
                  <p class="font-serif text-lg italic text-primary mb-4">{product.tagline}</p>
                  <a 
                    href={product.checkoutUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center bg-[#9a4a0b] hover:bg-[#9a4a0b]/90 text-white font-medium py-2 px-4 rounded-md transition-colors"
                  >
                    Buy Now <ExternalLink className="ml-2 h-4 w-4" />
                  </a>
                </div>
              </div>
            </div>
            
            <div class="p-6">
              <h3 class="font-serif text-xl font-bold text-primary mb-1">
                {product.name}
                <span class="text-[#9a4a0b] ml-1">{product.description}</span>
              </h3>
              <div class="flex justify-between items-center mt-2">
                <p class="font-sans text-primary/80 text-sm">{product.tagline}</p>
                <span class="font-serif text-xl font-bold text-primary">{product.price}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Message & Visual Story Section -->
  <div class="py-20 bg-white">
    <div class="container mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row items-center">
        <div class="w-full md:w-1/2 mb-10 md:mb-0 md:pr-10">
          <h2 class="font-serif text-3xl md:text-4xl font-bold text-primary mb-6">
            This is legacy you can live in.
          </h2>
          
          <p class="text-lg text-primary/80 mb-6">
            Our collection redefines inheritance as responsibility, not entitlement. Every piece carries a message—wearable reminders of purpose, growth, and intentional living.
          </p>
          
          <p class="text-lg text-primary/80 mb-6">
            When you wear Ethical Nepotism™, you're not just making a fashion statement—you're making a declaration about how you view privilege, opportunity, and the transfer of knowledge and resources across generations.
          </p>
        </div>
        
        <div class="w-full md:w-1/2 rounded-xl overflow-hidden shadow-2xl">
          <img 
            src="https://images.unsplash.com/photo-1564518160120-94178fcdf5d4?w=600&h=400&auto=format&fit=crop&q=80" 
            alt="Ethical Nepotism lifestyle" 
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Final CTA Section -->
  <div class="py-20 bg-[#f2f0eb]">
    <div class="container mx-auto px-4 md:px-8 text-center">
      <h2 class="font-serif text-3xl md:text-5xl font-bold text-primary mb-4">
        Each drop is a statement.
      </h2>
      <p class="text-2xl md:text-3xl font-serif text-[#9a4a0b] mb-10">
        This is Ethical Nepotism™.
      </p>
      
      <Button 
        id="final-cta"
        size="lg"
        class="text-white bg-primary hover:bg-primary/90 text-lg font-medium px-8 py-6 mt-4"
        onclick="document.getElementById('product-section').scrollIntoView({behavior: 'smooth'})"
      >
        Shop Now <ChevronDown className="ml-2 h-5 w-5" />
      </Button>
    </div>
  </div>
</BaseLayout>

<style>
  /* Animations */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }
  
  .animate-fade-in {
    animation: fadeIn 1s ease-out forwards;
  }
  
  .product-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  /* Apply floating animation on hover */
  .product-card:hover {
    animation: float 3s ease-in-out infinite;
  }
  
  /* Make font adjustments */
  .font-serif {
    font-family: 'Playfair Display', Georgia, serif;
  }
  
  .font-sans {
    font-family: 'Inter', system-ui, sans-serif;
  }
  
  /* Responsive adjustments */
  @media (max-width: 768px) {
    .product-card .absolute {
      transform: translateY(0) !important;
    }
  }
</style>

<script>
  // Add scroll-based animations
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
          observer.unobserve(entry.target);
        }
      });
    }, {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    });
    
    // Observe product cards
    document.querySelectorAll('.product-card').forEach(card => {
      observer.observe(card);
      // Initially hide the cards
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
    });
    
    // Add click events to CTA buttons
    document.querySelectorAll('#shop-cta, #final-cta').forEach(button => {
      button.addEventListener('click', () => {
        document.getElementById('product-section').scrollIntoView({
          behavior: 'smooth'
        });
      });
    });
  });
</script>