---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { MailPlus, Building, Megaphone, DollarSign, MailCheck } from "lucide-react";
import ContactPageForm from "@/components/ContactPageForm";
import { Image } from 'astro:assets';
// TimeTriggeredModal import removed as requested
import legacyBackground from "@/assets/untitled-presentation-1_nw_100c1b23.png";
---

<BaseLayout
  title="Contact | In the Room With Legacy"
  description="Connect with us to build legacy together. Reach out for general inquiries, partnerships, speaking engagements, or investment opportunities."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 relative overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute inset-0 z-0">
      <Image 
        src={legacyBackground} 
        alt="Contact us background image with family legacy themes" 
        class="w-full h-full object-cover"
      />
      <!-- Dark overlay with primary brand color at 60% opacity -->
      <div class="absolute inset-0 bg-primary opacity-60"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6 drop-shadow-sm">
          Connect with Us
        </h1>
        <p class="text-lg md:text-xl text-white mb-8 max-w-2xl mx-auto drop-shadow-sm">
          We look forward to connecting with you. To ensure your inquiry reaches the right place quickly, please select the category below that best describes your interest. Each link will take you to a dedicated form for your request.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Directory Section -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Block 1: Join the Room -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">Join the Room</h3>
            <p class="text-foreground/80 mb-6">For general inquiries or to introduce yourself to the In the Room with Legacy™ community.</p>
            <a 
              href="https://laurenrosamiller.kit.com/25d26f1801" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Start Conversation
            </a>
          </div>
          
          <!-- Block 2: Program Waitlist -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">Program Waitlist</h3>
            <p class="text-foreground/80 mb-6">Be the first to know when dates open for new foundational experiences and programs.</p>
            <a 
              href="https://laurenrosamiller.kit.com/d714efb37b" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Join Waitlist Now
            </a>
          </div>
          
          <!-- Block 3: Request a Family Session -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">Request a Family Session</h3>
            <p class="text-foreground/80 mb-6">For families interested in scheduling a facilitated planning session for While We're Still Here™.</p>
            <a 
              href="https://laurenrosamiller.kit.com/111a0f854c" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Request Session
            </a>
          </div>
          
          <!-- Block 4: Advisory Services -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">Advisory Services</h3>
            <p class="text-foreground/80 mb-6">To inquire about bespoke advisory support for complex family governance, wealth, or enterprise challenges.</p>
            <a 
              href="https://laurenrosamiller.kit.com/a818ccbe8d" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Inquire About Advising
            </a>
          </div>
          
          <!-- Block 5: Partnership Inquiry -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">Partnership Inquiry</h3>
            <p class="text-foreground/80 mb-6">For organizations and professionals interested in strategic collaborations and partnership pathways.</p>
            <a 
              href="https://laurenrosamiller.kit.com/c4a6c9d83f" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Start Partnership Inquiry
            </a>
          </div>
          
          <!-- Block 6: Legacy Assessment Access -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">Legacy Assessment Access</h3>
            <p class="text-foreground/80 mb-6">Request access to the AI-Powered Legacy Assessment Tool (Beta).</p>
            <a 
              href="https://laurenrosamiller.kit.com/844036749a" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Request Tool Access
            </a>
          </div>
          
          <!-- Block 7: More Questions? -->
          <div class="bg-muted/10 rounded-lg p-6 md:p-8 border border-primary/10 shadow-sm hover:shadow-md transition-all">
            <h3 class="font-display text-xl font-bold text-primary mb-3">More Questions?</h3>
            <p class="text-foreground/80 mb-6">If your specific inquiry is not listed above, please use this form to compose a general message or note.</p>
            <a 
              href="https://laurenrosamiller.kit.com/406652a985" 
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Contact Us
            </a>
          </div>
        </div>
        
        <div class="text-center mt-12 text-foreground/70">
          <p class="text-sm">
            Prefer email? Reach out directly to <a href="mailto:hello@intheroomwithlegacy.com" class="text-primary hover:underline">hello@intheroomwithlegacy.com</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Time Triggered Modal has been removed to provide a cleaner user experience on this page -->
</BaseLayout>