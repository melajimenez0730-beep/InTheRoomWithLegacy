---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Brain, Award, BookOpen } from "lucide-react";
---

<BaseLayout
  title="Tools & Resources | In the Room With Legacy"
  description="Access powerful tools and resources to help you protect, preserve, and pass on your family legacy across generations."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          Tools & Resources
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          Access powerful tools and resources designed to help you protect, preserve, and pass on your family legacy across generations.
        </p>
      </div>
    </div>
  </section>

  <!-- Tools Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          Legacy Building Tools
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Legacy Assessment Tool Card -->
          <div class="group bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden hover:shadow-lg transition-all">
            <div class="bg-primary/5 p-6 relative">
              <div class="absolute top-4 right-4 z-10">
                <div class="inline-flex items-center justify-center px-3 py-1 bg-secondary/10 text-secondary border border-secondary/20 rounded-full text-sm font-medium">
                  <Award className="w-4 h-4 mr-1" /> Beta
                </div>
              </div>
              <div class="flex justify-center">
                <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center">
                  <Brain className="w-12 h-12 text-primary" />
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-display font-semibold text-primary mb-3">Legacy Assessment Tool</h3>
              <p class="text-foreground/80 mb-6">
                A guided experience that helps families measure where they are, map what matters most, and take real steps to protect their legacy across generations.
              </p>
              <a 
                href="/tools/legacy-assessment" 
                class={buttonVariants({
                  variant: "default",
                  size: "default",
                  class: "w-full justify-center"
                })}
              >
                Access Tool
              </a>
            </div>
          </div>

          <!-- Placeholder for Future Tool -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden opacity-70">
            <div class="bg-primary/5 p-6">
              <div class="flex justify-center">
                <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center">
                  <BookOpen className="w-12 h-12 text-primary" />
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-display font-semibold text-primary mb-3">Legacy Guidebook</h3>
              <p class="text-foreground/80 mb-6">
                Coming soon: A customizable template to document your family's values, stories, wishes, and important information.
              </p>
              <button 
                disabled
                class={buttonVariants({
                  variant: "outline",
                  size: "default",
                  class: "w-full justify-center cursor-not-allowed"
                })}
              >
                Coming Soon
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources Section Placeholder -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Legacy Resources
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          More resources coming soon to help you on your legacy journey.
        </p>
        <a 
          href="/#join-the-room" 
          class={buttonVariants({
            variant: "outline",
            size: "lg",
            class: "border-primary text-primary hover:bg-primary/10 font-medium"
          })}
        >
          Join the Room for Updates
        </a>
      </div>
    </div>
  </section>
</BaseLayout>