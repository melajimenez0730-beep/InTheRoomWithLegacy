---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Brain, Award, BookOpen, CheckSquare, FileText, Map } from "lucide-react";
import { Image } from 'astro:assets';
import legacyBackground from "@/assets/ash-grey-and-black-modern-professional-brand-research-presentation-3_nw_390fd864.png";
---

<BaseLayout
  title="Tools & Resources | In the Room With Legacy"
  description="Access powerful tools and resources to help you protect, preserve, and pass on your family legacy across generations."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 relative overflow-hidden min-h-[60vh] flex items-center">
    <div class="absolute inset-0 z-0">
      <Image 
        src={legacyBackground} 
        alt="Vintage family photographs showing legacy moments" 
        class="w-full h-full object-cover brightness-[0.8] sepia-[0.1]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-primary/70 to-primary/60 mix-blend-multiply"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-white leading-tight mb-6">
          This didn't start with strategy.<br/>It started with a story.
        </h1>
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          In the Room with Legacy™ was born in a sacred transition.
        </p>
        <a 
          href="#tools" 
          class={buttonVariants({
            variant: "secondary",
            size: "lg",
            class: "font-medium bg-white text-primary hover:bg-white/90"
          })}
        >
          Explore Our Tools
        </a>
      </div>
    </div>
  </section>

  <!-- Tools Section -->
  <section id="tools" class="py-24 bg-white">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <p class="text-lg text-foreground/80 mb-12 text-center max-w-3xl mx-auto">
          Whether you're ready to map your values, begin a family conversation, or build generational wealth, these resources are for you. Use them, share them, shape them into your work.
        </p>
        <p class="text-lg text-foreground/80 mb-12 text-center font-medium">
          Starting with our Legacy Assessment, checklist, and guides — more coming soon.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Legacy Assessment Tool Card -->
          <div class="group bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden hover:shadow-lg transition-all">
            <div class="bg-primary/5 p-6 relative">
              <div class="absolute top-4 right-4 z-10">
                <div class="inline-flex items-center justify-center px-3 py-1 bg-secondary/10 text-secondary border border-secondary/20 rounded-full text-sm font-medium">
                  <Award className="w-4 h-4 mr-1" /> Beta
                </div>
              </div>
              <div class="flex justify-center">
                <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center">
                  <Brain className="w-12 h-12 text-primary" />
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-display font-semibold text-primary mb-3">Legacy Assessment Tool</h3>
              <p class="text-foreground/80 mb-6">
                A guided experience that helps families measure where they are, map what matters most, and take real steps to protect their legacy across generations.
              </p>
              <a 
                href="/tools/legacy-assessment" 
                class={buttonVariants({
                  variant: "default",
                  size: "default",
                  class: "w-full justify-center"
                })}
              >
                Access Tool
              </a>
            </div>
          </div>

          <!-- Legacy Building Checklist -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden hover:shadow-lg transition-all">
            <div class="bg-primary/5 p-6">
              <div class="flex justify-center">
                <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center">
                  <CheckSquare className="w-12 h-12 text-primary" />
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-display font-semibold text-primary mb-3">Legacy Building Checklist</h3>
              <p class="text-foreground/80 mb-6">
                A comprehensive checklist to help you identify and address key areas of your legacy planning journey.
              </p>
              <a 
                href="#download" 
                class={buttonVariants({
                  variant: "default",
                  size: "default",
                  class: "w-full justify-center"
                })}
              >
                Free Download
              </a>
            </div>
          </div>

          <!-- Heir Readiness Guide -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden hover:shadow-lg transition-all">
            <div class="bg-primary/5 p-6">
              <div class="flex justify-center">
                <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center">
                  <FileText className="w-12 h-12 text-primary" />
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-display font-semibold text-primary mb-3">Heir Readiness Conversation Guide</h3>
              <p class="text-foreground/80 mb-6">
                Worksheet with prompts and exercises to help prepare next-generation family members for inheritance responsibilities.
              </p>
              <a 
                href="#download" 
                class={buttonVariants({
                  variant: "default",
                  size: "default",
                  class: "w-full justify-center"
                })}
              >
                Download Worksheet
              </a>
            </div>
          </div>
        </div>

        <!-- Second Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
          <!-- Family Values Mapping Template -->
          <div class="bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden hover:shadow-lg transition-all">
            <div class="bg-primary/5 p-6">
              <div class="flex justify-center">
                <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center">
                  <Map className="w-12 h-12 text-primary" />
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-display font-semibold text-primary mb-3">Family Values Mapping Template</h3>
              <p class="text-foreground/80 mb-6">
                A structured framework to help your family identify, document, and align on core values across generations.
              </p>
              <a 
                href="#download" 
                class={buttonVariants({
                  variant: "default",
                  size: "default",
                  class: "w-full justify-center"
                })}
              >
                Download Template
              </a>
            </div>
          </div>

          <!-- Placeholder for Future Tools -->
          <div class="md:col-span-2 bg-white rounded-lg shadow-md border border-primary/10 overflow-hidden flex flex-col justify-center items-center p-8">
            <BookOpen className="w-16 h-16 text-primary/40 mb-4" />
            <h3 class="text-xl font-display font-semibold text-primary mb-2 text-center">More Tools Coming Soon</h3>
            <p class="text-foreground/70 text-center max-w-md">
              We're building new resources to support your legacy journey. Stay connected for updates on our upcoming tools and templates.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Join the Room Section -->
  <section class="py-24 bg-muted/30" id="join-the-room">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Want to be the first to know when new tools drop?
        </h2>
        <p class="text-lg text-foreground/80 mb-10">
          Join our community to receive updates on new resources and tools as they become available.
        </p>
        <a 
          href="/#join-the-room" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium"
          })}
        >
          Join the Room
        </a>
      </div>
    </div>
  </section>
</BaseLayout>