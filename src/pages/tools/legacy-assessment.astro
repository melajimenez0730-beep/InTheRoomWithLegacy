---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ArrowRight, Award, Brain, Lightbulb, BarChart3, Users, BookOpen, ChevronDown } from "lucide-react";
---

<BaseLayout
  title="Legacy Assessment Tool | In the Room With Legacy"
  description="The first AI-powered Legacy Assessment Tool: A guided experience that helps families measure where they are, map what matters most, and take real steps to protect their legacy across generations."
>
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-primary/5 relative overflow-hidden">
    <!-- Enhanced beta banner ribbon -->
    <div class="absolute right-0 top-12 z-10 hidden md:block">
      <div class="bg-secondary text-white py-2 px-8 font-bold shadow-md transform rotate-45 translate-x-8 text-sm">
        BETA ACCESS
      </div>
    </div>
    <div class="absolute inset-0 z-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <!-- Beta Badge -->
        <div class="inline-flex items-center justify-center px-4 py-2 bg-secondary/10 text-secondary border border-secondary/20 rounded-full mb-6 text-sm font-medium transform hover:scale-105 transition-transform">
          <Award className="w-4 h-4 mr-2" /> Exclusive Beta Access
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-6">
          The first AI-powered Legacy Assessment Tool.
        </h1>
        <p class="text-lg md:text-xl text-foreground/80 mb-8 max-w-2xl mx-auto">
          Now in Beta: A guided experience that helps families measure where they are, map what matters most, and take real steps to protect their legacy across generations.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#learn-more" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Learn More About the Assessment
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What It Is Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Not just a survey. A legacy journey.
        </h2>
        <p class="text-lg text-foreground/80 mb-10 text-center">
          This isn't a 5-minute quiz. The Legacy Assessment takes time because your story matters. In about 30–40 minutes, you'll walk through thoughtful, culturally rooted questions across multiple dimensions of legacy — from family and values to finances and heir readiness. At the end, you'll receive personalized insights and next steps tailored to where you are in your journey.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 flex flex-col items-center text-center hover:shadow-md transition-all">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6">
              <Brain className="w-8 h-8 text-primary" />
            </div>
            <h3 class="text-xl font-display font-semibold text-primary mb-3">Personalized</h3>
            <p class="text-foreground/80">Customized questions based on your unique family context and legacy goals.</p>
          </div>
          
          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 flex flex-col items-center text-center hover:shadow-md transition-all">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6">
              <BarChart3 className="w-8 h-8 text-primary" />
            </div>
            <h3 class="text-xl font-display font-semibold text-primary mb-3">Comprehensive</h3>
            <p class="text-foreground/80">Covers all dimensions of legacy – values, stories, finances, relationships, and more.</p>
          </div>
          
          <div class="bg-muted/20 p-8 rounded-lg border border-primary/10 flex flex-col items-center text-center hover:shadow-md transition-all">
            <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mb-6">
              <Lightbulb className="w-8 h-8 text-primary" />
            </div>
            <h3 class="text-xl font-display font-semibold text-primary mb-3">Insightful</h3>
            <p class="text-foreground/80">AI-driven analysis provides actionable insights and next steps for your family.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-12 text-center">
          How It Works
        </h2>

        <div class="relative">
          <!-- Journey Path - Enhanced Progressive Visual -->
          <div class="absolute left-6 top-8 h-[calc(100%-160px)] w-0.5 bg-gradient-to-b from-primary via-secondary to-accent hidden md:block"></div>
          
          <!-- Step 1 -->
          <div class="flex flex-col md:flex-row gap-6 md:gap-10 items-start mb-12 relative">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary flex items-center justify-center text-primary-foreground font-bold z-10">
              1
            </div>
            <div class="flex-1 bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
              <h3 class="text-xl font-display font-semibold text-primary mb-3">Answer with honesty.</h3>
              <p class="text-foreground/80 mb-4">
                Take your time to thoughtfully respond to each question. The more honest and detailed your answers, the more valuable your results will be.
              </p>
            </div>
          </div>
          
          <!-- Step 2 -->
          <div class="flex flex-col md:flex-row gap-6 md:gap-10 items-start mb-12 relative">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary flex items-center justify-center text-primary-foreground font-bold z-10">
              2
            </div>
            <div class="flex-1 bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
              <h3 class="text-xl font-display font-semibold text-primary mb-3">Receive insights.</h3>
              <p class="text-foreground/80 mb-4">
                Your assessment generates a personalized legacy profile showing your strengths and areas for growth across multiple dimensions.
              </p>
            </div>
          </div>
          
          <!-- Step 3 -->
          <div class="flex flex-col md:flex-row gap-6 md:gap-10 items-start relative">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary flex items-center justify-center text-primary-foreground font-bold z-10">
              3
            </div>
            <div class="flex-1 bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
              <h3 class="text-xl font-display font-semibold text-primary mb-3">Get next steps.</h3>
              <p class="text-foreground/80 mb-4">
                Walk away with a clear action plan to strengthen your legacy, preserve what matters, and prepare for the future.
              </p>
            </div>
          </div>
        </div>
        
        <div class="text-center mt-16">
          <a 
            href="#learn-more" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium shadow-md hover:shadow-lg transition-shadow"
            })}
          >
            Learn More About the Beta Assessment <span class="ml-1 text-xs bg-amber-500/20 text-amber-600 font-bold rounded-full px-2 py-0.5">BETA</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Beta Section -->
  <section class="py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="bg-primary/5 rounded-lg p-8 md:p-10 border border-primary/10 relative overflow-hidden">
          <!-- Visual Elements -->
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-primary/5 rounded-full"></div>
          <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-primary/5 rounded-full"></div>
          
          <div class="relative z-10">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
              Be part of shaping the future of legacy tools.
            </h2>
            <p class="text-lg text-foreground/80 mb-6">
              This is the very first release of the Legacy Assessment Tool. By joining the Beta, you'll not only gain early access, you'll also help us refine the experience. Your reflections and feedback will guide how we continue to build a tool that serves families everywhere.
            </p>
            
            <div class="flex items-center gap-3 bg-white/80 p-4 rounded-lg inline-block">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
                <Award className="text-secondary w-5 h-5" />
              </div>
              <span class="text-primary font-medium">Early access to future updates and features</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why It Matters Section -->
  <section class="py-24 bg-muted/30">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6 text-center">
          Measure what matters. Protect what lasts.
        </h2>
        <p class="text-lg text-foreground/80 mb-12 text-center">
          Most families wait until crisis to talk about legacy. This tool gives you clarity before that moment — helping you see where you are, celebrate what's strong, and prepare for what's next. Whether you're a founder, an inheritor, or simply beginning the conversation, this assessment is your starting point.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Users className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">For All Families</h3>
            </div>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80">Find clarity about what matters most</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80">Identify gaps in your legacy planning</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80">Begin necessary conversations</span>
              </li>
            </ul>
          </div>
          
          <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-primary/10">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <BookOpen className="text-primary w-6 h-6" />
              </div>
              <h3 class="text-xl font-display font-semibold text-primary">For Business Owners</h3>
            </div>
            <ul class="space-y-3">
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80">Evaluate successor readiness</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80">Assess values alignment across generations</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-primary mt-1">✓</span>
                <span class="text-foreground/80">Identify key transition challenges</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing Section -->
  <section class="py-24 bg-primary/5" id="learn-more">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-primary mb-6">
          Want to learn more about the Legacy Assessment?
        </h2>
        
        <p class="text-lg text-foreground/80 mb-8">
          This detailed assessment tool is being developed to provide comprehensive insights about your family's legacy journey. The full Beta version will be available soon.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">          
          <a 
            href="/contact" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium"
            })}
          >
            Contact Us for More Information
          </a>
        </div>
        
        <div class="mt-8">
          <a 
            href="/contact" 
            class={buttonVariants({
              variant: "link",
              size: "default",
              class: "text-primary hover:text-primary/80 font-medium text-sm"
            })}
          >
            Join the Room
          </a>
          <p class="text-sm text-foreground/60 mt-2">Stay updated as new resources and tools launch.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>