---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Target, Building, Briefcase, ExternalLink, ArrowRight, CircleCheck, Users, University, Network, TestTube, Wrench, Computer, BriefcaseBusiness, CheckCheck, BadgeCheck, Handshake, ListChecks, Star, CheckCircle, MessageCircle, ChevronDown } from "lucide-react";
import { Image } from 'astro:assets';
import heroImage from "@/assets/advisory-innovation-connection_nw_950e6454.png";
import { TimeTriggeredModal } from "@/components/TimeTriggeredModal";
import FrameworkCarousel from "@/components/FrameworkCarousel.astro";
---

<BaseLayout title="In the Room with Legacy Advisors - In the Room With Legacy" description="In the Room with Legacy Advisors (IRL Advisors) is an advisory and innovation arm of In the Room with Legacy™. We provide the strategies, tools, and networks that families, businesses, and institutions need to sustain legacy across generations.">
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-[#f3f4f6] relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 z-0">
      <Image 
        src={heroImage} 
        alt="Advisory, Innovation, and Connection concept image" 
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[#f3f4f6]/40 mix-blend-overlay"></div>
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-display tracking-tight text-[#052d3f] leading-tight mb-6">
          <div class="flex flex-col text-center">
            <div class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">Legacy Advisory for Families, Built With Clarity & Intention</div>
          </div>
        </h1>
        <p class="text-xl md:text-2xl text-[#052d3f]/90 leading-relaxed mb-8 max-w-3xl mx-auto">
          IRL Advisors partners with families, family businesses, and multigenerational stewards to preserve heritage, steward generational wealth, and prepare successors with purpose and confidence. Through culturally grounded advisory and structured, thoughtful planning, we help families build legacy that stands the test of time.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#contact-form" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium text-base px-8 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
            })}
          >
            Request an Initiation Session
          </a>
          <a 
            href="#tools" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "font-medium text-base px-8 border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/10 shadow-sm"
            })}
          >
            Explore Family Advisory Services
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Who We Are Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          Who We Are
        </h2>
        <p class="text-lg text-[#052d3f]/80 mb-12">
          IRL Advisors is where family enterprise expertise meets innovation. While In the Room with Legacy™ centers cultural storytelling and community, IRL Advisors delivers the advisory services, strategic counsel, and professional networks that transform vision into action.
        </p>
        
        <h3 class="text-xl font-display font-semibold mb-8 text-[#052d3f]">We Exist to Help</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Client Type 1 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <Users class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Enterprising families</h4>
          </div>
          
          <!-- Client Type 2 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <Building class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Family businesses & offices</h4>
          </div>
          
          <!-- Client Type 3 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <University class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Institutions & organizations</h4>
          </div>
          
          <!-- Client Type 4 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <BriefcaseBusiness class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Advisors & professionals</h4>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Tools & Frameworks Section -->
  <section class="py-16 md:py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-6">
          Tools & Frameworks That Deepen Your Impact
        </h2>
        <p class="text-xl md:text-2xl text-[#052d3f]/90 font-medium mb-8 max-w-3xl mx-auto leading-relaxed">
          IRL equips advisors with a new set of tools for guiding families through legacy-building in its fullest form.
        </p>
        
        <p class="text-base text-[#052d3f]/70 mb-10">
          With access to the IRL Legacy Operating System (beta) and our advisory frameworks, you can help clients:
        </p>
        
        <FrameworkCarousel />
        
        
        <p class="text-lg text-[#052d3f]/80 font-medium">
          Our tools help you bring the human side of legacy into your practice.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Bespoke Family Advisory Section -->
  <section class="py-16 md:py-24 bg-[#f8f7f2] border-t border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center justify-center mb-6">
          <Star className="text-[#9a4a0b] h-6 w-6 mr-2" />
          <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f]">
            Bespoke Family Advisory
          </h2>
          <span class="text-sm text-[#9a4a0b] ml-3 font-medium">(Limited Availability)</span>
        </div>
        
        <p class="text-xl md:text-2xl text-[#052d3f]/90 font-medium mb-10 max-w-2xl mx-auto leading-relaxed">
          Family legacy is multidimensional — rooted in values, wealth, land, identity, responsibility, and the stories that shape each generation.
        </p>
        
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm text-left mb-10">
          <p class="text-[#052d3f]/80 font-medium mb-4">IRL Advisors provides tailored guidance for:</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="flex items-start">
              <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
              <span>First-generation founders building intentional legacy from the ground up</span>
            </div>
            
            <div class="flex items-start">
              <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
              <span>Second- and third-generation successors preparing for continuity and leadership</span>
            </div>
            
            <div class="flex items-start">
              <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
              <span>Family business owners navigating governance, structure, and succession</span>
            </div>
            
            <div class="flex items-start">
              <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
              <span>Stewards of land and heritage preserving long-held assets and responsibility</span>
            </div>
            
            <div class="flex items-start">
              <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
              <span>Heirs and inheritors stepping into generational roles</span>
            </div>
            
            <div class="flex items-start">
              <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
              <span>Multibranch families seeking alignment, communication, and clarity</span>
            </div>
          </div>
          
          <p class="text-[#052d3f]/80 mb-4">
            We help families plan with intention, structure, and care — protecting what matters and preparing those who will carry it forward.
          </p>
          
          <p class="text-[#052d3f]/80 italic text-sm">
            This service is highly selective and available by consultation only.
          </p>
        </div>
        
        <a 
          href="#contact-form" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
          })}
        >
          Inquire About Bespoke Family Advisory
        </a>
      </div>
    </div>
  </section>
  
  <!-- What We Do Section -->
  <section id="tools" class="py-16 md:py-24 bg-blue-50/50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          What We Do
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Service 1: Legacy & Generational Planning -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Target class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Legacy & Generational Planning</h3>
          <p class="text-[#052d3f]/80 text-center">Clarify your family's values, vision, identity, and long-term goals across generations.</p>
        </div>
        
        <!-- Service 2: Succession & Transition Strategy -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <ArrowRight class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Succession & Transition Strategy</h3>
          <p class="text-[#052d3f]/80 text-center">Design smooth leadership transitions and prepare next-generation heirs for their roles.</p>
        </div>
        
        <!-- Service 3: Family Governance & Structure -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Building class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Family Governance & Structure</h3>
          <p class="text-[#052d3f]/80 text-center">Establish decision-making processes, roles, communication guidelines, and systems for continuity.</p>
        </div>
        
        <!-- Service 4: Stewardship & Impact Planning -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Briefcase class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Stewardship & Impact Planning</h3>
          <p class="text-[#052d3f]/80 text-center">Integrate family mission, heritage, land, philanthropy, and community legacy into a unified strategy.</p>
        </div>
        
        <!-- Service 5: Family Alignment & Guided Conversations -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <MessageCircle class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Family Alignment & Guided Conversations</h3>
          <p class="text-[#052d3f]/80 text-center">Facilitated values mapping and intentional conversations that support unity, respect, and clarity.</p>
        </div>
        
        <!-- Service 6: The IRL Legacy Assessment Tool -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <TestTube class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">The IRL Legacy Assessment Tool</h3>
          <p class="text-[#052d3f]/80 text-center">A culturally grounded diagnostic that helps families understand readiness, alignment, and areas of opportunity.</p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- How It Works Section -->
  <section class="py-16 md:py-24 bg-[#f3f4f6] border-t border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-12">
          How It Works
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
          <!-- Step 1 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col relative">
            <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-[#052d3f] flex items-center justify-center text-white font-bold text-xl shadow-md">1</div>
            <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] mt-4">Initiation Session</h3>
            <p class="text-[#052d3f]/80">Your journey begins with a low-commitment conversation to explore your family's story, goals, and needs.</p>
          </div>
          
          <!-- Step 2 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col relative">
            <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-[#052d3f] flex items-center justify-center text-white font-bold text-xl shadow-md">2</div>
            <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] mt-4">Assessment & Planning</h3>
            <p class="text-[#052d3f]/80">We use the IRL Legacy Assessment Tool and strategic frameworks to map a tailored legacy pathway.</p>
          </div>
          
          <!-- Step 3 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col relative">
            <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-[#052d3f] flex items-center justify-center text-white font-bold text-xl shadow-md">3</div>
            <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] mt-4">Implementation</h3>
            <p class="text-[#052d3f]/80">We support governance, succession, stewardship, or alignment work based on your family's roadmap.</p>
          </div>
          
          <!-- Step 4 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col relative">
            <div class="absolute -top-4 -left-4 w-10 h-10 rounded-full bg-[#052d3f] flex items-center justify-center text-white font-bold text-xl shadow-md">4</div>
            <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] mt-4">Ongoing Partnership</h3>
            <p class="text-[#052d3f]/80">Families may continue through periodic strategy sessions, deeper advisory, or select ecosystem offerings.</p>
          </div>
        </div>
        
        <div class="mt-12">
          <a 
            href="#contact-form" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium text-base px-8 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
            })}
          >
            Start Your Legacy Journey
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- IRL Advisors Ecosystem Section -->
  <section class="py-16 md:py-24 bg-white border-t border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-4">
          Within the IRL Advisors Ecosystem
        </h2>
        
        <h3 class="text-xl md:text-2xl font-display font-semibold text-[#9a4a0b] mb-8">
          A Private, Curated Circle for Black Family Enterprise Leaders
        </h3>
        
        <p class="text-lg text-[#052d3f]/80 mb-10 max-w-3xl mx-auto">
          IRL Advisors is cultivating a private, curated community for Black family business founders, multigenerational successors, and active stewards carrying forward family wealth, business, and heritage across generations.
        </p>
        
        <div class="bg-[#f8f7f2] p-8 rounded-lg border border-[#052d3f]/10 shadow-sm mb-10 max-w-2xl mx-auto">
          <h4 class="text-lg font-display font-semibold text-[#052d3f] mb-6 text-left">
            This circle offers:
          </h4>
          
          <ul class="space-y-4 text-left">
            <li class="flex items-start">
              <CheckCircle className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
              <span class="text-[#052d3f]/80">A trusted community of peers navigating similar responsibilities</span>
            </li>
            
            <li class="flex items-start">
              <CheckCircle className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
              <span class="text-[#052d3f]/80">Shared wisdom rooted in heritage, enterprise stewardship, and legacy</span>
            </li>
            
            <li class="flex items-start">
              <CheckCircle className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
              <span class="text-[#052d3f]/80">Early access to conversations, resources, and frameworks as the community grows</span>
            </li>
          </ul>
        </div>
        
        <p class="text-lg text-[#052d3f]/80 italic mb-8">
          Membership is limited and extended based on alignment, values, and timing.
        </p>
        
        <a 
          href="#contact-form" 
          class={buttonVariants({
            size: "lg",
            class: "font-medium text-base px-8 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
          })}
        >
          Request Consideration
        </a>
      </div>
    </div>
  </section>
  
  <!-- Advisor Partnership Pathways Section -->
  <section class="py-16 md:py-24 bg-[#f3f4f6] border-t border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          Advisor Partnership Pathways
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-12">
          <!-- Partner List -->
          <div>
            <p class="text-lg text-[#052d3f]/80 mb-6 text-left font-medium">
              While our core work centers families directly, IRL Advisors also partners with:
            </p>
            
            <ul class="space-y-3 text-left">
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Family enterprise advisors</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Wealth, legal, or estate professionals</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Family therapists or facilitators</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Organizational or legacy consultants</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Institutions serving multigenerational families</span>
              </li>
            </ul>
          </div>
          
          <!-- Opportunities List -->
          <div>
            <p class="text-lg text-[#052d3f]/80 mb-6 text-left font-medium">
              Partnership opportunities include:
            </p>
            
            <ul class="space-y-3 text-left">
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Collaborative family engagements</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Speaking, teaching, or workshops</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Integration or future licensing of IRL tools</span>
              </li>
              
              <li class="flex items-start">
                <ArrowRight className="text-[#9a4a0b] w-5 h-5 mt-0.5 mr-3 flex-shrink-0" />
                <span class="text-[#052d3f]/80">Co-developed initiatives or research</span>
              </li>
            </ul>
          </div>
        </div>
        
        <a 
          href="#contact-form" 
          class={buttonVariants({
            variant: "outline",
            size: "default",
            class: "font-medium border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/10"
          })}
        >
          Explore Advisor Partnerships
        </a>
      </div>
    </div>
  </section>
  
  <!-- Frequently Asked Questions Section -->
  <section class="py-16 md:py-24 bg-white border-t border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-12">
