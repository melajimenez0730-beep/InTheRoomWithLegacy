---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Target, Building, Briefcase, ExternalLink, ArrowRight, CircleCheck, Users, University, Network, TestTube, Wrench, Computer, BriefcaseBusiness, CheckCheck, BadgeCheck, Handshake, ListChecks } from "lucide-react";
import { Image } from 'astro:assets';
import legacyCollage from "@/assets/legacy_collage_nw_ddd335e4.png";
---

<BaseLayout title="In the Room with Legacy Advisors - In the Room With Legacy" description="In the Room with Legacy Advisors (IRL Advisors) is an advisory and innovation arm of In the Room with Legacy™. We provide the strategies, tools, and networks that families, businesses, and institutions need to sustain legacy across generations.">
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-[#f3f4f6] relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 z-0">
      <Image 
        src={legacyCollage} 
        alt="Legacy collage background" 
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[#f3f4f6]/40 mix-blend-overlay"></div>
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-display tracking-tight text-[#052d3f] leading-tight mb-8">
          <div class="flex flex-col text-center">
            <div class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">Advisory. Innovation. Connection.</div>
            <div class="text-xl md:text-2xl lg:text-3xl font-medium">For Families & Institutions Building Legacy.</div>
          </div>
        </h1>
        <!-- Removed buttons - moved to dedicated intro section -->
      </div>
    </div>
  </section>

  <!-- Dedicated Introductory Section -->
  <section class="py-16 md:py-20 bg-[#F7F7F7] border-t border-b border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xl md:text-2xl text-[#052d3f]/90 leading-relaxed mb-10 font-medium">
          In the Room with Legacy Advisors (IRL Advisors) is an advisory and innovation arm of In the Room with Legacy™. We provide the strategies, tools, and networks that families, businesses, and institutions need to sustain legacy across generations.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#contact" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium text-base px-8 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
            })}
          >
            Work With Us
          </a>
          <a 
            href="#tools" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "font-medium text-base px-8 border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/10 shadow-sm"
            })}
          >
            Explore Our Tools & Network
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Are Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          Who We Are
        </h2>
        <p class="text-lg text-[#052d3f]/80 mb-12">
          In the Room with Legacy Advisors is where family enterprise expertise meets innovation. While In the Room with Legacy™ centers cultural storytelling and community, In the Room with Legacy Advisors delivers the advisory services, strategic counsel, and professional networks that transform vision into action.
        </p>
        
        <h3 class="text-xl font-display font-semibold mb-8 text-[#052d3f]">We Exist to Help</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Client Type 1 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <Users class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Enterprising families</h4>
          </div>
          
          <!-- Client Type 2 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <Building class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Family businesses & offices</h4>
          </div>
          
          <!-- Client Type 3 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <University class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Institutions & organizations</h4>
          </div>
          
          <!-- Client Type 4 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <BriefcaseBusiness class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Advisors & professionals</h4>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- What We Do Section -->
  <section id="tools" class="py-16 md:py-24 bg-blue-50/50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          What We Do
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <!-- Service 1: Advisory Services -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Target class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Advisory Services</h3>
          <ul class="space-y-4 text-[#052d3f]/80 flex-grow">
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Family business strategy & governance</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Succession and transition design</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Wealth stewardship frameworks</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Multi-generational engagement</span>
            </li>
          </ul>
        </div>
        
        <!-- Service 2: Signature Tools & Products -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <TestTube class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Signature Tools & Products</h3>
          <ul class="space-y-4 text-[#052d3f]/80 flex-grow">
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>In the Room with Legacy Assessment Tool – AI-powered, culturally rooted legacy assessment for families & advisors</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Data dashboards & insights for family wealth and impact</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Custom retreats, labs, and workshops</span>
            </li>
          </ul>
        </div>
        
        <!-- Service 3: Professional Network -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Network class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Professional Network</h3>
          <div class="text-[#052d3f]/80 flex-grow">
            <div class="mb-4 text-center font-medium text-[#052d3f]">
              Black Family Business Network (BFBN)
            </div>
            <p class="mb-4 text-[#052d3f]/80">
              A first-of-its-kind hub connecting Black family business leaders, heirs, and professionals. Through curated convenings, resources, and peer-to-peer exchange, BFBN builds community while advancing the role of Black families in global enterprise and wealth creation.
            </p>
          </div>
          <a 
            href="/programs/black-family-business-network" 
            class={buttonVariants({
              variant: "outline",
              size: "default",
              class: "mt-4 w-full justify-center border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/10"
            })}
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Why IRL Advisors Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-6 text-center">
          Why IRL Advisors
        </h2>
        <p class="text-lg text-[#052d3f]/80 mb-12 text-center font-medium">
          Legacy thrives when families have structure, strategy, and support.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Differentiator 1 -->
          <div class="flex items-start bg-white p-6 rounded-lg hover:shadow-md transition-all">
            <BadgeCheck className="h-7 w-7 text-[#9a4a0b] mr-4 mt-1 flex-shrink-0" />
            <div>
              <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">Decades of expertise in both public and private sectors</h3>
              <p class="text-[#052d3f]/80">Bringing diverse perspectives from family offices, foundations, global corporations, and beyond.</p>
            </div>
          </div>
          
          <!-- Differentiator 2 -->
          <div class="flex items-start bg-white p-6 rounded-lg hover:shadow-md transition-all">
            <BadgeCheck className="h-7 w-7 text-[#9a4a0b] mr-4 mt-1 flex-shrink-0" />
            <div>
              <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">Deep cultural insight rooted in lived legacy stewardship</h3>
              <p class="text-[#052d3f]/80">Understanding the nuances of legacy from professional expertise and personal experience.</p>
            </div>
          </div>
          
          <!-- Differentiator 3 -->
          <div class="flex items-start bg-white p-6 rounded-lg hover:shadow-md transition-all">
            <BadgeCheck className="h-7 w-7 text-[#9a4a0b] mr-4 mt-1 flex-shrink-0" />
            <div>
              <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">A dual lens: people-centered storytelling + data-driven strategy</h3>
              <p class="text-[#052d3f]/80">Balancing the human elements of legacy with rigorous strategic frameworks.</p>
            </div>
          </div>
          
          <!-- Differentiator 4 -->
          <div class="flex items-start bg-white p-6 rounded-lg hover:shadow-md transition-all">
            <BadgeCheck className="h-7 w-7 text-[#9a4a0b] mr-4 mt-1 flex-shrink-0" />
            <div>
              <h3 class="font-display font-semibold text-[#052d3f] text-lg mb-2">An ecosystem that unites advisory, technology, and networks</h3>
              <p class="text-[#052d3f]/80">Creating a comprehensive approach to legacy building across multiple dimensions.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Final CTA Section -->
  <section id="contact" class="py-16 md:py-24 bg-[#f3f4f6]">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-6">
          Build with strategy. Connect with peers. Lead with legacy.
        </h2>
        <p class="text-lg md:text-xl text-[#052d3f]/80 mb-10 max-w-2xl mx-auto">
          Whether you're a family preparing for succession, a Black family business leader seeking community, or an institution designing legacy programs — In the Room with Legacy Advisors is your partner.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#contact-form" 
            class={buttonVariants({
              size: "lg",
              variant: "default",
              class: "font-medium text-base px-8 py-6 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
            })}
          >
            Schedule a Consultation
          </a>
          <a 
            id="bfbn"
            href="/programs/black-family-business-network" 
            class={buttonVariants({
              size: "lg",
              variant: "outline",
              class: "font-medium text-base px-8 py-6 border-[#052d3f] bg-transparent text-[#052d3f] hover:bg-[#052d3f]/10 shadow-sm"
            })}
          >
            Sign Up
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Contact Form Section -->
  <section id="contact-form" class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-display font-bold tracking-tight text-[#052d3f] mb-10 text-center">
          Get Started
        </h2>
        <div class="bg-blue-50/50 p-8 rounded-lg shadow-md">
          <form class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="block text-sm font-medium text-[#052d3f]">Full Name</label>
                <input type="text" id="name" name="name" class="w-full px-4 py-3 rounded-md border border-[#052d3f]/20 focus:outline-none focus:ring-2 focus:ring-[#052d3f]/40 focus:border-[#052d3f]" />
              </div>
              <div class="space-y-2">
                <label for="email" class="block text-sm font-medium text-[#052d3f]">Email Address</label>
                <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-md border border-[#052d3f]/20 focus:outline-none focus:ring-2 focus:ring-[#052d3f]/40 focus:border-[#052d3f]" />
              </div>
              <div class="space-y-2">
                <label for="organization" class="block text-sm font-medium text-[#052d3f]">Organization/Company</label>
                <input type="text" id="organization" name="organization" class="w-full px-4 py-3 rounded-md border border-[#052d3f]/20 focus:outline-none focus:ring-2 focus:ring-[#052d3f]/40 focus:border-[#052d3f]" />
              </div>
              <div class="space-y-2">
                <label for="interest" class="block text-sm font-medium text-[#052d3f]">Primary Interest</label>
                <select id="interest" name="interest" class="w-full px-4 py-3 rounded-md border border-[#052d3f]/20 focus:outline-none focus:ring-2 focus:ring-[#052d3f]/40 focus:border-[#052d3f]">
                  <option value="">Please select...</option>
                  <option value="advisory">Advisory Services</option>
                  <option value="tools">Legacy Assessment Tools</option>
                  <option value="bfbn">Black Family Business Network</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="space-y-2">
              <label for="message" class="block text-sm font-medium text-[#052d3f]">How can we help?</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 rounded-md border border-[#052d3f]/20 focus:outline-none focus:ring-2 focus:ring-[#052d3f]/40 focus:border-[#052d3f]"></textarea>
            </div>
            <input type="hidden" name="form_name" value="In the Room with Legacy Advisors Contact" />
            <button 
              type="submit" 
              class={buttonVariants({
                size: "lg",
                class: "w-full justify-center font-medium bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
              })}
            >
              Submit Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>