---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Target, Building, Briefcase, ExternalLink, ArrowRight, CircleCheck, Users, University, Network, TestTube, Wrench, Computer, BriefcaseBusiness, CheckCheck, BadgeCheck, Handshake, ListChecks, Star, CheckCircle } from "lucide-react";
import { Image } from 'astro:assets';
import heroImage from "@/assets/advisory-innovation-connection_nw_950e6454.png";
import { TimeTriggeredModal } from "@/components/TimeTriggeredModal";
import { ScrollStickyCTA } from '@/components/ScrollStickyCTA';
---

<BaseLayout title="In the Room with Legacy Advisors - In the Room With Legacy" description="In the Room with Legacy Advisors (IRL Advisors) is an advisory and innovation arm of In the Room with Legacy™. We provide the strategies, tools, and networks that families, businesses, and institutions need to sustain legacy across generations.">
  <!-- Hero Section -->
  <section class="py-24 md:py-32 bg-[#f3f4f6] relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 z-0">
      <Image 
        src={heroImage} 
        alt="Advisory, Innovation, and Connection concept image" 
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-[#f3f4f6]/40 mix-blend-overlay"></div>
    </div>
    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-display tracking-tight text-[#052d3f] leading-tight mb-8">
          <div class="flex flex-col text-center">
            <div class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">For Advisors & Practitioners</div>
          </div>
        </h1>
        <!-- Removed buttons - moved to dedicated intro section -->
      </div>
    </div>
  </section>

  <!-- Dedicated Introductory Section -->
  <section class="py-16 md:py-20 bg-[#F7F7F7] border-t border-b border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xl md:text-2xl text-[#052d3f]/90 leading-relaxed mb-6 font-medium">
          Equip your clients and communities with culturally rooted, emotionally intelligent legacy tools that deepen connection, clarify stewardship, and strengthen multigenerational outcomes.
        </p>
        
        <p class="text-lg text-[#052d3f]/90 leading-relaxed mb-6">
          IRL partners with advisors, planners, wealth professionals, family enterprise consultants, attorneys, coaches, nonprofit leaders, and institutions who support families in building, protecting, and transferring legacy.
        </p>
        
        <p class="text-lg text-[#052d3f]/90 leading-relaxed mb-10">
          Our work blends culture, emotional clarity, identity, readiness, and governance — the pieces traditional planning often misses.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="#contact" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium text-base px-8 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 shadow-md"
            })}
          >
            Work With Us
          </a>
          <a 
            href="#tools" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "font-medium text-base px-8 border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/10 shadow-sm"
            })}
          >
            Explore Our Tools & Network
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Are Section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          Who We Are
        </h2>
        <p class="text-lg text-[#052d3f]/80 mb-12">
          In the Room with Legacy Advisors is where family enterprise expertise meets innovation. While In the Room with Legacy™ centers cultural storytelling and community, In the Room with Legacy Advisors delivers the advisory services, strategic counsel, and professional networks that transform vision into action.
        </p>
        
        <h3 class="text-xl font-display font-semibold mb-8 text-[#052d3f]">We Exist to Help</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Client Type 1 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <Users class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Enterprising families</h4>
          </div>
          
          <!-- Client Type 2 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <Building class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Family businesses & offices</h4>
          </div>
          
          <!-- Client Type 3 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <University class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Institutions & organizations</h4>
          </div>
          
          <!-- Client Type 4 -->
          <div class="bg-white p-6 rounded-lg border border-[#052d3f]/10 text-center flex flex-col items-center hover:shadow-md transition-all group">
            <div class="w-16 h-16 mb-4 rounded-full bg-[#052d3f]/10 flex items-center justify-center group-hover:bg-[#052d3f]/20 transition-colors">
              <BriefcaseBusiness class="text-[#052d3f] h-8 w-8" />
            </div>
            <h4 class="font-display font-semibold text-[#052d3f] text-lg">Advisors & professionals</h4>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Tools & Frameworks Section -->
  <section class="py-16 md:py-24 bg-[#f8f7f2]">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-6">
          Tools & Frameworks That Deepen Your Impact
        </h2>
        <p class="text-lg text-[#052d3f]/80 mb-10">
          IRL equips advisors with a new set of tools for guiding families through legacy-building in its fullest form.
        </p>
        
        <p class="text-lg text-[#052d3f]/80 mb-10">
          With access to the IRL Legacy Operating System (beta) and our advisory frameworks, you can help clients:
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left max-w-2xl mx-auto mb-8">
          <div class="flex items-start">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>navigate emotional and relational dynamics</p>
          </div>
          
          <div class="flex items-start">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>strengthen intergenerational communication</p>
          </div>
          
          <div class="flex items-start">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>prepare successors and next-gen leaders</p>
          </div>
          
          <div class="flex items-start">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>map cultural and identity-based strengths</p>
          </div>
          
          <div class="flex items-start">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>support transitions, caregiving, and aging</p>
          </div>
          
          <div class="flex items-start">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>build family governance foundations</p>
          </div>
          
          <div class="flex items-start md:col-span-2 justify-center">
            <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
            <p>facilitate legacy conversations with confidence</p>
          </div>
        </div>
        
        <p class="text-lg text-[#052d3f]/80 font-medium">
          Our tools help you bring the human side of legacy into your practice.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Advisor Partnership Pathways Section -->
  <section class="py-16 md:py-24 bg-white border-t border-[#052d3f]/10">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-6">
          Advisor Partnership Pathways
        </h2>
        <p class="text-lg text-[#052d3f]/80 mb-12 font-medium">
          Choose the pathway that fits your practice or institution.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
          <!-- Pathway 1: Legacy OS Licensing -->
          <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col">
            <div class="inline-flex items-center mb-4">
              <span class="w-8 h-8 rounded-full bg-[#052d3f] text-white text-xl font-bold flex items-center justify-center mr-3">1</span>
              <h3 class="text-xl font-display font-semibold text-[#052d3f]">Legacy OS Licensing (Beta)</h3>
            </div>
            
            <p class="text-[#052d3f]/80 mb-4">
              Gain early access to our culturally rooted, AI-powered Legacy Operating System (beta) — designed to help families document, preserve, and transfer legacy across generations.
            </p>
            
            <p class="text-[#052d3f]/80 font-medium mb-3">Use it to support clients in:</p>
            
            <ul class="space-y-2 mb-6 text-[#052d3f]/80">
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>emotional estate mapping</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>cultural & identity documentation</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>heir readiness pathways</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>transitions and caregiving preparation</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>succession communication</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>multigenerational alignment</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>family narrative archiving</span>
              </li>
            </ul>
            
            <p class="text-[#052d3f]/80 text-sm mt-auto">
              This is ideal for advisors, planners, consultants, and institutions seeking a structured, holistic, tech-enabled approach.
            </p>
          </div>
          
          <!-- Pathway 2: IRL Framework Integration -->
          <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col">
            <div class="inline-flex items-center mb-4">
              <span class="w-8 h-8 rounded-full bg-[#052d3f] text-white text-xl font-bold flex items-center justify-center mr-3">2</span>
              <h3 class="text-xl font-display font-semibold text-[#052d3f]">IRL Framework Integration</h3>
            </div>
            
            <p class="text-[#052d3f]/80 mb-4">
              Integrate IRL's signature frameworks into your advisory practice.
            </p>
            
            <p class="text-[#052d3f]/80 font-medium mb-3">Available frameworks include:</p>
            
            <ul class="space-y-2 mb-6 text-[#052d3f]/80">
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Family Legacy Mapping</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Cultural & Identity Inventory</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Emotional Estate Assessments</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Successor Readiness Pathways</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Multigenerational Governance Foundations</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Rituals, Story & Tradition Documentation</span>
              </li>
            </ul>
            
            <p class="text-[#052d3f]/80 text-sm mt-auto">
              These frameworks give you structure, language, and facilitation tools to guide complex family conversations with clarity and cultural depth.
            </p>
          </div>
          
          <!-- Pathway 3: Program Partnerships -->
          <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col">
            <div class="inline-flex items-center mb-4">
              <span class="w-8 h-8 rounded-full bg-[#052d3f] text-white text-xl font-bold flex items-center justify-center mr-3">3</span>
              <h3 class="text-xl font-display font-semibold text-[#052d3f]">Program Partnerships</h3>
            </div>
            
            <p class="text-[#052d3f]/80 mb-4">
              Bring IRL-led or co-facilitated programming into your organization, firm, school, or community.
            </p>
            
            <p class="text-[#052d3f]/80 font-medium mb-3">Programs include:</p>
            
            <ul class="space-y-2 mb-6 text-[#052d3f]/80">
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>While We're Still Here™ (guided legacy conversations)</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Family governance workshops</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Next-gen stewardship programs</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Multigenerational retreats</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Successor development intensives</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Community-based legacy experiences</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>Cohort and multi-family experiences</span>
              </li>
            </ul>
            
            <p class="text-[#052d3f]/80 text-sm mt-auto">
              These partnerships allow your organization to offer deeper, culturally-informed legacy programming.
            </p>
          </div>
          
          <!-- Pathway 4: Strategic Alliances -->
          <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-md transition-all h-full flex flex-col">
            <div class="inline-flex items-center mb-4">
              <span class="w-8 h-8 rounded-full bg-[#052d3f] text-white text-xl font-bold flex items-center justify-center mr-3">4</span>
              <h3 class="text-xl font-display font-semibold text-[#052d3f]">Strategic Alliances</h3>
            </div>
            
            <p class="text-[#052d3f]/80 mb-4">
              For high-impact organizations seeking deeper, long-term collaboration.
            </p>
            
            <p class="text-[#052d3f]/80 font-medium mb-3">Strategic alliances may include:</p>
            
            <ul class="space-y-2 mb-6 text-[#052d3f]/80">
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>enterprise licensing of the Legacy OS (beta)</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>advisory partnerships with family offices</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>municipal or statewide legacy initiatives</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>data + research collaborations</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>legacy planning programs for institutions</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>community or philanthropic legacy initiatives</span>
              </li>
              <li class="flex items-start">
                <ArrowRight className="h-4 w-4 text-[#9a4a0b] mr-2 mt-1 flex-shrink-0" />
                <span>culturally rooted intergenerational wealth strategies</span>
              </li>
            </ul>
            
            <p class="text-[#052d3f]/80 text-sm mt-auto">
              These multi-year partnerships expand legacy access, elevate family governance, and create lasting community impact.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- What We Do Section -->
  <section id="tools" class="py-16 md:py-24 bg-blue-50/50">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-display font-bold tracking-tight text-[#052d3f] mb-8">
          What We Do
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <!-- Service 1: Advisory Services -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Target class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Advisory Services</h3>
          <ul class="space-y-4 text-[#052d3f]/80 flex-grow">
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Family business strategy & governance</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Succession and transition design</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Wealth stewardship frameworks</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Multi-generational engagement</span>
            </li>
          </ul>
        </div>
        
        <!-- Service 2: Signature Tools & Products -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <TestTube class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Signature Tools & Products</h3>
          <ul class="space-y-4 text-[#052d3f]/80 flex-grow">
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>In the Room with Legacy Assessment Tool – AI-powered, culturally rooted legacy assessment for families & advisors</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Data dashboards & insights for family wealth and impact</span>
            </li>
            <li class="flex items-start">
              <ArrowRight className="h-5 w-5 text-[#9a4a0b] mr-3 mt-1 flex-shrink-0" />
              <span>Custom retreats, labs, and workshops</span>
            </li>
          </ul>
        </div>
        
        <!-- Service 3: Professional Network -->
        <div class="bg-white p-8 rounded-lg border border-[#052d3f]/10 shadow-sm hover:shadow-lg transition-all h-full flex flex-col">
          <div class="w-16 h-16 mb-6 rounded-full bg-[#052d3f]/10 flex items-center justify-center mx-auto">
            <Network class="text-[#052d3f] h-8 w-8" />
          </div>
          <h3 class="text-xl font-display font-semibold mb-4 text-[#052d3f] text-center">Professional Network</h3>
          <div class="text-[#052d3f]/80 flex-grow">
            <div class="mb-4 text-center font-medium text-[#052d3f]">
              Black Family Business Network (BFBN)
            </div>
            <p class="mb-4 text-[#052d3f]/80">
              A first-of-its-kind hub connecting Black family business leaders, heirs, and professionals. Through curated convenings, resources, and peer-to-peer exchange, BFBN builds community while advancing the role of Black families in global enterprise and wealth creation.
            </p>
          </div>
          <a 
            href="/programs/black-family-business-network" 
            class={buttonVariants({
              variant: "outline",
              size: "default",
              class: "mt-4 w-full justify-center border-[#052d3f] text-[#052d3f] hover:bg-[#052d3f]/10"
            })}
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>
  
