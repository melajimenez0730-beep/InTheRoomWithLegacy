---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from '@/components/ContactForm';
import HeroSection from '@/components/HeroSection.astro';
import MarqueeBanner from '@/components/MarqueeBanner.astro';
import DimensionsSection from '@/components/DimensionsSection.astro';
import FounderSection from '@/components/FounderSection.astro';
import LeadMagnetSection from '@/components/LeadMagnetSection.astro';
import ResourcesSection from '@/components/ResourcesSection.astro';
---

<BaseLayout
  title="In the Room With Legacy | Making Legacy, Not just an Inheritance"
  description="We help families thrive across generations with tools, guided conversations, and cultural touchstones that keep legacy alive while we're still here."
>
  <HeroSection />
  <MarqueeBanner text="Ethical Nepotism (n.): Legacy with accountability. The practice of preparing heirs with intention, discipline, and education—not entitlement. Privilege made purposeful, inheritance made responsible." speed={35} />
  <DimensionsSection />
  <ResourcesSection />
  <FounderSection />
  
  <section class="py-24 container max-w-3xl">
    <!-- KEEP ALL FORMS client:load !! DO NOT USE client:visible AS THIS CAUSES HYDRATION ISSUES!!-->
    <ContactForm client:load />
  </section>
</BaseLayout>
