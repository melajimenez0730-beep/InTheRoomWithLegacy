---
import { buttonVariants } from "@/components/ui/button";
import Navigation from "@/components/Navigation";
import MobileNav from "@/components/MobileNav";
---

<header
  class="bg-[#052d3f] sticky top-0 z-50 w-full border-b border-[#052d3f]/20"
>
  <div
    class="container flex h-20 items-center space-x-4 sm:justify-between sm:space-x-0"
  >
    <div class="flex gap-6 md:gap-10">
      <a href="/" class="flex items-center space-x-2">
        <span class="hidden md:inline-block font-display text-xl font-bold tracking-tight text-[#f7f6dc]">In the Room With Legacy</span>
        <span class="md:hidden inline-block font-display text-base font-bold tracking-tight text-[#f7f6dc]">IRL</span>
      </a>
    </div>
    <div class="flex flex-1 items-center justify-end space-x-4">
      <div class="hidden md:flex">
        <Navigation client:load />
      </div>
      <!-- Desktop-only CTA buttons - explicitly hidden on all mobile screen sizes -->
      <div class="hidden md:block">
        <a
          href="/tools/legacy-assessment"
          class={buttonVariants({
            variant: "default",
            size: "sm",
            class: "bg-[#f7f6dc] text-[#052d3f] hover:bg-[#f7f6dc]/90"
          })}
        >
          Take the Legacy Assessment
        </a>
      </div>
      <div class="hidden md:block">
        <a
          href="#join-the-room"
          class={buttonVariants({
            variant: "secondary",
            size: "sm",
            class: "bg-[#9a4a0b] text-[#f7f6dc] hover:bg-[#9a4a0b]/80 border-none"
          })}
        >
          Join the Room
        </a>
      </div>
      <button 
        class="md:hidden flex items-center p-2 text-[#f7f6dc]"
        aria-label="Toggle menu"
        data-toggle-menu
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation -->
<div id="mobile-nav-container"></div>
<MobileNav client:load isOpen={false} onClose={() => {}} />

<script>
  // Mobile menu functionality
  let isMenuOpen = false;
  const menuButton = document.querySelector('[data-toggle-menu]');
  const mobileNavContainer = document.getElementById('mobile-nav-container');
  
  // Custom event to communicate with React component
  const toggleMobileNav = (isOpen) => {
    const event = new CustomEvent('toggleMobileNav', { detail: { isOpen } });
    document.dispatchEvent(event);
    
    // Update body scroll
    document.body.style.overflow = isOpen ? 'hidden' : '';
    isMenuOpen = isOpen;
  };
  
  if (menuButton) {
    menuButton.addEventListener('click', () => {
      toggleMobileNav(!isMenuOpen);
    });
  }
  
  // Close mobile menu on ESC key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMobileNav(false);
    }
  });
</script>
