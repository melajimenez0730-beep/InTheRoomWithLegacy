---
import { buttonVariants } from "@/components/ui/button";
import Navigation from "@/components/Navigation";
import MobileNav from "@/components/MobileNav";
import { Image } from 'astro:assets';
import logoImage from '../assets/parchment-irl-main-badge-rgb-1_nw_936bfa90.png';
---

<header
  class="bg-[#052d3f] sticky top-0 z-50 w-full border-b border-[#052d3f]/20"
>
  <div
    class="container flex h-16 items-center"
  >
    <div class="flex gap-4 md:gap-8 flex-shrink-0 mr-8">
      <a href="/" class="flex items-center gap-1 md:gap-3">
        <!-- Logo for both desktop and mobile -->
        <Image 
          src={logoImage} 
          alt="In the Room With Legacy" 
          width={48} 
          height={48} 
          class="w-8 h-8 md:w-10 md:h-10"
        />
        <!-- Desktop view: Show brand name next to logo -->
        <span class="hidden md:inline-block font-display text-sm font-medium tracking-tight whitespace-nowrap text-[#f7f6dc] ml-2">In the Room with Legacy</span>
        <!-- Mobile view: only show on very small screens -->
        <span class="md:hidden inline-block font-display text-xs font-medium tracking-tight whitespace-nowrap text-[#f7f6dc]">In the Room with Legacy</span>
      </a>
    </div>
    <div class="flex flex-1 items-center justify-end space-x-4 ml-auto">
      <div class="hidden md:flex">
        <Navigation client:load />
      </div>
      <!-- Desktop-only CTA buttons - explicitly hidden on all mobile screen sizes -->
      <div class="hidden md:block">
        <a
          href="/tools/legacy-assessment"
          class={buttonVariants({
            variant: "outline",
            size: "sm",
            class: "bg-[#f7f6dc] text-[#052d3f] font-medium border-2 border-[#052d3f] hover:bg-[#052d3f] hover:text-white transition-colors duration-300"
          })}
        >
          Take the Legacy Assessment
        </a>
      </div>
      <!-- Donate button temporarily removed -->
      <div class="hidden">
        <a
          href="/join-the-room"
          class={buttonVariants({
            variant: "secondary",
            size: "sm",
            class: "bg-[#9a4a0b] text-[#f7f6dc] hover:bg-[#9a4a0b]/80 border-none"
          })}
        >
          Donate Now
        </a>
      </div>
      <button 
        class="md:hidden flex items-center p-2 text-[#f7f6dc]"
        aria-label="Toggle menu"
        data-toggle-menu
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="6" y2="6"/>
          <line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation -->
<div id="mobile-nav-container"></div>
<MobileNav client:load isOpen={false} onClose={() => {}} />

<script>
  // Mobile menu functionality
  let isMenuOpen = false;
  const menuButton = document.querySelector('[data-toggle-menu]');
  const mobileNavContainer = document.getElementById('mobile-nav-container');
  
  // Custom event to communicate with React component
  const toggleMobileNav = (isOpen) => {
    const event = new CustomEvent('toggleMobileNav', { detail: { isOpen } });
    document.dispatchEvent(event);
    
    // Update body scroll
    document.body.style.overflow = isOpen ? 'hidden' : '';
    isMenuOpen = isOpen;
  };
  
  if (menuButton) {
    menuButton.addEventListener('click', () => {
      toggleMobileNav(!isMenuOpen);
    });
  }
  
  // Close mobile menu on ESC key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      toggleMobileNav(false);
    }
  });
</script>
