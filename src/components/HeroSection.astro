---
import { buttonVariants } from "@/components/ui/button";
import { Image } from 'astro:assets';
import heroBackgroundImage from "@/assets/programs/family-legacy_nw_7f4ee194.jpg";
---

<!-- Part 1: Full-Screen Photo Hero Section -->
<section class="relative w-full h-[85vh] min-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={heroBackgroundImage}
      alt="Family legacy photo" 
      class="w-full h-full object-cover"
      widths={[400, 800, 1200, 1600, 2000]}
      sizes="100vw"
    />
    <!-- Light Overlay for Text Readability -->
    <div class="absolute inset-0 bg-white/30"></div>
  </div>

  <!-- Hero Content -->
  <div class="container relative z-10 mx-auto px-4 sm:px-6 md:px-8 text-center sm:text-left">
    <div class="max-w-3xl mx-auto sm:mx-0 sm:max-w-2xl">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold tracking-tight leading-tight mb-6">
        <span class="text-[#052d3f]">Making Legacy a Lifestyle,</span> <span class="block sm:inline text-[#9a4a0b]">Not just an Inheritance.</span>
      </h1>
      <p class="text-xl sm:text-2xl md:text-3xl text-gray-800 font-medium leading-snug max-w-xl">
        We help families thrive across generations with tools, guided frameworks, and culturally rooted practices that keep legacy alive while we're still here.
      </p>
    </div>
  </div>
</section>

<!-- Part 2: Separate CTA Section -->
<section class="bg-white py-10 sm:py-14 md:py-16">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg sm:text-xl text-foreground/80 mb-6">
        Begin with your Legacy Snapshot—a quick 3–5 minute assessment that reveals where you are on your legacy journey.
      </p>
      <a 
        href="/tools/legacy-assessment" 
        class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 h-12 rounded-md px-10 py-3 bg-[#052d3f] text-white hover:bg-[#052d3f]/90"
      >
        Take the Legacy Snapshot
      </a>
    </div>
  </div>
</section>