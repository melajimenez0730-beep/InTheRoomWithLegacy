---
import { buttonVariants } from "@/components/ui/button";
import { Image } from 'astro:assets';
import heroImage from "@/assets/hero-image_nw_8dd7e556.jpg";
---

<section class="relative overflow-hidden py-16 sm:py-20 md:py-32 bg-background">
  <!-- Decorative pattern -->
  <div class="absolute inset-0 z-0 opacity-5">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
  </div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div class="flex flex-col space-y-6 md:space-y-8">
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-4">
            Making Legacy a Lifestyle, <span class="text-secondary block sm:inline">Not just an Inheritance.</span>
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-foreground/80 max-w-lg">
            We help families thrive across generations with tools, guided conversations, and cultural touchstones that keep legacy alive while we're still here.
          </p>
        </div>
        
        <div class="flex flex-col gap-4 w-full">
          <a 
            href="/tools/legacy-assessment" 
            class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 h-10 rounded-md px-8 bg-[#052d3f] text-white hover:bg-[#052d3f]/90 w-full sm:w-auto justify-center"
          >
            Take the Legacy Assessment
          </a>
          <a 
            href="#join-the-room" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium w-full sm:w-auto justify-center"
            })}
          >
            Join the Room
          </a>
        </div>
      </div>
      
      <div class="relative rounded-lg overflow-hidden shadow-2xl mt-6 md:mt-0">
        <Image 
          src={heroImage}
          alt="Family legacy photo" 
          class="w-full h-auto object-cover aspect-[4/3]"
        />
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/50 to-transparent mix-blend-multiply"></div>
      </div>
    </div>
  </div>
</section>