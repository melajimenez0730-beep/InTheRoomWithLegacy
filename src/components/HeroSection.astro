---
import { buttonVariants } from "@/components/ui/button";
---

<section class="relative overflow-hidden py-24 md:py-32 bg-background">
  <!-- Decorative pattern -->
  <div class="absolute inset-0 z-0 opacity-5">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml;base64,'); background-size: 60px 60px;"></div>
  </div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col space-y-8">
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight text-primary leading-tight mb-4">
            Making Legacy a Lifestyle, <br/><span class="text-secondary">Not just an Inheritance.</span>
          </h1>
          <p class="text-lg md:text-xl text-foreground/80 max-w-lg">
            We help families thrive across generations with tools, guided conversations, and cultural touchstones that keep legacy alive while we're still here.
          </p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href="/tools/legacy-assessment" 
            class={buttonVariants({
              size: "lg",
              class: "font-medium"
            })}
          >
            Take the Legacy Assessment
          </a>
          <a 
            href="#join-the-room" 
            class={buttonVariants({
              variant: "outline",
              size: "lg",
              class: "border-primary text-primary hover:bg-primary/10 font-medium"
            })}
          >
            Join the Room
          </a>
        </div>
      </div>
      
      <div class="relative rounded-lg overflow-hidden shadow-2xl">
        <img 
          src="https://images.unsplash.com/photo-1528569937393-ee892b976859?w=1200&h=600&auto=format&fit=crop&q=80"
          alt="Family legacy photo album" 
          class="w-full h-auto object-cover aspect-[4/3]"
        />
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/50 to-transparent mix-blend-multiply"></div>
      </div>
    </div>
  </div>
</section>