---
import { buttonVariants } from "@/components/ui/button";
import { BookOpen, Building, Users, Heart, Sparkles, Briefcase } from "lucide-react";
---

<section class="py-16 sm:py-20 md:py-24 bg-white">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 px-4">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold mb-4 text-primary">
        Who This is For
      </h2>
      <p class="text-base sm:text-lg text-foreground/80">
        Whether you're a founder building something sacred, an inheritor navigating stewardship, a family creating alignment, cousins building collective value — or you're simply being called back to roots — IRL is for you.
      </p>
    </div>

    <!-- Single row layout with horizontal scrolling on smaller screens -->
    <div class="relative -mx-4 px-4 md:mx-0 md:px-0 mb-10">
      <!-- Mobile: swipe-friendly carousel (no scrollbar) -->
      <div class="md:hidden carousel-container overflow-hidden relative px-2" touch-action="pan-y">
        <!-- Improved mobile card carousel with swipe functionality -->
        <div id="resourceCarousel" class="flex transition-transform duration-300 ease-in-out pb-6 w-full">
          <!-- Card 1: Founders -->
          <div class="flex-none w-full px-2 sm:px-10 resource-slide">
            <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
              <div class="p-5 flex justify-center">
                <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
                  <Building className="text-secondary/80" size={20} />
                </div>
              </div>
              <div class="px-5 pb-5 flex-1 flex flex-col">
