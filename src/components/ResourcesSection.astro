---
import { buttonVariants } from "@/components/ui/button";
import { BookOpen, Building, Users, Heart, Sparkles, Briefcase } from "lucide-react";
---

<section class="py-16 sm:py-20 md:py-24 bg-muted/5">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 px-4">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-display font-bold mb-4 text-primary">
        Stories & Resources for Every Stage of the Legacy Journey
      </h2>
      <p class="text-base sm:text-lg text-foreground/80">
        Whether you're building new traditions, stewarding something handed down, or creating something together—IRL meets you where you are with stories, guidance, and tools made for your path.
      </p>
    </div>

    <!-- Single row layout with horizontal scrolling on smaller screens -->
    <div class="relative -mx-4 px-4 md:mx-0 md:px-0 mb-10">
      <!-- Mobile: horizontal scrolling cards -->
      <div class="flex md:hidden flex-nowrap overflow-x-auto gap-4 pb-6 snap-x px-2">
        <!-- Card 1: Founders -->
        <div class="snap-center min-w-[250px] w-[250px] bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Building className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5">
            <h3 class="font-display font-semibold text-primary text-center mb-3">Founders</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 h-12">
              First-generation wealth and legacy builders creating a foundation.
            </p>
            <a 
              href="/tools" 
              class="flex justify-center items-center text-primary font-medium text-sm hover:underline"
            >
              Learn More <span class="ml-1">→</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Inheritors & Heirs -->
        <div class="snap-center min-w-[250px] w-[250px] bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group">
