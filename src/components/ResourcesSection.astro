              class="flex justify-center items-center text-primary font-medium text-sm hover:underline mt-auto"
            >
              Learn More <span class="ml-1">→</span>
            </a>
          </div>
        </div>

        <!-- Card 2: Inheritors & Heirs -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Sparkles className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Inheritors & Heirs</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
