---
import { buttonVariants } from "@/components/ui/button";
import { BookOpen, Building, Users, Heart, Sparkles, BookOpenCheck } from "lucide-react";
---

<section class="py-24 bg-muted/50">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-4 text-primary">
        Stories & Resources for Every Stage of the Legacy Journey
      </h2>
      <p class="text-lg text-foreground/80">
        Whether you're building new traditions, stewarding something handed down, or creating something together—IRL meets you where you are with stories, guidance, and tools made for your path.
      </p>
    </div>

    <!-- Horizontally scrollable cards on mobile, grid on desktop -->
    <div class="relative -mx-4 px-4 md:mx-0 md:px-0">
      <div class="flex overflow-x-auto pb-6 md:pb-0 md:grid md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5 snap-x">
        <!-- Card 1: Founders -->
        <div class="snap-center min-w-[280px] sm:min-w-[320px] md:min-w-0 bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
          <div class="bg-primary/10 p-5 flex items-center gap-3">
            <Building className="text-primary" size={20} />
            <h3 class="font-display font-semibold text-primary">Founders</h3>
          </div>
          <div class="p-6">
            <p class="text-foreground/80 mb-4 font-medium">
              Checklist: First-Gen Legacy Builder Steps
            </p>
            <a 
              href="/resources/founders" 
              class={buttonVariants({
                variant: "outline",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>

        <!-- Card 2: Inheritors & Heirs -->
        <div class="snap-center min-w-[280px] sm:min-w-[320px] md:min-w-0 bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
          <div class="bg-secondary/20 p-5 flex items-center gap-3">
            <Sparkles className="text-primary" size={20} />
            <h3 class="font-display font-semibold text-primary">Inheritors & Heirs</h3>
          </div>
          <div class="p-6">
            <p class="text-foreground/80 mb-4 font-medium">
              How to Have 'Heir Readiness' Conversations
            </p>
            <a 
              href="/resources/inheritors" 
              class={buttonVariants({
                variant: "outline",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>

        <!-- Card 3: Families Building Together -->
        <div class="snap-center min-w-[280px] sm:min-w-[320px] md:min-w-0 bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
          <div class="bg-accent/20 p-5 flex items-center gap-3">
            <Users className="text-primary" size={20} />
            <h3 class="font-display font-semibold text-primary">Families Building Together</h3>
          </div>
          <div class="p-6">
            <p class="text-foreground/80 mb-4 font-medium">
              Case Study: A Family Meeting That Changed Everything
            </p>
            <a 
              href="/resources/families" 
              class={buttonVariants({
                variant: "outline",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>

        <!-- Card 4: Collective Builders & Chosen Kin -->
        <div class="snap-center min-w-[280px] sm:min-w-[320px] md:min-w-0 bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
          <div class="bg-primary/10 p-5 flex items-center gap-3">
            <Heart className="text-primary" size={20} />
            <h3 class="font-display font-semibold text-primary">Collective Builders & Chosen Kin</h3>
          </div>
          <div class="p-6">
            <p class="text-foreground/80 mb-4 font-medium">
              Guide: Forming Your Cousin Corps
            </p>
            <a 
              href="/resources/collective-builders" 
              class={buttonVariants({
                variant: "outline",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>

        <!-- Card 5: Curious Seekers -->
        <div class="snap-center min-w-[280px] sm:min-w-[320px] md:min-w-0 bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group">
          <div class="bg-secondary/20 p-5 flex items-center gap-3">
            <BookOpen className="text-primary" size={20} />
            <h3 class="font-display font-semibold text-primary">Curious Seekers</h3>
          </div>
          <div class="p-6">
            <p class="text-foreground/80 mb-4 font-medium">
              Blog: Why Legacy Matters Now
            </p>
            <a 
              href="/blog/why-legacy-matters" 
              class={buttonVariants({
                variant: "outline",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>
      
      <!-- Scroll indicators for mobile -->
      <div class="flex gap-1 justify-center mt-4 md:hidden">
        <span class="w-2 h-2 rounded-full bg-primary/60"></span>
        <span class="w-2 h-2 rounded-full bg-primary/30"></span>
        <span class="w-2 h-2 rounded-full bg-primary/30"></span>
        <span class="w-2 h-2 rounded-full bg-primary/30"></span>
        <span class="w-2 h-2 rounded-full bg-primary/30"></span>
      </div>
    </div>

    <div class="text-center mt-12">
      <a 
        href="#join-the-room" 
        class={buttonVariants({
          size: "lg",
          class: "font-medium"
        })}
      >
        Join the Room
      </a>
    </div>
  </div>
</section>