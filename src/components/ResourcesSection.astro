---
import { buttonVariants } from "@/components/ui/button";
import { BookOpen, Building, Users, Heart, Sparkles, Briefcase } from "lucide-react";
---

<section class="py-24 bg-muted/50">
  <div class="container">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold mb-4 text-primary">
        Stories & Resources for Every Stage of the Legacy Journey
      </h2>
      <p class="text-lg text-foreground/80">
        Whether you're building new traditions, stewarding something handed down, or creating something together—IRL meets you where you are with stories, guidance, and tools made for your path.
      </p>
    </div>

    <!-- Grid Layout - Fixed dimensions for consistent card sizes -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
      <!-- Card 1: Founders -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group h-[240px] flex flex-col">
        <div class="bg-primary/10 p-4 flex items-center gap-3">
          <Building className="text-primary" size={20} />
          <h3 class="font-display font-semibold text-primary">Founders</h3>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <p class="text-foreground/80 mb-4 text-sm font-medium line-clamp-2">
            First-Gen Legacy Builder Steps
          </p>
          <div class="mt-auto">
            <a 
              href="/resources/founders" 
              class={buttonVariants({
                variant: "outline",
                size: "sm",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2: Inheritors & Heirs -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group h-[240px] flex flex-col">
        <div class="bg-secondary/20 p-4 flex items-center gap-3">
          <Sparkles className="text-primary" size={20} />
          <h3 class="font-display font-semibold text-primary">Inheritors & Heirs</h3>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <p class="text-foreground/80 mb-4 text-sm font-medium line-clamp-2">
            'Heir Readiness' Conversations
          </p>
          <div class="mt-auto">
            <a 
              href="/resources/inheritors" 
              class={buttonVariants({
                variant: "outline",
                size: "sm",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>

      <!-- Card 3: Families Building Together -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group h-[240px] flex flex-col">
        <div class="bg-accent/20 p-4 flex items-center gap-3">
          <Users className="text-primary" size={20} />
          <h3 class="font-display font-semibold text-primary">Families Building Together</h3>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <p class="text-foreground/80 mb-4 text-sm font-medium line-clamp-2">
            Family Meetings That Work
          </p>
          <div class="mt-auto">
            <a 
              href="/resources/families" 
              class={buttonVariants({
                variant: "outline",
                size: "sm",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>

      <!-- Card 4: Collective Builders & Chosen Kin -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group h-[240px] flex flex-col">
        <div class="bg-primary/10 p-4 flex items-center gap-3">
          <Heart className="text-primary" size={20} />
          <h3 class="font-display font-semibold text-primary">Collective Builders</h3>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <p class="text-foreground/80 mb-4 text-sm font-medium line-clamp-2">
            Forming Your Cousin Corps
          </p>
          <div class="mt-auto">
            <a 
              href="/resources/collective-builders" 
              class={buttonVariants({
                variant: "outline",
                size: "sm",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>

      <!-- Card 5: Curious Seekers -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group h-[240px] flex flex-col">
        <div class="bg-secondary/20 p-4 flex items-center gap-3">
          <BookOpen className="text-primary" size={20} />
          <h3 class="font-display font-semibold text-primary">Curious Seekers</h3>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <p class="text-foreground/80 mb-4 text-sm font-medium line-clamp-2">
            Why Legacy Matters Now
          </p>
          <div class="mt-auto">
            <a 
              href="/blog/why-legacy-matters" 
              class={buttonVariants({
                variant: "outline",
                size: "sm",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>

      <!-- Card 6: Partners & Institutions -->
      <div class="bg-white rounded-lg shadow-md overflow-hidden border border-border/30 hover:border-primary/30 transition-all hover:shadow-lg group h-[240px] flex flex-col">
        <div class="bg-accent/20 p-4 flex items-center gap-3">
          <Briefcase className="text-primary" size={20} />
          <h3 class="font-display font-semibold text-primary">Partners & Institutions</h3>
        </div>
        <div class="p-4 flex flex-col flex-grow">
          <p class="text-foreground/80 mb-4 text-sm font-medium line-clamp-2">
            Funders, advisors, and aligned organizations
          </p>
          <div class="mt-auto">
            <a 
              href="/resources/partners" 
              class={buttonVariants({
                variant: "outline",
                size: "sm",
                class: "w-full justify-center border-primary text-primary hover:bg-primary/10"
              })}
            >
              Learn More
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-12">
      <a 
        href="#join-the-room" 
        class={buttonVariants({
          size: "lg",
          class: "font-medium"
        })}
      >
        Join the Room
      </a>
    </div>
  </div>
</section>