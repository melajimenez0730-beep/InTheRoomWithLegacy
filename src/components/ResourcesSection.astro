              </div>
              <div class="px-5 pb-5 flex-1 flex flex-col">
                <h3 class="font-display font-semibold text-primary text-center mb-3">Collective Builders</h3>
                <p class="text-foreground/70 text-sm text-center mb-4 flex-grow">
                  Chosen family and kin creating community-based legacy.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 5: Curious Seekers -->
          <div class="flex-none w-full px-2 sm:px-10 resource-slide">
            <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
              <div class="p-5 flex justify-center">
                <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
                  <BookOpen className="text-secondary/80" size={20} />
                </div>
              </div>
              <div class="px-5 pb-5 flex-1 flex flex-col">
                <h3 class="font-display font-semibold text-primary text-center mb-3">Curious Seekers</h3>
                <p class="text-foreground/70 text-sm text-center mb-4 flex-grow">
                  Individuals exploring family history and legacy concepts.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 6: Partners & Institutions -->
          <div class="flex-none w-full px-2 sm:px-10 resource-slide">
            <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
              <div class="p-5 flex justify-center">
                <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
                  <Briefcase className="text-secondary/80" size={20} />
                </div>
              </div>
              <div class="px-5 pb-5 flex-1 flex flex-col">
                <h3 class="font-display font-semibold text-primary text-center mb-3">Partners & Institutions</h3>
                <p class="text-foreground/70 text-sm text-center mb-4 flex-grow">
                  Funders, advisors, and aligned organizations.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Desktop: grid layout -->
      <div class="hidden md:grid grid-cols-3 lg:grid-cols-6 gap-4">
        <!-- Card 1: Founders -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Building className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Founders</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
              First-generation wealth and legacy builders creating a foundation.
            </p>
          </div>
        </div>

        <!-- Card 2: Inheritors & Heirs -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Sparkles className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Inheritors & Heirs</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
              Those preparing to receive or steward family assets and traditions.
            </p>
          </div>
        </div>

        <!-- Card 3: Families Building Together -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Users className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Families Building Together</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
              Multi-generational families creating shared legacy.
            </p>
          </div>
        </div>

        <!-- Card 4: Collective Builders -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Heart className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Collective Builders</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
              Chosen family and kin creating community-based legacy.
            </p>
          </div>
        </div>

        <!-- Card 5: Curious Seekers -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <BookOpen className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Curious Seekers</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
              Individuals exploring family history and legacy concepts.
            </p>
          </div>
        </div>

        <!-- Card 6: Partners & Institutions -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-border/20 hover:border-primary/20 transition-all hover:shadow-md group flex flex-col h-full">
          <div class="p-5 flex justify-center">
            <div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center">
              <Briefcase className="text-secondary/80" size={20} />
            </div>
          </div>
          <div class="px-5 pb-5 flex-1 flex flex-col">
            <h3 class="font-display font-semibold text-primary text-center mb-3 h-14 flex items-center justify-center">Partners & Institutions</h3>
            <p class="text-foreground/70 text-sm text-center mb-4 flex-1">
              Funders, advisors, and aligned organizations.
            </p>
          </div>
        </div>
      </div>
      
      <!-- Interactive pagination indicators for mobile -->
      <div class="flex gap-2 justify-center mt-6 md:hidden" id="carouselIndicators">
        <button aria-label="Go to slide 1" class="w-2.5 h-2.5 rounded-full bg-primary cursor-pointer transition-all duration-300" data-index="0"></button>
        <button aria-label="Go to slide 2" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="1"></button>
        <button aria-label="Go to slide 3" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="2"></button>
        <button aria-label="Go to slide 4" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="3"></button>
        <button aria-label="Go to slide 5" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="4"></button>
        <button aria-label="Go to slide 6" class="w-2.5 h-2.5 rounded-full bg-primary/30 cursor-pointer transition-all duration-300" data-index="5"></button>
      </div>
      
      <script>
        // Wait for DOM to load
        document.addEventListener('DOMContentLoaded', function() {
          // Get necessary elements
          const carousel = document.getElementById('resourceCarousel');
          const indicators = document.getElementById('carouselIndicators');
          const slides = document.querySelectorAll('.resource-slide');
          const indicatorButtons = document.querySelectorAll('#carouselIndicators button');
          
          // Variables to track carousel state
          let currentIndex = 0;
          let startX, moveX;
          let isPointerDown = false;
          const slideWidth = 100; // percentage based on container width
          let autoPlayInterval;
          let isDragging = false;
          let autoPlayDelay = 5000; // 5 seconds between slides
          let userInteracting = false;
          let lastInteractionTime = 0;
          const interactionTimeout = 3000; // Resume auto-play 3 seconds after interaction

          // Add visual feedback classes to carousel
          carousel.classList.add('transition-transform', 'duration-300', 'ease-in-out');
          
          // Function to start auto-play
          function startAutoPlay() {
            clearInterval(autoPlayInterval);
            autoPlayInterval = setInterval(() => {
              // Don't auto-advance during user interaction or shortly after
              if (isDragging || userInteracting) return;
              if (Date.now() - lastInteractionTime < interactionTimeout) return;
              
              let nextIndex = currentIndex + 1;
              if (nextIndex >= slides.length) {
                nextIndex = 0; // Loop back to first slide
              }
              updateCarousel(nextIndex);
            }, autoPlayDelay);
          }
          
          // Function to stop auto-play
          function stopAutoPlay() {
            clearInterval(autoPlayInterval);
            userInteracting = true;
            lastInteractionTime = Date.now();
          }
          
          // Function to handle the end of user interaction
          function handleInteractionEnd() {
            userInteracting = false;
            lastInteractionTime = Date.now();
            // Start auto-play after the interaction timeout
            setTimeout(() => {
              if (!userInteracting) startAutoPlay();
            }, interactionTimeout);
          }
          
          // Function to update carousel position
          function updateCarousel(index) {
            // Ensure index is within bounds
            if (index < 0) index = 0;
            if (index >= slides.length) index = slides.length - 1;
            
            // Update current index
            currentIndex = index;
            
            // Move carousel to show current slide with smooth animation
            carousel.style.transition = 'transform 300ms ease-in-out';
            carousel.style.transform = `translateX(-${currentIndex * slideWidth}%)`;
            
            // Update indicators
            indicatorButtons.forEach((button, i) => {
              if (i === currentIndex) {
                button.classList.remove('bg-primary/30');
                button.classList.add('bg-primary');
                button.setAttribute('aria-current', 'true');
              } else {
                button.classList.remove('bg-primary');
                button.classList.add('bg-primary/30');
                button.removeAttribute('aria-current');
              }
            });

            // Update ARIA attributes for accessibility
            slides.forEach((slide, i) => {
              if (i === currentIndex) {
                slide.setAttribute('aria-hidden', 'false');
              } else {
                slide.setAttribute('aria-hidden', 'true');
              }
            });
          }
          
          // Add click handlers to indicator buttons
          indicatorButtons.forEach((button, index) => {
            button.addEventListener('click', () => {
              updateCarousel(index);
              stopAutoPlay();
              startAutoPlay(); // Restart auto-play after manual interaction
            });
          });
          
          // Enhanced touch/pointer event handlers
          function handlePointerDown(e) {
            isPointerDown = true;
            isDragging = false;
            userInteracting = true;
            
            // Get touch coordinates
            startX = e.clientX || (e.touches && e.touches[0].clientX);
            carousel.style.transition = 'none'; // Remove transition for responsive dragging
            
            stopAutoPlay(); // Pause auto-play during interaction
            
            // Prevent default only for pointer events to avoid scroll interference issues
            if (e.type === 'pointerdown') {
              e.preventDefault();
            }
          }
          
          function handlePointerMove(e) {
            if (!isPointerDown) return;
            
            // Get current touch position
            moveX = e.clientX || (e.touches && e.touches[0].clientX);
            if (!moveX) return;
            
            const diff = moveX - startX;
            if (Math.abs(diff) > 10) {
              isDragging = true;
            }
            
            // Prevent vertical scrolling when swiping horizontally
            if (isDragging && e.cancelable) {
              e.preventDefault();
            }
            
            // Calculate movement with resistance at edges
            const minTranslate = 0;
            const maxTranslate = -(slides.length - 1) * slideWidth;
            let translate = -(currentIndex * slideWidth) + (diff / carousel.offsetWidth * 100);
            
            // Add resistance at boundaries
            if (translate > minTranslate) {
              translate = minTranslate + (translate - minTranslate) * 0.3;
            } else if (translate < maxTranslate) {
              translate = maxTranslate + (translate - maxTranslate) * 0.3;
            }
            
            carousel.style.transform = `translateX(${translate}%)`;
          }
          
          // Enhanced pointer up handling with better snap animation
          function handlePointerUp(e) {
            if (!isPointerDown) return;
            isPointerDown = false;
            
            // Restore transition for smooth snapping
            carousel.style.transition = 'transform 300ms ease-in-out';
            
            // Get final position
            const endX = e.clientX || (e.changedTouches && e.changedTouches[0].clientX) || moveX;
            if (!endX) {
              updateCarousel(currentIndex);
              handleInteractionEnd();
              return;
            }
            
            const diff = endX - startX;
            const threshold = carousel.offsetWidth * 0.15; // 15% of width threshold for swipe - more sensitive
            
            if (diff > threshold) {
              // Swiped right - go to previous
              updateCarousel(currentIndex - 1);
            } else if (diff < -threshold) {
              // Swiped left - go to next
              updateCarousel(currentIndex + 1);
            } else {
              // Not enough movement, snap back
              updateCarousel(currentIndex);
            }
            
            setTimeout(() => {
              isDragging = false;
              handleInteractionEnd(); // Handle the end of interaction properly
            }, 300);
          }
          
          // Add both pointer and touch event listeners for maximum compatibility
          carousel.addEventListener('pointerdown', handlePointerDown, { passive: false });
          carousel.addEventListener('pointermove', handlePointerMove, { passive: false });
          carousel.addEventListener('pointerup', handlePointerUp);
          carousel.addEventListener('pointercancel', handlePointerUp);
          carousel.addEventListener('pointerleave', handlePointerUp);
          
          // Add touch event listeners specifically for mobile
          carousel.addEventListener('touchstart', handlePointerDown, { passive: true });
          carousel.addEventListener('touchmove', handlePointerMove, { passive: false });
          carousel.addEventListener('touchend', handlePointerUp);
          carousel.addEventListener('touchcancel', handlePointerUp);
          
          // Pause auto-play on hover/focus and resume on leave
          const carouselContainer = document.querySelector('.carousel-container');
          carouselContainer.addEventListener('mouseenter', () => {
            stopAutoPlay();
            userInteracting = true;
          });
          carouselContainer.addEventListener('mouseleave', () => {
            userInteracting = false;
            handleInteractionEnd();
          });
          carouselContainer.addEventListener('focusin', stopAutoPlay);
          carouselContainer.addEventListener('focusout', handleInteractionEnd);
          
          // Add keyboard navigation
          carouselContainer.setAttribute('tabindex', '0');
          carouselContainer.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
              updateCarousel(currentIndex - 1);
              stopAutoPlay();
              handleInteractionEnd();
            } else if (e.key === 'ArrowRight') {
              updateCarousel(currentIndex + 1);
              stopAutoPlay();
              handleInteractionEnd();
            }
          });
          
          // Set initial state and start auto-play
          updateCarousel(0);
          startAutoPlay();

          // Add accessibility attributes
          carousel.setAttribute('aria-roledescription', 'carousel');
          carousel.setAttribute('aria-live', 'polite');
          slides.forEach((slide, index) => {
            slide.setAttribute('role', 'group');
            slide.setAttribute('aria-roledescription', 'slide');
            slide.setAttribute('aria-label', `${index + 1} of ${slides.length}`);
          });

          // Add swipe hint for mobile users
          if (window.innerWidth < 768) {
            const swipeHint = document.createElement('div');
            swipeHint.className = 'text-xs text-center text-foreground/60 mt-1';
            swipeHint.textContent = 'Swipe left or right to navigate';
            indicators.parentNode.insertBefore(swipeHint, indicators.nextSibling);
            
            // Remove the hint after user interacts with the carousel
            const removeHint = () => {
              swipeHint.classList.add('opacity-0', 'transition-opacity', 'duration-500');
              setTimeout(() => swipeHint.remove(), 500);
              carousel.removeEventListener('pointerdown', removeHint);
            };
            carousel.addEventListener('pointerdown', removeHint);
            
            // Also auto-remove the hint after 5 seconds
            setTimeout(removeHint, 5000);
          }
        });
      </script>
    </div>

    <div class="text-center">
      <a 
        href="/tools/legacy-assessment" 
        class={buttonVariants({
          size: "lg",
          class: "font-medium w-full sm:w-auto justify-center"
        })}
      >
        Get Started with your Snapshot
      </a>
    </div>
  </div>
</section>