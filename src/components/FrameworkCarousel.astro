---
// Import necessary components and styles
import { ChevronLeft, ChevronRight } from 'lucide-react';
---

<div class="framework-carousel relative max-w-4xl mx-auto px-4 py-6">
  <div class="overflow-hidden">
    <div class="carousel-container flex transition-transform duration-500 ease-in-out">
      <!-- Card 1 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">navigate emotional and relational dynamics</p>
      </div>
      
      <!-- Card 2 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">strengthen intergenerational communication</p>
      </div>
      
      <!-- Card 3 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">prepare successors and next-gen leaders</p>
      </div>
      
      <!-- Card 4 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">map cultural and identity-based strengths</p>
      </div>
      
      <!-- Card 5 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">support transitions, caregiving, and aging</p>
      </div>
      
      <!-- Card 6 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">build family governance foundations</p>
      </div>
      
      <!-- Card 7 -->
      <div class="carousel-card min-w-[280px] md:min-w-[320px] bg-white shadow-md rounded-lg p-6 mx-2 border border-[#052d3f]/10 flex flex-col items-center justify-center h-[180px]">
        <div class="text-[#9a4a0b] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </div>
        <p class="text-center text-[#052d3f] font-medium">facilitate legacy conversations with confidence</p>
      </div>
    </div>
  </div>
  
  <!-- Navigation Arrows -->
  <button class="carousel-prev absolute left-0 top-1/2 transform -translate-y-1/2 bg-white/90 text-[#052d3f] rounded-full p-2 shadow-md border border-[#052d3f]/20 hover:bg-[#052d3f]/10 z-10">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
  </button>
  
  <button class="carousel-next absolute right-0 top-1/2 transform -translate-y-1/2 bg-white/90 text-[#052d3f] rounded-full p-2 shadow-md border border-[#052d3f]/20 hover:bg-[#052d3f]/10 z-10">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>
  </button>
  
  <!-- Indicators -->
  <div class="carousel-indicators flex justify-center mt-6 gap-2">
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-100"></span>
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-40"></span>
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-40"></span>
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-40"></span>
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-40"></span>
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-40"></span>
    <span class="w-2 h-2 rounded-full bg-[#052d3f] opacity-40"></span>
  </div>
</div>

<script>
  // Wait for DOM content to load
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('.carousel-container');
    const cards = document.querySelectorAll('.carousel-card');
    const prevBtn = document.querySelector('.carousel-prev');
    const nextBtn = document.querySelector('.carousel-next');
    const indicators = document.querySelectorAll('.carousel-indicators span');
    
    let currentIndex = 0;
    let cardWidth = cards[0].clientWidth + 16; // Add margin
    const totalCards = cards.length;
    
    // Function to update carousel position
    function updateCarousel() {
      // Calculate how many cards to show based on container width
      const containerWidth = container.parentElement.clientWidth;
      const visibleCards = Math.floor(containerWidth / cardWidth);
      const maxIndex = totalCards - visibleCards;
      
      // Ensure currentIndex doesn't go beyond limits
      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }
      
      // Calculate transform value
      const translateX = -currentIndex * cardWidth;
      
      // Apply transform
      container.style.transform = `translateX(${translateX}px)`;
      
      // Update indicators
      indicators.forEach((indicator, index) => {
        if (index === currentIndex) {
          indicator.classList.add('opacity-100');
          indicator.classList.remove('opacity-40');
        } else {
          indicator.classList.add('opacity-40');
          indicator.classList.remove('opacity-100');
        }
      });
      
      // Handle button visibility
      prevBtn.style.opacity = currentIndex === 0 ? '0.5' : '1';
      nextBtn.style.opacity = currentIndex >= maxIndex ? '0.5' : '1';
    }
    
    // Event listeners for navigation
    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    });
    
    nextBtn.addEventListener('click', () => {
      const containerWidth = container.parentElement.clientWidth;
      const visibleCards = Math.floor(containerWidth / cardWidth);
      const maxIndex = totalCards - visibleCards;
      
      if (currentIndex < maxIndex) {
        currentIndex++;
        updateCarousel();
      }
    });
    
    // Handle indicator clicks
    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentIndex = index;
        updateCarousel();
      });
    });
    
    // Auto advance the carousel
    let autoPlayInterval = setInterval(() => {
      const containerWidth = container.parentElement.clientWidth;
      const visibleCards = Math.floor(containerWidth / cardWidth);
      const maxIndex = totalCards - visibleCards;
      
      if (currentIndex < maxIndex) {
        currentIndex++;
      } else {
        currentIndex = 0;
      }
      
      updateCarousel();
    }, 6000); // Change slide every 6 seconds
    
    // Pause auto advance on hover
    const carouselElement = document.querySelector('.framework-carousel');
    carouselElement.addEventListener('mouseenter', () => {
      clearInterval(autoPlayInterval);
    });
    
    carouselElement.addEventListener('mouseleave', () => {
      autoPlayInterval = setInterval(() => {
        const containerWidth = container.parentElement.clientWidth;
        const visibleCards = Math.floor(containerWidth / cardWidth);
        const maxIndex = totalCards - visibleCards;
        
        if (currentIndex < maxIndex) {
          currentIndex++;
        } else {
          currentIndex = 0;
        }
        
        updateCarousel();
      }, 6000);
    });
    
    // Handle window resize
    window.addEventListener('resize', () => {
      // Recalculate card width
      cardWidth = cards[0].clientWidth + 16;
      updateCarousel();
    });
    
    // Initial update
    updateCarousel();
  });
</script>